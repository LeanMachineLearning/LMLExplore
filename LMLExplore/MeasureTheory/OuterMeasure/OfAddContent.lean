module

public import Mathlib.MeasureTheory.OuterMeasure.OfAddContent
public import Mathlib.MeasureTheory.SetAlgebra
import Mathlib.MeasureTheory.Measure.Typeclasses.Finite

/-!
# Finite measures as the outer measures of their generating algebras

A finite measure on the σ-algebra generated by an algebra of sets is determined by its values on
the algebra, through Carathéodory's construction: the measure of a set of the generated σ-algebra
is the infimum of `∑' i, μ (f i)` over the countable covers `⋃ i, f i` of the set by members of the
algebra. This is the covering form of the uniqueness of the extension of a finite measure from a
generating algebra [Bil79, §3]. It applies to the union of the σ-algebras of a filtration, which is
an algebra of sets: every set of the limit σ-algebra `⨆ n, ℱ n` is covered by countably many events
of the filtration, of total measure arbitrarily close to its own.

## Main statements

* `MeasureTheory.measure_eq_iInf_tsum_of_isSetAlgebra`: a finite measure of a set of the
  σ-algebra generated by an algebra of measurable sets is the infimum of the sums of its values on
  the countable covers of the set by members of the algebra.

## Implementation notes

The proof restricts the measure to an additive content on the algebra
(`MeasureTheory.IsSetRing.addContent_of_union`), extends it to a measure on the generated
σ-algebra by Mathlib's Carathéodory construction `MeasureTheory.AddContent.measure`, whose values
are those of the induced outer measure, and identifies that measure with the trimmed measure by
uniqueness of the extension from a π-system (`MeasureTheory.ext_of_generate_finite`).

## References

* [Bil79] P. Billingsley, *Probability and Measure*, Wiley Series in Probability and Mathematical
  Statistics, John Wiley & Sons, New York, 1979, §3 (the Carathéodory extension of a probability
  measure from a field of sets, through the outer measure of countable covers by members of the
  field).
-/

public section

open Set MeasurableSpace
open scoped ENNReal

namespace MeasureTheory

variable {α : Type*} {mα : MeasurableSpace α}

/-- **The covering form of the extension of a finite measure from an algebra** [Bil79, §3]. For a
finite measure `μ` and an algebra `C` of measurable sets, the measure of a set of the σ-algebra
generated by `C` is the infimum of `∑' i, μ (f i)` over the countable covers `s ⊆ ⋃ i, f i` of the
set by members of `C`.

The finiteness of `μ` is needed: for the counting measure on `ℚ` and the algebra generated by the
intervals with dyadic endpoints, which generates the singletons, every cover of a singleton by
members of the algebra has infinite measure. -/
theorem measure_eq_iInf_tsum_of_isSetAlgebra (μ : Measure α) [IsFiniteMeasure μ]
    {C : Set (Set α)} (hC : IsSetAlgebra C) (hCm : ∀ s ∈ C, MeasurableSet s) {s : Set α}
    (hs : MeasurableSet[generateFrom C] s) :
    μ s = ⨅ (f : ℕ → Set α) (_ : ∀ i, f i ∈ C) (_ : s ⊆ ⋃ i, f i), ∑' i, μ (f i) := by
  refine le_antisymm (le_iInf fun f ↦ le_iInf fun _ ↦ le_iInf fun hsf ↦
    (measure_mono hsf).trans (measure_iUnion_le f)) ?_
  have hle : generateFrom C ≤ mα := generateFrom_le hCm
  have hCs : IsSetSemiring C := hC.isSetRing.isSetSemiring
  -- the restriction of `μ` to `C` is a σ-subadditive content
  let m : AddContent ℝ≥0∞ C := hC.isSetRing.addContent_of_union (fun s ↦ μ s) measure_empty
    fun _ ht hst ↦ measure_union hst (hCm _ ht)
  have hm_apply : ∀ t, m t = μ t := fun _ ↦ rfl
  have hm : m.IsSigmaSubadditive := fun f _ _ ↦ measure_iUnion_le (μ := μ) f
  -- its Carathéodory extension `ν` is the trimmed measure, by uniqueness from the π-system `C`
  let ν : @Measure α (generateFrom C) := m.measure (mα := generateFrom C) hCs le_rfl hm
  have h_eq : ∀ t ∈ C, ν t = μ t := fun t ht ↦ m.measure_eq (mα := generateFrom C) hCs rfl hm ht
  have h_ext : μ.trim hle = ν := by
    refine ext_of_generate_finite (m0 := generateFrom C) C rfl hCs.isPiSystem (fun t ht ↦ ?_) ?_
    · rw [trim_measurableSet_eq hle (measurableSet_generateFrom ht), h_eq t ht]
    · rw [trim_measurableSet_eq hle (@MeasurableSet.univ _ (generateFrom C)),
        h_eq univ hC.univ_mem]
  -- on the generated σ-algebra, `ν` is the outer measure induced by the content, an infimum
  -- over the countable covers by members of `C`
  have h_ind : μ s = inducedOuterMeasure (fun t (_ : t ∈ C) ↦ μ t) hCs.empty_mem measure_empty s :=
    calc μ s = μ.trim hle s := (trim_measurableSet_eq hle hs).symm
    _ = ν s := by rw [h_ext]
    -- `ν` is by definition (`AddContent.measure`) the trim to `generateFrom C` of the
    -- Carathéodory measure, whose values are those of the induced outer measure
    _ = inducedOuterMeasure (fun t (_ : t ∈ C) ↦ m t) hCs.empty_mem addContent_empty s :=
      (trim_measurableSet_eq (m := generateFrom C) _ hs).trans
        (m.measureCaratheodory_eq_inducedOuterMeasure hCs hm)
    -- the content `m` is `μ` on `C`, by construction
    _ = _ := by simp only [hm_apply]
  rw [h_ind, inducedOuterMeasure,
    OuterMeasure.ofFunction_eq_iInf_mem _ _ (fun t ht ↦ extend_eq_top _ ht)]
  exact iInf₂_mono fun f hf ↦ iInf_mono fun _ ↦
    tsum_le_tsum fun i ↦ (extend_eq (fun t (_ : t ∈ C) ↦ μ t) (hf i)).ge

end MeasureTheory
