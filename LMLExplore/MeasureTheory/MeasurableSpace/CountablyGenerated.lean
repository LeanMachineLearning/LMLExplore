module

public import Mathlib.MeasureTheory.Constructions.Polish.Basic
public import Mathlib.MeasureTheory.MeasurableSpace.CountablyGenerated
import Mathlib.MeasureTheory.Function.FactorsThrough
import Mathlib.MeasureTheory.MeasurableSpace.Pi
import TauCeti.MeasureTheory.MeasurableSpace.CountablyGenerated

/-!
# Countable products of countably generated measurable spaces, and Boolean coordinates

The product σ-algebra on `∀ i, α i` is generated by the preimages, under the coordinate maps, of
generating families of the factors. For a countable index type and countable generating families
this is a countable family, so a countable product of countably generated measurable spaces is
countably generated. Mathlib has the binary product (the instance on `α × β`).

Countably many measurable functions `f k` on powers `ι k → α` of one measurable space, with values
in a nonempty standard Borel space, factor through a single measurable map `q : α → ℕ → Bool`
applied to every coordinate: `f k = g k ∘ fun x i ↦ q (x i)` with `g k` measurable. The
σ-algebra pulled back along `f k` is countably generated, each of its generators lies in the
σ-algebra generated by countably many cylinders `{x | x i ∈ A}`, and the countably many sides `A`
are pulled back from the Cantor space along one map. This is Tau Ceti's
`Measurable.exists_eq_measurable_comp_prodMap` for powers instead of binary products, and for
countably many functions at once. It replaces an arbitrary measurable space by a countably
generated one before any measure enters.

## Main statements

* `MeasurableSpace.CountablyGenerated.pi`: a countable product of countably generated measurable
  spaces is countably generated.
* `MeasurableSpace.exists_measurable_forall_eq_measurable_comp_piMap`: countably many measurable
  functions on powers of `α` factor through Boolean coordinates of each coordinate.

## Implementation notes

The factorization through Boolean coordinates is adapted from
`EValuesResearch/Results/NumeraireTrimAux.lean` (commit `dd4072f`) in the paper project
`RemyDegenne/evalues_research`, rewritten on the API of Mathlib and Tau Ceti.
-/

public section

open MeasureTheory

namespace MeasurableSpace

/-- A countable product of countably generated measurable spaces is countably generated. -/
instance CountablyGenerated.pi {ι : Type*} [Countable ι] {α : ι → Type*}
    [∀ i, MeasurableSpace (α i)] [∀ i, CountablyGenerated (α i)] :
    CountablyGenerated (∀ i, α i) := by
  refine ⟨⟨⋃ i, (fun s ↦ (fun b : ∀ i, α i ↦ b i) ⁻¹' s) '' countableGeneratingSet (α i),
    Set.countable_iUnion fun i ↦ countable_countableGeneratingSet.image _, ?_⟩⟩
  rw [← iSup_generateFrom]
  refine iSup_congr fun i ↦ ?_
  rw [← comap_generateFrom, generateFrom_countableGeneratingSet]

/-- **Countably many measurable functions on powers factor through Boolean coordinates.** Let
`f k : (ι k → α) → γ`, for `k` in a countable type, be measurable functions into a nonempty
standard Borel space. There is a single measurable `q : α → ℕ → Bool` such that every `f k` is a
measurable function of the images `fun i ↦ q (x i)` of the coordinates. -/
theorem exists_measurable_forall_eq_measurable_comp_piMap {κ : Type*} [Countable κ]
    {ι : κ → Type*} {α γ : Type*} [MeasurableSpace α] [MeasurableSpace γ] [StandardBorelSpace γ]
    [Nonempty γ] {f : ∀ k, (ι k → α) → γ} (hf : ∀ k, Measurable (f k)) :
    ∃ q : α → ℕ → Bool, Measurable q ∧ ∃ g : ∀ k, (ι k → ℕ → Bool) → γ,
      (∀ k, Measurable (g k)) ∧ ∀ k, f k = g k ∘ fun x i ↦ q (x i) := by
  -- the σ-algebra pulled back along `f k` is generated by countably many sets `C k`
  choose C hCc hCgen using fun k ↦
    (CountablyGenerated.comap (f k) (m := (inferInstance : MeasurableSpace γ))).isCountablyGenerated
  -- each of them uses countably many cylinders
  have hD (k : κ) (c : Set (ι k → α)) (hc : c ∈ C k) :
      ∃ D ⊆ {B | ∃ (i : ι k) (A : Set α), MeasurableSet A ∧ Function.eval i ⁻¹' A = B},
        D.Countable ∧ MeasurableSet[generateFrom D] c := by
    have h := (hf k).comap_le c (hCgen k ▸ measurableSet_generateFrom hc)
    rw [pi_eq_generateFrom_projections] at h
    exact h.exists_countable_subset_generateFrom
  choose D hDcyl hDc hD using hD
  set R : ∀ k, Set (Set (ι k → α)) := fun k ↦ ⋃ (c) (hc : c ∈ C k), D k c hc
  have hRc (k : κ) : (R k).Countable := (hCc k).biUnion (hDc k)
  -- the sides of these cylinders
  choose idx side hside hidx using fun k (B : R k) ↦
    Set.iUnion₂_subset (hDcyl k) B.property
  set 𝒜 : Set (Set α) := ⋃ k, Set.range (side k)
  have h𝒜c : 𝒜.Countable := Set.countable_iUnion fun k ↦
    have := (hRc k).to_subtype
    Set.countable_range _
  obtain ⟨q, hq, hqgen⟩ := h𝒜c.exists_measurable_comap_eq_generateFrom (by
    simp only [𝒜, Set.mem_iUnion, Set.mem_range, forall_exists_index]
    rintro _ k B rfl
    exact hside k B)
  refine ⟨q, hq, ?_⟩
  -- every `f k` is measurable for the σ-algebra pulled back along the Boolean coordinates
  have hle (k : κ) : MeasurableSpace.comap (f k) (inferInstance : MeasurableSpace γ) ≤
      MeasurableSpace.comap (fun (x : ι k → α) i ↦ q (x i)) MeasurableSpace.pi := by
    rw [hCgen k]
    refine generateFrom_le fun c hc ↦ generateFrom_le (fun B hB ↦ ?_) c (hD k c hc)
    have hBR : B ∈ R k := Set.mem_iUnion₂.2 ⟨c, hc, hB⟩
    obtain ⟨A, hA, hAeq⟩ : MeasurableSet[MeasurableSpace.comap q MeasurableSpace.pi]
        (side k ⟨B, hBR⟩) :=
      hqgen ▸ measurableSet_generateFrom (Set.mem_iUnion.2 ⟨k, ⟨B, hBR⟩, rfl⟩)
    refine ⟨Function.eval (idx k ⟨B, hBR⟩) ⁻¹' A, measurable_pi_apply _ hA, ?_⟩
    have h := hidx k ⟨B, hBR⟩
    rw [← hAeq] at h
    exact h
  choose g hg hfg using fun k ↦ (measurable_iff_comap_le.2 (hle k)).exists_eq_measurable_comp
  exact ⟨g, hg, hfg⟩

end MeasurableSpace
