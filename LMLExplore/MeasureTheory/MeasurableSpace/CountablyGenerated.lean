module

public import Mathlib.MeasureTheory.MeasurableSpace.CountablyGenerated

/-!
# Countable products of countably generated measurable spaces

The product σ-algebra on `∀ i, α i` is generated by the preimages, under the coordinate maps, of
generating families of the factors. For a countable index type and countable generating families
this is a countable family, so a countable product of countably generated measurable spaces is
countably generated. Mathlib has the binary product (the instance on `α × β`).

## Main statements

* `MeasurableSpace.CountablyGenerated.pi`: a countable product of countably generated measurable
  spaces is countably generated.
-/

public section

namespace MeasurableSpace

/-- A countable product of countably generated measurable spaces is countably generated. -/
instance CountablyGenerated.pi {ι : Type*} [Countable ι] {α : ι → Type*}
    [∀ i, MeasurableSpace (α i)] [∀ i, CountablyGenerated (α i)] :
    CountablyGenerated (∀ i, α i) := by
  refine ⟨⟨⋃ i, (fun s ↦ (fun b : ∀ i, α i ↦ b i) ⁻¹' s) '' countableGeneratingSet (α i),
    Set.countable_iUnion fun i ↦ countable_countableGeneratingSet.image _, ?_⟩⟩
  rw [← iSup_generateFrom]
  refine iSup_congr fun i ↦ ?_
  rw [← comap_generateFrom, generateFrom_countableGeneratingSet]

end MeasurableSpace
