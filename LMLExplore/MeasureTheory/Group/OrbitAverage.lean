module

public import Mathlib.MeasureTheory.Group.Action
public import Mathlib.MeasureTheory.Group.LIntegral
public import Mathlib.MeasureTheory.Measure.Prod
import Mathlib.MeasureTheory.Integral.Lebesgue.Countable

/-!
# Averages over the orbits of a group action

For a group `G` acting on `α` and a measure `η` on `G`, the **orbit average** of a function
`f : α → ℝ≥0∞` is `orbitAverage η f x = ∫⁻ g, f (g • x) ∂η`. When `G` is compact and `η` is its
Haar probability measure, it is the symmetrization of `f`, the average of `f` over the orbit of
`x`; for a finite group and the uniform measure, it is `(∑ g, f (g • x)) / #G`.

The orbit average is the adjoint of the symmetrization `∫ g_* μ dη(g)` of measures, so that it
does not change the integral of `f` against an invariant measure (`lintegral_orbitAverage`), and
the invariant measures are exactly the measures against which every function and its orbit
average have the same integral (`smulInvariantMeasure_iff_lintegral_orbitAverage`) [LRR26,
Lemma 5.4]. This is how the e-variables for the invariant laws are described.

## Main definitions

* `MeasureTheory.orbitAverage η f`: the average of `f` over the orbits, with weights `η`.

## Main statements

* `MeasureTheory.lintegral_orbitAverage`: `∫⁻ orbitAverage η f ∂μ = η univ * ∫⁻ f ∂μ` for an
  invariant measure `μ`.
* `MeasureTheory.smulInvariantMeasure_iff_lintegral_orbitAverage`: for a left-invariant
  probability measure `η`, a measure is invariant exactly when the orbit average preserves the
  integral of every measurable function [LRR26, Lemma 5.4].
* `MeasureTheory.orbitAverage_smul`: for a right-invariant `η`, the orbit average is constant on
  the orbits, and `MeasureTheory.orbitAverage_orbitAverage`: averaging twice is averaging once.
* `MeasureTheory.orbitAverage_ite_div`: the orbit average of the ratio `f / orbitAverage η f`,
  with `0 / 0 = 1`, is `1` where the orbit average of `f` is finite, and `0` elsewhere.
* `MeasureTheory.lintegral_map_smul_const`: the orbit average at `x` is the integral against the
  image `η.map (· • x)` of `η` on the orbit of `x`, an invariant measure when `η` is
  left-invariant (`MeasureTheory.smulInvariantMeasure_map_smul_const`).

## References

* [LRR26] M. Larsson, A. Ramdas and J. Ruf, *Testing hypotheses generated by constraints*, Math.
  Oper. Res. (2026), arXiv:2504.02974v5: Section 5.
-/

public section

open Set
open scoped ENNReal

namespace MeasureTheory

open Measure

variable {G α : Type*} [MeasurableSpace G] {η : Measure G} {f : α → ℝ≥0∞}

section SMul

variable [SMul G α]

/-- The **orbit average** of `f : α → ℝ≥0∞` with weights `η`: `x ↦ ∫⁻ g, f (g • x) ∂η`. For the
Haar probability measure of a compact group it is the symmetrization of `f`, the average of `f`
over the orbit of `x`. -/
noncomputable def orbitAverage (η : Measure G) (f : α → ℝ≥0∞) (x : α) : ℝ≥0∞ :=
  ∫⁻ g, f (g • x) ∂η

theorem orbitAverage_apply (η : Measure G) (f : α → ℝ≥0∞) (x : α) :
    orbitAverage η f x = ∫⁻ g, f (g • x) ∂η := (rfl)

/-- The orbit average of a constant is the constant times the mass of `η`. -/
@[simp]
theorem orbitAverage_const (η : Measure G) (c : ℝ≥0∞) :
    orbitAverage η (fun _ : α ↦ c) = fun _ ↦ c * η univ := by
  ext x
  simp [orbitAverage_apply]

@[simp]
theorem orbitAverage_one (η : Measure G) [IsProbabilityMeasure η] :
    orbitAverage η (1 : α → ℝ≥0∞) = 1 := by
  ext x
  simp [orbitAverage_apply]

/-- For a finite group with the uniform measure, the orbit average is
`(∑ g, f (g • x)) / #G`. -/
theorem orbitAverage_inv_card_smul_count [Fintype G] [MeasurableSingletonClass G]
    (f : α → ℝ≥0∞) :
    orbitAverage ((Fintype.card G : ℝ≥0∞)⁻¹ • (count : Measure G)) f =
      fun x ↦ (∑ g : G, f (g • x)) / Fintype.card G := by
  ext x
  rw [orbitAverage_apply, lintegral_smul_measure, lintegral_count, tsum_fintype, smul_eq_mul,
    ENNReal.div_eq_inv_mul]

/-- The orbit average is monotone in the function. -/
theorem orbitAverage_mono {f₁ f₂ : α → ℝ≥0∞} (h : f₁ ≤ f₂) :
    orbitAverage η f₁ ≤ orbitAverage η f₂ := fun x ↦
  lintegral_mono fun g ↦ h (g • x)

variable [MeasurableSpace α]

/-- The orbit average of a measurable function is measurable, for a jointly measurable
action. -/
theorem Measurable.orbitAverage [MeasurableSMul₂ G α] [SFinite η] (hf : Measurable f) :
    Measurable (orbitAverage η f) :=
  Measurable.lintegral_prod_right' (f := fun p : α × G ↦ f (p.2 • p.1))
    (hf.comp (measurable_smul.comp measurable_swap))

/-- The orbit average at `x` is the integral against the image of `η` on the orbit of `x`. -/
theorem lintegral_map_smul_const [MeasurableSMul G α] (hf : Measurable f) (x : α) :
    ∫⁻ y, f y ∂(η.map (· • x)) = orbitAverage η f x :=
  lintegral_map hf (measurable_smul_const x)

/-- **The orbit average does not change integrals against invariant measures**:
`∫⁻ orbitAverage η f ∂μ = η univ * ∫⁻ f ∂μ`. -/
theorem lintegral_orbitAverage [MeasurableSMul₂ G α] [SFinite η] {μ : Measure α} [SFinite μ]
    [SMulInvariantMeasure G α μ] (hf : Measurable f) :
    ∫⁻ x, orbitAverage η f x ∂μ = η univ * ∫⁻ x, f x ∂μ := by
  simp_rw [orbitAverage_apply]
  rw [lintegral_lintegral_swap (f := fun x (g : G) ↦ f (g • x))
    (hf.comp (measurable_smul.comp measurable_swap)).aemeasurable]
  simp_rw [fun g ↦ (measurePreserving_smul g μ).lintegral_comp hf, lintegral_const, mul_comm]

end SMul

section MulAction

variable [Group G] [MeasurableMul G] [MulAction G α]

section NoMeasurableSpace

/-- For a left-invariant `η`, translating a function by an element of the group does not change
its orbit average. -/
theorem orbitAverage_comp_smul [IsMulLeftInvariant η] (f : α → ℝ≥0∞) (g : G) :
    orbitAverage η (fun x ↦ f (g • x)) = orbitAverage η f := by
  ext x
  simp_rw [orbitAverage_apply, smul_smul]
  exact lintegral_mul_left_eq_self (fun h ↦ f (h • x)) g

/-- For a right-invariant `η`, the orbit average is constant on the orbits. -/
@[simp]
theorem orbitAverage_smul [IsMulRightInvariant η] (f : α → ℝ≥0∞) (g : G) (x : α) :
    orbitAverage η f (g • x) = orbitAverage η f x := by
  simp_rw [orbitAverage_apply, smul_smul]
  exact lintegral_mul_right_eq_self (fun h ↦ f (h • x)) g

/-- For a right-invariant probability measure `η`, averaging twice over the orbits is averaging
once. -/
@[simp]
theorem orbitAverage_orbitAverage [IsMulRightInvariant η] [IsProbabilityMeasure η]
    (f : α → ℝ≥0∞) : orbitAverage η (orbitAverage η f) = orbitAverage η f := by
  ext x
  simp [orbitAverage_apply (f := orbitAverage η f), orbitAverage_smul]

end NoMeasurableSpace

/-- **The orbit average of a normalized function**: for a right-invariant probability measure
`η`, the ratio `f / orbitAverage η f`, with `0 / 0 = 1`, has orbit average `1` at the points where
the orbit average of `f` is finite, and `0` at the others. -/
theorem orbitAverage_ite_div [MeasurableSpace α] [MeasurableSMul G α] [IsMulRightInvariant η]
    [IsProbabilityMeasure η] (hf : Measurable f) (x : α) :
    orbitAverage η (fun y ↦ if orbitAverage η f y = 0 then 1 else f y / orbitAverage η f y) x =
      if orbitAverage η f x = ∞ then 0 else 1 := by
  rw [orbitAverage_apply]
  simp_rw [orbitAverage_smul]
  by_cases h0 : orbitAverage η f x = 0
  · simp [h0]
  simp_rw [h0, ite_false, div_eq_mul_inv]
  rw [lintegral_mul_const (f := fun g ↦ f (g • x)) _ (hf.comp (measurable_smul_const x)),
    ← orbitAverage_apply,
    ← div_eq_mul_inv]
  by_cases htop : orbitAverage η f x = ∞
  · simp [htop]
  · simp [htop, ENNReal.div_self h0 htop]

variable [MeasurableSpace α]

/-- For a left-invariant `η`, the image `η.map (· • x)` of `η` on the orbit of `x` is an invariant
measure. -/
theorem smulInvariantMeasure_map_smul_const [MeasurableSMul G α] [IsMulLeftInvariant η]
    (x : α) : SMulInvariantMeasure G α (η.map (· • x)) :=
  smulInvariantMeasure_map η _ (fun _ _ ↦ mul_smul _ _ _) (measurable_smul_const x)

/-- **Invariant measures through orbit averages** [LRR26, Lemma 5.4]: for a left-invariant
probability measure `η`, a measure `μ` is invariant exactly when every measurable function and its
orbit average have the same integral against `μ`. -/
theorem smulInvariantMeasure_iff_lintegral_orbitAverage [MeasurableSMul₂ G α]
    [IsMulLeftInvariant η] [IsProbabilityMeasure η] {μ : Measure α} [SFinite μ] :
    SMulInvariantMeasure G α μ ↔
      ∀ f : α → ℝ≥0∞, Measurable f → ∫⁻ x, orbitAverage η f x ∂μ = ∫⁻ x, f x ∂μ := by
  refine ⟨fun _ f hf ↦ by simp [lintegral_orbitAverage hf], fun h ↦ ⟨fun g s hs ↦ ?_⟩⟩
  have hgs : MeasurableSet ((g • ·) ⁻¹' s) := measurable_const_smul g hs
  have hind : ((g • ·) ⁻¹' s).indicator 1 = fun x ↦ s.indicator (1 : α → ℝ≥0∞) (g • x) :=
    funext fun _ ↦ indicator_comp_right (g := 1) _
  rw [← lintegral_indicator_one hgs, ← lintegral_indicator_one hs,
    ← h _ (measurable_one.indicator hgs), ← h _ (measurable_one.indicator hs), hind,
    orbitAverage_comp_smul]

end MulAction

end MeasureTheory
