module

public import Mathlib.MeasureTheory.Integral.Bochner.Basic
public import Mathlib.Order.LiminfLimsup
import LMLExplore.MeasureTheory.Measure.SetwiseConvergence

/-!
# Lower semicontinuous envelopes of functions of probability measures

The topology on the probability measures of a measurable space generated by the integrals of the
bounded measurable functions (the `τ`-topology of large deviations theory) has the basic
neighbourhoods `{R | ∀ i, |∫ g i ∂R - ∫ g i ∂Q| ≤ ε}` of `Q`, for finitely many bounded
measurable functions `g i` and a tolerance `ε > 0`. For a function `Φ` of measures with values in
`EReal`, this file defines its lower semicontinuous envelope at `Q` for that topology, and a
sequential version for setwise convergence, without defining the topology.

* The *neighbourhood envelope* `tauEnvelope Φ Q` is the supremum, over the basic neighbourhoods
  of `Q`, of the infimum of `Φ` over the probability measures in them (`tauNbhdInf`).
* The *sequential envelope* `seqTauEnvelope Φ Q` is the infimum of `liminf Φ (R n)` over the
  sequences of probability measures `R n` with `R n A → Q A` for every measurable set `A`.

For a probability measure `Q`, `tauEnvelope Φ Q ≤ seqTauEnvelope Φ Q ≤ Φ Q`: a setwise
convergent sequence of probability measures is eventually in every basic neighbourhood, since the
integrals of a bounded measurable function converge along it
(`MeasureTheory.tendsto_integral_of_tendsto_measure`).
The smallest relative entropy to a null hypothesis is the function these envelopes are applied to
in `LMLExplore.EValues.BipolarRate.Envelope`, where they bound the optimal growth rate of
e-processes.

## Main definitions

* `MeasureTheory.tauNbhdInf Φ Q g ε`: the infimum of `Φ` over the probability measures of the
  basic neighbourhood of `Q` given by the functions `g i` and the tolerance `ε`.
* `MeasureTheory.tauEnvelope Φ Q`: the neighbourhood envelope of `Φ` at `Q`.
* `MeasureTheory.seqTauEnvelope Φ Q`: the sequential envelope of `Φ` at `Q`.

## Main statements

* `MeasureTheory.tauEnvelope_le`, `MeasureTheory.seqTauEnvelope_le`: both envelopes are at most
  `Φ Q` at a probability measure `Q`.
* `MeasureTheory.tauEnvelope_le_seqTauEnvelope`: the neighbourhood envelope is at most the
  sequential envelope.

## Implementation notes

Basic neighbourhoods are written with `≤ ε`. Every neighbourhood of `Q` for the topology of the
integrals of the bounded measurable functions contains one of them, so the supremum over them is
the lower semicontinuous envelope. The infima are over probability measures only, so `Φ` matters
only on probability measures. The definitions and their first properties are adapted from
`EValuesResearch/Results/Envelopes.lean` in the paper project `RemyDegenne/evalues_research`.

## References

* [EVR26] *Answers to open questions in e-values and anytime-valid inference*, notes and the Lean
  library `EValuesResearch` of github.com/RemyDegenne/evalues_research, 2026; written and refereed
  by AI agents: Note 15, *When does the bipolar rate equal KL_inf? A variational formula*, and
  Note 19, *The bipolar rate is not determined by the single-letter τ-envelopes of KL_inf*.
-/

public section

open Filter
open scoped Topology

namespace MeasureTheory

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {Φ Ψ : Measure Ω → EReal} {Q R : Measure Ω}
  {k : ℕ} {g : Fin k → Ω → ℝ} {ε : ℝ} {c : EReal}

/-! ### Definitions -/

/-- The infimum of `Φ` over a basic neighbourhood of `Q` for the topology of the integrals of
bounded measurable functions: over the probability measures `R` with
`|∫ g i ∂R - ∫ g i ∂Q| ≤ ε` for every `i`. -/
noncomputable def tauNbhdInf (Φ : Measure Ω → EReal) (Q : Measure Ω) {k : ℕ}
    (g : Fin k → Ω → ℝ) (ε : ℝ) : EReal :=
  ⨅ (R : Measure Ω) (_ : IsProbabilityMeasure R)
    (_ : ∀ i, |∫ x, g i x ∂R - ∫ x, g i x ∂Q| ≤ ε), Φ R

lemma tauNbhdInf_def (Φ : Measure Ω → EReal) (Q : Measure Ω) (g : Fin k → Ω → ℝ) (ε : ℝ) :
    tauNbhdInf Φ Q g ε = ⨅ (R : Measure Ω) (_ : IsProbabilityMeasure R)
      (_ : ∀ i, |∫ x, g i x ∂R - ∫ x, g i x ∂Q| ≤ ε), Φ R :=
  (rfl)

/-- The **neighbourhood envelope** of `Φ` at `Q`: the lower semicontinuous envelope at `Q` for the
topology of the integrals of bounded measurable functions, as the supremum over the basic
neighbourhoods of `Q` (finitely many bounded measurable functions `g i` and a tolerance `ε > 0`)
of the infimum of `Φ` over the probability measures in them. -/
noncomputable def tauEnvelope (Φ : Measure Ω → EReal) (Q : Measure Ω) : EReal :=
  ⨆ (k : ℕ) (g : Fin k → Ω → ℝ) (_ : ∀ i, Measurable (g i)) (_ : ∀ i, ∃ C, ∀ x, |g i x| ≤ C)
    (ε : ℝ) (_ : 0 < ε), tauNbhdInf Φ Q g ε

lemma tauEnvelope_def (Φ : Measure Ω → EReal) (Q : Measure Ω) :
    tauEnvelope Φ Q = ⨆ (k : ℕ) (g : Fin k → Ω → ℝ) (_ : ∀ i, Measurable (g i))
      (_ : ∀ i, ∃ C, ∀ x, |g i x| ≤ C) (ε : ℝ) (_ : 0 < ε), tauNbhdInf Φ Q g ε :=
  (rfl)

/-- The **sequential envelope** of `Φ` at `Q`: the infimum of `liminf Φ (R n)` over the sequences
of probability measures `R n` that converge to `Q` on every measurable set. -/
noncomputable def seqTauEnvelope (Φ : Measure Ω → EReal) (Q : Measure Ω) : EReal :=
  ⨅ (R : ℕ → Measure Ω) (_ : ∀ n, IsProbabilityMeasure (R n))
    (_ : ∀ A, MeasurableSet A → Tendsto (fun n ↦ R n A) atTop (𝓝 (Q A))),
    liminf (fun n ↦ Φ (R n)) atTop

lemma seqTauEnvelope_def (Φ : Measure Ω → EReal) (Q : Measure Ω) :
    seqTauEnvelope Φ Q = ⨅ (R : ℕ → Measure Ω) (_ : ∀ n, IsProbabilityMeasure (R n))
      (_ : ∀ A, MeasurableSet A → Tendsto (fun n ↦ R n A) atTop (𝓝 (Q A))),
      liminf (fun n ↦ Φ (R n)) atTop :=
  (rfl)

/-! ### The infimum over a basic neighbourhood -/

lemma le_tauNbhdInf_iff :
    c ≤ tauNbhdInf Φ Q g ε ↔ ∀ R, IsProbabilityMeasure R →
      (∀ i, |∫ x, g i x ∂R - ∫ x, g i x ∂Q| ≤ ε) → c ≤ Φ R := by
  simp only [tauNbhdInf, le_iInf_iff]

/-- The infimum of `Φ` over a basic neighbourhood is at most its value at every probability
measure of the neighbourhood. -/
lemma tauNbhdInf_le (hR : IsProbabilityMeasure R)
    (hRg : ∀ i, |∫ x, g i x ∂R - ∫ x, g i x ∂Q| ≤ ε) : tauNbhdInf Φ Q g ε ≤ Φ R :=
  le_tauNbhdInf_iff.1 le_rfl R hR hRg

@[gcongr]
lemma tauNbhdInf_mono (h : ∀ R, IsProbabilityMeasure R → Φ R ≤ Ψ R) :
    tauNbhdInf Φ Q g ε ≤ tauNbhdInf Ψ Q g ε :=
  le_tauNbhdInf_iff.2 fun R hR hRg ↦ (tauNbhdInf_le hR hRg).trans (h R hR)

/-! ### The neighbourhood envelope -/

lemma tauEnvelope_le_iff :
    tauEnvelope Φ Q ≤ c ↔ ∀ (k : ℕ) (g : Fin k → Ω → ℝ), (∀ i, Measurable (g i)) →
      (∀ i, ∃ C, ∀ x, |g i x| ≤ C) → ∀ ε, 0 < ε → tauNbhdInf Φ Q g ε ≤ c := by
  simp only [tauEnvelope, iSup_le_iff]

lemma lt_tauEnvelope_iff :
    c < tauEnvelope Φ Q ↔ ∃ (k : ℕ) (g : Fin k → Ω → ℝ), (∀ i, Measurable (g i)) ∧
      (∀ i, ∃ C, ∀ x, |g i x| ≤ C) ∧ ∃ ε, 0 < ε ∧ c < tauNbhdInf Φ Q g ε := by
  simp only [tauEnvelope, lt_iSup_iff, exists_prop]

/-- The infimum of `Φ` over a basic neighbourhood is at most the neighbourhood envelope. -/
lemma tauNbhdInf_le_tauEnvelope (hg : ∀ i, Measurable (g i)) (hgb : ∀ i, ∃ C, ∀ x, |g i x| ≤ C)
    (hε : 0 < ε) : tauNbhdInf Φ Q g ε ≤ tauEnvelope Φ Q :=
  tauEnvelope_le_iff.1 le_rfl k g hg hgb ε hε

/-- The neighbourhood envelope of `Φ` at a probability measure `Q` is at most `Φ Q`: `Q` is in
each of its basic neighbourhoods. -/
lemma tauEnvelope_le [IsProbabilityMeasure Q] : tauEnvelope Φ Q ≤ Φ Q :=
  tauEnvelope_le_iff.2 fun _ _ _ _ _ hε ↦ tauNbhdInf_le ‹_› fun i ↦ by simpa using hε.le

@[gcongr]
lemma tauEnvelope_mono (h : ∀ R, IsProbabilityMeasure R → Φ R ≤ Ψ R) :
    tauEnvelope Φ Q ≤ tauEnvelope Ψ Q :=
  tauEnvelope_le_iff.2 fun _ _ hg hgb _ hε ↦
    (tauNbhdInf_mono h).trans (tauNbhdInf_le_tauEnvelope hg hgb hε)

/-! ### The sequential envelope -/

lemma le_seqTauEnvelope_iff :
    c ≤ seqTauEnvelope Φ Q ↔ ∀ R : ℕ → Measure Ω, (∀ n, IsProbabilityMeasure (R n)) →
      (∀ A, MeasurableSet A → Tendsto (fun n ↦ R n A) atTop (𝓝 (Q A))) →
      c ≤ liminf (fun n ↦ Φ (R n)) atTop := by
  simp only [seqTauEnvelope, le_iInf_iff]

/-- The sequential envelope of `Φ` at `Q` is at most `liminf Φ (R n)` along every sequence of
probability measures `R n` that converges to `Q` on every measurable set. -/
lemma seqTauEnvelope_le_liminf {R : ℕ → Measure Ω} (hR : ∀ n, IsProbabilityMeasure (R n))
    (hRQ : ∀ A, MeasurableSet A → Tendsto (fun n ↦ R n A) atTop (𝓝 (Q A))) :
    seqTauEnvelope Φ Q ≤ liminf (fun n ↦ Φ (R n)) atTop :=
  le_seqTauEnvelope_iff.1 le_rfl R hR hRQ

/-- The sequential envelope of `Φ` at a probability measure `Q` is at most `Φ Q`: take the
constant sequence. -/
lemma seqTauEnvelope_le [IsProbabilityMeasure Q] : seqTauEnvelope Φ Q ≤ Φ Q :=
  (seqTauEnvelope_le_liminf (R := fun _ ↦ Q) (fun _ ↦ ‹_›) fun _ _ ↦ tendsto_const_nhds).trans
    (by simp)

@[gcongr]
lemma seqTauEnvelope_mono (h : ∀ R, IsProbabilityMeasure R → Φ R ≤ Ψ R) :
    seqTauEnvelope Φ Q ≤ seqTauEnvelope Ψ Q :=
  le_seqTauEnvelope_iff.2 fun R hR hRQ ↦ (seqTauEnvelope_le_liminf hR hRQ).trans
    (liminf_le_liminf (.of_forall fun n ↦ h (R n) (hR n)))

/-- **The neighbourhood envelope is at most the sequential envelope.** Probability measures that
converge to `Q` on every measurable set have integrals of bounded measurable functions that
converge to those of `Q`, so they are eventually in every basic neighbourhood of `Q`. No
assumption on `Q` is needed: if such a sequence exists, then `Q univ = 1`. -/
theorem tauEnvelope_le_seqTauEnvelope (Φ : Measure Ω → EReal) (Q : Measure Ω) :
    tauEnvelope Φ Q ≤ seqTauEnvelope Φ Q := by
  refine le_seqTauEnvelope_iff.2 fun R hR hRQ ↦ tauEnvelope_le_iff.2 fun k g hg hgb ε hε ↦ ?_
  -- `Q` is a probability measure, as the limit of `R n univ = 1`
  have : IsProbabilityMeasure Q := ⟨tendsto_nhds_unique (hRQ _ MeasurableSet.univ)
    (tendsto_const_nhds.congr fun n ↦ (hR n).measure_univ.symm)⟩
  have hev : ∀ᶠ n in atTop, ∀ i, |∫ x, g i x ∂R n - ∫ x, g i x ∂Q| ≤ ε := by
    refine eventually_all.2 fun i ↦ ?_
    obtain ⟨C, hC⟩ := hgb i
    filter_upwards [Metric.tendsto_nhds.1 (tendsto_integral_of_tendsto_measure hRQ (hg i)
      (.of_forall fun _ ↦ .of_forall fun x ↦ by simpa [Real.norm_eq_abs] using hC x)) ε hε]
      with n hn
    rw [Real.dist_eq] at hn
    exact hn.le
  exact le_liminf_of_le (by isBoundedDefault) (hev.mono fun n hn ↦ tauNbhdInf_le (hR n) hn)

end MeasureTheory
