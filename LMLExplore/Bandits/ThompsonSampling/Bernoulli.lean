module

public import LMLExplore.Bandits.ThompsonSampling.Basic
public import LMLExplore.Probability.Distributions.ExponentialFamily.Bernoulli

/-!
# Thompson sampling with the Jeffreys prior for Bernoulli arms

The Bernoulli laws `Ber((1 : ℝ), 0, m)` with `m ∈ (0, 1)` form the natural exponential family
generated by `Ber((1 : ℝ), 0, sigmoid η₀)`, for any `η₀` (for example `η₀ = 0` and the fair coin).
Its Jeffreys prior is the arcsine law `Beta(1 / 2, 1 / 2)` on the mean, up to its total mass `π`,
and the image of the posterior after `s` observations of sum `S` by the mean map is
`Beta(S + 1 / 2, s - S + 1 / 2)` (`LMLExplore.map_deriv_cgf_jeffreysPrior_bernoulliMeasure_sigmoid`,
`LMLExplore.map_deriv_cgf_expFamilyPosterior_bernoulliMeasure_sigmoid_jeffreysPrior`). So Thompson
sampling with the Jeffreys prior for Bernoulli arms [KKM13, Figure 1] perturbs an arm with `S`
successes in `s ≥ 1` pulls by a mean drawn from `Beta(S + 1 / 2, s - S + 1 / 2)`, and it exceeds a
level `c` with the probability that this beta law gives to `(c, ∞)`: the quantity `G_s` of the
generic bound of follow-the-perturbed-leader [LS, Theorem 36.2]
(`LMLExplore.Bandits.ExpFamilyTS.lintegral_pullCount_le`).

## Main statements

* `LMLExplore.Bandits.expFamilyTSStackLaw_bernoulliMeasure_sigmoid_jeffreysPrior`: the
  perturbation law of an arm pulled `s ≠ 0` times with sum of rewards `S`, for
  `-1 / 2 < S < s + 1 / 2`, is the image in `EReal` of `Beta(S + 1 / 2, s - S + 1 / 2)`.

## References

* [KKM13] N. Korda, E. Kaufmann and R. Munos, *Thompson sampling for 1-dimensional exponential
  family bandits*, NeurIPS 2013.
* [LS] T. Lattimore and Cs. Szepesvári, *Bandit Algorithms*, Cambridge University Press, 2020,
  Chapter 36.
-/

public section

open MeasureTheory ProbabilityTheory

namespace LMLExplore.Bandits

variable {s : ℕ} {S : ℝ}

/-- **Thompson sampling with the Jeffreys prior for Bernoulli arms samples from beta laws**
[KKM13, Figure 1]: for the exponential family of `Ber((1 : ℝ), 0, sigmoid η₀)` and its Jeffreys
prior, the perturbation law of an arm pulled `s ≠ 0` times with sum of rewards `S`, for
`-1 / 2 < S < s + 1 / 2` (for example `S` successes in `s` pulls), is the image in `EReal` of
`Beta(S + 1 / 2, s - S + 1 / 2)`. -/
theorem expFamilyTSStackLaw_bernoulliMeasure_sigmoid_jeffreysPrior (η₀ : ℝ) (hs : s ≠ 0)
    (hS0 : -(1 / 2) < S) (hS1 : S < s + 1 / 2) :
    expFamilyTSStackLaw Ber((1 : ℝ), 0, unitInterval.sigmoid η₀)
        (Ber((1 : ℝ), 0, unitInterval.sigmoid η₀).jeffreysPrior id) s S =
      (betaMeasure (S + 1 / 2) (s - S + 1 / 2)).map ((↑) : ℝ → EReal) := by
  have hpost := map_deriv_cgf_expFamilyPosterior_bernoulliMeasure_sigmoid_jeffreysPrior η₀ hS0 hS1
  have := isProbabilityMeasureBeta (α := S + 1 / 2) (β := s - S + 1 / 2) (by linarith)
    (by linarith)
  have hne : Ber((1 : ℝ), 0, unitInterval.sigmoid η₀).expFamilyPosterior id
      (Ber((1 : ℝ), 0, unitInterval.sigmoid η₀).jeffreysPrior id) s S ≠ 0 := by
    intro h
    rw [h, Measure.map_zero] at hpost
    exact IsProbabilityMeasure.ne_zero _ hpost.symm
  rw [expFamilyTSStackLaw_of_ne_zero hs hne, ← hpost,
    Measure.map_map (by fun_prop) (measurable_deriv _), Function.comp_def]

end LMLExplore.Bandits
