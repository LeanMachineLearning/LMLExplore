module

public import Mathlib.Order.Filter.Germ.Basic
public import Mathlib.Order.Minimal

/-!
# Admissible elements and complete classes for an eventual order

Fix a filter `l` on `α` and a set `𝓑` of functions `α → β` into a preorder, the *bets*. A bet `f`
dominates a bet `g` when `g ≤ᶠ[l] f`. This file defines the bets that no bet dominates strictly,
the *admissible* ones, and the sets of bets that dominate every bet, the *complete classes*, and
proves the lemma that relates them [LRR26, Lemma 6.2]: a minimal complete class exists exactly when
every bet is dominated by an admissible one; its members are then admissible, it contains a version
of every admissible bet, and it is unique up to versions.

The filter makes one definition serve every notion of admissibility of anytime-valid inference.
For a null `S`, the quasi-sure filter (almost surely under every member of `S`) gives admissible
e-variables and e-processes; the filter `⊤` gives the pointwise order of calibrators, for which
admissibility is Mathlib's `Maximal` (`Filter.isAdmissible_top_iff`); a principal filter gives
merging functions compared at finite arguments. In general admissibility is maximality in the
preorder of germs (`Filter.isAdmissible_iff_maximal_germ`). Bets are functions rather than germs
because the sets of bets of interest, such as e-variables, ask for measurability, which is not a
property of germs.

## Main definitions

* `Filter.IsAdmissible l 𝓑 f`: `f ∈ 𝓑`, and every bet of `𝓑` that dominates `f` is dominated by
  `f`.
* `Filter.IsCompleteClass l 𝓑 𝓒`: `𝓒 ⊆ 𝓑`, and every bet of `𝓑` is dominated by a member of `𝓒`.
* `Filter.IsMinimalCompleteClass l 𝓑 𝓒`: a complete class that is no longer complete once a member
  and all its versions (the functions equal to it `l`-eventually) are removed.

## Main statements

* `Filter.IsCompleteClass.exists_eventuallyEq_of_isAdmissible`: every complete class contains a
  version of every admissible bet.
* `Filter.isMinimalCompleteClass_iff`: a complete class is minimal exactly when its members are
  admissible.
* `Filter.exists_isMinimalCompleteClass_iff`: a minimal complete class exists exactly when every bet
  is dominated by an admissible bet [LRR26, Lemma 6.2].
* `Filter.IsMinimalCompleteClass.setOf_isAdmissible`: the admissible bets are the bets equal to a
  member of a minimal complete class `l`-eventually.
* `Filter.IsMinimalCompleteClass.exists_eventuallyEq`: two minimal complete classes are equal up to
  versions.

## References

* [LRR26] M. Larsson, A. Ramdas and J. Ruf, *Testing hypotheses generated by constraints*, Math.
  Oper. Res. (2026), arXiv:2504.02974v5: Definition 6.1 and Lemma 6.2.
-/

public section

open Set

namespace Filter

variable {α β : Type*} {l : Filter α} {𝓑 𝓒 𝓒' : Set (α → β)} {f g : α → β}

section Preorder

variable [Preorder β]

/-- A bet `f ∈ 𝓑` is **admissible** for the filter `l` when every bet of `𝓑` that dominates it,
`f ≤ᶠ[l] g`, is dominated by it, `g ≤ᶠ[l] f`: no bet dominates `f` strictly. This is maximality in
the preorder of germs along `l` (`isAdmissible_iff_maximal_germ`), and Mathlib's `Maximal` for the
pointwise order when `l = ⊤` (`isAdmissible_top_iff`). -/
structure IsAdmissible (l : Filter α) (𝓑 : Set (α → β)) (f : α → β) : Prop where
  mem : f ∈ 𝓑
  eventuallyLE_of_eventuallyLE : ∀ g ∈ 𝓑, f ≤ᶠ[l] g → g ≤ᶠ[l] f

/-- A bet that dominates an admissible bet is dominated by it. -/
theorem IsAdmissible.eventuallyLE (hf : IsAdmissible l 𝓑 f) (hg : g ∈ 𝓑) (hfg : f ≤ᶠ[l] g) :
    g ≤ᶠ[l] f :=
  hf.eventuallyLE_of_eventuallyLE g hg hfg

/-- A version of an admissible bet, a bet equal to it `l`-eventually, is admissible. -/
theorem IsAdmissible.congr (hf : IsAdmissible l 𝓑 f) (hg : g ∈ 𝓑) (hfg : f =ᶠ[l] g) :
    IsAdmissible l 𝓑 g where
  mem := hg
  eventuallyLE_of_eventuallyLE _ hh hgh :=
    (hf.eventuallyLE hh (hfg.trans_le hgh)).trans_eq hfg

/-- Admissibility is maximality, among the germs of the bets, in the preorder of germs along
`l`. -/
theorem isAdmissible_iff_maximal_germ :
    IsAdmissible l 𝓑 f ↔ f ∈ 𝓑 ∧ Maximal (· ∈ ((↑) : (α → β) → Germ l β) '' 𝓑) (f : Germ l β) := by
  refine ⟨fun hf ↦ ⟨hf.mem, ⟨mem_image_of_mem _ hf.mem, ?_⟩⟩,
    fun ⟨hf, hmax⟩ ↦ ⟨hf, fun g hg hfg ↦ Germ.coe_le.1 (hmax.2 ⟨g, hg, rfl⟩ (Germ.coe_le.2 hfg))⟩⟩
  rintro _ ⟨g, hg, rfl⟩ hfg
  exact Germ.coe_le.2 (hf.eventuallyLE hg (Germ.coe_le.1 hfg))

/-- For the filter `⊤`, admissibility is maximality for the pointwise order. -/
theorem isAdmissible_top_iff : IsAdmissible ⊤ 𝓑 f ↔ Maximal (· ∈ 𝓑) f := by
  have hle (g h : α → β) : g ≤ᶠ[⊤] h ↔ g ≤ h := by
    simp only [EventuallyLE, eventually_top, Pi.le_def]
  exact ⟨fun hf ↦ ⟨hf.mem, fun g hg hfg ↦ (hle g f).1 (hf.eventuallyLE hg ((hle f g).2 hfg))⟩,
    fun hmax ↦ ⟨hmax.prop, fun g hg hfg ↦ (hle g f).2 (hmax.2 hg ((hle f g).1 hfg))⟩⟩

/-- A **complete class** of bets for the filter `l` [LRR26, Definition 6.1]: a set `𝓒 ⊆ 𝓑` such
that every bet of `𝓑` is dominated by a member of `𝓒`. -/
structure IsCompleteClass (l : Filter α) (𝓑 𝓒 : Set (α → β)) : Prop where
  subset : 𝓒 ⊆ 𝓑
  exists_eventuallyLE : ∀ f ∈ 𝓑, ∃ g ∈ 𝓒, f ≤ᶠ[l] g

/-- The set of all bets is a complete class. -/
theorem isCompleteClass_self (l : Filter α) (𝓑 : Set (α → β)) : IsCompleteClass l 𝓑 𝓑 :=
  ⟨subset_rfl, fun f hf ↦ ⟨f, hf, EventuallyLE.refl l f⟩⟩

/-- A set of bets that contains a complete class is a complete class. -/
theorem IsCompleteClass.mono (h𝓒 : IsCompleteClass l 𝓑 𝓒) (h𝓒𝓒' : 𝓒 ⊆ 𝓒') (h𝓒' : 𝓒' ⊆ 𝓑) :
    IsCompleteClass l 𝓑 𝓒' :=
  ⟨h𝓒', fun f hf ↦ (h𝓒.exists_eventuallyLE f hf).imp fun _ ⟨hg, hfg⟩ ↦ ⟨h𝓒𝓒' hg, hfg⟩⟩

/-- The admissible bets form a complete class exactly when every bet is dominated by an admissible
bet. -/
theorem isCompleteClass_setOf_isAdmissible_iff :
    IsCompleteClass l 𝓑 {f | IsAdmissible l 𝓑 f} ↔ ∀ f ∈ 𝓑, ∃ g, IsAdmissible l 𝓑 g ∧ f ≤ᶠ[l] g :=
  ⟨fun h f hf ↦ h.exists_eventuallyLE f hf, fun h ↦ ⟨fun _ hg ↦ hg.mem, h⟩⟩

/-- A **minimal complete class** of bets for the filter `l` [LRR26, Definition 6.1]: a complete
class that is no longer complete once any of its members is removed together with its versions,
the functions equal to it `l`-eventually. -/
structure IsMinimalCompleteClass (l : Filter α) (𝓑 𝓒 : Set (α → β)) : Prop
    extends IsCompleteClass l 𝓑 𝓒 where
  not_isCompleteClass_sep : ∀ g ∈ 𝓒, ¬ IsCompleteClass l 𝓑 {h ∈ 𝓒 | ¬ h =ᶠ[l] g}

/-- **The members of a minimal complete class are admissible** [LRR26, Lemma 6.2]. -/
theorem IsMinimalCompleteClass.isAdmissible (h𝓒 : IsMinimalCompleteClass l 𝓑 𝓒) (hg : g ∈ 𝓒) :
    IsAdmissible l 𝓑 g := by
  refine ⟨h𝓒.subset hg, fun f hf hgf ↦ by_contra fun hfg ↦ h𝓒.not_isCompleteClass_sep g hg ?_⟩
  refine ⟨fun _ hk ↦ h𝓒.subset hk.1, fun e he ↦ ?_⟩
  obtain ⟨k, hk, hek⟩ := h𝓒.exists_eventuallyLE e he
  by_cases hkg : k =ᶠ[l] g
  · -- the bet `e` is dominated by `g`, hence by `f`, which a member `k'` of the class dominates;
    -- `k'` is not a version of `g`, since `f` is not dominated by `g`
    obtain ⟨k', hk', hfk'⟩ := h𝓒.exists_eventuallyLE f hf
    exact ⟨k', ⟨hk', fun hk'g ↦ hfg (hfk'.trans_eq hk'g)⟩,
      ((hek.trans_eq hkg).trans hgf).trans hfk'⟩
  · exact ⟨k, ⟨hk, hkg⟩, hek⟩

end Preorder

section PartialOrder

variable [PartialOrder β]

/-- A bet that dominates an admissible bet is a version of it. -/
theorem IsAdmissible.eventuallyEq (hf : IsAdmissible l 𝓑 f) (hg : g ∈ 𝓑) (hfg : f ≤ᶠ[l] g) :
    g =ᶠ[l] f :=
  (hf.eventuallyLE hg hfg).antisymm hfg

/-- **A complete class contains a version of every admissible bet** [LRR26, Lemma 6.2]. -/
theorem IsCompleteClass.exists_eventuallyEq_of_isAdmissible (h𝓒 : IsCompleteClass l 𝓑 𝓒)
    (hf : IsAdmissible l 𝓑 f) : ∃ g ∈ 𝓒, g =ᶠ[l] f :=
  (h𝓒.exists_eventuallyLE f hf.mem).imp fun _ ⟨hg, hfg⟩ ↦ ⟨hg, hf.eventuallyEq (h𝓒.subset hg) hfg⟩

/-- A complete class of admissible bets is minimal [LRR26, Lemma 6.2]. -/
theorem IsCompleteClass.isMinimalCompleteClass (h𝓒 : IsCompleteClass l 𝓑 𝓒)
    (hadm : ∀ g ∈ 𝓒, IsAdmissible l 𝓑 g) : IsMinimalCompleteClass l 𝓑 𝓒 where
  toIsCompleteClass := h𝓒
  not_isCompleteClass_sep g hg h := by
    obtain ⟨k, ⟨hk, hkg⟩, hgk⟩ := h.exists_eventuallyLE g (h𝓒.subset hg)
    exact hkg ((hadm g hg).eventuallyEq (h𝓒.subset hk) hgk)

/-- A complete class is minimal exactly when its members are admissible [LRR26, Lemma 6.2]. -/
theorem isMinimalCompleteClass_iff :
    IsMinimalCompleteClass l 𝓑 𝓒 ↔ IsCompleteClass l 𝓑 𝓒 ∧ ∀ g ∈ 𝓒, IsAdmissible l 𝓑 g :=
  ⟨fun h𝓒 ↦ ⟨h𝓒.toIsCompleteClass, fun _ hg ↦ h𝓒.isAdmissible hg⟩,
    fun ⟨h𝓒, hadm⟩ ↦ h𝓒.isMinimalCompleteClass hadm⟩

/-- **The minimal complete class lemma** [LRR26, Lemma 6.2]: a minimal complete class exists
exactly when every bet is dominated by an admissible bet. The admissible bets then form one. -/
theorem exists_isMinimalCompleteClass_iff :
    (∃ 𝓒, IsMinimalCompleteClass l 𝓑 𝓒) ↔ ∀ f ∈ 𝓑, ∃ g, IsAdmissible l 𝓑 g ∧ f ≤ᶠ[l] g := by
  refine ⟨fun ⟨𝓒, h𝓒⟩ f hf ↦ ?_, fun h ↦ ⟨_, (isCompleteClass_setOf_isAdmissible_iff.2 h)
    |>.isMinimalCompleteClass fun _ hg ↦ hg⟩⟩
  obtain ⟨g, hg, hfg⟩ := h𝓒.exists_eventuallyLE f hf
  exact ⟨g, h𝓒.isAdmissible hg, hfg⟩

/-- The admissible bets are the bets that are versions of a member of a minimal complete class
[LRR26, Lemma 6.2]. -/
theorem IsMinimalCompleteClass.setOf_isAdmissible (h𝓒 : IsMinimalCompleteClass l 𝓑 𝓒) :
    {f | IsAdmissible l 𝓑 f} = {f ∈ 𝓑 | ∃ g ∈ 𝓒, g =ᶠ[l] f} := by
  ext f
  exact ⟨fun hf ↦ ⟨hf.mem, h𝓒.exists_eventuallyEq_of_isAdmissible hf⟩,
    fun ⟨hf, g, hg, hgf⟩ ↦ (h𝓒.isAdmissible hg).congr hf hgf⟩

/-- **Uniqueness of the minimal complete class** [LRR26, Lemma 6.2]: every member of a minimal
complete class has a version in any other minimal complete class. -/
theorem IsMinimalCompleteClass.exists_eventuallyEq (h𝓒 : IsMinimalCompleteClass l 𝓑 𝓒)
    (h𝓒' : IsMinimalCompleteClass l 𝓑 𝓒') (hg : g ∈ 𝓒) : ∃ g' ∈ 𝓒', g' =ᶠ[l] g :=
  h𝓒'.exists_eventuallyEq_of_isAdmissible (h𝓒.isAdmissible hg)

end PartialOrder

end Filter
