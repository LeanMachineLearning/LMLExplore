/-!
# The filtration of the strict past of a process

This file defines the filtration `MeasureTheory.Filtration.naturalLT` of the strict past of a
measurable process `u`: at time `i`, the σ-algebra generated by the `u j` with `j < i`. The
variable `u i` is measurable at every later time, and if the `u i` are independent, `u i` is
independent of its strict past. For the coordinates of a product measure, this is the filtration
with respect to which each coordinate is drawn independently of the previous ones.

For the coordinates of `Π i, X i`, this is `Filtration.piLT`. On sequences `ℕ → 𝓧` its time `n`
has seen the `n` observations `ω 0, …, ω (n - 1)`, so that it counts observations: time `0` is
trivial and `piLT (n + 1) = piLE n`.

Functions of the first coordinates are measurable and adapted for `piLT`, and random times that
are functions of the first `k` coordinates and are at least `k` are stopping times. For
Mathlib's filtration `Filtration.piLE` of the first coordinates of a sequence, whose time `n` has
seen the coordinates `0, …, n`, functions of the first `n + 1` coordinates are measurable at
time `n`.

## Main definitions

* `MeasureTheory.Filtration.naturalLT`: the filtration of the strict past of a measurable process.
* `MeasureTheory.Filtration.piLT`: the filtration of the strict past of the coordinates of a
  product.

## Main statements

* `MeasureTheory.Filtration.measurable_naturalLT`: for `j < i`, `u j` is measurable for
  `naturalLT u hu i`.
* `MeasureTheory.Filtration.indep_naturalLT`: if the `u i` are independent, `u i` is independent
  of `naturalLT u hu i`.
* `MeasureTheory.Filtration.indep_naturalLT_infinitePi`: under a product measure
  `Measure.infinitePi P`, each coordinate is independent of the strict past of the coordinates.
* `MeasureTheory.Filtration.naturalLT_eval_le_comap`: for the coordinates of `ℕ → β`, the strict
  past at time `k` is at most the σ-algebra of the restriction to the first `k` coordinates.
* `MeasureTheory.Filtration.piLT_zero`, `MeasureTheory.Filtration.piLT_add_one`: for sequences,
  `piLT 0` is trivial and `piLT (n + 1) = piLE n`.
* `MeasureTheory.Filtration.measurable_piLT_initSeg`: for `k ≤ n`, the first `k` terms of a
  sequence are measurable at time `n` of `piLT`.
* `MeasureTheory.Filtration.piLT_eq_comap_initSeg`: time `n` of `piLT` is the σ-algebra generated
  by the first `n` terms of a sequence.
* `Measurable.dependsOn_of_piLT`, `MeasureTheory.Filtration.measurable_piLT_of_dependsOn`: a
  function measurable at time `i` of `piLT` only depends on the coordinates `j < i`, and for
  sequences a measurable function of the first `n` coordinates is measurable at time `n` of
  `piLT`.
* `MeasurableSet.dependsOn_of_piLT`: membership in a set measurable at time `i` of `piLT` only
  depends on the coordinates `j < i`.
* `Measurable.apply_eq_of_piLT_zero`, `Measurable.apply_update_eq_of_piLT`: a function measurable
  at time `0` of `piLT` is constant, and one measurable at time `n + 1`, with the term of index `n`
  replaced, only depends on the first `n` terms.
* `MeasureTheory.IsStoppingTime.eq_of_forall_lt`: a stopping time of `piLT` is determined, where
  it is finite, by the coordinates before it.
* `MeasureTheory.Filtration.adapted_piLT_comp_initSeg`,
  `MeasureTheory.Filtration.isStoppingTime_piLT_comp_initSeg`: functions of the first `n` terms
  form a process adapted to `piLT`, and a function of the first `k` terms that is at least `k` is a
  stopping time of `piLT`.
* `MeasureTheory.Filtration.measurable_piLE_initSeg`: the first `k` terms are measurable at time
  `n` of `Filtration.piLE` for `k ≤ n + 1`.
* `MeasureTheory.Filtration.measurable_piLE_of_dependsOn`: a measurable function that depends only
  on the first `n + 1` terms is measurable at time `n` of `Filtration.piLE`.
-/

public section

open ProbabilityTheory

namespace MeasureTheory.Filtration

variable {ι : Type*} [Preorder ι] {Ω : Type*} {mΩ : MeasurableSpace Ω} {β : ι → Type*}
  [∀ i, MeasurableSpace (β i)] {u : (i : ι) → Ω → β i}

/-- The filtration of the **strict past** of a measurable process `u`: at time `i`, the σ-algebra
generated by the variables `u j` with `j < i`. -/
def naturalLT (u : (i : ι) → Ω → β i) (hu : ∀ i, Measurable (u i)) : Filtration ι mΩ where
  seq i := ⨆ j < i, MeasurableSpace.comap (u j) inferInstance
  mono' _ _ hii' := biSup_mono fun _ hj ↦ lt_of_lt_of_le hj hii'
  le' _ := iSup₂_le fun j _ ↦ (hu j).comap_le

lemma naturalLT_apply (hu : ∀ i, Measurable (u i)) (i : ι) :
    naturalLT u hu i = ⨆ j < i, MeasurableSpace.comap (u j) inferInstance :=
  (rfl)

/-- For `j < i`, the variable `u j` is measurable for the strict past `naturalLT u hu i`. -/
theorem measurable_naturalLT (hu : ∀ i, Measurable (u i)) {i j : ι} (hji : j < i) :
    Measurable[naturalLT u hu i] (u j) :=
  measurable_biSup_comap u hji

/-- If the variables `u i` are independent, each `u i` is independent of its strict past
`naturalLT u hu i`. -/
theorem indep_naturalLT (hu : ∀ i, Measurable (u i)) {μ : Measure Ω} (h_indep : iIndepFun u μ)
    (i : ι) : Indep (MeasurableSpace.comap (u i) inferInstance) (naturalLT u hu i) μ := by
  have h := indep_iSup_of_disjoint (fun j ↦ (hu j).comap_le)
    ((iIndepFun_iff_iIndep _ _ _).1 h_indep) (S := {i}) (T := Set.Iio i) (by simp)
  simpa only [Set.mem_singleton_iff, iSup_iSup_eq_left, Set.mem_Iio, naturalLT_apply] using h

/-- Under a product measure `Measure.infinitePi P`, the coordinate `ω i` is independent of the
strict past `naturalLT` of the coordinates at time `i`: each coordinate is drawn independently of
the previous ones. -/
theorem indep_naturalLT_infinitePi {X : ι → Type*} [∀ i, MeasurableSpace (X i)]
    (P : (i : ι) → Measure (X i)) [∀ i, IsProbabilityMeasure (P i)] (i : ι) :
    Indep (MeasurableSpace.comap (fun ω : (j : ι) → X j ↦ ω i) inferInstance)
      (naturalLT (fun j (ω : (j : ι) → X j) ↦ ω j) measurable_pi_apply i)
      (Measure.infinitePi P) :=
  indep_naturalLT measurable_pi_apply
    (iIndepFun_infinitePi (X := fun _ ↦ id) fun _ ↦ measurable_id) i

/-- For the coordinates of `ℕ → β`, the strict past at time `k` is at most the σ-algebra of the
restriction to the first `k` coordinates. -/
theorem naturalLT_eval_le_comap {β : Type*} [MeasurableSpace β] (k : ℕ) :
    naturalLT (fun i (ω : ℕ → β) ↦ ω i) measurable_pi_apply k ≤
      MeasurableSpace.comap (fun (ω : ℕ → β) (i : Fin k) ↦ ω i) MeasurableSpace.pi := by
  rw [naturalLT_apply]
  refine iSup₂_le fun j hj ↦ Measurable.comap_le ?_
  exact (measurable_pi_apply (⟨j, hj⟩ : Fin k)).comp
    (comap_measurable (fun (ω : ℕ → β) (i : Fin k) ↦ ω i))

/-! ### The filtration of the strict past of the coordinates -/

section piLT

variable {X : ι → Type*} [∀ i, MeasurableSpace (X i)]

/-- The filtration of the **strict past of the coordinates** of `Π i, X i`: at time `i`, the
σ-algebra generated by the coordinates `ω j` with `j < i`, that is, `naturalLT` of the coordinate
process. For sequences, time `n` has seen the `n` coordinates `ω 0, …, ω (n - 1)`, one fewer than
Mathlib's `Filtration.piLE`: `piLT (n + 1) = piLE n`. -/
def piLT : @Filtration (Π i, X i) ι _ MeasurableSpace.pi :=
  naturalLT (fun i ω ↦ ω i) measurable_pi_apply

/-- `piLT` is the filtration of the strict past of the coordinate process. -/
lemma piLT_eq_naturalLT : piLT (X := X) = naturalLT (fun i ω ↦ ω i) measurable_pi_apply :=
  (rfl)

/-- Time `i` of `piLT` is generated by the coordinates `j < i`. -/
lemma piLT_apply (i : ι) :
    piLT (X := X) i = ⨆ j < i, MeasurableSpace.comap (fun ω : Π i, X i ↦ ω j) inferInstance :=
  (rfl)

/-- For `j < i`, the coordinate `j` is measurable at time `i` of `piLT`. -/
lemma measurable_piLT_apply {i j : ι} (hji : j < i) :
    Measurable[piLT (X := X) i] fun ω ↦ ω j :=
  measurable_naturalLT measurable_pi_apply hji

/-- A function that is measurable at time `i` of the strict past `Filtration.piLT` of the
coordinates only depends on the coordinates `j < i`, as `Measurable.dependsOn_of_piLE` for
Mathlib's `Filtration.piLE`. -/
lemma _root_.Measurable.dependsOn_of_piLT {Z : Type*} [MeasurableSpace Z]
    [MeasurableSingletonClass Z] {f : (Π i, X i) → Z} {i : ι}
    (hf : Measurable[piLT (X := X) i] f) : DependsOn f (Set.Iio i) := by
  -- time `i` of `piLT` is coarser than the σ-algebra of the restriction to `Set.Iio i`
  refine dependsOn_iff_factorsThrough.2 (Measurable.factorsThrough (hf.mono ?_ le_rfl))
  refine iSup₂_le fun j hj ↦ Measurable.comap_le ?_
  exact (measurable_pi_apply (⟨j, hj⟩ : Set.Iio i)).comp
    (comap_measurable (Set.Iio i).domRestrict)

/-- Membership in a set measurable at time `i` of `Filtration.piLT` only depends on the
coordinates `j < i`: the set form of `Measurable.dependsOn_of_piLT`. -/
lemma _root_.MeasurableSet.dependsOn_of_piLT {s : Set (Π i, X i)} {i : ι}
    (hs : MeasurableSet[piLT i] s) {ω ω' : Π i, X i} (h : ∀ j < i, ω j = ω' j) :
    ω ∈ s ↔ ω' ∈ s :=
  Eq.to_iff (((@measurable_mem _ s (piLT i)).2 hs).dependsOn_of_piLT fun j hj ↦ h j hj)

end piLT

section piLTNat

variable {X : ℕ → Type*} [∀ n, MeasurableSpace (X n)]

/-- At time `0`, the strict past of the coordinates of a sequence is the trivial σ-algebra: no
coordinate has been seen. -/
@[simp]
lemma piLT_zero : piLT (X := X) 0 = ⊥ := by
  simp [piLT_apply]

/-- Time `n + 1` of the strict past of the coordinates of a sequence is time `n` of
`Filtration.piLE`: both have seen the coordinates `0, …, n`. -/
lemma piLT_add_one (n : ℕ) : piLT (X := X) (n + 1) = piLE n := by
  refine le_antisymm
    (iSup₂_le fun j hj ↦ (measurable_piLE_apply (Nat.lt_succ_iff.1 hj)).comap_le) ?_
  exact Measurable.comap_le <| @Measurable.of_eval _ _ _ (piLT (n + 1)) _ _
    fun j ↦ measurable_piLT_apply (Nat.lt_succ_of_le j.property)

/-- For `k ≤ n`, the first `k` terms of a sequence are measurable at time `n` of `piLT`. -/
lemma measurable_piLT_initSeg {𝓧 : Type*} [MeasurableSpace 𝓧] {k n : ℕ} (hk : k ≤ n) :
    Measurable[piLT (X := fun _ : ℕ ↦ 𝓧) n] (initSeg k) := by
  rw [initSeg_def]
  exact @Measurable.of_eval _ _ _ (piLT n) _ _ fun i ↦
    measurable_piLT_apply (by have := i.isLt; omega)

/-- Time `n` of the strict past of the coordinates of a sequence is the σ-algebra generated by its
first `n` terms, as `Filtration.piLE_eq_comap_frestrictLe` for Mathlib's `Filtration.piLE`. -/
lemma piLT_eq_comap_initSeg {𝓧 : Type*} [MeasurableSpace 𝓧] (n : ℕ) :
    piLT (X := fun _ : ℕ ↦ 𝓧) n = MeasurableSpace.comap (initSeg n) MeasurableSpace.pi := by
  refine le_antisymm ?_ (measurable_piLT_initSeg le_rfl).comap_le
  rw [piLT_eq_naturalLT, initSeg_def]
  exact naturalLT_eval_le_comap n

/-- The process of the values of measurable functions `X n` of the first `n` terms of a sequence
is adapted to `Filtration.piLT`. -/
lemma adapted_piLT_comp_initSeg {𝓧 β : Type*} [MeasurableSpace 𝓧] [MeasurableSpace β]
    {X : (n : ℕ) → (Fin n → 𝓧) → β} (hX : ∀ n, Measurable (X n)) :
    Adapted (piLT (X := fun _ : ℕ ↦ 𝓧)) fun n ω ↦ X n (initSeg n ω) :=
  fun n ↦ (hX n).comp (measurable_piLT_initSeg le_rfl)

/-- A random time that is a measurable function, at least `k`, of the first `k` terms of a
sequence is a stopping time of `Filtration.piLT`. -/
lemma isStoppingTime_piLT_comp_initSeg {𝓧 : Type*} [MeasurableSpace 𝓧] {k : ℕ}
    {T : (Fin k → 𝓧) → ℕ} (hT : Measurable T) (hTk : ∀ x, k ≤ T x) :
    IsStoppingTime (piLT (X := fun _ : ℕ ↦ 𝓧)) fun ω ↦ (T (initSeg k ω) : WithTop ℕ) := by
  intro i
  by_cases hi : k ≤ i
  · exact measurable_piLT_initSeg hi
      (hT (MeasurableSet.of_discrete (s := {m : ℕ | (m : WithTop ℕ) ≤ i})))
  · -- before time `k` the random time has not stopped yet
    convert @MeasurableSet.empty _ (piLT (X := fun _ : ℕ ↦ 𝓧) i) using 1
    ext ω
    simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, not_le]
    exact Nat.cast_lt.2 (lt_of_lt_of_le (by omega) (hTk _))

/-- A function that is measurable at time `0` of the strict past `Filtration.piLT` of the
coordinates of a sequence is constant: at time `0`, no coordinate has been seen. -/
lemma _root_.Measurable.apply_eq_of_piLT_zero {Z : Type*} [MeasurableSpace Z]
    [MeasurableSingletonClass Z] {f : (Π n, X n) → Z} (hf : Measurable[piLT (X := X) 0] f)
    (ω ω' : Π n, X n) : f ω = f ω' :=
  hf.dependsOn_of_piLT fun i hi ↦ absurd hi (Nat.not_lt_zero i)

/-- A measurable function of the first `n` terms of a sequence is measurable at time `n` of
`Filtration.piLT`: the converse of `Measurable.dependsOn_of_piLT`. -/
lemma measurable_piLT_of_dependsOn {𝓧 β : Type*} [MeasurableSpace 𝓧] [MeasurableSpace β]
    {f : (ℕ → 𝓧) → β} {n : ℕ} (hf : Measurable f) (hfn : DependsOn f (Set.Iio n)) :
    Measurable[piLT n] f := by
  -- `exists_measurable_eq_comp_initSeg` needs `[Nonempty 𝓧]`; the empty case is trivial
  rcases isEmpty_or_nonempty 𝓧 with h𝓧 | h𝓧
  · let : MeasurableSpace (ℕ → 𝓧) := piLT n
    exact Subsingleton.measurable
  obtain ⟨g, hg, rfl⟩ := exists_measurable_eq_comp_initSeg hf hfn
  exact Measurable.comp (mα := piLT n) hg (measurable_piLT_initSeg le_rfl)

/-- A stopping time of the strict past `Filtration.piLT` of the coordinates of a sequence is
determined by the coordinates before it: if `τ ω = n` and `ω'` agrees with `ω` before `n`, then
`τ ω' = n`, as `IsStoppingTime.eq_of_forall_le` for Mathlib's `Filtration.piLE`. -/
lemma _root_.MeasureTheory.IsStoppingTime.eq_of_forall_lt {τ : (Π n, X n) → WithTop ℕ}
    (hτ : IsStoppingTime piLT τ) {ω ω' : Π n, X n} {n : ℕ} (hn : τ ω = n)
    (h : ∀ i < n, ω i = ω' i) : τ ω' = n := by
  have hm : MeasurableSet[piLT n] {ω' | τ ω' = n} := by
    simpa using hτ.measurableSet_eq n
  exact (hm.dependsOn_of_piLT h).1 hn

/-- Replacing the term of index `n` of a sequence is measurable from the strict past
`piLT n` and the new term to the strict past `piLT (n + 1)`. -/
lemma measurable_update_piLT (n : ℕ) :
    @Measurable _ _ ((piLT (X := X) n).prod inferInstance) (piLT (X := X) (n + 1))
      fun p : (Π n, X n) × X n ↦ Function.update p.1 n p.2 := by
  rw [measurable_iff_comap_le, piLT_apply, MeasurableSpace.comap_iSup]
  refine iSup_le fun j ↦ ?_
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun hj ↦ ?_
  rw [MeasurableSpace.comap_comp]
  refine Measurable.comap_le ?_
  rcases eq_or_ne j n with rfl | hjn
  · simpa [Function.comp_def] using measurable_snd
  · simp only [Function.comp_def, Function.update_of_ne hjn]
    exact (measurable_piLT_apply (by omega)).comp measurable_fst

/-- A function that is measurable at time `n + 1` of the strict past `Filtration.piLT`, evaluated
at a sequence whose term of index `n` is replaced by `y`, only depends on the first `n` terms of the
sequence. -/
lemma _root_.Measurable.apply_update_eq_of_piLT {Z : Type*} [MeasurableSpace Z]
    [MeasurableSingletonClass Z] {f : (Π n, X n) → Z} {n : ℕ}
    (hf : Measurable[piLT (X := X) (n + 1)] f) {ω ω' : Π n, X n} (h : ∀ i < n, ω i = ω' i)
    (y : X n) : f (Function.update ω n y) = f (Function.update ω' n y) :=
  hf.dependsOn_of_piLT fun i hi ↦ by
    rcases eq_or_ne i n with rfl | hin
    · simp
    · simp only [Function.update_of_ne hin]
      exact h i (by simp only [Set.mem_Iio] at hi; omega)

/-- For a process `M` adapted to `piLT`, the function `(ω, y) ↦ M (n + 1) (update ω n y)`, the
value at time `n + 1` with the term of index `n` replaced by `y`, is jointly measurable for the
strict past `piLT n` and the new term. -/
lemma _root_.MeasureTheory.Adapted.measurable_uncurry_update_piLT {β : Type*}
    [MeasurableSpace β] {M : ℕ → (Π n, X n) → β} (hM : Adapted piLT M) (n : ℕ) :
    Measurable[(piLT (X := X) n).prod inferInstance]
      (Function.uncurry fun ω y ↦ M (n + 1) (Function.update ω n y)) :=
  (hM (n + 1)).comp (measurable_update_piLT n)

end piLTNat

/-! ### The filtration of the first coordinates -/

section piLE

variable {𝓧 : Type*} {m𝓧 : MeasurableSpace 𝓧}

/-- For `k ≤ n + 1`, the first `k` terms of a sequence are measurable at time `n` of
`Filtration.piLE`. -/
lemma measurable_piLE_initSeg {k n : ℕ} (hk : k ≤ n + 1) :
    Measurable[piLE (X := fun _ : ℕ ↦ 𝓧) n] (initSeg k) := by
  rw [initSeg_def]
  exact @Measurable.of_eval _ _ _ (piLE n) _ _ fun i ↦
    measurable_piLE_apply (by have := i.isLt; omega)

/-- A measurable function of the first `n + 1` terms of a sequence is measurable at time `n` of
`Filtration.piLE`. -/
lemma measurable_piLE_of_dependsOn {β : Type*} [MeasurableSpace β]
    {f : (ℕ → 𝓧) → β} {n : ℕ} (hf : Measurable f) (hfn : DependsOn f (Set.Iio (n + 1))) :
    Measurable[piLE n] f :=
  piLT_add_one (X := fun _ : ℕ ↦ 𝓧) n ▸ measurable_piLT_of_dependsOn hf hfn

end piLE

end MeasureTheory.Filtration
