module

public import Mathlib.Probability.Independence.Basic
public import Mathlib.Probability.Process.Filtration

/-!
# The filtration of the strict past of a process

This file defines the filtration `MeasureTheory.Filtration.naturalLT` of the strict past of a
measurable process `u`: at time `i`, the σ-algebra generated by the `u j` with `j < i`. The
variable `u i` is measurable at every later time, and if the `u i` are independent, `u i` is
independent of its strict past. For the coordinates of a product measure, this is the filtration
with respect to which each coordinate is drawn independently of the previous ones.

## Main definitions

* `MeasureTheory.Filtration.naturalLT`: the filtration of the strict past of a measurable process.

## Main statements

* `MeasureTheory.Filtration.measurable_naturalLT`: for `j < i`, `u j` is measurable for
  `naturalLT u hu i`.
* `MeasureTheory.Filtration.indep_naturalLT`: if the `u i` are independent, `u i` is independent
  of `naturalLT u hu i`.
-/

public section

open ProbabilityTheory

namespace MeasureTheory.Filtration

variable {ι : Type*} [Preorder ι] {Ω : Type*} {mΩ : MeasurableSpace Ω} {β : ι → Type*}
  [∀ i, MeasurableSpace (β i)] {u : (i : ι) → Ω → β i}

/-- The filtration of the **strict past** of a measurable process `u`: at time `i`, the σ-algebra
generated by the variables `u j` with `j < i`. -/
def naturalLT (u : (i : ι) → Ω → β i) (hu : ∀ i, Measurable (u i)) : Filtration ι mΩ where
  seq i := ⨆ j < i, MeasurableSpace.comap (u j) inferInstance
  mono' _ _ hii' := biSup_mono fun _ hj ↦ lt_of_lt_of_le hj hii'
  le' _ := iSup₂_le fun j _ ↦ (hu j).comap_le

lemma naturalLT_apply (hu : ∀ i, Measurable (u i)) (i : ι) :
    naturalLT u hu i = ⨆ j < i, MeasurableSpace.comap (u j) inferInstance :=
  (rfl)

/-- For `j < i`, the variable `u j` is measurable for the strict past `naturalLT u hu i`. -/
theorem measurable_naturalLT (hu : ∀ i, Measurable (u i)) {i j : ι} (hji : j < i) :
    Measurable[naturalLT u hu i] (u j) :=
  Measurable.of_comap_le (le_iSup₂ (f := fun k (_ : k < i) ↦
    MeasurableSpace.comap (u k) inferInstance) j hji)

/-- If the variables `u i` are independent, each `u i` is independent of its strict past
`naturalLT u hu i`. -/
theorem indep_naturalLT (hu : ∀ i, Measurable (u i)) {μ : Measure Ω} (h_indep : iIndepFun u μ)
    (i : ι) : Indep (MeasurableSpace.comap (u i) inferInstance) (naturalLT u hu i) μ := by
  have h := indep_iSup_of_disjoint (fun j ↦ (hu j).comap_le)
    ((iIndepFun_iff_iIndep _ _ _).1 h_indep) (S := {i}) (T := Set.Iio i) (by simp)
  simpa only [Set.mem_singleton_iff, iSup_iSup_eq_left, Set.mem_Iio, naturalLT_apply] using h

end MeasureTheory.Filtration
