module

public import LMLExplore.MeasureTheory.MeasurableSpace.Constructions
public import Mathlib.Probability.Independence.Basic
public import Mathlib.Probability.Independence.InfinitePi
public import Mathlib.Probability.Process.Stopping
public import Statlib.ForMathlib.Probability.Process.Filtration

/-!
# The filtration of the strict past of a process

This file defines the filtration `MeasureTheory.Filtration.naturalLT` of the strict past of a
measurable process `u`: at time `i`, the σ-algebra generated by the `u j` with `j < i`. The
variable `u i` is measurable at every later time, and if the `u i` are independent, `u i` is
independent of its strict past. For the coordinates of a product measure, this is the filtration
with respect to which each coordinate is drawn independently of the previous ones.

For the coordinates of `Π i, X i`, this is `Filtration.piLT`. On sequences `ℕ → 𝓧` its time `n`
has seen the `n` observations `ω 0, …, ω (n - 1)`, so that it counts observations: time `0` is
trivial and `piLT (n + 1) = piLE n`.

For Mathlib's filtration `Filtration.piLE` of the first coordinates of a sequence, whose time `n`
has seen the coordinates `0, …, n`, functions of the first coordinates are measurable and
adapted, and random times that are functions of the first `k + 1` coordinates and are at least `k`
are stopping times.

## Main definitions

* `MeasureTheory.Filtration.naturalLT`: the filtration of the strict past of a measurable process.
* `MeasureTheory.Filtration.piLT`: the filtration of the strict past of the coordinates of a
  product.

## Main statements

* `MeasureTheory.Filtration.measurable_naturalLT`: for `j < i`, `u j` is measurable for
  `naturalLT u hu i`.
* `MeasureTheory.Filtration.indep_naturalLT`: if the `u i` are independent, `u i` is independent
  of `naturalLT u hu i`.
* `MeasureTheory.Filtration.indep_naturalLT_infinitePi`: under a product measure
  `Measure.infinitePi P`, each coordinate is independent of the strict past of the coordinates.
* `MeasureTheory.Filtration.naturalLT_eval_le_comap`: for the coordinates of `ℕ → β`, the strict
  past at time `k` is at most the σ-algebra of the restriction to the first `k` coordinates.
* `MeasureTheory.Filtration.piLT_zero`, `MeasureTheory.Filtration.piLT_add_one`: for sequences,
  `piLT 0` is trivial and `piLT (n + 1) = piLE n`.
* `MeasureTheory.Filtration.measurable_piLT_initSeg`: for `k ≤ n`, the first `k` terms of a
  sequence are measurable at time `n` of `piLT`.
* `MeasureTheory.Filtration.measurable_piLE_initSeg`,
  `MeasureTheory.Filtration.adapted_piLE_comp_initSeg`,
  `MeasureTheory.Filtration.isStoppingTime_piLE_comp_initSeg`: the first `k` terms are measurable
  at time `n` of `Filtration.piLE` for `k ≤ n + 1`, functions of the first `n + 1` terms form an
  adapted process, and a function of the first `k + 1` terms that is at least `k` is a stopping
  time.
* `MeasureTheory.Filtration.measurable_piLE_of_dependsOn`: a measurable function that depends only
  on the first `n + 1` terms is measurable at time `n` of `Filtration.piLE`.
-/

public section

open ProbabilityTheory

namespace MeasureTheory.Filtration

variable {ι : Type*} [Preorder ι] {Ω : Type*} {mΩ : MeasurableSpace Ω} {β : ι → Type*}
  [∀ i, MeasurableSpace (β i)] {u : (i : ι) → Ω → β i}

/-- The filtration of the **strict past** of a measurable process `u`: at time `i`, the σ-algebra
generated by the variables `u j` with `j < i`. -/
def naturalLT (u : (i : ι) → Ω → β i) (hu : ∀ i, Measurable (u i)) : Filtration ι mΩ where
  seq i := ⨆ j < i, MeasurableSpace.comap (u j) inferInstance
  mono' _ _ hii' := biSup_mono fun _ hj ↦ lt_of_lt_of_le hj hii'
  le' _ := iSup₂_le fun j _ ↦ (hu j).comap_le

lemma naturalLT_apply (hu : ∀ i, Measurable (u i)) (i : ι) :
    naturalLT u hu i = ⨆ j < i, MeasurableSpace.comap (u j) inferInstance :=
  (rfl)

/-- For `j < i`, the variable `u j` is measurable for the strict past `naturalLT u hu i`. -/
theorem measurable_naturalLT (hu : ∀ i, Measurable (u i)) {i j : ι} (hji : j < i) :
    Measurable[naturalLT u hu i] (u j) :=
  Measurable.of_comap_le (le_iSup₂ (f := fun k (_ : k < i) ↦
    MeasurableSpace.comap (u k) inferInstance) j hji)

/-- If the variables `u i` are independent, each `u i` is independent of its strict past
`naturalLT u hu i`. -/
theorem indep_naturalLT (hu : ∀ i, Measurable (u i)) {μ : Measure Ω} (h_indep : iIndepFun u μ)
    (i : ι) : Indep (MeasurableSpace.comap (u i) inferInstance) (naturalLT u hu i) μ := by
  have h := indep_iSup_of_disjoint (fun j ↦ (hu j).comap_le)
    ((iIndepFun_iff_iIndep _ _ _).1 h_indep) (S := {i}) (T := Set.Iio i) (by simp)
  simpa only [Set.mem_singleton_iff, iSup_iSup_eq_left, Set.mem_Iio, naturalLT_apply] using h

/-- Under a product measure `Measure.infinitePi P`, the coordinate `ω i` is independent of the
strict past `naturalLT` of the coordinates at time `i`: each coordinate is drawn independently of
the previous ones. -/
theorem indep_naturalLT_infinitePi {X : ι → Type*} [∀ i, MeasurableSpace (X i)]
    (P : (i : ι) → Measure (X i)) [∀ i, IsProbabilityMeasure (P i)] (i : ι) :
    Indep (MeasurableSpace.comap (fun ω : (j : ι) → X j ↦ ω i) inferInstance)
      (naturalLT (fun j (ω : (j : ι) → X j) ↦ ω j) measurable_pi_apply i)
      (Measure.infinitePi P) :=
  indep_naturalLT measurable_pi_apply
    (iIndepFun_infinitePi (X := fun _ ↦ id) fun _ ↦ measurable_id) i

/-- For the coordinates of `ℕ → β`, the strict past at time `k` is at most the σ-algebra of the
restriction to the first `k` coordinates. -/
theorem naturalLT_eval_le_comap {β : Type*} [MeasurableSpace β] (k : ℕ) :
    naturalLT (fun i (ω : ℕ → β) ↦ ω i) measurable_pi_apply k ≤
      MeasurableSpace.comap (fun (ω : ℕ → β) (i : Fin k) ↦ ω i) MeasurableSpace.pi := by
  rw [naturalLT_apply]
  refine iSup₂_le fun j hj ↦ Measurable.comap_le ?_
  exact (measurable_pi_apply (⟨j, hj⟩ : Fin k)).comp
    (comap_measurable (fun (ω : ℕ → β) (i : Fin k) ↦ ω i))

/-! ### The filtration of the strict past of the coordinates -/

section piLT

variable {X : ι → Type*} [∀ i, MeasurableSpace (X i)]

/-- The filtration of the **strict past of the coordinates** of `Π i, X i`: at time `i`, the
σ-algebra generated by the coordinates `ω j` with `j < i`, that is, `naturalLT` of the coordinate
process. For sequences, time `n` has seen the `n` coordinates `ω 0, …, ω (n - 1)`, one fewer than
Mathlib's `Filtration.piLE`: `piLT (n + 1) = piLE n`. -/
def piLT : @Filtration (Π i, X i) ι _ MeasurableSpace.pi :=
  naturalLT (fun i ω ↦ ω i) measurable_pi_apply

/-- `piLT` is the filtration of the strict past of the coordinate process. -/
lemma piLT_eq_naturalLT : piLT (X := X) = naturalLT (fun i ω ↦ ω i) measurable_pi_apply :=
  (rfl)

/-- Time `i` of `piLT` is generated by the coordinates `j < i`. -/
lemma piLT_apply (i : ι) :
    piLT (X := X) i = ⨆ j < i, MeasurableSpace.comap (fun ω : Π i, X i ↦ ω j) inferInstance :=
  (rfl)

/-- For `j < i`, the coordinate `j` is measurable at time `i` of `piLT`. -/
lemma measurable_piLT_apply {i j : ι} (hji : j < i) :
    Measurable[piLT (X := X) i] fun ω ↦ ω j :=
  measurable_naturalLT measurable_pi_apply hji

end piLT

section piLTNat

variable {X : ℕ → Type*} [∀ n, MeasurableSpace (X n)]

/-- At time `0`, the strict past of the coordinates of a sequence is the trivial σ-algebra: no
coordinate has been seen. -/
@[simp]
lemma piLT_zero : piLT (X := X) 0 = ⊥ := by
  simp [piLT_apply]

/-- Time `n + 1` of the strict past of the coordinates of a sequence is time `n` of
`Filtration.piLE`: both have seen the coordinates `0, …, n`. -/
lemma piLT_add_one (n : ℕ) : piLT (X := X) (n + 1) = piLE n := by
  refine le_antisymm
    (iSup₂_le fun j hj ↦ (measurable_piLE_apply (Nat.lt_succ_iff.1 hj)).comap_le) ?_
  exact Measurable.comap_le <| @Measurable.of_eval _ _ _ (piLT (n + 1)) _ _
    fun j ↦ measurable_piLT_apply (Nat.lt_succ_of_le j.2)

/-- For `k ≤ n`, the first `k` terms of a sequence are measurable at time `n` of `piLT`. -/
lemma measurable_piLT_initSeg {𝓧 : Type*} [MeasurableSpace 𝓧] {k n : ℕ} (hk : k ≤ n) :
    Measurable[piLT (X := fun _ : ℕ ↦ 𝓧) n] (initSeg k) := by
  rw [initSeg_def]
  exact @Measurable.of_eval _ _ _ (piLT n) _ _ fun i ↦ measurable_piLT_apply (by have := i.2; omega)

end piLTNat

/-! ### The filtration of the first coordinates -/

section piLE

variable {𝓧 : Type*} {m𝓧 : MeasurableSpace 𝓧}

/-- For `k ≤ n + 1`, the first `k` terms of a sequence are measurable at time `n` of
`Filtration.piLE`. -/
lemma measurable_piLE_initSeg {k n : ℕ} (hk : k ≤ n + 1) :
    Measurable[piLE (X := fun _ : ℕ ↦ 𝓧) n] (initSeg k) := by
  rw [initSeg_def]
  exact @Measurable.of_eval _ _ _ (piLE n) _ _ fun i ↦ measurable_piLE_apply (by have := i.2; omega)

/-- The process of the values of measurable functions `X n` of the first `n + 1` terms of a
sequence is adapted to `Filtration.piLE`. -/
lemma adapted_piLE_comp_initSeg {β : Type*} [MeasurableSpace β]
    {X : (n : ℕ) → (Fin (n + 1) → 𝓧) → β} (hX : ∀ n, Measurable (X n)) :
    Adapted (piLE (X := fun _ : ℕ ↦ 𝓧)) fun n ω ↦ X n (initSeg (n + 1) ω) :=
  fun n ↦ (hX n).comp (measurable_piLE_initSeg le_rfl)

/-- A measurable function of the first `n + 1` terms of a sequence is measurable at time `n` of
`Filtration.piLE`. -/
lemma measurable_piLE_of_dependsOn {β : Type*} [MeasurableSpace β]
    {f : (ℕ → 𝓧) → β} {n : ℕ} (hf : Measurable f) (hfn : DependsOn f (Set.Iio (n + 1))) :
    Measurable[piLE n] f := by
  -- `exists_measurable_eq_comp_initSeg` needs `[Nonempty 𝓧]`; the empty case is trivial
  rcases isEmpty_or_nonempty 𝓧 with h𝓧 | h𝓧
  · let : MeasurableSpace (ℕ → 𝓧) := piLE n
    exact Subsingleton.measurable
  obtain ⟨g, hg, rfl⟩ := exists_measurable_eq_comp_initSeg hf hfn
  exact Measurable.comp (mα := piLE n) hg (measurable_piLE_initSeg le_rfl)

/-- A random time that is a measurable function, at least `k`, of the first `k + 1` terms of a
sequence is a stopping time of `Filtration.piLE`. -/
lemma isStoppingTime_piLE_comp_initSeg {k : ℕ} {T : (Fin (k + 1) → 𝓧) → ℕ}
    (hT : Measurable T) (hTk : ∀ x, k ≤ T x) :
    IsStoppingTime (piLE (X := fun _ : ℕ ↦ 𝓧)) fun ω ↦ (T (initSeg (k + 1) ω) : WithTop ℕ) := by
  intro i
  by_cases hi : k ≤ i
  · exact measurable_piLE_initSeg (by omega)
      (hT (MeasurableSet.of_discrete (s := {m : ℕ | (m : WithTop ℕ) ≤ i})))
  · -- before time `k` the random time has not stopped yet
    convert @MeasurableSet.empty _ (piLE (X := fun _ : ℕ ↦ 𝓧) i) using 1
    ext ω
    simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, not_le]
    exact Nat.cast_lt.2 (lt_of_lt_of_le (by omega) (hTk _))

end piLE

end MeasureTheory.Filtration
