module

public import LMLExplore.Probability.Distributions.ExponentialFamily.Mean
public import TauCeti.Probability.Distributions.Poisson.Basic

/-!
# The Poisson laws as an exponential family

The Poisson laws `Po(r)` on `ℕ`, with the statistic `T = Nat.cast : ℕ → ℝ`, form the exponential
family generated by any of them. Tilting `Po(r)` by `n ↦ η n` multiplies its rate by `exp η`: the
member of natural parameter `η` of the exponential family of `Po(r)` is `Po(r exp η)`. The
log-partition function is the cumulant generating function `ψ(η) = r (exp η - 1)` of the count under
`Po(r)`, so the mean map is `ψ'(η) = r exp η`. For `r ≠ 0` it takes every positive value: the means
of the family are the interval `(0, ∞)`, the natural parameter of the mean `μ` is `log (μ / r)`,
the member of mean `μ` is `Po(μ)`, and the divergence of the family in the mean parametrization is
`d(μ, μ') = μ log (μ / μ') - μ + μ'`. This is also the Kullback–Leibler divergence between Poisson
laws of positive rates.

Poisson arms are one of the parametric arm models of bandit identification, for example in
A. Garivier and E. Kaufmann, *Optimal best arm identification with fixed confidence*, COLT 2016,
where the closed form of the divergence makes the transportation costs explicit.

## Main statements

* `LMLExplore.tilted_mul_natCast_poissonMeasure`, `LMLExplore.expFamily_poissonMeasure`: the
  member of natural parameter `η` of the exponential family of `Po(r)` is `Po(r exp η)`.
* `LMLExplore.cgf_natCast_poissonMeasure`, `LMLExplore.integrableExpSet_natCast_poissonMeasure`:
  the log-partition function of the family is `η ↦ r (exp η - 1)`, finite for every `η`.
* `LMLExplore.deriv_cgf_natCast_poissonMeasure`: the mean map of the family is `η ↦ r exp η`.
* `LMLExplore.not_ae_eq_const_natCast_poissonMeasure`: for `r ≠ 0`, the count is not almost
  everywhere constant under `Po(r)`, the nondegeneracy assumption of the mean parametrization.
* `LMLExplore.expFamilyMeans_poissonMeasure`: for `r ≠ 0`, the means of the family are `(0, ∞)`.
* `LMLExplore.natParam_poissonMeasure`: for `r ≠ 0`, the natural parameter of the mean `μ > 0` is
  `log (μ / r)`.
* `LMLExplore.expFamily_natParam_poissonMeasure`: for `r ≠ 0`, the member of mean `μ > 0` is
  `Po(μ)`.
* `LMLExplore.expFamilyDiv_poissonMeasure`: for `r ≠ 0`, the divergence of the family is
  `d(μ, μ') = μ log (μ / μ') - μ + μ'` for `μ, μ' > 0`.
* `LMLExplore.klDiv_poissonMeasure`: the Kullback–Leibler divergence between `Po(μ)` and `Po(μ')`
  for `μ, μ' ≠ 0` is `μ log (μ / μ') - μ + μ'`.
-/

public section

open MeasureTheory ProbabilityTheory InformationTheory Real Set

open scoped NNReal ENNReal Nat

namespace LMLExplore

variable {r : ℝ≥0} {μ μ' : ℝ}

/-- The moment generating function of the count under `Po(r)` is `η ↦ exp (r (exp η - 1))`. -/
lemma mgf_natCast_poissonMeasure (r : ℝ≥0) (η : ℝ) :
    mgf (Nat.cast : ℕ → ℝ) (poissonMeasure r) η = exp (r * (exp η - 1)) :=
  (TauCeti.Probability.pgf_exp id _ η).symm.trans (TauCeti.Probability.pgf_poissonMeasure r _)

/-- The cumulant generating function of the count under `Po(r)`, the log-partition function of
the exponential family of `Po(r)`, is `η ↦ r (exp η - 1)`. -/
@[simp]
theorem cgf_natCast_poissonMeasure (r : ℝ≥0) (η : ℝ) :
    cgf (Nat.cast : ℕ → ℝ) (poissonMeasure r) η = r * (exp η - 1) := by
  rw [cgf, mgf_natCast_poissonMeasure, log_exp]

/-- Every exponential moment of the count under `Po(r)` is finite: the natural parameters of the
exponential family of `Po(r)` are all of `ℝ`. -/
@[simp]
theorem integrableExpSet_natCast_poissonMeasure (r : ℝ≥0) :
    integrableExpSet (Nat.cast : ℕ → ℝ) (poissonMeasure r) = univ :=
  eq_univ_of_forall fun η ↦ by
    rw [integrableExpSet, mem_ofPred_eq, ← mgf_pos_iff, mgf_natCast_poissonMeasure]
    exact exp_pos _

/-- Tilting a Poisson law by `n ↦ η n` multiplies its rate by `exp η`. -/
@[simp]
theorem tilted_mul_natCast_poissonMeasure (r : ℝ≥0) (η : ℝ) :
    (poissonMeasure r).tilted (fun n ↦ η * n) = poissonMeasure (r * exp η).toNNReal := by
  have hr : ((r * exp η).toNNReal : ℝ) = r * exp η := coe_toNNReal _ (by positivity)
  refine Measure.ext_of_singleton fun n ↦ ?_
  have h_mgf : ∫ k : ℕ, exp (η * k) ∂(poissonMeasure r) = exp (r * (exp η - 1)) :=
    mgf_natCast_poissonMeasure r η
  rw [tilted_apply, lintegral_singleton, h_mgf, poissonMeasure_singleton, poissonMeasure_singleton,
    hr, ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  -- `exp (η n) / exp (r (exp η - 1)) * (exp (-r) r ^ n / n!) = exp (-(r exp η)) (r exp η) ^ n / n!`
  rw [mul_pow, ← exp_nat_mul, mul_comm (n : ℝ) η]
  have h : exp (-(r * exp η)) = exp (-r) / exp (r * (exp η - 1)) := by
    rw [← exp_sub]
    ring_nf
  rw [h]
  field_simp

/-- The member of natural parameter `η` of the exponential family of `Po(r)` with statistic
`Nat.cast` is `Po(r exp η)`. -/
@[simp]
theorem expFamily_poissonMeasure (r : ℝ≥0) (η : ℝ) :
    (poissonMeasure r).expFamily Nat.cast η = poissonMeasure (r * exp η).toNNReal := by
  rw [Measure.expFamily_def]
  exact tilted_mul_natCast_poissonMeasure r η

/-- The mean map of the exponential family of `Po(r)` is `η ↦ r exp η`. -/
@[simp]
theorem deriv_cgf_natCast_poissonMeasure (r : ℝ≥0) (η : ℝ) :
    deriv (cgf (Nat.cast : ℕ → ℝ) (poissonMeasure r)) η = r * exp η := by
  rw [show cgf (Nat.cast : ℕ → ℝ) (poissonMeasure r) = fun η ↦ r * (exp η - 1) from
    funext (cgf_natCast_poissonMeasure r)]
  have h : HasDerivAt (fun η ↦ (r : ℝ) * (exp η - 1)) (r * exp η) η := by
    simpa using ((hasDerivAt_exp η).sub_const 1).const_mul (r : ℝ)
  exact h.deriv

/-- For `r ≠ 0`, the count is not almost everywhere constant under `Po(r)`: the values `0` and `1`
both have positive probability. This is the nondegeneracy assumption of the mean parametrization
of the exponential family of `Po(r)`. -/
lemma not_ae_eq_const_natCast_poissonMeasure (hr : r ≠ 0) (c : ℝ) :
    ¬ (Nat.cast : ℕ → ℝ) =ᵐ[poissonMeasure r] fun _ ↦ c := by
  intro h
  rw [Filter.EventuallyEq, ae_iff_of_countable] at h
  have h_pos (n : ℕ) : poissonMeasure r {n} ≠ 0 :=
    (measureReal_ne_zero_iff (measure_ne_top _ _)).1
      (poissonMeasure_real_singleton_pos n (pos_iff_ne_zero.2 hr)).ne'
  have h0 := h 0 (h_pos 0)
  have h1 := h 1 (h_pos 1)
  simp only [Nat.cast_zero, Nat.cast_one] at h0 h1
  linarith

/-- For `r ≠ 0`, the means of the exponential family of `Po(r)` are the interval `(0, ∞)`. -/
@[simp]
theorem expFamilyMeans_poissonMeasure (hr : r ≠ 0) :
    (poissonMeasure r).expFamilyMeans Nat.cast = Ioi 0 := by
  have hr' : (0 : ℝ) < r := NNReal.coe_pos.2 (pos_iff_ne_zero.2 hr)
  ext μ
  simp only [Measure.mem_expFamilyMeans_iff, integrableExpSet_natCast_poissonMeasure,
    interior_univ, mem_univ, true_and, deriv_cgf_natCast_poissonMeasure, mem_Ioi]
  refine ⟨fun ⟨η, hη⟩ ↦ hη ▸ by positivity, fun hμ ↦ ⟨log (μ / r), ?_⟩⟩
  rw [exp_log (div_pos hμ hr')]
  field_simp

/-- For `r ≠ 0`, the natural parameter of the member of mean `μ > 0` of the exponential family of
`Po(r)` is `log (μ / r)`. -/
@[simp]
theorem natParam_poissonMeasure (hr : r ≠ 0) (hμ : 0 < μ) :
    (poissonMeasure r).natParam Nat.cast μ = log (μ / r) := by
  have hr' : (r : ℝ) ≠ 0 := NNReal.coe_ne_zero.2 hr
  have h := Measure.deriv_cgf_natParam (ρ := poissonMeasure r) (T := Nat.cast) (μ := μ)
    (by rwa [expFamilyMeans_poissonMeasure hr])
  rw [deriv_cgf_natCast_poissonMeasure] at h
  have h_exp : exp ((poissonMeasure r).natParam Nat.cast μ) = μ / r := by
    rw [eq_div_iff hr', mul_comm, h]
  rw [← h_exp, log_exp]

/-- For `r ≠ 0`, the member of mean `μ > 0` of the exponential family of `Po(r)` is `Po(μ)`. -/
theorem expFamily_natParam_poissonMeasure (hr : r ≠ 0) (hμ : 0 < μ) :
    (poissonMeasure r).expFamily Nat.cast ((poissonMeasure r).natParam Nat.cast μ) =
      poissonMeasure μ.toNNReal := by
  have hr' : (0 : ℝ) < r := NNReal.coe_pos.2 (pos_iff_ne_zero.2 hr)
  rw [expFamily_poissonMeasure, natParam_poissonMeasure hr hμ, exp_log (div_pos hμ hr'),
    mul_div_cancel₀ _ hr'.ne']

/-- For `r ≠ 0`, the divergence of the exponential family of `Po(r)` in the mean parametrization
is `d(μ, μ') = μ log (μ / μ') - μ + μ'` for `μ, μ' > 0`. -/
@[simp]
theorem expFamilyDiv_poissonMeasure (hr : r ≠ 0) (hμ : 0 < μ) (hμ' : 0 < μ') :
    (poissonMeasure r).expFamilyDiv Nat.cast μ μ' = μ * log (μ / μ') - μ + μ' := by
  have hr' : (0 : ℝ) < r := NNReal.coe_pos.2 (pos_iff_ne_zero.2 hr)
  simp only [Measure.expFamilyDiv_def, natParam_poissonMeasure hr hμ,
    natParam_poissonMeasure hr hμ', cgf_natCast_poissonMeasure]
  rw [exp_log (div_pos hμ hr'), exp_log (div_pos hμ' hr'),
    log_div hμ.ne' hr'.ne', log_div hμ'.ne' hr'.ne', log_div hμ.ne' hμ'.ne']
  field_simp
  ring

/-- The Kullback–Leibler divergence between Poisson laws of nonzero rates `μ` and `μ'` is
`μ log (μ / μ') - μ + μ'`. -/
theorem klDiv_poissonMeasure {μ μ' : ℝ≥0} (hμ : μ ≠ 0) (hμ' : μ' ≠ 0) :
    klDiv (poissonMeasure μ) (poissonMeasure μ') =
      ENNReal.ofReal (μ * log (μ / μ') - μ + μ') := by
  have hμ₀ : (0 : ℝ) < μ := NNReal.coe_pos.2 (pos_iff_ne_zero.2 hμ)
  have hμ₀' : (0 : ℝ) < μ' := NNReal.coe_pos.2 (pos_iff_ne_zero.2 hμ')
  have hmem (ν : ℝ≥0) (hν : (0 : ℝ) < ν) :
      (ν : ℝ) ∈ (poissonMeasure μ').expFamilyMeans Nat.cast := by
    rwa [expFamilyMeans_poissonMeasure hμ']
  have h := Measure.klDiv_expFamily_natParam (hmem μ hμ₀) (hmem μ' hμ₀')
  rwa [expFamily_natParam_poissonMeasure hμ' hμ₀, expFamily_natParam_poissonMeasure hμ' hμ₀',
    toNNReal_coe, toNNReal_coe, expFamilyDiv_poissonMeasure hμ' hμ₀ hμ₀'] at h

end LMLExplore
