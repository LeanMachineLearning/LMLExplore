module

public import LMLExplore.Probability.Distributions.ExponentialFamily.Mean
public import TauCeti.Probability.Distributions.Exponential.Basic

/-!
# The exponential laws as an exponential family

The exponential laws `expMeasure r` of positive rate `r` form the natural exponential family
(`T = id`) generated by any of them. Tilting `expMeasure r` by `x ↦ η x` for `η < r` lowers its rate
by `η`: the member of natural parameter `η` of the exponential family of `expMeasure r` is
`expMeasure (r - η)`. The natural parameters are the `η < r`, the log-partition function is the
cumulant generating function `ψ(η) = log (r / (r - η))`, and the mean map is
`ψ'(η) = (r - η)⁻¹`. It takes every positive value: the means of the family are the interval
`(0, ∞)`, the natural parameter of the mean `μ` is `r - μ⁻¹`, the member of mean `μ` is
`expMeasure μ⁻¹`, and the divergence of the family in the mean parametrization is
`d(μ, μ') = μ / μ' - 1 - log (μ / μ')`. In terms of the rates, the Kullback–Leibler divergence
between `expMeasure r` and `expMeasure r'` is `r' / r - 1 - log (r' / r)`.

Exponential arms are one of the parametric arm models of bandit identification, for example in
A. Garivier and E. Kaufmann, *Optimal best arm identification with fixed confidence*, COLT 2016,
where the closed form of the divergence makes the transportation costs explicit.

## Main statements

* `LMLExplore.tilted_mul_expMeasure`, `LMLExplore.expFamily_expMeasure`: the member of natural
  parameter `η` of the exponential family of `expMeasure r` is `expMeasure (r - η)` (the zero
  measure for `η ≥ r`, as is `expMeasure` of a nonpositive rate, `LMLExplore.expMeasure_of_nonpos`).
* `LMLExplore.deriv_cgf_expMeasure`: the mean map of the family is `η ↦ (r - η)⁻¹` on `η < r`.
* `LMLExplore.not_ae_eq_const_expMeasure`: the identity is not almost everywhere constant under
  `expMeasure r`, the nondegeneracy assumption of the mean parametrization.
* `LMLExplore.expFamilyMeans_expMeasure`: the means of the family are `(0, ∞)`.
* `LMLExplore.natParam_expMeasure`: the natural parameter of the mean `μ > 0` is `r - μ⁻¹`.
* `LMLExplore.expFamily_natParam_expMeasure`: the member of mean `μ > 0` is `expMeasure μ⁻¹`.
* `LMLExplore.expFamilyDiv_expMeasure`: the divergence of the family is
  `d(μ, μ') = μ / μ' - 1 - log (μ / μ')` for `μ, μ' > 0`.
* `LMLExplore.klDiv_expMeasure`: the Kullback–Leibler divergence between `expMeasure r` and
  `expMeasure r'` for `r, r' > 0` is `r' / r - 1 - log (r' / r)`.
-/

public section

open MeasureTheory ProbabilityTheory InformationTheory Real Set

namespace LMLExplore

variable {r η μ μ' : ℝ}

/-- The exponential law of a nonpositive rate is the zero measure: its density vanishes. -/
@[simp]
lemma expMeasure_of_nonpos (hr : r ≤ 0) : expMeasure r = 0 := by
  rw [TauCeti.Probability.expMeasure_eq_withDensity, ← withDensity_zero]
  congr 1
  funext x
  rw [exponentialPDF_eq, Pi.zero_apply, ENNReal.ofReal_eq_zero]
  split_ifs
  · exact mul_nonpos_of_nonpos_of_nonneg hr (exp_pos _).le
  · exact le_rfl

/-- Tilting an exponential law by `x ↦ η x` lowers its rate by `η`: `expMeasure r` tilted by
`x ↦ η x` is `expMeasure (r - η)`. For `η ≥ r`, both sides are the zero measure. -/
@[simp]
theorem tilted_mul_expMeasure (hr : 0 < r) (η : ℝ) :
    (expMeasure r).tilted (fun x ↦ η * x) = expMeasure (r - η) := by
  rcases lt_or_ge η r with hη | hη
  swap
  · -- `x ↦ exp (η x)` is not integrable, and the rate `r - η` is nonpositive.
    rw [tilted_of_not_integrable (by simpa [hr] using hη), expMeasure_of_nonpos (by linarith)]
  rw [Measure.tilted, TauCeti.Probability.expMeasure_eq_withDensity,
    TauCeti.Probability.expMeasure_eq_withDensity,
    ← withDensity_mul _ (f := exponentialPDF r) (measurable_exponentialPDFReal r).ennreal_ofReal
      (by fun_prop)]
  congr 1
  funext x
  have h_mgf : ∫ y, exp (η * y) ∂(volume.withDensity (exponentialPDF r)) = r / (r - η) := by
    rw [← TauCeti.Probability.expMeasure_eq_withDensity]
    exact TauCeti.Probability.mgf_id_expMeasure hr hη
  have hrη : 0 < r - η := sub_pos.2 hη
  simp only [Pi.mul_apply, h_mgf, exponentialPDF_eq]
  split_ifs with hx
  · rw [← ENNReal.ofReal_mul (by positivity)]
    congr 1
    -- `r exp (-(r x)) * (exp (η x) / (r / (r - η))) = (r - η) exp (-((r - η) x))`
    have h : exp (-((r - η) * x)) = exp (-(r * x)) * exp (η * x) := by
      rw [← exp_add]
      ring_nf
    rw [h]
    field_simp
  · simp

/-- The member of natural parameter `η` of the exponential family of `expMeasure r` with statistic
`id` is `expMeasure (r - η)`. For `η ≥ r`, both sides are the zero measure. -/
@[simp]
theorem expFamily_expMeasure (hr : 0 < r) (η : ℝ) :
    (expMeasure r).expFamily id η = expMeasure (r - η) := by
  rw [Measure.expFamily_def]
  exact tilted_mul_expMeasure hr η

/-- The mean map of the exponential family of `expMeasure r` is `η ↦ (r - η)⁻¹` on `η < r`. -/
theorem deriv_cgf_expMeasure (hr : 0 < r) (hη : η < r) :
    deriv (cgf id (expMeasure r)) η = (r - η)⁻¹ := by
  rw [← Measure.integral_expFamily (by simpa [hr] using hη), expFamily_expMeasure hr η]
  exact TauCeti.Probability.integral_id_expMeasure (sub_pos.2 hη)

/-- The identity is not almost everywhere constant under `expMeasure r` for `r > 0`: the
exponential law has a density, hence no atoms. This is the nondegeneracy assumption of the mean
parametrization of the exponential family of `expMeasure r`. -/
lemma not_ae_eq_const_expMeasure (hr : 0 < r) (c : ℝ) :
    ¬ id =ᵐ[expMeasure r] fun _ ↦ c := by
  have := isProbabilityMeasure_expMeasure hr
  have h_ne : ∀ᵐ x ∂expMeasure r, x ≠ c := by
    rw [TauCeti.Probability.expMeasure_eq_withDensity]
    exact (withDensity_absolutelyContinuous _ _).ae_le (Measure.ae_ne volume c)
  intro h
  obtain ⟨x, hx, hxc⟩ := (h.and h_ne).exists
  exact hxc hx

/-- The means of the exponential family of `expMeasure r` for `r > 0` are the interval
`(0, ∞)`. -/
@[simp]
theorem expFamilyMeans_expMeasure (hr : 0 < r) :
    (expMeasure r).expFamilyMeans id = Ioi 0 := by
  ext μ
  rw [Measure.mem_expFamilyMeans_iff, TauCeti.Probability.integrableExpSet_id_expMeasure hr,
    interior_Iio, mem_Ioi]
  refine ⟨fun ⟨η, hη, h⟩ ↦ ?_, fun hμ ↦ ⟨r - μ⁻¹, by simpa using hμ, ?_⟩⟩
  · rw [← h, deriv_cgf_expMeasure hr hη]
    exact inv_pos.2 (sub_pos.2 hη)
  · rw [deriv_cgf_expMeasure hr (by simpa using hμ), sub_sub_cancel, inv_inv]

/-- The natural parameter of the member of mean `μ > 0` of the exponential family of
`expMeasure r` is `r - μ⁻¹`. -/
@[simp]
theorem natParam_expMeasure (hr : 0 < r) (hμ : 0 < μ) :
    (expMeasure r).natParam id μ = r - μ⁻¹ := by
  have hμ' : μ ∈ (expMeasure r).expFamilyMeans id := by rwa [expFamilyMeans_expMeasure hr]
  have h_lt : (expMeasure r).natParam id μ < r := by
    simpa [TauCeti.Probability.integrableExpSet_id_expMeasure hr] using
      Measure.natParam_mem_interior_integrableExpSet hμ'
  have h := Measure.deriv_cgf_natParam hμ'
  rw [deriv_cgf_expMeasure hr h_lt, inv_eq_iff_eq_inv] at h
  rw [← h, sub_sub_cancel]

/-- The member of mean `μ > 0` of the exponential family of `expMeasure r` is `expMeasure μ⁻¹`. -/
theorem expFamily_natParam_expMeasure (hr : 0 < r) (hμ : 0 < μ) :
    (expMeasure r).expFamily id ((expMeasure r).natParam id μ) = expMeasure μ⁻¹ := by
  rw [natParam_expMeasure hr hμ, expFamily_expMeasure hr, sub_sub_cancel]

/-- The divergence of the exponential family of `expMeasure r` in the mean parametrization is
`d(μ, μ') = μ / μ' - 1 - log (μ / μ')` for `μ, μ' > 0`. -/
@[simp]
theorem expFamilyDiv_expMeasure (hr : 0 < r) (hμ : 0 < μ) (hμ' : 0 < μ') :
    (expMeasure r).expFamilyDiv id μ μ' = μ / μ' - 1 - log (μ / μ') := by
  rw [Measure.expFamilyDiv_def, natParam_expMeasure hr hμ, natParam_expMeasure hr hμ',
    TauCeti.Probability.cgf_id_expMeasure hr (by simpa using hμ'),
    TauCeti.Probability.cgf_id_expMeasure hr (by simpa using hμ), sub_sub_cancel, sub_sub_cancel,
    div_inv_eq_mul, div_inv_eq_mul, log_mul hr.ne' hμ'.ne', log_mul hr.ne' hμ.ne',
    log_div hμ.ne' hμ'.ne']
  field_simp
  ring

/-- The Kullback–Leibler divergence between the exponential laws of positive rates `r` and `r'`
is `r' / r - 1 - log (r' / r)`. -/
theorem klDiv_expMeasure {r' : ℝ} (hr : 0 < r) (hr' : 0 < r') :
    klDiv (expMeasure r) (expMeasure r') = ENNReal.ofReal (r' / r - 1 - log (r' / r)) := by
  have hmem (s : ℝ) (hs : 0 < s) : s⁻¹ ∈ (expMeasure r).expFamilyMeans id := by
    rw [expFamilyMeans_expMeasure hr]
    exact inv_pos.2 hs
  have h := Measure.klDiv_expFamily_natParam (hmem r hr) (hmem r' hr')
  rwa [expFamily_natParam_expMeasure hr (inv_pos.2 hr),
    expFamily_natParam_expMeasure hr (inv_pos.2 hr'), inv_inv, inv_inv,
    expFamilyDiv_expMeasure hr (inv_pos.2 hr) (inv_pos.2 hr'), inv_div_inv] at h

end LMLExplore
