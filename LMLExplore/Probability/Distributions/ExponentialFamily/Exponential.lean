module

public import LMLExplore.Probability.Distributions.ExponentialFamily.Gamma
public import TauCeti.Probability.Distributions.Exponential.Basic

/-!
# The exponential laws as an exponential family

The exponential laws `expMeasure r = gammaMeasure 1 r` of positive rate `r` form the natural
exponential family (`T = id`) generated by any of them: the gamma family of shape `1`
(`Probability/Distributions/ExponentialFamily/Gamma.lean`), from which every statement here
follows. Tilting `expMeasure r` by `x ↦ η x` for `η < r` lowers its rate by `η`: the member of
natural parameter `η` of the exponential family of `expMeasure r` is `expMeasure (r - η)`. The
natural parameters are the `η < r`, the log-partition function is the cumulant generating function
`ψ(η) = log (r / (r - η))`, and the mean map is `ψ'(η) = (r - η)⁻¹`. It takes every positive
value: the means of the family are the interval `(0, ∞)`, the natural parameter of the mean `μ` is
`r - μ⁻¹`, the member of mean `μ` is `expMeasure μ⁻¹`, and the divergence of the family in the mean
parametrization is `d(μ, μ') = μ / μ' - 1 - log (μ / μ')`. In terms of the rates, the
Kullback–Leibler divergence between `expMeasure r` and `expMeasure r'` is
`r' / r - 1 - log (r' / r)`. Its extension to every level, the Cramér rate function of the member
of mean `μ`, is `dbar(x, μ) = x / μ - 1 - log (x / μ)` at levels `x > 0` and infinite at levels
`x ≤ 0`; it determines the KL-UCB index of exponential rewards.

Exponential arms are one of the parametric arm models of bandit identification, for example in
A. Garivier and E. Kaufmann, *Optimal best arm identification with fixed confidence*, COLT 2016,
where the closed form of the divergence makes the transportation costs explicit.

## Main statements

* `LMLExplore.expFamily_expMeasure`: the member of natural parameter `η` of the exponential family
  of `expMeasure r` is `expMeasure (r - η)`, for every `η` (the zero measure for `η ≥ r`, as is
  `expMeasure` of a nonpositive rate, `ProbabilityTheory.expMeasure_of_nonpos`).
* `LMLExplore.deriv_cgf_expMeasure`: the mean map of the family is `η ↦ (r - η)⁻¹` on `η < r`.
* `LMLExplore.not_ae_eq_const_expMeasure`: the identity is not almost everywhere constant under
  `expMeasure r`, the nondegeneracy assumption of the mean parametrization.
* `LMLExplore.expFamilyMeans_expMeasure`: the means of the family are `(0, ∞)`.
* `LMLExplore.natParam_expMeasure`: the natural parameter of the mean `μ > 0` is `r - μ⁻¹`.
* `LMLExplore.expFamily_natParam_expMeasure`: the member of mean `μ > 0` is `expMeasure μ⁻¹`.
* `LMLExplore.expFamilyDiv_expMeasure`: the divergence of the family is
  `d(μ, μ') = μ / μ' - 1 - log (μ / μ')` for `μ, μ' > 0`.
* `LMLExplore.klDiv_expMeasure`: the Kullback–Leibler divergence between `expMeasure r` and
  `expMeasure r'` for `r, r' > 0` is `r' / r - 1 - log (r' / r)`.
* `LMLExplore.image_expFamily_expMeasure`: the members of the family are the exponential laws
  `expMeasure b` of rate `b > 0`.
* `LMLExplore.expFamilyRate_expMeasure`, `LMLExplore.expFamilyRate_expMeasure_of_nonpos`: the
  extended divergence is `dbar(x, μ) = x / μ - 1 - log (x / μ)` at levels `x > 0`, and `∞` at
  levels `x ≤ 0`.
* `LMLExplore.le_expFamilyUpper_expMeasure_iff`, `LMLExplore.expFamilyUpper_expMeasure_of_nonpos`:
  the upper confidence level of the family at positive and at nonpositive levels.
-/

public section

open MeasureTheory ProbabilityTheory InformationTheory Real Set

open scoped ENNReal

namespace LMLExplore

variable {r η μ μ' x q : ℝ}

/-- The member of natural parameter `η` of the exponential family of `expMeasure r` with statistic
`id` is `expMeasure (r - η)`. For `η ≥ r`, both sides are the zero measure. -/
@[simp]
theorem expFamily_expMeasure (hr : 0 < r) (η : ℝ) :
    (expMeasure r).expFamily id η = expMeasure (r - η) := by
  rcases lt_or_ge η r with hη | hη
  · rw [expMeasure, expFamily_gammaMeasure one_pos hr hη, expMeasure]
  -- `x ↦ exp (η x)` is not integrable, and the rate `r - η` is nonpositive.
  rw [Measure.expFamily_def, tilted_of_not_integrable (by simpa [hr] using hη),
    expMeasure_of_nonpos (by linarith)]

/-- The mean map of the exponential family of `expMeasure r` is `η ↦ (r - η)⁻¹` on `η < r`. -/
@[simp]
theorem deriv_cgf_expMeasure (hr : 0 < r) (hη : η < r) :
    deriv (cgf id (expMeasure r)) η = (r - η)⁻¹ := by
  rw [expMeasure, deriv_cgf_gammaMeasure one_pos hr hη, one_div]

/-- The identity is not almost everywhere constant under `expMeasure r` for `r > 0`: the
exponential law has a density, hence no atoms. This is the nondegeneracy assumption of the mean
parametrization of the exponential family of `expMeasure r`. -/
lemma not_ae_eq_const_expMeasure (hr : 0 < r) (c : ℝ) :
    ¬ id =ᵐ[expMeasure r] fun _ ↦ c := by
  rw [expMeasure]
  exact not_ae_eq_const_gammaMeasure one_pos hr c

/-- The means of the exponential family of `expMeasure r` for `r > 0` are the interval
`(0, ∞)`. -/
@[simp]
theorem expFamilyMeans_expMeasure (hr : 0 < r) :
    (expMeasure r).expFamilyMeans id = Ioi 0 := by
  rw [expMeasure, expFamilyMeans_gammaMeasure one_pos hr]

/-- The natural parameter of the member of mean `μ > 0` of the exponential family of
`expMeasure r` is `r - μ⁻¹`. -/
@[simp]
theorem natParam_expMeasure (hr : 0 < r) (hμ : 0 < μ) :
    (expMeasure r).natParam id μ = r - μ⁻¹ := by
  rw [expMeasure, natParam_gammaMeasure one_pos hr hμ, one_div]

/-- The member of mean `μ > 0` of the exponential family of `expMeasure r` is `expMeasure μ⁻¹`. -/
theorem expFamily_natParam_expMeasure (hr : 0 < r) (hμ : 0 < μ) :
    (expMeasure r).expFamily id ((expMeasure r).natParam id μ) = expMeasure μ⁻¹ := by
  rw [expMeasure, expFamily_natParam_gammaMeasure one_pos hr hμ, one_div, expMeasure]

/-- The divergence of the exponential family of `expMeasure r` in the mean parametrization is
`d(μ, μ') = μ / μ' - 1 - log (μ / μ')` for `μ, μ' > 0`. -/
@[simp]
theorem expFamilyDiv_expMeasure (hr : 0 < r) (hμ : 0 < μ) (hμ' : 0 < μ') :
    (expMeasure r).expFamilyDiv id μ μ' = μ / μ' - 1 - log (μ / μ') := by
  rw [expMeasure, expFamilyDiv_gammaMeasure one_pos hr hμ hμ', one_mul]

/-- The Kullback–Leibler divergence between the exponential laws of positive rates `r` and `r'`
is `r' / r - 1 - log (r' / r)`. -/
theorem klDiv_expMeasure {r' : ℝ} (hr : 0 < r) (hr' : 0 < r') :
    klDiv (expMeasure r) (expMeasure r') = ENNReal.ofReal (r' / r - 1 - log (r' / r)) := by
  rw [expMeasure, expMeasure, klDiv_gammaMeasure one_pos hr hr', one_mul]

/-- The members of the exponential family of `expMeasure r` are the exponential laws `expMeasure b`
of positive rate `b`. -/
theorem image_expFamily_expMeasure (hr : 0 < r) :
    (expMeasure r).expFamily id '' interior (integrableExpSet id (expMeasure r)) =
      (fun b ↦ expMeasure b) '' Ioi 0 := by
  simp only [expMeasure]
  exact image_expFamily_gammaMeasure one_pos hr

/-- At a level `x > 0`, the extended divergence of the exponential family of `expMeasure r` is
`dbar(x, μ) = x / μ - 1 - log (x / μ)` for every mean `μ > 0`. -/
@[simp]
theorem expFamilyRate_expMeasure (hr : 0 < r) (hx : 0 < x) (hμ : 0 < μ) :
    (expMeasure r).expFamilyRate id x μ = ENNReal.ofReal (x / μ - 1 - log (x / μ)) := by
  rw [expMeasure, expFamilyRate_gammaMeasure one_pos hr hx hμ, one_mul]

/-- At a level `x ≤ 0`, the extended divergence of the exponential family of `expMeasure r` is
infinite for every mean `μ > 0`, since the exponential laws are supported on `(0, ∞)`. -/
@[simp]
theorem expFamilyRate_expMeasure_of_nonpos (hr : 0 < r) (hx : x ≤ 0) (hμ : 0 < μ) :
    (expMeasure r).expFamilyRate id x μ = ∞ := by
  rw [expMeasure, expFamilyRate_gammaMeasure_of_nonpos one_pos hr hx hμ]

/-- The upper confidence level of the exponential family of `expMeasure r` at a level `x > 0`: for
every `q ≥ x`, `q ≤ U(x, c)` if and only if `x / q - 1 - log (x / q) ≤ c`. This is the KL-UCB index
of exponential rewards. -/
theorem le_expFamilyUpper_expMeasure_iff (hr : 0 < r) (hx : 0 < x) (hxq : x ≤ q) {c : ℝ≥0∞} :
    (q : EReal) ≤ (expMeasure r).expFamilyUpper id x c ↔
      ENNReal.ofReal (x / q - 1 - log (x / q)) ≤ c := by
  rw [expMeasure, le_expFamilyUpper_gammaMeasure_iff one_pos hr hx hxq, one_mul]

/-- The upper confidence level of the exponential family of `expMeasure r` at a level `x ≤ 0` with
a finite budget `c` is `U(x, c) = x`. -/
@[simp]
theorem expFamilyUpper_expMeasure_of_nonpos (hr : 0 < r) (hx : x ≤ 0) {c : ℝ≥0∞} (hc : c ≠ ∞) :
    (expMeasure r).expFamilyUpper id x c = x := by
  rw [expMeasure, expFamilyUpper_gammaMeasure_of_nonpos one_pos hr hx hc]

end LMLExplore
