module

public import LMLExplore.Probability.Distributions.ExponentialFamily.RateFunction
public import TauCeti.MeasureTheory.Measure.Tilted

/-!
# Invariance of the mean parametrization of an exponential family

The exponential family of a measure `ρ` and a statistic `T : 𝓧 → ℝ` is determined, as a family of
measures, by much less than the pair `(ρ, T)`, and its mean parametrization does not see the
remaining freedom. This file proves the two invariances.

* **Change of base member.** For a natural parameter `η₀`, the family generated by the member
  `ρ_η₀ = ρ.expFamily T η₀` and `T` is the same family (`expFamily_expFamily`), with natural
  parameters shifted by `-η₀`. Its means are those of `ρ`, the natural parameter of a mean `μ` is
  `η(μ) - η₀`, the member of mean `μ` is the same measure, and the divergences `d` and `dbar` are
  unchanged. Any member of a family can therefore serve as its base measure: for example the
  Gaussian laws `𝒩(m, v)` of known mean `m`, with statistic `(x - m) ^ 2`, are the family of
  `𝒩(m, 1)`, whatever the base variance.
* **The law of the statistic.** The pair `(ρ, T)` and the natural exponential family of the law
  `ρ.map T` of the statistic, with statistic `id`, have the same natural parameters, the same
  log-partition function, hence the same means, natural parameters of the means and
  divergence `d`. For measurable `T`, the law of `T` under the member `ρ_η` is the member `η` of
  the natural family of `ρ.map T`, so `dbar` is also the same. The divergences of a family with
  statistic `T` are thus computed on the law of `T`: for example the law of `(x - m) ^ 2` under
  `𝒩(m, 1)` is the gamma law of shape and rate `1 / 2`.

The divergences `d` and `dbar` are the transportation costs of identification in bandits with
arms in an exponential family (A. Garivier and E. Kaufmann, *Optimal best arm identification with
fixed confidence*, COLT 2016), which these invariances let one compute on the simplest
representative of the family.

## Main statements

* `MeasureTheory.Measure.expFamilyMeans_expFamily`,
  `MeasureTheory.Measure.natParam_expFamily`,
  `MeasureTheory.Measure.expFamily_natParam_expFamily`,
  `MeasureTheory.Measure.expFamilyDiv_expFamily`,
  `MeasureTheory.Measure.expFamilyRate_expFamily`: replacing `ρ` by a member `ρ_η₀` keeps the
  means, shifts the natural parameters by `-η₀`, and keeps the members of each mean and the
  divergences `d` and `dbar`.
* `MeasureTheory.Measure.map_expFamily`: the law of `T` under `ρ_η` is the member `η` of the
  natural exponential family of `ρ.map T`.
* `MeasureTheory.Measure.expFamilyMeans_id_map`, `MeasureTheory.Measure.natParam_id_map`,
  `MeasureTheory.Measure.expFamilyDiv_id_map`, `MeasureTheory.Measure.expFamilyRate_id_map`: the
  natural exponential family of `ρ.map T` has the means, the natural parameters and the
  divergences `d` and `dbar` of the family of `ρ` and `T`.
-/

public section

open ProbabilityTheory LMLExplore Set

namespace MeasureTheory.Measure

variable {𝓧 : Type*} {m𝓧 : MeasurableSpace 𝓧} {ρ : Measure 𝓧} {T : 𝓧 → ℝ} {η₀ μ μ' : ℝ}

/-! ### Changing the base measure to a member of the family -/

/-- The family generated by a member `ρ_η₀` and `T` has the means of the family of `ρ` and `T`. -/
theorem expFamilyMeans_expFamily (hη₀ : η₀ ∈ integrableExpSet T ρ) :
    (ρ.expFamily T η₀).expFamilyMeans T = ρ.expFamilyMeans T := by
  ext μ
  simp only [mem_expFamilyMeans_iff, interior_integrableExpSet_expFamily hη₀, mem_preimage]
  constructor
  · rintro ⟨η, hη, rfl⟩
    exact ⟨η₀ + η, hη, (deriv_cgf_expFamily hη₀ hη).symm⟩
  · rintro ⟨η, hη, rfl⟩
    refine ⟨η - η₀, by rwa [add_sub_cancel], ?_⟩
    rw [deriv_cgf_expFamily hη₀ (by rwa [add_sub_cancel]), add_sub_cancel]

/-- A statistic which is not `ρ`-almost everywhere constant is not almost everywhere constant
under any member `ρ_η₀` with `η₀ ∈ integrableExpSet T ρ`. -/
lemma not_ae_eq_const_expFamily (hT : ∀ c, ¬ T =ᵐ[ρ] fun _ ↦ c)
    (hη₀ : η₀ ∈ integrableExpSet T ρ) (c : ℝ) :
    ¬ T =ᵐ[ρ.expFamily T η₀] fun _ ↦ c :=
  fun h ↦ hT c ((absolutelyContinuous_expFamily hη₀).ae_eq h)

/-- The natural parameter of a mean `μ` in the family generated by a member `ρ_η₀` and `T` is
`η(μ) - η₀`, where `η(μ)` is its natural parameter in the family of `ρ` and `T`. -/
theorem natParam_expFamily (hT : ∀ c, ¬ T =ᵐ[ρ] fun _ ↦ c) (hη₀ : η₀ ∈ integrableExpSet T ρ)
    (hμ : μ ∈ ρ.expFamilyMeans T) :
    (ρ.expFamily T η₀).natParam T μ = ρ.natParam T μ - η₀ := by
  have h_mem : η₀ + (ρ.natParam T μ - η₀) ∈ interior (integrableExpSet T ρ) := by
    rw [add_sub_cancel]
    exact natParam_mem_interior_integrableExpSet hμ
  have h_int : ρ.natParam T μ - η₀ ∈ interior (integrableExpSet T (ρ.expFamily T η₀)) := by
    rwa [interior_integrableExpSet_expFamily hη₀]
  conv_lhs => rw [← deriv_cgf_natParam hμ, ← add_sub_cancel η₀ (ρ.natParam T μ),
    ← deriv_cgf_expFamily hη₀ h_mem]
  exact natParam_deriv_cgf (not_ae_eq_const_expFamily hT hη₀) h_int

/-- The member of mean `μ` of the family generated by a member `ρ_η₀` and `T` is the member of mean
`μ` of the family of `ρ` and `T`. -/
theorem expFamily_natParam_expFamily (hT : ∀ c, ¬ T =ᵐ[ρ] fun _ ↦ c)
    (hη₀ : η₀ ∈ integrableExpSet T ρ) (hμ : μ ∈ ρ.expFamilyMeans T) :
    (ρ.expFamily T η₀).expFamily T ((ρ.expFamily T η₀).natParam T μ) =
      ρ.expFamily T (ρ.natParam T μ) := by
  rw [natParam_expFamily hT hη₀ hμ, expFamily_expFamily hη₀, add_sub_cancel]

/-- The family generated by a member `ρ_η₀` and `T` has the divergence `d` of the family of `ρ`
and `T`. -/
theorem expFamilyDiv_expFamily (hT : ∀ c, ¬ T =ᵐ[ρ] fun _ ↦ c) (hη₀ : η₀ ∈ integrableExpSet T ρ)
    (hμ : μ ∈ ρ.expFamilyMeans T) (hμ' : μ' ∈ ρ.expFamilyMeans T) :
    (ρ.expFamily T η₀).expFamilyDiv T μ μ' = ρ.expFamilyDiv T μ μ' := by
  have h_cgf {ν : ℝ} (hν : ν ∈ ρ.expFamilyMeans T) :
      cgf T (ρ.expFamily T η₀) (ρ.natParam T ν - η₀) = cgf T ρ (ρ.natParam T ν) - cgf T ρ η₀ := by
    rw [cgf_expFamily hη₀ (by
      rw [add_sub_cancel]
      exact interior_subset (natParam_mem_interior_integrableExpSet hν)), add_sub_cancel]
  rw [expFamilyDiv_def, expFamilyDiv_def, natParam_expFamily hT hη₀ hμ,
    natParam_expFamily hT hη₀ hμ', h_cgf hμ, h_cgf hμ']
  ring

/-- The family generated by a member `ρ_η₀` and `T` has the extended divergence `dbar` of the
family of `ρ` and `T`. -/
theorem expFamilyRate_expFamily (hT : ∀ c, ¬ T =ᵐ[ρ] fun _ ↦ c)
    (hη₀ : η₀ ∈ integrableExpSet T ρ) (x : ℝ) (hμ : μ ∈ ρ.expFamilyMeans T) :
    (ρ.expFamily T η₀).expFamilyRate T x μ = ρ.expFamilyRate T x μ := by
  rw [expFamilyRate_def, expFamilyRate_def, expFamily_natParam_expFamily hT hη₀ hμ]

/-! ### The natural exponential family of the law of the statistic -/

/-- The law of the statistic `T` under the member `ρ_η` of the family of `ρ` and `T` is the member
`η` of the natural exponential family of the law `ρ.map T`. -/
theorem map_expFamily (hT : Measurable T) (η : ℝ) :
    (ρ.expFamily T η).map T = (ρ.map T).expFamily id η := by
  simp_rw [expFamily_def]
  exact map_tilted ρ hT (g := fun y ↦ η * id y) (by fun_prop)

/-- The natural exponential family of the law `ρ.map T` has the means of the family of `ρ`
and `T`. -/
theorem expFamilyMeans_id_map (hT : AEMeasurable T ρ) :
    (ρ.map T).expFamilyMeans id = ρ.expFamilyMeans T := by
  rw [expFamilyMeans_def, expFamilyMeans_def, cgf_id_map hT, integrableExpSet_id_map hT]

/-- The natural exponential family of the law `ρ.map T` has the natural parameters of the family
of `ρ` and `T`. -/
theorem natParam_id_map (hT : AEMeasurable T ρ) : (ρ.map T).natParam id = ρ.natParam T := by
  ext μ
  rw [natParam_def, natParam_def, cgf_id_map hT, integrableExpSet_id_map hT]

/-- The natural exponential family of the law `ρ.map T` has the divergence `d` of the family of
`ρ` and `T`. -/
theorem expFamilyDiv_id_map (hT : AEMeasurable T ρ) :
    (ρ.map T).expFamilyDiv id = ρ.expFamilyDiv T := by
  ext μ μ'
  rw [expFamilyDiv_def, expFamilyDiv_def, cgf_id_map hT, natParam_id_map hT]

/-- The natural exponential family of the law `ρ.map T` has the extended divergence `dbar` of the
family of `ρ` and `T`. -/
theorem expFamilyRate_id_map (hT : Measurable T) :
    (ρ.map T).expFamilyRate id = ρ.expFamilyRate T := by
  ext x μ
  rw [expFamilyRate_def, expFamilyRate_def, natParam_id_map hT.aemeasurable, ← map_expFamily hT]
  exact congrFun (IdentDistrib.rateFunction_eq ⟨aemeasurable_id, hT.aemeasurable, map_id⟩) x

end MeasureTheory.Measure
