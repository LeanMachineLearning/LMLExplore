module

public import Mathlib.InformationTheory.KullbackLeibler.Basic
public import LMLExplore.Probability.Moments.Tilted

/-!
# Natural exponential families on `ℝ`

The natural exponential family generated by a measure `ρ` on `ℝ` is the family of its exponential
tilts `ρ_η = ρ.tilted (η * ·)`: the measure `ρ_η` has density `x ↦ exp (η x - ψ(η))` with respect
to `ρ`, where `ψ = cgf id ρ` is the log-partition function of the family. The tilt `ρ_η` is a
probability measure for every natural parameter `η` in `integrableExpSet id ρ` (when `ρ ≠ 0`),
and the family is closed under tilting: tilting `ρ_η` by `t * ·` gives `ρ_(η + t)`.

For `η` in the interior of `integrableExpSet id ρ`, the tilt `ρ_η` has moments of all orders, its
mean is `ψ'(η)` and its variance is `ψ''(η)`. The mean `ψ'(η)` is strictly increasing in `η` when
`ρ` is a probability measure that is not a Dirac mass
(`ProbabilityTheory.strictMonoOn_deriv_cgf_id`), so the members of the family with natural
parameters in that interior are determined by their means. The
Kullback–Leibler divergence between two members is the Bregman divergence of `ψ`:
`KL(ρ_η, ρ_η') = ψ(η') - ψ(η) - ψ'(η) (η' - η)`.

Gaussian laws with a fixed variance, Bernoulli, Poisson and exponential laws are natural
exponential families. They are the parametric arm distributions of the bandit literature, for
example of the lower bounds and algorithms of A. Garivier and E. Kaufmann, *Optimal best arm
identification with fixed confidence*, COLT 2016, where the closed form of the divergence makes the
transportation costs explicit.

## Main definitions

* `MeasureTheory.Measure.natExpFamily ρ η`: the member `ρ.tilted (η * ·)` of the natural
  exponential family of `ρ` with natural parameter `η`.

## Main statements

* `MeasureTheory.Measure.natExpFamily_natExpFamily`: tilting `ρ_η` by `t * ·` gives `ρ_(η + t)`.
* `MeasureTheory.Measure.cgf_id_natExpFamily`: the cumulant generating function of `ρ_η` is
  `t ↦ ψ(η + t) - ψ(η)`.
* `MeasureTheory.Measure.integral_id_natExpFamily`,
  `MeasureTheory.Measure.variance_id_natExpFamily`: the mean and the variance of `ρ_η` are `ψ'(η)`
  and `ψ''(η)`.
* `MeasureTheory.Measure.llr_natExpFamily`: the log-likelihood ratio of `ρ_η` with respect to
  `ρ_η'` is `x ↦ (η - η') x + ψ(η') - ψ(η)`, `ρ_η`-almost everywhere.
* `MeasureTheory.Measure.klDiv_natExpFamily`:
  `KL(ρ_η, ρ_η') = ψ(η') - ψ(η) - ψ'(η) (η' - η)`.
-/

public section

open ProbabilityTheory InformationTheory Real Set

open scoped ENNReal NNReal ProbabilityTheory

namespace MeasureTheory.Measure

variable {ρ : Measure ℝ} {η η' t : ℝ}

/-- The member with natural parameter `η` of the natural exponential family generated by a
measure `ρ` on `ℝ`: the exponential tilt `ρ.tilted (η * ·)`, with density
`x ↦ exp (η x - cgf id ρ η)` with respect to `ρ` (`natExpFamily_apply`). It is a probability
measure for `η ∈ integrableExpSet id ρ` and `ρ ≠ 0`, and `0` otherwise. -/
noncomputable def natExpFamily (ρ : Measure ℝ) (η : ℝ) : Measure ℝ := ρ.tilted (η * ·)

lemma natExpFamily_def (ρ : Measure ℝ) (η : ℝ) : ρ.natExpFamily η = ρ.tilted (η * ·) := (rfl)

@[simp]
lemma natExpFamily_zero_measure (η : ℝ) : (0 : Measure ℝ).natExpFamily η = 0 := by
  simp [natExpFamily_def]

/-- The member of natural parameter `0` of the natural exponential family of a probability
measure is the measure itself. -/
@[simp]
lemma natExpFamily_zero (ρ : Measure ℝ) [IsProbabilityMeasure ρ] : ρ.natExpFamily 0 = ρ := by
  simp [natExpFamily_def]

/-- The density of `ρ_η` with respect to `ρ` is `x ↦ exp (η x - cgf id ρ η)`. -/
lemma natExpFamily_apply [SFinite ρ] (hη : η ∈ integrableExpSet id ρ) (s : Set ℝ) :
    ρ.natExpFamily η s = ∫⁻ x in s, ENNReal.ofReal (exp (η * x - cgf id ρ η)) ∂ρ :=
  tilted_mul_apply_cgf (X := id) s hη

instance (ρ : Measure ℝ) (η : ℝ) : IsZeroOrProbabilityMeasure (ρ.natExpFamily η) := by
  rw [natExpFamily_def]
  infer_instance

lemma isProbabilityMeasure_natExpFamily [NeZero ρ] (hη : η ∈ integrableExpSet id ρ) :
    IsProbabilityMeasure (ρ.natExpFamily η) :=
  isProbabilityMeasure_tilted hη

lemma natExpFamily_absolutelyContinuous (ρ : Measure ℝ) (η : ℝ) : ρ.natExpFamily η ≪ ρ :=
  tilted_absolutelyContinuous _ _

lemma absolutelyContinuous_natExpFamily (hη : η ∈ integrableExpSet id ρ) :
    ρ ≪ ρ.natExpFamily η :=
  absolutelyContinuous_tilted hη

/-- Members of a natural exponential family with a natural parameter in `integrableExpSet id ρ`
have the null sets of `ρ`, hence are mutually absolutely continuous. -/
lemma natExpFamily_absolutelyContinuous_natExpFamily (η : ℝ) (hη' : η' ∈ integrableExpSet id ρ) :
    ρ.natExpFamily η ≪ ρ.natExpFamily η' :=
  (natExpFamily_absolutelyContinuous ρ η).trans (absolutelyContinuous_natExpFamily hη')

/-- A natural exponential family is closed under tilting: the member of natural parameter `t` of
the family generated by `ρ_η` is `ρ_(η + t)`. -/
lemma natExpFamily_natExpFamily (hη : η ∈ integrableExpSet id ρ) (t : ℝ) :
    (ρ.natExpFamily η).natExpFamily t = ρ.natExpFamily (η + t) := by
  simp_rw [natExpFamily_def, tilted_tilted (f := (η * ·)) hη]
  congr with x
  rw [Pi.add_apply, add_mul]

lemma mgf_id_natExpFamily : mgf id (ρ.natExpFamily η) t = mgf id ρ (η + t) / mgf id ρ η :=
  mgf_tilted_mul (X := id)

/-- The cumulant generating function of `ρ_η` is `t ↦ ψ(η + t) - ψ(η)`. -/
lemma cgf_id_natExpFamily (hη : η ∈ integrableExpSet id ρ)
    (hηt : η + t ∈ integrableExpSet id ρ) :
    cgf id (ρ.natExpFamily η) t = cgf id ρ (η + t) - cgf id ρ η :=
  cgf_tilted_mul (X := id) hη hηt

lemma integrableExpSet_id_natExpFamily (hη : η ∈ integrableExpSet id ρ) :
    integrableExpSet id (ρ.natExpFamily η) = (η + ·) ⁻¹' integrableExpSet id ρ :=
  integrableExpSet_tilted_mul (X := id) hη

lemma memLp_id_natExpFamily (hη : η ∈ interior (integrableExpSet id ρ)) (p : ℝ≥0) :
    MemLp id p (ρ.natExpFamily η) :=
  memLp_tilted_mul (X := id) hη p

lemma integrable_id_natExpFamily (hη : η ∈ interior (integrableExpSet id ρ)) :
    Integrable id (ρ.natExpFamily η) :=
  (memLp_id_natExpFamily hη 1).integrable le_rfl

/-- The mean of `ρ_η` is `ψ'(η)`. -/
lemma integral_id_natExpFamily (hη : η ∈ interior (integrableExpSet id ρ)) :
    ∫ x, x ∂(ρ.natExpFamily η) = deriv (cgf id ρ) η :=
  integral_tilted_mul_self (X := id) hη

/-- The variance of `ρ_η` is `ψ''(η)`. -/
lemma variance_id_natExpFamily (hη : η ∈ interior (integrableExpSet id ρ)) :
    Var[id; ρ.natExpFamily η] = iteratedDeriv 2 (cgf id ρ) η :=
  variance_tilted_mul (X := id) hη

/-- The log-likelihood ratio of `ρ_η` with respect to `ρ_η'` is
`x ↦ (η - η') x + ψ(η') - ψ(η)`, `ρ_η`-almost everywhere. -/
lemma llr_natExpFamily (hη' : η' ∈ integrableExpSet id ρ) :
    llr (ρ.natExpFamily η) (ρ.natExpFamily η') =ᵐ[ρ.natExpFamily η]
      fun x ↦ (η - η') * x + cgf id ρ η' - cgf id ρ η := by
  obtain hη | hη := em' (η ∈ integrableExpSet id ρ)
  · have h_zero : ρ.natExpFamily η = 0 := tilted_of_not_integrable hη
    simp [h_zero, Filter.EventuallyEq]
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp [Filter.EventuallyEq]
  have := isProbabilityMeasure_natExpFamily hη
  -- `ρ_η'` is the tilt of `ρ_η` by `(η' - η) * ·`.
  have h_int : η' - η ∈ integrableExpSet id (ρ.natExpFamily η) := by
    rwa [integrableExpSet_id_natExpFamily hη, mem_preimage, add_sub_cancel]
  have h_eq : ρ.natExpFamily η' = (ρ.natExpFamily η).tilted ((η' - η) * ·) := by
    rw [← natExpFamily_def, natExpFamily_natExpFamily hη, add_sub_cancel]
  have h_log : log (∫ x, exp ((η' - η) * x) ∂(ρ.natExpFamily η)) = cgf id ρ η' - cgf id ρ η := by
    have h := cgf_id_natExpFamily (t := η' - η) hη (by rwa [add_sub_cancel])
    rw [add_sub_cancel] at h
    exact h
  rw [h_eq]
  filter_upwards [llr_tilted_right (f := ((η' - η) * ·)) AbsolutelyContinuous.rfl h_int,
    llr_self (ρ.natExpFamily η)] with x hx h_self
  rw [hx, h_self, h_log, Pi.zero_apply]
  ring

lemma integrable_llr_natExpFamily (hη : η ∈ interior (integrableExpSet id ρ))
    (hη' : η' ∈ integrableExpSet id ρ) :
    Integrable (llr (ρ.natExpFamily η) (ρ.natExpFamily η')) (ρ.natExpFamily η) := by
  rw [integrable_congr (llr_natExpFamily hη')]
  exact (((integrable_id_natExpFamily hη).const_mul _).add (integrable_const _)).sub
    (integrable_const _)

lemma integral_llr_natExpFamily (hη : η ∈ interior (integrableExpSet id ρ))
    (hη' : η' ∈ integrableExpSet id ρ) :
    ∫ x, llr (ρ.natExpFamily η) (ρ.natExpFamily η') x ∂(ρ.natExpFamily η) =
      cgf id ρ η' - cgf id ρ η - deriv (cgf id ρ) η * (η' - η) := by
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp
  have := isProbabilityMeasure_natExpFamily (interior_subset hη)
  have h_int : Integrable (fun x ↦ (η - η') * x) (ρ.natExpFamily η) :=
    (integrable_id_natExpFamily hη).const_mul _
  rw [integral_congr_ae (llr_natExpFamily hη'), integral_sub ?_ (integrable_const _),
    integral_add h_int (integrable_const _), integral_const_mul, integral_id_natExpFamily hη]
  · simp only [integral_const, probReal_univ, smul_eq_mul, one_mul]
    ring
  · exact h_int.add (integrable_const _)

/-- The Kullback–Leibler divergence between two members of a natural exponential family, as a
real number: `KL(ρ_η, ρ_η') = ψ(η') - ψ(η) - ψ'(η) (η' - η)`. -/
theorem toReal_klDiv_natExpFamily (hη : η ∈ interior (integrableExpSet id ρ))
    (hη' : η' ∈ integrableExpSet id ρ) :
    (klDiv (ρ.natExpFamily η) (ρ.natExpFamily η')).toReal =
      cgf id ρ η' - cgf id ρ η - deriv (cgf id ρ) η * (η' - η) := by
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp
  have := isProbabilityMeasure_natExpFamily (interior_subset hη)
  have := isProbabilityMeasure_natExpFamily hη'
  rw [toReal_klDiv (natExpFamily_absolutelyContinuous_natExpFamily η hη')
    (integrable_llr_natExpFamily hη hη'), integral_llr_natExpFamily hη hη']
  simp

/-- **Kullback–Leibler divergence in a natural exponential family.** The divergence between two
members is the Bregman divergence of the log-partition function `ψ = cgf id ρ`:
`KL(ρ_η, ρ_η') = ψ(η') - ψ(η) - ψ'(η) (η' - η)`. In particular it is finite. -/
theorem klDiv_natExpFamily (hη : η ∈ interior (integrableExpSet id ρ))
    (hη' : η' ∈ integrableExpSet id ρ) :
    klDiv (ρ.natExpFamily η) (ρ.natExpFamily η') =
      ENNReal.ofReal (cgf id ρ η' - cgf id ρ η - deriv (cgf id ρ) η * (η' - η)) := by
  rw [← toReal_klDiv_natExpFamily hη hη', ENNReal.ofReal_toReal]
  refine klDiv_ne_top (natExpFamily_absolutelyContinuous_natExpFamily η hη') ?_
  exact integrable_llr_natExpFamily hη hη'

end MeasureTheory.Measure
