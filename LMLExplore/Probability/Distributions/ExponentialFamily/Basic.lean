/-!
# Exponential families

The exponential family generated by a measure `ρ` on a measurable space `𝓧` and a statistic
`T : 𝓧 → ℝ` is the family of the exponential tilts `ρ_η = ρ.tilted (fun x ↦ η * T x)`: the measure
`ρ_η` has density `x ↦ exp (η T(x) - ψ(η))` with respect to `ρ`, where `ψ = cgf T ρ` is the
log-partition function of the family. The tilt `ρ_η` is a probability measure for every natural
parameter `η` in `integrableExpSet T ρ` (when `ρ ≠ 0`), and the family is closed under tilting:
tilting `ρ_η` by `fun x ↦ t * T x` gives `ρ_(η + t)`. The *natural* exponential families of
measures on `ℝ` are the case `T = id`.

For `η` in the interior of `integrableExpSet T ρ`, the statistic `T` has moments of all orders
under `ρ_η`, its mean is `ψ'(η)` and its variance is `ψ''(η)`. The mean `ψ'(η)` is strictly
increasing in `η` when `T` is not `ρ`-almost everywhere constant
(`ProbabilityTheory.strictMonoOn_deriv_cgf`), so the members of the family with natural parameters
in that interior are determined by the means of `T`. The Kullback–Leibler divergence between two
members is the Bregman divergence of `ψ`: `KL(ρ_η, ρ_η') = ψ(η') - ψ(η) - ψ'(η) (η' - η)`.

Gaussian laws with a fixed variance, Bernoulli and exponential laws are natural exponential
families; Poisson laws on `ℕ` (with `T = Nat.cast`) and Gaussian laws with a fixed mean `m` (with
`T x = (x - m) ^ 2`) are exponential families with another statistic. They are the parametric arm
distributions of the bandit literature, for example of the lower bounds and algorithms of
A. Garivier and E. Kaufmann, *Optimal best arm identification with fixed confidence*, COLT 2016,
where the closed form of the divergence makes the transportation costs explicit.

## Main definitions

* `MeasureTheory.Measure.expFamily ρ T η`: the member `ρ.tilted (fun x ↦ η * T x)` of the
  exponential family of `ρ` and `T` with natural parameter `η`.

## Main statements

* `MeasureTheory.Measure.expFamily_expFamily`: tilting `ρ_η` by `fun x ↦ t * T x` gives
  `ρ_(η + t)`.
* `MeasureTheory.Measure.cgf_expFamily`: the cumulant generating function of `T` under `ρ_η` is
  `t ↦ ψ(η + t) - ψ(η)`.
* `ProbabilityTheory.HasLaw.cgf_expFamily`,
  `ProbabilityTheory.iIndepFun.cgf_sum_of_hasLaw_expFamily`: the cumulant generating function of
  `T (Y)` for a random variable `Y` with law `ρ_η` is `t ↦ ψ(η + t) - ψ(η)`, and that of
  `∑ i ∈ s, T (Y i)` for `#s` independent random variables `Y i` with law `ρ_η` is
  `t ↦ #s (ψ(η + t) - ψ(η))`.
* `MeasureTheory.Measure.integral_expFamily`, `MeasureTheory.Measure.variance_expFamily`: the
  mean and the variance of `T` under `ρ_η` are `ψ'(η)` and `ψ''(η)`.
* `MeasureTheory.Measure.llr_expFamily`: the log-likelihood ratio of `ρ_η` with respect to `ρ_η'`
  is `x ↦ (η - η') T(x) + ψ(η') - ψ(η)`, `ρ_η`-almost everywhere.
* `MeasureTheory.Measure.klDiv_expFamily`: `KL(ρ_η, ρ_η') = ψ(η') - ψ(η) - ψ'(η) (η' - η)`.
-/

public section

open ProbabilityTheory InformationTheory Real Set

open scoped ENNReal NNReal ProbabilityTheory

namespace MeasureTheory.Measure

variable {𝓧 : Type*} {m𝓧 : MeasurableSpace 𝓧} {ρ : Measure 𝓧} {T : 𝓧 → ℝ} {η η' t : ℝ}

/-- The member with natural parameter `η` of the exponential family generated by a measure `ρ`
and a statistic `T`: the exponential tilt `ρ.tilted (fun x ↦ η * T x)`, with density
`x ↦ exp (η T(x) - cgf T ρ η)` with respect to `ρ` (`expFamily_apply`). It is a probability
measure for `η ∈ integrableExpSet T ρ` and `ρ ≠ 0`, and `0` otherwise. -/
noncomputable def expFamily (ρ : Measure 𝓧) (T : 𝓧 → ℝ) (η : ℝ) : Measure 𝓧 :=
  ρ.tilted (fun x ↦ η * T x)

lemma expFamily_def (ρ : Measure 𝓧) (T : 𝓧 → ℝ) (η : ℝ) :
    ρ.expFamily T η = ρ.tilted (fun x ↦ η * T x) := (rfl)

@[simp]
lemma expFamily_zero_measure (T : 𝓧 → ℝ) (η : ℝ) : (0 : Measure 𝓧).expFamily T η = 0 := by
  simp [expFamily_def]

/-- The member of natural parameter `0` of the exponential family of a probability measure is the
measure itself. -/
@[simp]
lemma expFamily_zero (ρ : Measure 𝓧) [IsProbabilityMeasure ρ] (T : 𝓧 → ℝ) :
    ρ.expFamily T 0 = ρ := by
  simp [expFamily_def]

/-- The density of `ρ_η` with respect to `ρ` is `x ↦ exp (η T(x) - cgf T ρ η)`. -/
lemma expFamily_apply [SFinite ρ] (hη : η ∈ integrableExpSet T ρ) (s : Set 𝓧) :
    ρ.expFamily T η s = ∫⁻ x in s, ENNReal.ofReal (exp (η * T x - cgf T ρ η)) ∂ρ :=
  tilted_mul_apply_cgf s hη

instance (ρ : Measure 𝓧) (T : 𝓧 → ℝ) (η : ℝ) : IsZeroOrProbabilityMeasure (ρ.expFamily T η) := by
  rw [expFamily_def]
  infer_instance

lemma isProbabilityMeasure_expFamily [NeZero ρ] (hη : η ∈ integrableExpSet T ρ) :
    IsProbabilityMeasure (ρ.expFamily T η) :=
  isProbabilityMeasure_tilted hη

lemma expFamily_absolutelyContinuous (ρ : Measure 𝓧) (T : 𝓧 → ℝ) (η : ℝ) :
    ρ.expFamily T η ≪ ρ :=
  tilted_absolutelyContinuous _ _

lemma absolutelyContinuous_expFamily (hη : η ∈ integrableExpSet T ρ) : ρ ≪ ρ.expFamily T η :=
  absolutelyContinuous_tilted hη

/-- Members of an exponential family with a natural parameter in `integrableExpSet T ρ` have the
null sets of `ρ`, hence are mutually absolutely continuous. -/
lemma expFamily_absolutelyContinuous_expFamily (η : ℝ) (hη' : η' ∈ integrableExpSet T ρ) :
    ρ.expFamily T η ≪ ρ.expFamily T η' :=
  (expFamily_absolutelyContinuous ρ T η).trans (absolutelyContinuous_expFamily hη')

/-- An exponential family is closed under tilting: the member of natural parameter `t` of the
family generated by `ρ_η` and `T` is `ρ_(η + t)`. -/
lemma expFamily_expFamily (hη : η ∈ integrableExpSet T ρ) (t : ℝ) :
    (ρ.expFamily T η).expFamily T t = ρ.expFamily T (η + t) := by
  simp_rw [expFamily_def, tilted_tilted (f := fun x ↦ η * T x) hη]
  congr with x
  rw [Pi.add_apply, add_mul]

/-- The moment generating function of `T` under `ρ_η` is `t ↦ mgf T ρ (η + t) / mgf T ρ η`. -/
lemma mgf_expFamily : mgf T (ρ.expFamily T η) t = mgf T ρ (η + t) / mgf T ρ η :=
  mgf_tilted_mul

/-- The cumulant generating function of `T` under `ρ_η` is `t ↦ ψ(η + t) - ψ(η)`. -/
lemma cgf_expFamily (hη : η ∈ integrableExpSet T ρ) (hηt : η + t ∈ integrableExpSet T ρ) :
    cgf T (ρ.expFamily T η) t = cgf T ρ (η + t) - cgf T ρ η :=
  cgf_tilted_mul hη hηt

lemma integrableExpSet_expFamily (hη : η ∈ integrableExpSet T ρ) :
    integrableExpSet T (ρ.expFamily T η) = (η + ·) ⁻¹' integrableExpSet T ρ :=
  integrableExpSet_tilted_mul hη

lemma memLp_expFamily (hη : η ∈ interior (integrableExpSet T ρ)) (p : ℝ≥0) :
    MemLp T p (ρ.expFamily T η) :=
  memLp_tilted_mul hη p

lemma integrable_expFamily (hη : η ∈ interior (integrableExpSet T ρ)) :
    Integrable T (ρ.expFamily T η) :=
  (memLp_expFamily hη 1).integrable le_rfl

/-- The mean of `T` under `ρ_η` is `ψ'(η)`. -/
lemma integral_expFamily (hη : η ∈ interior (integrableExpSet T ρ)) :
    ∫ x, T x ∂(ρ.expFamily T η) = deriv (cgf T ρ) η :=
  integral_tilted_mul_self hη

/-- The variance of `T` under `ρ_η` is `ψ''(η)`. -/
lemma variance_expFamily (hη : η ∈ interior (integrableExpSet T ρ)) :
    Var[T; ρ.expFamily T η] = iteratedDeriv 2 (cgf T ρ) η :=
  variance_tilted_mul hη

/-- The log-likelihood ratio of `ρ_η` with respect to `ρ_η'` is
`x ↦ (η - η') T(x) + ψ(η') - ψ(η)`, `ρ_η`-almost everywhere. -/
lemma llr_expFamily (hη' : η' ∈ integrableExpSet T ρ) :
    llr (ρ.expFamily T η) (ρ.expFamily T η') =ᵐ[ρ.expFamily T η]
      fun x ↦ (η - η') * T x + cgf T ρ η' - cgf T ρ η := by
  obtain hη | hη := em' (η ∈ integrableExpSet T ρ)
  · have h_zero : ρ.expFamily T η = 0 := tilted_of_not_integrable hη
    simp [h_zero, Filter.EventuallyEq]
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp [Filter.EventuallyEq]
  have := isProbabilityMeasure_expFamily hη
  -- `ρ_η'` is the tilt of `ρ_η` by `fun x ↦ (η' - η) * T x`.
  have h_int : η' - η ∈ integrableExpSet T (ρ.expFamily T η) := by
    rwa [integrableExpSet_expFamily hη, mem_preimage, add_sub_cancel]
  have h_eq : ρ.expFamily T η' = (ρ.expFamily T η).tilted (fun x ↦ (η' - η) * T x) := by
    rw [← expFamily_def, expFamily_expFamily hη, add_sub_cancel]
  have h_log : log (∫ x, exp ((η' - η) * T x) ∂(ρ.expFamily T η)) = cgf T ρ η' - cgf T ρ η := by
    have h := cgf_expFamily (t := η' - η) hη (by rwa [add_sub_cancel])
    rw [add_sub_cancel] at h
    exact h
  rw [h_eq]
  filter_upwards [llr_tilted_right (f := fun x ↦ (η' - η) * T x) AbsolutelyContinuous.rfl h_int,
    llr_self (ρ.expFamily T η)] with x hx h_self
  rw [hx, h_self, h_log, Pi.zero_apply]
  ring

lemma integrable_llr_expFamily (hη : η ∈ interior (integrableExpSet T ρ))
    (hη' : η' ∈ integrableExpSet T ρ) :
    Integrable (llr (ρ.expFamily T η) (ρ.expFamily T η')) (ρ.expFamily T η) := by
  rw [integrable_congr (llr_expFamily hη')]
  exact (((integrable_expFamily hη).const_mul _).add (integrable_const _)).sub
    (integrable_const _)

lemma integral_llr_expFamily (hη : η ∈ interior (integrableExpSet T ρ))
    (hη' : η' ∈ integrableExpSet T ρ) :
    ∫ x, llr (ρ.expFamily T η) (ρ.expFamily T η') x ∂(ρ.expFamily T η) =
      cgf T ρ η' - cgf T ρ η - deriv (cgf T ρ) η * (η' - η) := by
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp
  have := isProbabilityMeasure_expFamily (interior_subset hη)
  have h_int : Integrable (fun x ↦ (η - η') * T x) (ρ.expFamily T η) :=
    (integrable_expFamily hη).const_mul _
  rw [integral_congr_ae (llr_expFamily hη'), integral_sub ?_ (integrable_const _),
    integral_add h_int (integrable_const _), integral_const_mul, integral_expFamily hη]
  · simp only [integral_const, probReal_univ, smul_eq_mul, one_mul]
    ring
  · exact h_int.add (integrable_const _)

/-- The Kullback–Leibler divergence between two members of an exponential family, as a real
number: `KL(ρ_η, ρ_η') = ψ(η') - ψ(η) - ψ'(η) (η' - η)`. -/
theorem toReal_klDiv_expFamily (hη : η ∈ interior (integrableExpSet T ρ))
    (hη' : η' ∈ integrableExpSet T ρ) :
    (klDiv (ρ.expFamily T η) (ρ.expFamily T η')).toReal =
      cgf T ρ η' - cgf T ρ η - deriv (cgf T ρ) η * (η' - η) := by
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp
  have := isProbabilityMeasure_expFamily (interior_subset hη)
  have := isProbabilityMeasure_expFamily hη'
  rw [toReal_klDiv (expFamily_absolutelyContinuous_expFamily η hη')
    (integrable_llr_expFamily hη hη'), integral_llr_expFamily hη hη']
  simp

/-- **Kullback–Leibler divergence in an exponential family.** The divergence between two members
is the Bregman divergence of the log-partition function `ψ = cgf T ρ`:
`KL(ρ_η, ρ_η') = ψ(η') - ψ(η) - ψ'(η) (η' - η)`. In particular it is finite. -/
theorem klDiv_expFamily (hη : η ∈ interior (integrableExpSet T ρ))
    (hη' : η' ∈ integrableExpSet T ρ) :
    klDiv (ρ.expFamily T η) (ρ.expFamily T η') =
      ENNReal.ofReal (cgf T ρ η' - cgf T ρ η - deriv (cgf T ρ) η * (η' - η)) := by
  rw [← toReal_klDiv_expFamily hη hη', ENNReal.ofReal_toReal]
  exact klDiv_ne_top (expFamily_absolutelyContinuous_expFamily η hη')
    (integrable_llr_expFamily hη hη')

end MeasureTheory.Measure

namespace ProbabilityTheory

open MeasureTheory
open scoped Finset

variable {Ω ι 𝓧 : Type*} {mΩ : MeasurableSpace Ω} {m𝓧 : MeasurableSpace 𝓧} {P : Measure Ω}
  {ρ : Measure 𝓧} {T : 𝓧 → ℝ} {Y : Ω → 𝓧} {X : ι → Ω → 𝓧} {s : Finset ι} {η t : ℝ}

/-! ### Exponential moments of the statistic under the members of an exponential family -/

/-- The statistic `T` is almost everywhere measurable for every member of the exponential family
of `ρ` and `T` if it is for `ρ`. -/
private lemma aemeasurable_expFamily (hT : AEMeasurable T ρ) (η : ℝ) :
    AEMeasurable T (ρ.expFamily T η) :=
  hT.mono_ac (Measure.expFamily_absolutelyContinuous ρ T η)

/-- For a random variable `Y` with law `ρ_η`, the statistic `T` is almost everywhere measurable
for the law of `Y` if it is for `ρ`. -/
private lemma HasLaw.aemeasurable_map_expFamily (hT : AEMeasurable T ρ)
    (hY : HasLaw Y (ρ.expFamily T η) P) : AEMeasurable T (P.map Y) := by
  rw [hY.map_eq]
  exact aemeasurable_expFamily hT η

/-- For a random variable `Y` with law `ρ_η`, the variable `T (Y)` is almost everywhere
measurable if `T` is for `ρ`. -/
private lemma HasLaw.aemeasurable_comp_expFamily (hT : AEMeasurable T ρ)
    (hY : HasLaw Y (ρ.expFamily T η) P) : AEMeasurable (fun ω ↦ T (Y ω)) P :=
  (hY.aemeasurable_map_expFamily hT).comp_aemeasurable hY.aemeasurable

/-- For a random variable `Y` with law `ρ_η`, the function `x ↦ exp (t T(x))` is almost
everywhere strongly measurable for the law of `Y` if `T` is for `ρ`. -/
private lemma HasLaw.aestronglyMeasurable_exp_mul_expFamily (hT : AEMeasurable T ρ)
    (hY : HasLaw Y (ρ.expFamily T η) P) (t : ℝ) :
    AEStronglyMeasurable (fun x ↦ exp (t * T x)) (P.map Y) :=
  ((hY.aemeasurable_map_expFamily hT).const_mul t).exp.aestronglyMeasurable

/-- For a random variable `Y` with law `ρ_η`, the variable `T (Y)` has an exponential moment of
order `t` iff `η + t` is a natural parameter of `ρ` and `T`. -/
lemma HasLaw.integrable_exp_mul_iff_expFamily (hT : AEMeasurable T ρ)
    (hY : HasLaw Y (ρ.expFamily T η) P) (hη : η ∈ integrableExpSet T ρ) :
    Integrable (fun ω ↦ exp (t * T (Y ω))) P ↔ η + t ∈ integrableExpSet T ρ := by
  rw [← Set.mem_preimage (f := (η + ·)), ← Measure.integrableExpSet_expFamily hη, ← hY.map_eq]
  simp only [integrableExpSet, Set.mem_ofPred_eq]
  rw [integrable_map_measure (hY.aestronglyMeasurable_exp_mul_expFamily hT t) hY.aemeasurable,
    Function.comp_def]

/-- The cumulant generating function of `T (Y)` for a random variable `Y` with law `ρ_η` is
`t ↦ ψ(η + t) - ψ(η)`, where `ψ = cgf T ρ`. -/
lemma HasLaw.cgf_expFamily (hT : AEMeasurable T ρ) (hY : HasLaw Y (ρ.expFamily T η) P)
    (hη : η ∈ integrableExpSet T ρ) (hηt : η + t ∈ integrableExpSet T ρ) :
    cgf (fun ω ↦ T (Y ω)) P t = cgf T ρ (η + t) - cgf T ρ η := by
  rw [cgf, ← Function.comp_def,
    ← mgf_map hY.aemeasurable (hY.aestronglyMeasurable_exp_mul_expFamily hT t), hY.map_eq, ← cgf,
    Measure.cgf_expFamily hη hηt]

/-- The cumulant generating function of `∑ i ∈ s, T (X i)` for independent random variables `X i`
with law `ρ_η` is `t ↦ #s (ψ(η + t) - ψ(η))`, where `ψ = cgf T ρ`. -/
lemma iIndepFun.cgf_sum_of_hasLaw_expFamily (h_indep : iIndepFun X P) (hT : AEMeasurable T ρ)
    (hX : ∀ i ∈ s, HasLaw (X i) (ρ.expFamily T η) P) (hη : η ∈ integrableExpSet T ρ)
    (hηt : η + t ∈ integrableExpSet T ρ) :
    cgf (fun ω ↦ ∑ i ∈ s, T (X i ω)) P t = #s * (cgf T ρ (η + t) - cgf T ρ η) := by
  -- Restrict the family to `s`, so that the hypotheses hold for every index.
  rw [← Finset.sum_fn, ← Finset.sum_coe_sort s,
    (h_indep.comp_subtype_of_hasLaw (aemeasurable_expFamily hT η) hX).cgf_sum₀
    (fun i ↦ (hX i i.2).aemeasurable_comp_expFamily hT)
    fun i _ ↦ ((hX i i.2).integrable_exp_mul_iff_expFamily hT hη).2 hηt]
  simp [fun i : s ↦ (hX i i.2).cgf_expFamily hT hη hηt, mul_sub]

/-- For independent random variables `X i` with law `ρ_η`, the sum `∑ i ∈ s, T (X i)` has an
exponential moment of order `t` if `η + t` is a natural parameter of `ρ` and `T`. -/
lemma iIndepFun.integrable_exp_mul_sum_of_hasLaw_expFamily (h_indep : iIndepFun X P)
    (hT : AEMeasurable T ρ) (hX : ∀ i ∈ s, HasLaw (X i) (ρ.expFamily T η) P)
    (hη : η ∈ integrableExpSet T ρ) (hηt : η + t ∈ integrableExpSet T ρ) :
    Integrable (fun ω ↦ exp (t * ∑ i ∈ s, T (X i ω))) P := by
  have := h_indep.isProbabilityMeasure
  refine (mgf_pos_iff (X := fun ω ↦ ∑ i ∈ s, T (X i ω))).1 ?_
  rw [← Finset.sum_fn, ← Finset.sum_coe_sort s,
    (h_indep.comp_subtype_of_hasLaw (aemeasurable_expFamily hT η) hX).mgf_sum₀
    fun i ↦ (hX i i.2).aemeasurable_comp_expFamily hT]
  exact Finset.prod_pos fun i _ ↦
    mgf_pos (((hX i i.2).integrable_exp_mul_iff_expFamily hT hη).2 hηt)

end ProbabilityTheory
