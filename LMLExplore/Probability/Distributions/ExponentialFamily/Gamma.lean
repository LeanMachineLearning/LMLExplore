module

public import LMLExplore.Probability.Distributions.ExponentialFamily.Mean
public import TauCeti.Probability.Distributions.Gamma.Basic
import LMLExplore.Analysis.SpecialFunctions.Log.Basic
import TauCeti.Probability.Distributions.Tilted

/-!
# The gamma laws of known shape as an exponential family

For a shape `a > 0`, the gamma laws `gammaMeasure a r` of positive rate `r` form the natural
exponential family (`T = id`) generated by any of them. Tilting `gammaMeasure a r` by `x ↦ η x` for
`η < r` lowers its rate by `η` (`TauCeti.Probability.gammaMeasure_tilted_mul`): the member of
natural parameter `η` of the exponential family of `gammaMeasure a r` is `gammaMeasure a (r - η)`.
The natural parameters are the `η < r`, the log-partition function is the cumulant generating
function `ψ(η) = -a log (1 - η / r)`, and the mean map is `ψ'(η) = a / (r - η)`. It takes every
positive value: the means of the family are the interval `(0, ∞)`, the natural parameter of the
mean `μ` is `r - a / μ`, the member of mean `μ` is `gammaMeasure a (a / μ)`, and the divergence of
the family in the mean parametrization is `d(μ, μ') = a (μ / μ' - 1 - log (μ / μ'))`. In terms of
the rates, the Kullback–Leibler divergence between `gammaMeasure a r` and `gammaMeasure a r'` is
`a (r' / r - 1 - log (r' / r))`. For `r = 1`, the member `gammaMeasure a r'` of the family of
`gammaMeasure a 1` has natural parameter `1 - r'`.

The exponential laws `expMeasure r = gammaMeasure 1 r` are the shape `a = 1`
(`Probability/Distributions/ExponentialFamily/Exponential.lean`).

Gamma and exponential arms are among the parametric arm models of bandit identification, for
example in A. Garivier and E. Kaufmann, *Optimal best arm identification with fixed confidence*,
COLT 2016, where the closed form of the divergence makes the transportation costs explicit.

## Main statements

* `LMLExplore.expFamily_gammaMeasure`: for `η < r`, the member of natural parameter `η` of the
  exponential family of `gammaMeasure a r` is `gammaMeasure a (r - η)`.
* `LMLExplore.deriv_cgf_gammaMeasure`: the mean map of the family is `η ↦ a / (r - η)` on `η < r`.
* `LMLExplore.not_ae_eq_const_gammaMeasure`: the identity is not almost everywhere constant under
  `gammaMeasure a r`, the nondegeneracy assumption of the mean parametrization.
* `LMLExplore.expFamilyMeans_gammaMeasure`: the means of the family are `(0, ∞)`.
* `LMLExplore.natParam_gammaMeasure`: the natural parameter of the mean `μ > 0` is `r - a / μ`.
* `LMLExplore.expFamily_natParam_gammaMeasure`: the member of mean `μ > 0` is
  `gammaMeasure a (a / μ)`.
* `LMLExplore.expFamilyDiv_gammaMeasure`: the divergence of the family is
  `d(μ, μ') = a (μ / μ' - 1 - log (μ / μ'))` for `μ, μ' > 0`.
* `LMLExplore.klDiv_gammaMeasure`: the Kullback–Leibler divergence between `gammaMeasure a r` and
  `gammaMeasure a r'` for `r, r' > 0` is `a (r' / r - 1 - log (r' / r))`.
* `LMLExplore.tendsto_expFamilyDiv_gammaMeasure_nhdsGT_zero`,
  `LMLExplore.tendsto_expFamilyDiv_gammaMeasure_atTop`: `d(μ, μ') → ∞` as `μ'` tends to either
  endpoint `0` or `∞` of the means.
-/

public section

open MeasureTheory ProbabilityTheory InformationTheory Real Set Filter Topology

namespace LMLExplore

variable {a r η μ μ' : ℝ}

/-- For `η < r`, the member of natural parameter `η` of the exponential family of
`gammaMeasure a r` with statistic `id` is `gammaMeasure a (r - η)`. -/
@[simp]
theorem expFamily_gammaMeasure (ha : 0 < a) (hr : 0 < r) (hη : η < r) :
    (gammaMeasure a r).expFamily id η = gammaMeasure a (r - η) := by
  rw [Measure.expFamily_def]
  exact TauCeti.Probability.gammaMeasure_tilted_mul ha hr hη

/-- The natural parameters of the exponential family of `gammaMeasure a r` are the `η < r`. -/
lemma interior_integrableExpSet_id_gammaMeasure (ha : 0 < a) (hr : 0 < r) :
    interior (integrableExpSet id (gammaMeasure a r)) = Iio r := by
  rw [TauCeti.Probability.integrableExpSet_id_gammaMeasure ha hr, interior_Iio]

/-- The mean map of the exponential family of `gammaMeasure a r` is `η ↦ a / (r - η)` on
`η < r`. -/
@[simp]
theorem deriv_cgf_gammaMeasure (ha : 0 < a) (hr : 0 < r) (hη : η < r) :
    deriv (cgf id (gammaMeasure a r)) η = a / (r - η) := by
  rw [← Measure.integral_expFamily (by rwa [interior_integrableExpSet_id_gammaMeasure ha hr]),
    expFamily_gammaMeasure ha hr hη]
  exact TauCeti.Probability.integral_id_gammaMeasure ha (sub_pos.2 hη)

/-- The identity is not almost everywhere constant under `gammaMeasure a r`: the gamma law has a
density, hence no atoms. This is the nondegeneracy assumption of the mean parametrization of the
exponential family of `gammaMeasure a r`. -/
lemma not_ae_eq_const_gammaMeasure (ha : 0 < a) (hr : 0 < r) (c : ℝ) :
    ¬ id =ᵐ[gammaMeasure a r] fun _ ↦ c := by
  have := isProbabilityMeasure_gammaMeasure ha hr
  have h_ne : ∀ᵐ x ∂gammaMeasure a r, x ≠ c := by
    rw [gammaMeasure]
    exact (withDensity_absolutelyContinuous _ _).ae_le (Measure.ae_ne volume c)
  intro h
  obtain ⟨x, hx, hxc⟩ := (h.and h_ne).exists
  exact hxc hx

/-- The mean map of the exponential family of `gammaMeasure a r` sends `r - a / μ` to `μ`, for
`μ > 0`. -/
private lemma deriv_cgf_gammaMeasure_sub_div (ha : 0 < a) (hr : 0 < r) (hμ : 0 < μ) :
    deriv (cgf id (gammaMeasure a r)) (r - a / μ) = μ := by
  rw [deriv_cgf_gammaMeasure ha hr (sub_lt_self r (div_pos ha hμ)), sub_sub_cancel,
    div_div_cancel₀ ha.ne']

/-- The means of the exponential family of `gammaMeasure a r` for `a, r > 0` are the interval
`(0, ∞)`. -/
@[simp]
theorem expFamilyMeans_gammaMeasure (ha : 0 < a) (hr : 0 < r) :
    (gammaMeasure a r).expFamilyMeans id = Ioi 0 := by
  ext μ
  rw [Measure.mem_expFamilyMeans_iff, interior_integrableExpSet_id_gammaMeasure ha hr, mem_Ioi]
  refine ⟨fun ⟨η, hη, h⟩ ↦ ?_, fun hμ ↦ ⟨r - a / μ, sub_lt_self r (div_pos ha hμ),
    deriv_cgf_gammaMeasure_sub_div ha hr hμ⟩⟩
  rw [← h, deriv_cgf_gammaMeasure ha hr hη]
  exact div_pos ha (sub_pos.2 hη)

/-- The natural parameter of the member of mean `μ > 0` of the exponential family of
`gammaMeasure a r` is `r - a / μ`. -/
@[simp]
theorem natParam_gammaMeasure (ha : 0 < a) (hr : 0 < r) (hμ : 0 < μ) :
    (gammaMeasure a r).natParam id μ = r - a / μ := by
  have h_deriv := deriv_cgf_gammaMeasure_sub_div ha hr hμ
  rw [← h_deriv, Measure.natParam_deriv_cgf (not_ae_eq_const_gammaMeasure ha hr)
    (by rw [interior_integrableExpSet_id_gammaMeasure ha hr]
        exact sub_lt_self r (div_pos ha hμ)), h_deriv]

/-- The member of mean `μ > 0` of the exponential family of `gammaMeasure a r` is
`gammaMeasure a (a / μ)`. -/
theorem expFamily_natParam_gammaMeasure (ha : 0 < a) (hr : 0 < r) (hμ : 0 < μ) :
    (gammaMeasure a r).expFamily id ((gammaMeasure a r).natParam id μ) =
      gammaMeasure a (a / μ) := by
  rw [natParam_gammaMeasure ha hr hμ,
    expFamily_gammaMeasure ha hr (sub_lt_self r (div_pos ha hμ)), sub_sub_cancel]

/-- The value of the log-partition function of the exponential family of `gammaMeasure a r` at the
natural parameter `r - a / μ` of the mean `μ > 0` is `a log (μ r / a)`. -/
private lemma cgf_gammaMeasure_sub_div (ha : 0 < a) (hr : 0 < r) (hμ : 0 < μ) :
    cgf id (gammaMeasure a r) (r - a / μ) = a * log (μ * r / a) := by
  rw [TauCeti.Probability.cgf_id_gammaMeasure ha hr (sub_lt_self r (div_pos ha hμ)),
    show 1 - (r - a / μ) / r = (μ * r / a)⁻¹ by field_simp; ring, log_inv]
  ring

/-- The divergence of the exponential family of `gammaMeasure a r` in the mean parametrization is
`d(μ, μ') = a (μ / μ' - 1 - log (μ / μ'))` for `μ, μ' > 0`. -/
@[simp]
theorem expFamilyDiv_gammaMeasure (ha : 0 < a) (hr : 0 < r) (hμ : 0 < μ) (hμ' : 0 < μ') :
    (gammaMeasure a r).expFamilyDiv id μ μ' = a * (μ / μ' - 1 - log (μ / μ')) := by
  rw [Measure.expFamilyDiv_def, natParam_gammaMeasure ha hr hμ, natParam_gammaMeasure ha hr hμ',
    cgf_gammaMeasure_sub_div ha hr hμ', cgf_gammaMeasure_sub_div ha hr hμ]
  simp only [log_div, log_mul, hμ.ne', hμ'.ne', hr.ne', ha.ne', mul_ne_zero, ne_eq,
    not_false_eq_true]
  field_simp
  ring

/-- The Kullback–Leibler divergence between the gamma laws of shape `a > 0` and positive rates `r`
and `r'` is `a (r' / r - 1 - log (r' / r))`. -/
theorem klDiv_gammaMeasure {r' : ℝ} (ha : 0 < a) (hr : 0 < r) (hr' : 0 < r') :
    klDiv (gammaMeasure a r) (gammaMeasure a r') =
      ENNReal.ofReal (a * (r' / r - 1 - log (r' / r))) := by
  have hmem (s : ℝ) (hs : 0 < s) : a / s ∈ (gammaMeasure a r).expFamilyMeans id := by
    rw [expFamilyMeans_gammaMeasure ha hr]
    exact div_pos ha hs
  have h := Measure.klDiv_expFamily_natParam (hmem r hr) (hmem r' hr')
  rwa [expFamily_natParam_gammaMeasure ha hr (div_pos ha hr),
    expFamily_natParam_gammaMeasure ha hr (div_pos ha hr'), div_div_cancel₀ ha.ne',
    div_div_cancel₀ ha.ne', expFamilyDiv_gammaMeasure ha hr (div_pos ha hr) (div_pos ha hr'),
    div_div_div_cancel_left' _ _ ha.ne'] at h

/-- For a mean `μ > 0`, the divergence `d(μ, μ')` of the exponential family of `gammaMeasure a r`
tends to infinity as `μ'` tends to the endpoint `0` of the means. -/
theorem tendsto_expFamilyDiv_gammaMeasure_nhdsGT_zero (ha : 0 < a) (hr : 0 < r) (hμ : 0 < μ) :
    Tendsto ((gammaMeasure a r).expFamilyDiv id μ) (𝓝[>] 0) atTop := by
  have h : Tendsto (fun μ' ↦ μ / μ') (𝓝[>] 0) atTop := by
    simpa only [div_eq_mul_inv] using tendsto_inv_nhdsGT_zero.const_mul_atTop hμ
  refine ((tendsto_sub_one_sub_log_atTop.comp h).const_mul_atTop ha).congr' ?_
  filter_upwards [self_mem_nhdsWithin] with μ' (hμ' : 0 < μ')
  exact (expFamilyDiv_gammaMeasure ha hr hμ hμ').symm

/-- For a mean `μ > 0`, the divergence `d(μ, μ')` of the exponential family of `gammaMeasure a r`
tends to infinity as `μ'` tends to the endpoint `∞` of the means. -/
theorem tendsto_expFamilyDiv_gammaMeasure_atTop (ha : 0 < a) (hr : 0 < r) (hμ : 0 < μ) :
    Tendsto ((gammaMeasure a r).expFamilyDiv id μ) atTop atTop := by
  have h : Tendsto (fun μ' ↦ μ / μ') atTop (𝓝[>] 0) :=
    tendsto_nhdsWithin_iff.2 ⟨tendsto_const_nhds.div_atTop tendsto_id,
      (eventually_gt_atTop 0).mono fun μ' hμ' ↦ div_pos hμ hμ'⟩
  refine ((tendsto_sub_one_sub_log_nhdsGT_zero.comp h).const_mul_atTop ha).congr' ?_
  filter_upwards [eventually_gt_atTop 0] with μ' hμ'
  exact (expFamilyDiv_gammaMeasure ha hr hμ hμ').symm

end LMLExplore
