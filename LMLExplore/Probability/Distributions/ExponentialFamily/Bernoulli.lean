module

public import LMLExplore.Analysis.SpecialFunctions.Sigmoid
public import LMLExplore.InformationTheory.KullbackLeibler.Bernoulli
public import LMLExplore.Probability.Distributions.ExponentialFamily.Mean
public import TauCeti.Probability.Distributions.Bernoulli.Basic

/-!
# The Bernoulli laws as an exponential family

The real Bernoulli laws `Ber((1 : ℝ), 0, m)` with `m ∈ (0, 1)` form the natural exponential family
(`T = id`) generated by any of them. With the base `ρ = Ber((1 : ℝ), 0, sigmoid η₀)`, for example
`Ber((1 : ℝ), 0, 1/2)` with `η₀ = 0`, the member of natural parameter `η` is
`Ber((1 : ℝ), 0, sigmoid (η₀ + η))`: tilting a Bernoulli law multiplies the odds `m / (1 - m)` by
`exp η`. The mean map `ψ'(η) = sigmoid (η₀ + η)` takes every value in `(0, 1)`, so the means of the
family are the interval `(0, 1)`, the member of mean `m` is `Ber((1 : ℝ), 0, m)`, and the divergence
of the family in the mean parametrization is the binary relative entropy `klBerReal`.

This identifies the Chernoff bounds for exponential families with the Chernoff bounds for
Bernoulli laws in relative-entropy form.

## Main statements

* `LMLExplore.expFamily_bernoulliMeasure_sigmoid`: the member of natural parameter `η` of the
  exponential family of `Ber((1 : ℝ), 0, sigmoid η₀)` is `Ber((1 : ℝ), 0, sigmoid (η₀ + η))`.
* `LMLExplore.expFamilyMeans_bernoulliMeasure_sigmoid`: the means of the family are `(0, 1)`.
* `LMLExplore.expFamily_natParam_bernoulliMeasure_sigmoid`: the member of mean `m ∈ (0, 1)` is
  `Ber((1 : ℝ), 0, m)`.
* `LMLExplore.expFamilyDiv_bernoulliMeasure_sigmoid`: the divergence of the family is
  `klBerReal p m` for `p, m ∈ (0, 1)`.
-/

public section

open MeasureTheory ProbabilityTheory Real Set

open scoped ENNReal unitInterval

namespace LMLExplore

variable {η₀ m p : ℝ}

/-- Tilting a Bernoulli law multiplies its odds by `exp η`: the member of natural parameter `η` of
the exponential family of `Ber((1 : ℝ), 0, sigmoid η₀)` with statistic `id` is
`Ber((1 : ℝ), 0, sigmoid (η₀ + η))`. -/
@[simp]
theorem expFamily_bernoulliMeasure_sigmoid (η₀ η : ℝ) :
    Ber((1 : ℝ), 0, unitInterval.sigmoid η₀).expFamily id η =
      Ber((1 : ℝ), 0, unitInterval.sigmoid (η₀ + η)) := by
  -- the normalizing constant is the moment generating function `1 - s + s exp η`, `s = σ(η₀)`
  set Z := 1 - Real.sigmoid η₀ + Real.sigmoid η₀ * exp η with hZ_def
  have hZ_pos : 0 < Z := by
    have := Real.sigmoid_lt_one η₀
    have := Real.sigmoid_pos η₀
    positivity
  have h_one : Real.sigmoid η₀ * exp η / Z = Real.sigmoid (η₀ + η) := by
    rw [div_eq_iff hZ_pos.ne', hZ_def]
    simp only [Real.sigmoid_def, exp_neg, exp_add]
    field_simp
    ring
  have h_zero : (1 - Real.sigmoid η₀) / Z = 1 - Real.sigmoid (η₀ + η) := by
    rw [← h_one]
    field_simp
    ring
  -- `mgf id ρ η` is by definition the normalizing integral of the tilt
  have hZ : ∫ x, exp (η * id x) ∂Ber((1 : ℝ), 0, unitInterval.sigmoid η₀) = Z :=
    TauCeti.Probability.mgf_id_bernoulliMeasure _ η
  -- both measures are combinations of the Dirac masses at `1` and `0`
  rw [Measure.expFamily_def, Measure.tilted, hZ, bernoulliMeasure_def, bernoulliMeasure_def,
    withDensity_add_measure, ENNReal.smul_def, ENNReal.smul_def, ENNReal.smul_def,
    ENNReal.smul_def, withDensity_smul_measure, withDensity_smul_measure, dirac_withDensity,
    dirac_withDensity, smul_smul, smul_smul]
  congr 2
  · simp only [id_eq, mul_one, ENNReal.coe_nnreal_eq, unitInterval.coe_toNNReal]
    rw [← ENNReal.ofReal_mul (unitInterval.nonneg _), mul_div_assoc', unitInterval.coe_sigmoid,
      h_one, unitInterval.coe_sigmoid]
  · simp only [id_eq, mul_zero, exp_zero, ENNReal.coe_nnreal_eq, unitInterval.coe_toNNReal,
      unitInterval.coe_symm_eq]
    rw [← ENNReal.ofReal_mul (unitInterval.one_sub_nonneg _), mul_one_div,
      unitInterval.coe_sigmoid, h_zero, unitInterval.coe_sigmoid]

/-- The mean map of the exponential family of `Ber((1 : ℝ), 0, sigmoid η₀)` is
`η ↦ sigmoid (η₀ + η)`. -/
@[simp]
theorem deriv_cgf_bernoulliMeasure_sigmoid (η₀ η : ℝ) :
    deriv (cgf id Ber((1 : ℝ), 0, unitInterval.sigmoid η₀)) η = Real.sigmoid (η₀ + η) := by
  rw [← Measure.integral_expFamily (by simp), expFamily_bernoulliMeasure_sigmoid,
    integral_bernoulliMeasure]
  simp

/-- The means of the exponential family of `Ber((1 : ℝ), 0, sigmoid η₀)` are the interval
`(0, 1)`. -/
@[simp]
theorem expFamilyMeans_bernoulliMeasure_sigmoid (η₀ : ℝ) :
    Ber((1 : ℝ), 0, unitInterval.sigmoid η₀).expFamilyMeans id = Ioo 0 1 := by
  have h : deriv (cgf id Ber((1 : ℝ), 0, unitInterval.sigmoid η₀)) = Real.sigmoid ∘ (η₀ + ·) :=
    funext (deriv_cgf_bernoulliMeasure_sigmoid η₀)
  rw [Measure.expFamilyMeans_def, integrableExpSet_bernoulliMeasure, interior_univ, image_univ, h,
    (add_left_surjective η₀).range_comp, Real.range_sigmoid]

/-- The member of mean `m ∈ (0, 1)` of the exponential family of `Ber((1 : ℝ), 0, sigmoid η₀)` is
`Ber((1 : ℝ), 0, m)`. -/
theorem expFamily_natParam_bernoulliMeasure_sigmoid (η₀ : ℝ) (hm : m ∈ Ioo 0 1) :
    Ber((1 : ℝ), 0, unitInterval.sigmoid η₀).expFamily id
        (Ber((1 : ℝ), 0, unitInterval.sigmoid η₀).natParam id m) =
      Ber((1 : ℝ), 0, ⟨m, Ioo_subset_Icc_self hm⟩) := by
  have hm' : m ∈ Ber((1 : ℝ), 0, unitInterval.sigmoid η₀).expFamilyMeans id := by
    rwa [expFamilyMeans_bernoulliMeasure_sigmoid]
  rw [expFamily_bernoulliMeasure_sigmoid]
  congr 1
  ext
  rw [unitInterval.coe_sigmoid, ← deriv_cgf_bernoulliMeasure_sigmoid,
    Measure.deriv_cgf_natParam hm']

/-- The divergence of the exponential family of `Ber((1 : ℝ), 0, sigmoid η₀)` in the mean
parametrization is the binary relative entropy: `d(p, m) = klBerReal p m` for `p, m ∈ (0, 1)`. -/
theorem expFamilyDiv_bernoulliMeasure_sigmoid (η₀ : ℝ) (hp : p ∈ Ioo 0 1) (hm : m ∈ Ioo 0 1) :
    Ber((1 : ℝ), 0, unitInterval.sigmoid η₀).expFamilyDiv id p m = klBerReal p m := by
  rw [← Measure.toReal_klDiv_expFamily_natParam (by rwa [expFamilyMeans_bernoulliMeasure_sigmoid])
      (by rwa [expFamilyMeans_bernoulliMeasure_sigmoid]),
    expFamily_natParam_bernoulliMeasure_sigmoid η₀ hp,
    expFamily_natParam_bernoulliMeasure_sigmoid η₀ hm, klDiv_bernoulliMeasure]
  exact toReal_klBer (Ioo_subset_Icc_self hp) (Ioo_subset_Icc_self hm) (klBer_ne_top hm)

end LMLExplore
