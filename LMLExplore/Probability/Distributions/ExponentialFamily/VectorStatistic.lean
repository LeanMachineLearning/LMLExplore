/-!
# Exponential families with a vector statistic

The exponential family generated by a measure `ρ` on a measurable space `𝓧` and a statistic
`T : 𝓧 → E` with values in a real inner product space `E` is the family of the exponential tilts
`ρ_η = ρ.tilted (fun x ↦ ⟪η, T x⟫)`, for natural parameters `η ∈ E`. The member `ρ_η` has density
`x ↦ exp (⟪η, T x⟫ - ψ(η))` with respect to `ρ`, where `ψ(η) = log ∫ exp ⟪η, T x⟫ ∂ρ` is the
log-partition function. It is a probability measure (for `ρ ≠ 0`) when `η` lies in the set
`ρ.vecIntegrableExpSet T` of the `η` for which `exp ⟪η, T⟫` is `ρ`-integrable; the natural
parameters of the family are those of the interior of that set.

The family with a real statistic `T` (`MeasureTheory.Measure.expFamily`) is the restriction of this
family to a line: for `u : E`, the members of the family of the real statistic `⟪u, T⟫` are the
members `ρ_(t • u)`, and its cumulant generating function is `t ↦ ψ(t • u)`. Since the family is
closed under tilting (`ρ_η` tilted by `⟪η', T⟫` is `ρ_(η + η')`), the family of `⟪u, T⟫` generated
by `ρ_η` is the line `t ↦ ρ_(η + t • u)` through `η`. Most properties of the vector family are
reduced to the real case along these lines.

The two-parameter Gaussian laws `𝒩(μ, σ²)`, with statistic `x ↦ (x, x²)`, and the laws of bandit
arms with unknown means and variances are exponential families of this kind (L. D. Brown,
*Fundamentals of Statistical Exponential Families*, IMS Lecture Notes 9, 1986, Chapter 1;
M. J. Wainwright and M. I. Jordan, *Graphical models, exponential families, and variational
inference*, 2008, Section 3). The Kullback–Leibler divergence between two members is the Bregman
divergence of the log-partition function (A. Banerjee, S. Merugu, I. S. Dhillon and J. Ghosh,
*Clustering with Bregman divergences*, JMLR 6, 2005).

## Main definitions

* `MeasureTheory.Measure.vecIntegrableExpSet ρ T`: the set of the `η : E` such that
  `x ↦ exp ⟪η, T x⟫` is `ρ`-integrable.
* `MeasureTheory.Measure.vecExpFamily ρ T η`: the member `ρ.tilted (fun x ↦ ⟪η, T x⟫)` of the
  exponential family of `ρ` and `T` with natural parameter `η`.
* `MeasureTheory.Measure.vecLogPartition ρ T η`: the log-partition function
  `ψ(η) = log ∫ exp ⟪η, T x⟫ ∂ρ`.

## Main statements

* `MeasureTheory.Measure.expFamily_inner`, `MeasureTheory.Measure.cgf_inner`: the family of the
  real statistic `⟪u, T⟫` is the restriction of the vector family to the line `ℝ u`.
* `MeasureTheory.Measure.vecExpFamily_vecExpFamily`: tilting `ρ_η` by `⟪η', T⟫` gives
  `ρ_(η + η')`; `MeasureTheory.Measure.vecExpFamily_add_smul`,
  `MeasureTheory.Measure.cgf_inner_vecExpFamily`: on each line through `η`, the family is that of
  `⟪u, T⟫` generated by `ρ_η`, with cumulant generating function `t ↦ ψ(η + t • u) - ψ(η)`.
* `MeasureTheory.Measure.convex_vecIntegrableExpSet`,
  `MeasureTheory.Measure.convexOn_vecLogPartition`: the set of integrable exponential moments and
  the log-partition function on it are convex.
* `MeasureTheory.Measure.memLp_vecExpFamily`: in finite dimension, for `η` in the interior, `T`
  has moments of all orders under `ρ_η`.
* `MeasureTheory.Measure.hasFDerivAt_vecLogPartition`: in finite dimension, `ψ` is differentiable
  on the interior, with gradient at `η` the mean of `T` under `ρ_η`.
* `MeasureTheory.Measure.llr_vecExpFamily`: the log-likelihood ratio of `ρ_η` with respect to
  `ρ_η'` is `x ↦ ⟪η - η', T x⟫ + ψ(η') - ψ(η)`, `ρ_η`-almost everywhere.
* `MeasureTheory.Measure.klDiv_vecExpFamily`: in finite dimension, `KL(ρ_η, ρ_η')` is the
  Bregman divergence `ψ(η') - ψ(η) - Dψ(η) (η' - η)` of the log-partition function.
-/

public section

open ProbabilityTheory InformationTheory Real Set Filter

open scoped ENNReal NNReal Topology RealInnerProductSpace

namespace MeasureTheory.Measure

variable {𝓧 E : Type*} {m𝓧 : MeasurableSpace 𝓧} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  {ρ : Measure 𝓧} {T : 𝓧 → E} {η η' u : E} {t : ℝ}

/-! ### Definitions -/

/-- The set of the `η : E` such that `x ↦ exp ⟪η, T x⟫` is `ρ`-integrable: the members of the
exponential family of `ρ ≠ 0` and `T` with these parameters are probability measures. It is convex
(`convex_vecIntegrableExpSet`), and the natural parameters of the family are those of its
interior. Its restriction to the line `ℝ u` is the set `integrableExpSet` of the real statistic
`⟪u, T⟫` (`integrableExpSet_inner`). -/
def vecIntegrableExpSet (ρ : Measure 𝓧) (T : 𝓧 → E) : Set E :=
  {η | Integrable (fun x ↦ exp ⟪η, T x⟫) ρ}

lemma mem_vecIntegrableExpSet_iff :
    η ∈ ρ.vecIntegrableExpSet T ↔ Integrable (fun x ↦ exp ⟪η, T x⟫) ρ := Iff.rfl

lemma zero_mem_vecIntegrableExpSet [IsFiniteMeasure ρ] : 0 ∈ ρ.vecIntegrableExpSet T := by
  simp [mem_vecIntegrableExpSet_iff]

/-- The member with natural parameter `η` of the exponential family generated by a measure `ρ`
and a statistic `T` with values in an inner product space: the exponential tilt
`ρ.tilted (fun x ↦ ⟪η, T x⟫)`, with density `x ↦ exp (⟪η, T x⟫ - ψ(η))` with respect to `ρ`
(`vecExpFamily_apply`). It is a probability measure for `η ∈ ρ.vecIntegrableExpSet T` and
`ρ ≠ 0`, and `0` otherwise. -/
noncomputable def vecExpFamily (ρ : Measure 𝓧) (T : 𝓧 → E) (η : E) : Measure 𝓧 :=
  ρ.tilted (fun x ↦ ⟪η, T x⟫)

lemma vecExpFamily_def (ρ : Measure 𝓧) (T : 𝓧 → E) (η : E) :
    ρ.vecExpFamily T η = ρ.tilted (fun x ↦ ⟪η, T x⟫) := (rfl)

/-- The log-partition function `ψ(η) = log ∫ exp ⟪η, T x⟫ ∂ρ` of the exponential family of `ρ`
and `T`. Its restriction to the line `ℝ u` is the cumulant generating function of the real
statistic `⟪u, T⟫` (`cgf_inner`). -/
noncomputable def vecLogPartition (ρ : Measure 𝓧) (T : 𝓧 → E) (η : E) : ℝ :=
  log (∫ x, exp ⟪η, T x⟫ ∂ρ)

lemma vecLogPartition_def (ρ : Measure 𝓧) (T : 𝓧 → E) (η : E) :
    ρ.vecLogPartition T η = log (∫ x, exp ⟪η, T x⟫ ∂ρ) := (rfl)

/-! ### Basic properties -/

@[simp]
lemma vecExpFamily_zero_measure (T : 𝓧 → E) (η : E) : (0 : Measure 𝓧).vecExpFamily T η = 0 := by
  simp [vecExpFamily_def]

@[simp]
lemma vecLogPartition_zero_measure (T : 𝓧 → E) (η : E) :
    (0 : Measure 𝓧).vecLogPartition T η = 0 := by
  simp [vecLogPartition_def]

/-- The member of natural parameter `0` of the exponential family of a probability measure is the
measure itself. -/
@[simp]
lemma vecExpFamily_zero (ρ : Measure 𝓧) [IsProbabilityMeasure ρ] (T : 𝓧 → E) :
    ρ.vecExpFamily T 0 = ρ := by
  simp [vecExpFamily_def]

@[simp]
lemma vecLogPartition_zero (ρ : Measure 𝓧) [IsProbabilityMeasure ρ] (T : 𝓧 → E) :
    ρ.vecLogPartition T 0 = 0 := by
  simp [vecLogPartition_def]

/-- The density of `ρ_η` with respect to `ρ` is `x ↦ exp (⟪η, T x⟫ - ψ(η))`. -/
lemma vecExpFamily_apply [SFinite ρ] (hη : η ∈ ρ.vecIntegrableExpSet T) (s : Set 𝓧) :
    ρ.vecExpFamily T η s =
      ∫⁻ x in s, ENNReal.ofReal (exp (⟪η, T x⟫ - ρ.vecLogPartition T η)) ∂ρ := by
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp
  rw [vecExpFamily_def, tilted_apply]
  congr with x
  rw [exp_sub, vecLogPartition_def,
    exp_log (integral_exp_pos (mem_vecIntegrableExpSet_iff.mp hη))]

instance (ρ : Measure 𝓧) (T : 𝓧 → E) (η : E) :
    IsZeroOrProbabilityMeasure (ρ.vecExpFamily T η) := by
  rw [vecExpFamily_def]
  infer_instance

lemma isProbabilityMeasure_vecExpFamily [NeZero ρ] (hη : η ∈ ρ.vecIntegrableExpSet T) :
    IsProbabilityMeasure (ρ.vecExpFamily T η) :=
  isProbabilityMeasure_tilted hη

lemma vecExpFamily_absolutelyContinuous (ρ : Measure 𝓧) (T : 𝓧 → E) (η : E) :
    ρ.vecExpFamily T η ≪ ρ :=
  tilted_absolutelyContinuous _ _

lemma absolutelyContinuous_vecExpFamily (hη : η ∈ ρ.vecIntegrableExpSet T) :
    ρ ≪ ρ.vecExpFamily T η :=
  absolutelyContinuous_tilted hη

/-- Members of an exponential family with a parameter in `ρ.vecIntegrableExpSet T` have the null
sets of `ρ`, hence are mutually absolutely continuous. -/
lemma vecExpFamily_absolutelyContinuous_vecExpFamily (η : E)
    (hη' : η' ∈ ρ.vecIntegrableExpSet T) :
    ρ.vecExpFamily T η ≪ ρ.vecExpFamily T η' :=
  (vecExpFamily_absolutelyContinuous ρ T η).trans (absolutelyContinuous_vecExpFamily hη')

/-! ### Restriction to a line: the family of a real statistic -/

/-- The exponential family of the real statistic `⟪u, T⟫` is the restriction of the family of `T`
to the line `ℝ u`: its member of natural parameter `t` is `ρ_(t • u)`. -/
lemma expFamily_inner (ρ : Measure 𝓧) (T : 𝓧 → E) (u : E) (t : ℝ) :
    ρ.expFamily (fun x ↦ ⟪u, T x⟫) t = ρ.vecExpFamily T (t • u) := by
  simp [expFamily_def, vecExpFamily_def, real_inner_smul_left]

/-- The parameters `t` with an integrable exponential moment of `⟪u, T⟫` are those for which
`t • u` is in `ρ.vecIntegrableExpSet T`. -/
lemma integrableExpSet_inner (ρ : Measure 𝓧) (T : 𝓧 → E) (u : E) :
    integrableExpSet (fun x ↦ ⟪u, T x⟫) ρ = (· • u) ⁻¹' ρ.vecIntegrableExpSet T := by
  ext t
  simp [integrableExpSet, mem_vecIntegrableExpSet_iff, real_inner_smul_left]

/-- The cumulant generating function of the real statistic `⟪u, T⟫` is the restriction of the
log-partition function of `T` to the line `ℝ u`. -/
lemma cgf_inner (ρ : Measure 𝓧) (T : 𝓧 → E) (u : E) (t : ℝ) :
    cgf (fun x ↦ ⟪u, T x⟫) ρ t = ρ.vecLogPartition T (t • u) := by
  simp [cgf, mgf, vecLogPartition_def, real_inner_smul_left]

/-! ### Closure under tilting -/

/-- An exponential family is closed under tilting: the member of natural parameter `η'` of the
family generated by `ρ_η` and `T` is `ρ_(η + η')`. -/
lemma vecExpFamily_vecExpFamily (hη : η ∈ ρ.vecIntegrableExpSet T) (η' : E) :
    (ρ.vecExpFamily T η).vecExpFamily T η' = ρ.vecExpFamily T (η + η') := by
  simp_rw [vecExpFamily_def, tilted_tilted (f := fun x ↦ ⟪η, T x⟫) hη]
  congr with x
  rw [Pi.add_apply, inner_add_left]

/-- `exp ⟪η', T⟫` is integrable under `ρ_η` iff `exp ⟪η + η', T⟫` is integrable under `ρ`. -/
lemma vecIntegrableExpSet_vecExpFamily (hη : η ∈ ρ.vecIntegrableExpSet T) :
    (ρ.vecExpFamily T η).vecIntegrableExpSet T = (η + ·) ⁻¹' ρ.vecIntegrableExpSet T := by
  ext η'
  simp only [mem_vecIntegrableExpSet_iff, vecExpFamily_def, mem_preimage,
    integrable_tilted_iff hη, smul_eq_mul, ← exp_add, inner_add_left]

lemma interior_vecIntegrableExpSet_vecExpFamily (hη : η ∈ ρ.vecIntegrableExpSet T) :
    interior ((ρ.vecExpFamily T η).vecIntegrableExpSet T) =
      (η + ·) ⁻¹' interior (ρ.vecIntegrableExpSet T) := by
  rw [vecIntegrableExpSet_vecExpFamily hη]
  exact ((Homeomorph.addLeft η).preimage_interior _).symm

/-- The log-partition function of the family generated by `ρ_η` and `T` is
`η' ↦ ψ(η + η') - ψ(η)`. -/
lemma vecLogPartition_vecExpFamily (hη : η ∈ ρ.vecIntegrableExpSet T)
    (hηη' : η + η' ∈ ρ.vecIntegrableExpSet T) :
    (ρ.vecExpFamily T η).vecLogPartition T η' =
      ρ.vecLogPartition T (η + η') - ρ.vecLogPartition T η := by
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp
  rw [vecLogPartition_def, vecExpFamily_def, integral_exp_tilted]
  simp_rw [Pi.add_apply, ← inner_add_left]
  rw [log_div (integral_exp_pos (mem_vecIntegrableExpSet_iff.mp hηη')).ne'
    (integral_exp_pos (mem_vecIntegrableExpSet_iff.mp hη)).ne',
    vecLogPartition_def, vecLogPartition_def]

/-- On the line through `η` in the direction `u`, the family of `T` is the family of the real
statistic `⟪u, T⟫` generated by `ρ_η`. -/
lemma vecExpFamily_add_smul (hη : η ∈ ρ.vecIntegrableExpSet T) (u : E) (t : ℝ) :
    ρ.vecExpFamily T (η + t • u) = (ρ.vecExpFamily T η).expFamily (fun x ↦ ⟪u, T x⟫) t := by
  rw [expFamily_inner, vecExpFamily_vecExpFamily hη]

lemma integrableExpSet_inner_vecExpFamily (hη : η ∈ ρ.vecIntegrableExpSet T) (u : E) :
    integrableExpSet (fun x ↦ ⟪u, T x⟫) (ρ.vecExpFamily T η) =
      (fun t : ℝ ↦ η + t • u) ⁻¹' ρ.vecIntegrableExpSet T := by
  rw [integrableExpSet_inner, vecIntegrableExpSet_vecExpFamily hη, preimage_preimage]

/-- On the line through `η` in the direction `u`, `t ↦ ψ(η + t • u) - ψ(η)` is the cumulant
generating function of `⟪u, T⟫` under `ρ_η`. -/
lemma cgf_inner_vecExpFamily (hη : η ∈ ρ.vecIntegrableExpSet T)
    (hηt : η + t • u ∈ ρ.vecIntegrableExpSet T) :
    cgf (fun x ↦ ⟪u, T x⟫) (ρ.vecExpFamily T η) t =
      ρ.vecLogPartition T (η + t • u) - ρ.vecLogPartition T η := by
  rw [cgf_inner, vecLogPartition_vecExpFamily hη hηt]

/-- `ρ_η'` is the member of natural parameter `1` of the family of the real statistic
`⟪η' - η, T⟫` generated by `ρ_η`. -/
private lemma expFamily_inner_sub_one (hη : η ∈ ρ.vecIntegrableExpSet T) (η' : E) :
    (ρ.vecExpFamily T η).expFamily (fun x ↦ ⟪η' - η, T x⟫) 1 = ρ.vecExpFamily T η' := by
  rw [← vecExpFamily_add_smul hη, one_smul, add_sub_cancel]

private lemma one_mem_integrableExpSet_inner_sub (hη : η ∈ ρ.vecIntegrableExpSet T)
    (hη' : η' ∈ ρ.vecIntegrableExpSet T) :
    (1 : ℝ) ∈ integrableExpSet (fun x ↦ ⟪η' - η, T x⟫) (ρ.vecExpFamily T η) := by
  rwa [integrableExpSet_inner_vecExpFamily hη, mem_preimage, one_smul, add_sub_cancel]

/-- For `η` in the interior of `ρ.vecIntegrableExpSet T`, every real statistic `⟪u, T⟫` has
exponential moments near `0` under `ρ_η`. -/
lemma zero_mem_interior_integrableExpSet_inner_vecExpFamily
    (hη : η ∈ interior (ρ.vecIntegrableExpSet T)) (u : E) :
    0 ∈ interior (integrableExpSet (fun x ↦ ⟪u, T x⟫) (ρ.vecExpFamily T η)) := by
  rw [integrableExpSet_inner_vecExpFamily (interior_subset hη)]
  have h_cont : Continuous fun t : ℝ ↦ η + t • u := by fun_prop
  refine interior_mono (preimage_mono interior_subset) ?_
  rw [mem_interior]
  exact ⟨_, subset_refl _, isOpen_interior.preimage h_cont, by simpa using hη⟩

/-! ### Convexity -/

/-- The set of the parameters with an integrable exponential moment is convex. -/
lemma convex_vecIntegrableExpSet : Convex ℝ (ρ.vecIntegrableExpSet T) := by
  intro η₁ hη₁ η₂ hη₂ a b ha hb hab
  -- Along the line through `η₁` and `η₂`, this is the convexity of `integrableExpSet`.
  have h_mem : ∀ t : ℝ, t ∈ integrableExpSet (fun x ↦ ⟪η₂ - η₁, T x⟫) (ρ.vecExpFamily T η₁) ↔
      η₁ + t • (η₂ - η₁) ∈ ρ.vecIntegrableExpSet T := by
    intro t
    rw [integrableExpSet_inner_vecExpFamily hη₁, mem_preimage]
  have h0 := (h_mem 0).2 (by simpa using hη₁)
  have h1 := (h_mem 1).2 (by simpa using hη₂)
  have hb_mem := convex_integrableExpSet h0 h1 ha hb hab
  simp only [smul_eq_mul, mul_zero, mul_one, zero_add] at hb_mem
  convert (h_mem b).1 hb_mem using 1
  obtain rfl : a = 1 - b := by linarith
  module

/-- **Convexity of the log-partition function**: `ψ` is convex on the convex set
`ρ.vecIntegrableExpSet T`. -/
lemma convexOn_vecLogPartition : ConvexOn ℝ (ρ.vecIntegrableExpSet T) (ρ.vecLogPartition T) := by
  refine ⟨convex_vecIntegrableExpSet, fun η₁ hη₁ η₂ hη₂ a b ha hb hab ↦ ?_⟩
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp
  have hZ₁ := integral_exp_pos hη₁
  have hZ₂ := integral_exp_pos hη₂
  -- Hölder's inequality `∫ f ^ a g ^ b ≤ (∫ f) ^ a (∫ g) ^ b`, for `f = exp ⟪η₁, T⟫`
  -- and `g = exp ⟪η₂, T⟫`.
  have h_holder := integral_rpow_mul_rpow_le (ae_of_all _ fun x ↦ (exp_pos ⟪η₁, T x⟫).le)
    (ae_of_all _ fun x ↦ (exp_pos ⟪η₂, T x⟫).le) hη₁ hη₂ ha hb hab
  have h_eq : ∀ x, exp ⟪η₁, T x⟫ ^ a * exp ⟪η₂, T x⟫ ^ b = exp ⟪a • η₁ + b • η₂, T x⟫ := by
    intro x
    rw [← exp_mul, ← exp_mul, ← exp_add]
    simp [inner_add_left, real_inner_smul_left, mul_comm]
  simp_rw [h_eq] at h_holder
  simp only [vecLogPartition_def, smul_eq_mul]
  calc log (∫ x, exp ⟪a • η₁ + b • η₂, T x⟫ ∂ρ)
  _ ≤ log ((∫ x, exp ⟪η₁, T x⟫ ∂ρ) ^ a * (∫ x, exp ⟪η₂, T x⟫ ∂ρ) ^ b) :=
    log_le_log (integral_exp_pos (convex_vecIntegrableExpSet hη₁ hη₂ ha hb hab)) h_holder
  _ = a * log (∫ x, exp ⟪η₁, T x⟫ ∂ρ) + b * log (∫ x, exp ⟪η₂, T x⟫ ∂ρ) := by
    rw [log_mul (by positivity) (by positivity), log_rpow hZ₁, log_rpow hZ₂]

/-! ### The log-likelihood ratio -/

/-- The log-likelihood ratio of `ρ_η` with respect to `ρ_η'` is
`x ↦ ⟪η - η', T x⟫ + ψ(η') - ψ(η)`, `ρ_η`-almost everywhere. -/
lemma llr_vecExpFamily (hη' : η' ∈ ρ.vecIntegrableExpSet T) :
    llr (ρ.vecExpFamily T η) (ρ.vecExpFamily T η') =ᵐ[ρ.vecExpFamily T η]
      fun x ↦ ⟪η - η', T x⟫ + ρ.vecLogPartition T η' - ρ.vecLogPartition T η := by
  obtain hη | hη := em' (η ∈ ρ.vecIntegrableExpSet T)
  · have h_zero : ρ.vecExpFamily T η = 0 := tilted_of_not_integrable hη
    simp [h_zero, Filter.EventuallyEq]
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp [Filter.EventuallyEq]
  have := isProbabilityMeasure_vecExpFamily hη
  -- On the line through `η` and `η'`, `ρ_η` and `ρ_η'` are the members `0` and `1` of the family
  -- of the real statistic `⟪η' - η, T⟫` generated by `ρ_η`.
  have h_mem : η + (1 : ℝ) • (η' - η) ∈ ρ.vecIntegrableExpSet T := by simpa using hη'
  have h := llr_expFamily (ρ := ρ.vecExpFamily T η) (η := 0)
    (one_mem_integrableExpSet_inner_sub hη hη')
  rw [expFamily_zero, expFamily_inner_sub_one hη] at h
  filter_upwards [h] with x hx
  rw [hx, cgf_inner_vecExpFamily hη h_mem, one_smul, add_sub_cancel, cgf_zero, ← neg_sub η' η,
    inner_neg_left]
  ring

lemma integrable_llr_vecExpFamily (hη : η ∈ interior (ρ.vecIntegrableExpSet T))
    (hη' : η' ∈ ρ.vecIntegrableExpSet T) :
    Integrable (llr (ρ.vecExpFamily T η) (ρ.vecExpFamily T η')) (ρ.vecExpFamily T η) := by
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp
  have := isProbabilityMeasure_vecExpFamily (interior_subset hη)
  -- On the line through `η` and `η'`, `ρ_η` and `ρ_η'` are the members `0` and `1` of the family
  -- of the real statistic `⟪η' - η, T⟫` generated by `ρ_η`.
  have h := integrable_llr_expFamily (zero_mem_interior_integrableExpSet_inner_vecExpFamily hη _)
    (one_mem_integrableExpSet_inner_sub (interior_subset hη) hη')
  rwa [expFamily_zero, expFamily_inner_sub_one (interior_subset hη)] at h

/-! ### Derivatives of the exponential moments -/

/-- The derivative of `η ↦ exp ⟪η, y⟫` at `η` is `exp ⟪η, y⟫ • ⟪y, ·⟫`. -/
private lemma hasFDerivAt_exp_inner (η y : E) :
    HasFDerivAt (fun η ↦ exp ⟪η, y⟫) (exp ⟪η, y⟫ • innerSL ℝ y) η := by
  have h_inner : HasFDerivAt (fun η ↦ ⟪η, y⟫) (innerSL ℝ y) η := by
    convert (innerSL ℝ y).hasFDerivAt (x := η) using 1
    ext η
    simp [real_inner_comm]
  exact h_inner.exp

/-- On the ball of radius `ε / 2` around `η`, the derivative `exp ⟪η', y⟫ • ⟪y, ·⟫` of
`η' ↦ exp ⟪η', y⟫` is bounded by `2 / ε * exp (⟪η, y⟫ + ε ‖y‖)`. -/
private lemma norm_exp_inner_smul_innerSL_le {ε : ℝ} (hε : 0 < ε)
    (hη' : η' ∈ Metric.ball η (ε / 2)) (y : E) :
    ‖exp ⟪η', y⟫ • innerSL ℝ y‖ ≤ 2 / ε * exp (⟪η, y⟫ + ε * ‖y‖) := by
  rw [norm_smul, innerSL_apply_norm, norm_of_nonneg (exp_nonneg _)]
  have h_inner : ⟪η', y⟫ ≤ ⟪η, y⟫ + ε / 2 * ‖y‖ := by
    have h_dist : ‖η' - η‖ ≤ ε / 2 := by
      rw [← dist_eq_norm]
      exact (Metric.mem_ball.mp hη').le
    calc ⟪η', y⟫ = ⟪η, y⟫ + ⟪η' - η, y⟫ := by rw [inner_sub_left]; ring
    _ ≤ ⟪η, y⟫ + ‖η' - η‖ * ‖y‖ := by gcongr; exact real_inner_le_norm _ _
    _ ≤ ⟪η, y⟫ + ε / 2 * ‖y‖ := by gcongr
  have h_norm : ‖y‖ ≤ 2 / ε * exp (ε / 2 * ‖y‖) := by
    calc ‖y‖ = 2 / ε * (ε / 2 * ‖y‖) := by field_simp
    _ ≤ 2 / ε * exp (ε / 2 * ‖y‖) := by
      gcongr
      linarith [add_one_le_exp (ε / 2 * ‖y‖)]
  calc exp ⟪η', y⟫ * ‖y‖ ≤ exp (⟪η, y⟫ + ε / 2 * ‖y‖) * (2 / ε * exp (ε / 2 * ‖y‖)) := by
        gcongr
  _ = 2 / ε * exp (⟪η, y⟫ + ε * ‖y‖) := by
        rw [mul_left_comm, ← exp_add]
        ring_nf

/-! ### Moments of the statistic in the interior -/

section FiniteDimensional

variable [FiniteDimensional ℝ E]

/-- In finite dimension, for `η` in the interior of `ρ.vecIntegrableExpSet T`, the statistic `T`
has moments of all orders under `ρ_η`. -/
lemma memLp_vecExpFamily (hη : η ∈ interior (ρ.vecIntegrableExpSet T)) (p : ℝ≥0) :
    MemLp T p (ρ.vecExpFamily T η) := by
  let b := stdOrthonormalBasis ℝ E
  have h_eq : (fun x ↦ ∑ i, ⟪b i, T x⟫ • b i) = T := funext fun x ↦ b.sum_repr' (T x)
  have h_sum : MemLp (fun x ↦ ∑ i, ⟪b i, T x⟫ • b i) p (ρ.vecExpFamily T η) := by
    refine memLp_finsetSum _ fun i _ ↦ ?_
    have h := memLp_of_mem_interior_integrableExpSet
      (zero_mem_interior_integrableExpSet_inner_vecExpFamily hη (b i)) p
    simpa [Function.comp_def] using
      (ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (b i)).comp_memLp' h
  rwa [h_eq] at h_sum

lemma integrable_vecExpFamily (hη : η ∈ interior (ρ.vecIntegrableExpSet T)) :
    Integrable T (ρ.vecExpFamily T η) :=
  memLp_one_iff_integrable.mp (memLp_vecExpFamily hη 1)

/-- A statistic with an exponential moment in the interior of `ρ.vecIntegrableExpSet T` is
`ρ`-almost everywhere strongly measurable. -/
lemma aestronglyMeasurable_of_mem_interior_vecIntegrableExpSet
    (hη : η ∈ interior (ρ.vecIntegrableExpSet T)) : AEStronglyMeasurable T ρ :=
  (memLp_vecExpFamily hη 1).aestronglyMeasurable.mono_ac
    (absolutelyContinuous_vecExpFamily (interior_subset hη))

/-- For `η` in the interior of `ρ.vecIntegrableExpSet T`, some exponential moment of the norm of
`T` is integrable under `ρ_η`: there is `ε > 0` such that `x ↦ exp (⟪η, T x⟫ + ε ‖T x‖)` is
`ρ`-integrable. -/
lemma exists_integrable_exp_inner_add_mul_norm (hη : η ∈ interior (ρ.vecIntegrableExpSet T)) :
    ∃ ε > 0, Integrable (fun x ↦ exp (⟪η, T x⟫ + ε * ‖T x‖)) ρ := by
  let b := stdOrthonormalBasis ℝ E
  let d : ℝ := √(Fintype.card (Fin (Module.finrank ℝ E)))
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp (mem_interior_iff_mem_nhds.mp hη)
  -- The bound `exp (ε ‖y‖) ≤ 1 + ∑ i, (exp (ε d ⟪bᵢ, y⟫) + exp (-(ε d ⟪bᵢ, y⟫)))`
  -- (`OrthonormalBasis.exp_mul_norm_le`), with `d` the square root of the dimension, reduces the
  -- norm to the parameters `η ± ε d bᵢ` of the ball of radius `r`.
  set ε := r / (2 * (d + 1)) with hε_def
  have hε : 0 < ε := by positivity
  have hd : 0 ≤ d := by positivity
  have hc_lt : ε * d < r := by
    rw [hε_def, div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
    nlinarith
  have h_mem : ∀ i (s : ℝ), |s| ≤ ε * d → η + s • b i ∈ ρ.vecIntegrableExpSet T := by
    intro i s hs
    refine hball (Metric.mem_ball.mpr ?_)
    rw [dist_eq_norm, add_sub_cancel_left, norm_smul, b.orthonormal.1 i, mul_one, norm_eq_abs]
    exact hs.trans_lt hc_lt
  refine ⟨ε, hε, ?_⟩
  have h_int : Integrable (fun x ↦ exp ⟪η, T x⟫ +
      ∑ i, (exp ⟪η + (ε * d) • b i, T x⟫ + exp ⟪η + (-(ε * d)) • b i, T x⟫)) ρ := by
    refine (interior_subset hη).add (integrable_finsetSum _ fun i _ ↦ ?_)
    exact (h_mem i _ (by rw [abs_of_nonneg (by positivity)])).add
      (h_mem i _ (by rw [abs_neg, abs_of_nonneg (by positivity)]))
  refine h_int.mono' ?_ (ae_of_all _ fun x ↦ ?_)
  · have hT := aestronglyMeasurable_of_mem_interior_vecIntegrableExpSet hη
    have : AEStronglyMeasurable (fun x ↦ ⟪η, T x⟫) ρ := hT.const_inner
    fun_prop
  · rw [norm_of_nonneg (exp_nonneg _), exp_add]
    calc exp ⟪η, T x⟫ * exp (ε * ‖T x‖)
    _ ≤ exp ⟪η, T x⟫ *
        (1 + ∑ i, (exp (ε * d * ⟪b i, T x⟫) + exp (-(ε * d * ⟪b i, T x⟫)))) := by
      gcongr
      exact b.exp_mul_norm_le hε.le (T x)
    _ = _ := by
      simp only [inner_add_left, real_inner_smul_left, exp_add, Finset.mul_sum, mul_add, mul_one,
        neg_mul]

/-! ### The gradient of the log-partition function -/

/-- **Gradient of the log-partition function.** In finite dimension, `ψ` is differentiable at
every `η` in the interior of `ρ.vecIntegrableExpSet T`, with gradient the mean of `T` under `ρ_η`:
`Dψ(η) = ⟪∫ T ∂ρ_η, ·⟫`. -/
theorem hasFDerivAt_vecLogPartition (hη : η ∈ interior (ρ.vecIntegrableExpSet T)) :
    HasFDerivAt (ρ.vecLogPartition T) (innerSL ℝ (∫ x, T x ∂(ρ.vecExpFamily T η))) η := by
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · have h_zero : (0 : Measure 𝓧).vecLogPartition T = fun _ ↦ 0 :=
      funext fun _ ↦ vecLogPartition_zero_measure T _
    simpa [h_zero] using hasFDerivAt_const (0 : ℝ) η
  obtain ⟨ε, hε, h_int⟩ := exists_integrable_exp_inner_add_mul_norm hη
  have hT := aestronglyMeasurable_of_mem_interior_vecIntegrableExpSet hη
  have hη_mem := interior_subset hη
  -- On the ball of radius `ε / 2` around `η`, the derivatives are dominated by a multiple of the
  -- integrable function `exp (⟪η, T⟫ + ε ‖T‖)`.
  have hZ : HasFDerivAt (fun η ↦ ∫ x, exp ⟪η, T x⟫ ∂ρ)
      (∫ x, exp ⟪η, T x⟫ • innerSL ℝ (T x) ∂ρ) η := by
    refine hasFDerivAt_integral_of_dominated_of_fderiv_le (F := fun η x ↦ exp ⟪η, T x⟫)
      (F' := fun η x ↦ exp ⟪η, T x⟫ • innerSL ℝ (T x))
      (bound := fun x ↦ 2 / ε * exp (⟪η, T x⟫ + ε * ‖T x‖))
      (Metric.ball_mem_nhds η (half_pos hε)) ?_ hη_mem ?_ ?_ (h_int.const_mul _) ?_
    · exact Eventually.of_forall fun η' ↦ continuous_exp.comp_aestronglyMeasurable hT.const_inner
    · exact (continuous_exp.comp_aestronglyMeasurable hT.const_inner).smul
        ((innerSL ℝ).continuous.comp_aestronglyMeasurable hT)
    · exact ae_of_all _ fun x η' hη' ↦ norm_exp_inner_smul_innerSL_le hε hη' (T x)
    · exact ae_of_all _ fun x η' _ ↦ hasFDerivAt_exp_inner η' (T x)
  -- The gradient of `ψ = log Z` is `Z(η)⁻¹ • DZ(η)`, the mean of `T` under `ρ_η`.
  have h_int' : Integrable (fun x ↦ exp ⟪η, T x⟫ • T x) ρ :=
    (integrable_tilted_iff hη_mem T).mp (integrable_vecExpFamily hη)
  have h_mean : ∫ x, T x ∂(ρ.vecExpFamily T η) =
      (∫ x, exp ⟪η, T x⟫ ∂ρ)⁻¹ • ∫ x, exp ⟪η, T x⟫ • T x ∂ρ := by
    rw [vecExpFamily_def, integral_tilted, ← integral_smul]
    congr with x
    rw [smul_smul, div_eq_inv_mul]
  have h_log := hZ.log (integral_exp_pos hη_mem).ne'
  rw [h_mean, map_smul, ← (innerSL ℝ).integral_comp_comm h_int']
  simp_rw [map_smul]
  exact h_log

/-- The derivative of the log-partition function at `η` in the interior is `⟪∫ T ∂ρ_η, ·⟫`. -/
lemma fderiv_vecLogPartition (hη : η ∈ interior (ρ.vecIntegrableExpSet T)) :
    fderiv ℝ (ρ.vecLogPartition T) η = innerSL ℝ (∫ x, T x ∂(ρ.vecExpFamily T η)) :=
  (hasFDerivAt_vecLogPartition hη).fderiv

lemma differentiableOn_vecLogPartition :
    DifferentiableOn ℝ (ρ.vecLogPartition T) (interior (ρ.vecIntegrableExpSet T)) :=
  fun _ hη ↦ (hasFDerivAt_vecLogPartition hη).differentiableAt.differentiableWithinAt

/-! ### The Kullback–Leibler divergence between two members -/

/-- The Kullback–Leibler divergence between two members of an exponential family with a
statistic in a finite-dimensional space, as a real number:
`KL(ρ_η, ρ_η') = ψ(η') - ψ(η) - ⟪∫ T ∂ρ_η, η' - η⟫`. -/
theorem toReal_klDiv_vecExpFamily (hη : η ∈ interior (ρ.vecIntegrableExpSet T))
    (hη' : η' ∈ ρ.vecIntegrableExpSet T) :
    (klDiv (ρ.vecExpFamily T η) (ρ.vecExpFamily T η')).toReal =
      ρ.vecLogPartition T η' - ρ.vecLogPartition T η -
        ⟪∫ x, T x ∂(ρ.vecExpFamily T η), η' - η⟫ := by
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp
  have := isProbabilityMeasure_vecExpFamily (interior_subset hη)
  -- On the line through `η` and `η'`, `ρ_η` and `ρ_η'` are the members `0` and `1` of the family
  -- of the real statistic `⟪η' - η, T⟫` generated by `ρ_η`.
  have h0 := zero_mem_interior_integrableExpSet_inner_vecExpFamily hη (η' - η)
  have h := toReal_klDiv_expFamily h0 (one_mem_integrableExpSet_inner_sub (interior_subset hη) hη')
  rw [expFamily_zero, expFamily_inner_sub_one (interior_subset hη)] at h
  rw [h, ← integral_expFamily h0, expFamily_zero, integral_inner (integrable_vecExpFamily hη),
    cgf_zero, cgf_inner_vecExpFamily (interior_subset hη) (by simpa using hη'), one_smul,
    add_sub_cancel, real_inner_comm]
  ring

lemma integral_llr_vecExpFamily (hη : η ∈ interior (ρ.vecIntegrableExpSet T))
    (hη' : η' ∈ ρ.vecIntegrableExpSet T) :
    ∫ x, llr (ρ.vecExpFamily T η) (ρ.vecExpFamily T η') x ∂(ρ.vecExpFamily T η) =
      ρ.vecLogPartition T η' - ρ.vecLogPartition T η -
        ⟪∫ x, T x ∂(ρ.vecExpFamily T η), η' - η⟫ := by
  rcases eq_zero_or_neZero ρ with rfl | hρ
  · simp
  have := isProbabilityMeasure_vecExpFamily (interior_subset hη)
  have := isProbabilityMeasure_vecExpFamily hη'
  rw [← toReal_klDiv_vecExpFamily hη hη', toReal_klDiv
    (vecExpFamily_absolutelyContinuous_vecExpFamily η hη') (integrable_llr_vecExpFamily hη hη')]
  simp

/-- **Kullback–Leibler divergence in an exponential family with a vector statistic.** In finite
dimension, the divergence between two members is the Bregman divergence of the log-partition
function `ψ`: `KL(ρ_η, ρ_η') = ψ(η') - ψ(η) - Dψ(η) (η' - η)`. In particular it is finite. -/
theorem klDiv_vecExpFamily (hη : η ∈ interior (ρ.vecIntegrableExpSet T))
    (hη' : η' ∈ ρ.vecIntegrableExpSet T) :
    klDiv (ρ.vecExpFamily T η) (ρ.vecExpFamily T η') =
      ENNReal.ofReal (bregDiv (ρ.vecLogPartition T) η' η (fderiv ℝ (ρ.vecLogPartition T) η)) := by
  rw [bregDiv, fderiv_vecLogPartition hη, innerSL_apply_apply, ← toReal_klDiv_vecExpFamily hη hη',
    ENNReal.ofReal_toReal]
  exact klDiv_ne_top (vecExpFamily_absolutelyContinuous_vecExpFamily η hη')
    (integrable_llr_vecExpFamily hη hη')

end FiniteDimensional

end MeasureTheory.Measure
