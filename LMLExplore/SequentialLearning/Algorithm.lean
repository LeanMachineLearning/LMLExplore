/-!
# Algorithm-environment sequences: transport, prior history, piecewise algorithms and environments

Complements to LML's `LeanMachineLearning.SequentialLearning.Algorithm`.

An algorithm-environment sequence on `(Ω', P')` is transported to `(Ω, P)` along a measurable map
`g : Ω → Ω'` carrying `P` to `P'`. This is how a run of an algorithm on a canonical space (such as
a product of the trajectory space with the space of an extra random variable) is built from a run
on a smaller space.

The history of the first `n` rounds is known when the action of round `n` is chosen: the process
of histories of variable length is adapted to the filtration `IsAlgEnvSeq.filtrationAction`, which
at time `n` is generated by that history and the observation and action of round `n`. Hitting
times of this process, such as the stopping times of identification algorithms, are therefore
stopping times for this filtration, which does not contain the feedback of the round. On an
event of this filtration, the feedback of round `n` can be replaced by its conditional mean given
that information.

The piecewise algorithm `alg.piecewise s hs alg'` and the piecewise environment
`env.piecewise s hs env'` follow `alg` and `env` on the histories in `s n` and `alg'` and `env'`
elsewhere. With `s n` the histories after which a stopping rule has not stopped, they are the
algorithm and the environment that switch from `(alg, env)` to `(alg', env')` at the stopping
time, which is how a change of measure at a stopping time is reduced to a change of measure on
the whole trajectory.

## Main definitions

* `Learning.Algorithm.piecewise s hs alg alg'`: the algorithm whose policy at round `n` is that of
  `alg` on the histories in `s n` and that of `alg'` elsewhere.
* `Learning.Environment.piecewise s hs env env'`: the environment whose kernels at round `n` are
  those of `env` on the histories in `s n` and those of `env'` elsewhere.

## Main statements

* `Learning.IsAlgEnvSeq.comp_hasLaw`: algorithm-environment sequences are transported along a
  measurable map `g : Ω → Ω'` carrying `P` to `P'`.
* `Learning.init_history`: the history of the first `n` rounds is the initial segment `Fin.init`
  of the history of the first `n + 1` rounds.
* `Learning.IsAlgEnvSeq.adapted_sigmaHistory_filtrationAction`: the histories of variable length
  are adapted to `IsAlgEnvSeq.filtrationAction`.
* `Learning.IsAlgEnvSeq.condExp_comp_action`: the conditional expectation of a function
  `f (past, A n)` of the past (history and observation) and the action of round `n` given the past
  is the integral of `f (past, ·)` against the policy of round `n`.
* `Learning.IsAlgEnvSeq.setLIntegral_comp_feedback`: on an event of `h.filtrationAction n`, the
  expectation of `g(Y_n)` is that of `∫ g` against the conditional law of `Y_n`, for `g ≥ 0`.
* `Learning.IsAlgEnvSeq.ae_forall_feedback_mem_bandit`: along a run against a stochastic bandit
  whose arm laws are concentrated on a set, almost surely every feedback lies in that set.
* `Learning.IsAlgEnvSeq.integrable_feedback`: the feedback of a round is integrable when its
  conditional absolute mean has finite expectation.
* `Learning.IsAlgEnvSeq.setIntegral_feedback`: on an event of `h.filtrationAction n`, the
  expectation of `Y_n` is that of its conditional mean `env.means O A Y (A n) n`.
* `Learning.IsAlgEnvSeq.measurable_means_filtrationObs`: the means `env.means O A Y a n` of the
  feedbacks of round `n` are measurable with respect to the past `h.filtrationObs n` of round `n`.
* `Learning.IsAlgEnvSeq.map_obs`, `Learning.IsAlgEnvSeq.map_obs_action`: along every run, the
  observation of round `n`, and the pair of the observation and the action of round `n`, have the
  same laws as under the trajectory measure `trajMeasure alg env`.
* `Learning.IsAlgEnvSeq.map_restrict_history_succ`: on an event of the history of the first `M`
  rounds, the law of the history of the first `M + 1` rounds is the composition-product of the
  restricted law of the history of the first `M` rounds with the step kernel of round `M`.
* `Learning.stepKernel_piecewise`: the step kernel of `alg.piecewise s hs alg'` against
  `env.piecewise s hs env'` at a history in `s n` is that of `(alg, env)`, and that of
  `(alg', env')` elsewhere.

The transport lemma is adapted from the LMLPapers project (same author).
-/

public section

open MeasureTheory ProbabilityTheory

open scoped ENNReal

namespace Learning

variable {𝓞 𝓐 𝓨 Ω Ω' : Type*} {m𝓞 : MeasurableSpace 𝓞} {m𝓐 : MeasurableSpace 𝓐}
  {m𝓨 : MeasurableSpace 𝓨} {mΩ : MeasurableSpace Ω} {mΩ' : MeasurableSpace Ω'}
  {alg : Algorithm 𝓞 𝓐 𝓨} {env : Environment 𝓞 𝓐 𝓨}
  {P : Measure Ω} {P' : Measure Ω'} {g : Ω → Ω'}
  {O : ℕ → Ω' → 𝓞} {X : ℕ → Ω' → 𝓐} {Y : ℕ → Ω' → 𝓨}

/-- An algorithm-environment sequence is transported along a measurable map `g` carrying `P`
to `P'`. -/
lemma IsAlgEnvSeq.comp_hasLaw (h : IsAlgEnvSeq O X Y alg env P') (hg : HasLaw g P' P)
    (hgm : Measurable g) :
    IsAlgEnvSeq (fun n ↦ O n ∘ g) (fun n ↦ X n ∘ g) (fun n ↦ Y n ∘ g) alg env P where
  measurable_obs n := (h.measurable_obs n).comp hgm
  measurable_action n := (h.measurable_action n).comp hgm
  measurable_feedback n := (h.measurable_feedback n).comp hgm
  hasCondDistrib_obs n := (h.hasCondDistrib_obs n).comp_hasLaw hg
  hasCondDistrib_action n := (h.hasCondDistrib_action n).comp_hasLaw hg
  hasCondDistrib_feedback n := (h.hasCondDistrib_feedback n).comp_hasLaw hg

/-- The history of the first `n` rounds is the initial segment of the history of the first
`n + 1` rounds. -/
@[simp]
lemma init_history (O : ℕ → Ω' → 𝓞) (A : ℕ → Ω' → 𝓐) (Y : ℕ → Ω' → 𝓨) (n : ℕ) (ω : Ω') :
    Fin.init (history O A Y (n + 1) ω) = history O A Y n ω := by
  funext i
  simp [Fin.init, history_apply]

/-- The history of the first `n` rounds, as a history of variable length, is measurable with
respect to the σ-algebra `h.filtrationAction n` generated by that history and the observation and
action of round `n`. -/
lemma IsAlgEnvSeq.adapted_sigmaHistory_filtrationAction {P : Measure Ω}
    {O : ℕ → Ω → 𝓞} {X : ℕ → Ω → 𝓐} {Y : ℕ → Ω → 𝓨} (h : IsAlgEnvSeq O X Y alg env P) :
    Adapted h.filtrationAction (sigmaHistory O X Y) :=
  fun n ↦ (measurable_sigmaMk n).comp (h.measurable_history_filtrationAction n)

/-- Along a run of an algorithm, the conditional expectation of an integrable function
`f (past, A n)` of the past (history and observation) and of the action of round `n` given the
past is the integral of `f (past, ·)` against the policy of round `n` at the past. -/
lemma IsAlgEnvSeq.condExp_comp_action [StandardBorelSpace 𝓐] [Nonempty 𝓐] {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] {P : Measure Ω} [IsFiniteMeasure P]
    {O : ℕ → Ω → 𝓞} {A : ℕ → Ω → 𝓐} {Y : ℕ → Ω → 𝓨} (h : IsAlgEnvSeq O A Y alg env P) (n : ℕ)
    {f : (Hist 𝓞 𝓐 𝓨 n × 𝓞) × 𝓐 → E} (hf : StronglyMeasurable f)
    (hint : Integrable (fun ω ↦ f ((history O A Y n ω, O n ω), A n ω)) P) :
    P[fun ω ↦ f ((history O A Y n ω, O n ω), A n ω) | h.filtrationObs n] =ᵐ[P]
      fun ω ↦ ∫ a, f ((history O A Y n ω, O n ω), a)
        ∂(alg.policy n (history O A Y n ω, O n ω)) := by
  have hX : Measurable fun ω ↦ (history O A Y n ω, O n ω) :=
    (h.measurable_history n).prodMk (h.measurable_obs n)
  rw [h.filtrationObs_eq_comap]
  refine (condExp_prod_ae_eq_integral_condDistrib hX (h.measurable_action n).aemeasurable hf
    hint).trans ?_
  filter_upwards [ae_of_ae_map hX.aemeasurable (h.hasCondDistrib_action n).condDistrib_ae_eq]
    with ω hω
  rw [hω]

/-- Along a run of an algorithm, the pair of the observation and the action of round `n` is
measurable. -/
lemma IsAlgEnvSeq.measurable_obs_action (h : IsAlgEnvSeq O X Y alg env P') (n : ℕ) :
    Measurable fun ω ↦ (O n ω, X n ω) :=
  (h.measurable_obs n).prodMk (h.measurable_action n)

section Feedback

variable {P : Measure Ω} {O : ℕ → Ω → 𝓞} {A : ℕ → Ω → 𝓐} {Y : ℕ → Ω → 𝓨}

/-- On an event `s` of `h.filtrationAction n` (determined by the history before round `n`, the
observation of round `n` and the action of round `n`), the expectation of `g(Y_n)` is that of
`∫ g` against the law `env.feedbackKernel O A Y n ω (A n ω)` of the feedback given that
information, for a measurable `g ≥ 0`. -/
lemma IsAlgEnvSeq.setLIntegral_comp_feedback [SFinite P] (h : IsAlgEnvSeq O A Y alg env P) {n : ℕ}
    {s : Set Ω} (hs : MeasurableSet[h.filtrationAction n] s) {g : 𝓨 → ℝ≥0∞} (hg : Measurable g) :
    ∫⁻ ω in s, g (Y n ω) ∂P =
      ∫⁻ ω in s, ∫⁻ y, g y ∂(env.feedbackKernel O A Y n ω (A n ω)) ∂P := by
  rw [h.filtrationAction_eq_comap n] at hs
  obtain ⟨t, ht, rfl⟩ := hs
  simpa [Environment.feedbackKernel] using
    (h.hasCondDistrib_feedback n).setLIntegral_comp_eq_setLIntegral_lintegral ht hg

/-- Along a run against the stochastic bandit `Environment.bandit ν` whose arm laws are all
concentrated on a measurable set `s`, almost surely every feedback lies in `s`. -/
lemma IsAlgEnvSeq.ae_forall_feedback_mem_bandit [SFinite P] {alg : Algorithm Unit 𝓐 𝓨}
    {O : ℕ → Ω → Unit} {ν : Kernel 𝓐 𝓨} [IsMarkovKernel ν]
    (h : IsAlgEnvSeq O A Y alg (Environment.bandit ν) P) {s : Set 𝓨} (hs : MeasurableSet s)
    (hν : ∀ a, ∀ᵐ y ∂(ν a), y ∈ s) :
    ∀ᵐ ω ∂P, ∀ n, Y n ω ∈ s :=
  ae_all_iff.2 fun n ↦ (h.hasCondDistrib_feedback_bandit n).ae_mem hs hν

variable [NormedAddCommGroup 𝓨]

/-- The feedback of round `n` is integrable when the expected conditional absolute mean
`𝔼[∫ ‖y‖ d(env.feedbackKernel O A Y n · (A n ·))]` is finite. -/
lemma IsAlgEnvSeq.integrable_feedback [SFinite P] [OpensMeasurableSpace 𝓨]
    [SecondCountableTopology 𝓨]
    (h : IsAlgEnvSeq O A Y alg env P) {n : ℕ}
    (hY : ∫⁻ ω, ∫⁻ y, ‖y‖ₑ ∂(env.feedbackKernel O A Y n ω (A n ω)) ∂P ≠ ∞) :
    Integrable (Y n) P := by
  refine ⟨(h.measurable_feedback n).aestronglyMeasurable, ?_⟩
  have h_eq := h.setLIntegral_comp_feedback (n := n) MeasurableSet.univ measurable_enorm
  simp only [Measure.restrict_univ] at h_eq
  rw [hasFiniteIntegral_iff_enorm, h_eq]
  exact hY.lt_top

variable [NormedSpace ℝ 𝓨]

/-- On an event `s` of `h.filtrationAction n` (determined by the history before round `n`, the
observation of round `n` and the action of round `n`), the expectation of the feedback `Y_n` is
that of its conditional mean `env.means O A Y (A n) n`. -/
lemma IsAlgEnvSeq.setIntegral_feedback [IsFiniteMeasure P] [BorelSpace 𝓨]
    [SecondCountableTopology 𝓨] [CompleteSpace 𝓨] (h : IsAlgEnvSeq O A Y alg env P) {n : ℕ}
    (hY : Integrable (Y n) P) {s : Set Ω} (hs : MeasurableSet[h.filtrationAction n] s) :
    ∫ ω in s, Y n ω ∂P = ∫ ω in s, env.means O A Y (A n ω) n ω ∂P := by
  rw [← setIntegral_condExp (h.filtrationAction.le n) hY hs]
  exact setIntegral_congr_ae (h.filtrationAction.le n _ hs) <| by
    filter_upwards [h.condExp_feedback n hY] with ω hω _ using hω

/-- Along a run of an algorithm, the mean `env.means O A Y a n` of the feedback of an action `a`
at round `n` is measurable with respect to the past of round `n`. -/
lemma IsAlgEnvSeq.measurable_means_filtrationObs [BorelSpace 𝓨] [SecondCountableTopology 𝓨]
    (h : IsAlgEnvSeq O A Y alg env P) {n : ℕ} (a : 𝓐) :
    Measurable[h.filtrationObs n] (env.means O A Y a n) := by
  rw [funext (Environment.means_eq_integral env O A Y a n), h.filtrationObs_eq_comap]
  exact ((stronglyMeasurable_id.integral_kernel (κ := env.feedback n)).measurable.comp
    measurable_prodMk_right).comp (measurable_iff_comap_le.2 le_rfl)

end Feedback

section Laws

variable {P : Measure Ω} [IsProbabilityMeasure P] {O : ℕ → Ω → 𝓞} {A : ℕ → Ω → 𝓐}
  {Y : ℕ → Ω → 𝓨}

/-- Along a run of an algorithm, the observation of round `n` has the same law as under the
trajectory measure of the algorithm and the environment. -/
lemma IsAlgEnvSeq.map_obs (h : IsAlgEnvSeq O A Y alg env P) (n : ℕ) :
    P.map (O n) = (trajMeasure alg env).map (IT.obs n) := by
  rw [← h.map_trajectory, Measure.map_map (IT.measurable_obs n) h.measurable_trajectory]
  simp only [Function.comp_def, trajectory, IT.obs, Round.obs_mk]

/-- Along a run of an algorithm, the observation and the action of round `n` have the same joint
law as under the trajectory measure of the algorithm and the environment. -/
lemma IsAlgEnvSeq.map_obs_action (h : IsAlgEnvSeq O A Y alg env P) (n : ℕ) :
    P.map (fun ω ↦ (O n ω, A n ω)) =
      (trajMeasure alg env).map fun ω ↦ (IT.obs n ω, IT.action n ω) := by
  rw [← h.map_trajectory, Measure.map_map
    ((IT.measurable_obs n).prodMk (IT.measurable_action n)) h.measurable_trajectory]
  simp only [Function.comp_def, trajectory, IT.obs, IT.action, Round.obs_mk, Round.action_mk]

end Laws

/-- On the event that the history of the first `M` rounds lies in a measurable set `s`, the law of
the history of the first `M + 1` rounds is the composition-product of the restriction to `s` of
the law of the history of the first `M` rounds with the step kernel of round `M`, read as a
history of `M + 1` rounds. -/
lemma IsAlgEnvSeq.map_restrict_history_succ {P : Measure Ω} [IsFiniteMeasure P]
    {O : ℕ → Ω → 𝓞} {X : ℕ → Ω → 𝓐} {Y : ℕ → Ω → 𝓨} (h : IsAlgEnvSeq O X Y alg env P) {M : ℕ}
    {s : Set (Hist 𝓞 𝓐 𝓨 M)} (hs : MeasurableSet s) :
    (P.restrict (history O X Y M ⁻¹' s)).map (history O X Y (M + 1)) =
      ((P.map (history O X Y M)).restrict s ⊗ₘ stepKernel alg env M).map
        (MeasurableEquiv.finSuccProd (Round 𝓞 𝓐 𝓨) M).symm := by
  rw [history_succ, ← Measure.map_map (MeasurableEquiv.finSuccProd _ M).symm.measurable
      ((h.measurable_history M).prodMk (h.measurable_step M)),
    ((h.hasCondDistrib_step M).restrict_preimage hs).map_eq,
    Measure.restrict_map (h.measurable_history M) hs]

variable {s : (n : ℕ) → Set (Hist 𝓞 𝓐 𝓨 n)} {hs : ∀ n, MeasurableSet (s n)}
  {env' : Environment 𝓞 𝓐 𝓨} {n : ℕ} {x : Hist 𝓞 𝓐 𝓨 n}

namespace Algorithm

open scoped Classical in
/-- The algorithm whose policy at round `n` is that of `alg` when the history of the previous
rounds belongs to `s n`, and that of `alg'` otherwise. -/
noncomputable def piecewise (s : (n : ℕ) → Set (Hist 𝓞 𝓐 𝓨 n)) (hs : ∀ n, MeasurableSet (s n))
    (alg alg' : Algorithm 𝓞 𝓐 𝓨) : Algorithm 𝓞 𝓐 𝓨 where
  policy n := Kernel.piecewise ((hs n).preimage measurable_fst) (alg.policy n) (alg'.policy n)

open scoped Classical in
@[simp]
lemma policy_piecewise (alg alg' : Algorithm 𝓞 𝓐 𝓨) (n : ℕ) :
    (alg.piecewise s hs alg').policy n =
      Kernel.piecewise ((hs n).preimage measurable_fst) (alg.policy n) (alg'.policy n) :=
  (rfl)

end Algorithm

namespace Environment

open scoped Classical in
/-- The environment whose observation and feedback kernels at round `n` are those of `env` when
the history of the previous rounds belongs to `s n`, and those of `env'` otherwise. -/
noncomputable def piecewise (s : (n : ℕ) → Set (Hist 𝓞 𝓐 𝓨 n)) (hs : ∀ n, MeasurableSet (s n))
    (env env' : Environment 𝓞 𝓐 𝓨) : Environment 𝓞 𝓐 𝓨 where
  obs n := Kernel.piecewise (hs n) (env.obs n) (env'.obs n)
  feedback n := Kernel.piecewise ((hs n).preimage (measurable_fst.comp measurable_fst))
    (env.feedback n) (env'.feedback n)

open scoped Classical in
@[simp]
lemma obs_piecewise (n : ℕ) :
    (env.piecewise s hs env').obs n = Kernel.piecewise (hs n) (env.obs n) (env'.obs n) :=
  (rfl)

open scoped Classical in
@[simp]
lemma feedback_piecewise (n : ℕ) :
    (env.piecewise s hs env').feedback n =
      Kernel.piecewise ((hs n).preimage (measurable_fst.comp measurable_fst))
        (env.feedback n) (env'.feedback n) :=
  (rfl)

end Environment

open scoped Classical in
/-- The step kernel of `alg.piecewise s hs alg'` against `env.piecewise s hs env'` at round `n` is
that of `(alg, env)` on `s n` and that of `(alg', env')` elsewhere. -/
lemma stepKernel_piecewise (alg alg' : Algorithm 𝓞 𝓐 𝓨) (n : ℕ) :
    stepKernel (alg.piecewise s hs alg') (env.piecewise s hs env') n =
      Kernel.piecewise (hs n) (stepKernel alg env n) (stepKernel alg' env' n) := by
  ext x : 1
  by_cases hx : x ∈ s n <;>
  · simp only [Kernel.piecewise_apply, hx, ↓reduceIte, stepKernel_def]
    exact Kernel.compProd_apply_congr (by simp [Kernel.piecewise_apply, hx])
      fun _ ↦ Kernel.compProd_apply_congr (by simp [Kernel.piecewise_apply, hx])
        fun _ ↦ by simp [Kernel.piecewise_apply, hx]

/-- At a history in `s n`, the step kernel of `alg.piecewise s hs alg'` against
`env.piecewise s hs env'` is that of `(alg, env)`. -/
@[simp]
lemma stepKernel_piecewise_of_mem (alg alg' : Algorithm 𝓞 𝓐 𝓨) (hx : x ∈ s n) :
    stepKernel (alg.piecewise s hs alg') (env.piecewise s hs env') n x =
      stepKernel alg env n x := by
  classical
  simp [stepKernel_piecewise, Kernel.piecewise_apply, hx]

/-- At a history outside `s n`, the step kernel of `alg.piecewise s hs alg'` against
`env.piecewise s hs env'` is that of `(alg', env')`. -/
@[simp]
lemma stepKernel_piecewise_of_notMem (alg alg' : Algorithm 𝓞 𝓐 𝓨) (hx : x ∉ s n) :
    stepKernel (alg.piecewise s hs alg') (env.piecewise s hs env') n x =
      stepKernel alg' env' n x := by
  classical
  simp [stepKernel_piecewise, Kernel.piecewise_apply, hx]

end Learning
