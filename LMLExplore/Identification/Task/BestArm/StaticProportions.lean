/-!
# Static proportions in two-armed best arm identification

Consider best arm identification with two arms in the same exponential family, generated by a
measure `ρ` with a statistic `T` that is not `ρ`-almost everywhere constant, with log-partition
function `ψ`, natural parameters `η(μ)` and divergence `d(x, μ)` in the mean parametrization. The
models are the vectors of means `μ : Fin 2 → ℝ` of the family, and arm `a` of `μ` has the member of
mean `μ a`. Let `μ 0 ≠ μ 1`, with natural parameters `η₀ = η(μ 0)` and `η₁ = η(μ 1)`.

The alternatives to `μ` are the vectors of means ordered the other way. For an allocation `w` of
the simplex, the cost of the alternatives with the alternative first,
`inf_{λ ∈ Alt(μ)} w 0 d(λ 0, μ 0) + w 1 d(λ 1, μ 1)`, is attained in the limit on the diagonal,
at `λ 0 = λ 1 = x(w) = ψ'(w 0 η₀ + w 1 η₁)`. It is at most the Chernoff information
`d(x*, μ 0) = d(x*, μ 1)` of the two arms, at the slope `x* = (ψ(η₀) - ψ(η₁)) / (η₀ - η₁)`, with
equality at the allocation `w*` with `w* 0 = (η(x*) - η₁) / (η₀ - η₁)`, for which `x(w*) = x*`.
Hence the static-proportions difficulty is `H^{sp}(μ)⁻¹ = d(x*, μ 0)` [D23, Lemma 19]: the best
error exponent of a static allocation is the Chernoff information of the two arms, the rate of the
lower bound of [KCG16, Theorems 12–13] for consistent algorithms. When the members
of means `μ 0` and `μ 1` are `c`-sub-Gaussian,
`H^{sp}(μ)⁻¹ ≥ max (d(μ 0, μ 1)², d(μ 1, μ 0)²) / (2 c (η₀ - η₁)²)` [D23, Lemma 20].

For two Gaussian arms with variance `σ²`, `H^{sp}(μ) = 8 σ² / (μ 0 - μ 1)²`, the characteristic
time of fixed-confidence identification
(`LMLExplore.Identification.charTime_baiTask_gaussianBandit_of_forall_eq_or_eq`). For two
Bernoulli arms, `H^{sp}(μ)⁻¹ = kl(z, μ 0) = kl(z, μ 1)` at the explicit Chernoff point
`z = log ((1 - μ 1) / (1 - μ 0)) / log (μ 0 (1 - μ 1) / ((1 - μ 0) μ 1))` [D23, Lemma 9].

## Main statements

* `LMLExplore.Identification.mem_alternatives_baiTask_two_iff`: the alternatives of two-armed best
  arm identification, for any mean functional.
* `LMLExplore.Identification.iInf_cost_baiTask_two`: [D23, Lemma 19], the infimum, attained in the
  limit on the diagonal.
* `LMLExplore.Identification.isMaxOn_iInf_cost_baiTask_two`: [D23, Lemma 19], the maximizer.
* `LMLExplore.Identification.inv_staticDifficulty_baiTask_two`: [D23, Lemma 19].
* `LMLExplore.Identification.ofReal_div_le_inv_staticDifficulty_baiTask_two`: [D23, Lemma 20].
* `LMLExplore.Identification.staticDifficulty_baiTask_gaussianBandit_two`: [D23, Lemma 20], two
  Gaussian arms.
* `LMLExplore.Identification.inv_staticDifficulty_baiTask_bernoulliBandit_two`: [D23, Lemma 9],
  two Bernoulli arms.

## References

* [D23] R. Degenne, *On the existence of a complexity in fixed budget bandit identification*,
  COLT 2023, arXiv:2303.09468v2.
* [KCG16] E. Kaufmann, O. Cappé and A. Garivier, *On the complexity of best-arm identification in
  multi-armed bandit models*, JMLR 17, 2016.
* Adapted from the formalization of [D23] in the project `RemyDegenne/Degenne2023Existence`
  (same author), files `Degenne2023Existence/ForLMLExplore/Identification/Task/BestArmTwo.lean`,
  `D2023/Lemma9.lean` and `D2023/Lemma20.lean`, commit `a4244176eae7d9dd79c5c082f361c3b3b2541c0f`.
-/

public section

open MeasureTheory ProbabilityTheory Measure Filter Topology Set

open scoped ENNReal NNReal

namespace LMLExplore.Identification

variable {Θ 𝓧 : Type*} {m𝓧 : MeasurableSpace 𝓧}

/-- In two-armed best arm identification, the alternatives to a model `θ` whose arms have distinct
means are the models whose arms are ordered the other way:
`(mean θ' 0 - mean θ' 1) (mean θ 0 - mean θ 1) < 0`. -/
lemma mem_alternatives_baiTask_two_iff (ν : Θ → Kernel (Fin 2) 𝓧) [∀ θ, IsMarkovKernel (ν θ)]
    (mean : Θ → Fin 2 → ℝ) {θ θ' : Θ} (hθ : mean θ 0 ≠ mean θ 1) :
    θ' ∈ (baiTask ν mean).alternatives θ ↔
      (mean θ' 0 - mean θ' 1) * (mean θ 0 - mean θ 1) < 0 := by
  simp only [IdentTask.mem_alternatives_iff, M_baiTask, correct_baiTask, Set.mem_ofPred_eq,
    Set.disjoint_left, Fin.forall_fin_two, Fin.exists_fin_two, ne_eq, mul_neg_iff, sub_pos,
    sub_neg]
  grind

variable (ν : (Fin 2 → ℝ) → Kernel (Fin 2) 𝓧) [∀ μ, IsMarkovKernel (ν μ)] {ρ : Measure 𝓧}
  {T : 𝓧 → ℝ} {μ : Fin 2 → ℝ} {w : Fin 2 → ℝ}

/-- For two-armed best arm identification with arms in the exponential family of `ρ` and `T`, the
transportation cost from a vector of means `μ'` to a vector of means `μ` with the allocation
`w ≥ 0` is `w 0 d(μ' 0, μ 0) + w 1 d(μ' 1, μ 1)`. -/
private lemma cost_baiTask_two
    (hν : ∀ μ a, μ a ∈ ρ.expFamilyMeans T → ν μ a = ρ.expFamily T (ρ.natParam T (μ a)))
    (hμ : ∀ a, μ a ∈ ρ.expFamilyMeans T) {μ' : Fin 2 → ℝ} (hμ' : ∀ a, μ' a ∈ ρ.expFamilyMeans T)
    (hw : 0 ≤ w) :
    (baiTask ν id).cost w μ' μ = ENNReal.ofReal (w 0 * ρ.expFamilyDiv T (μ' 0) (μ 0) +
      w 1 * ρ.expFamilyDiv T (μ' 1) (μ 1)) := by
  rw [IdentTask.cost_eq_sum_ofReal_mul (ν := ν) (S := fun _ ↦ ρ.expFamilyMeans T)
    (d := fun _ ↦ ρ.expFamilyDiv T) (ν_baiTask ν id) (fun μ'' hμ'' c ↦ ?_) hw hμ, Fin.sum_univ_two,
    ← ENNReal.ofReal_add (mul_nonneg (hw 0) (expFamilyDiv_nonneg (hμ' 0) (hμ 0)))
      (mul_nonneg (hw 1) (expFamilyDiv_nonneg (hμ' 1) (hμ 1)))]
  rw [hν _ _ (hμ' c), hν _ _ (hμ'' c), klDiv_expFamily_natParam (hμ' c) (hμ'' c)]

/-- **The infimum of the cost of the alternatives** [D23, Lemma 19]. For two-armed best arm
identification with arms in the exponential family of `ρ` and `T`, on the vectors of means of the
family, a vector of means `μ` with `μ 0 ≠ μ 1` and an allocation `w` of the simplex, the infimum
over the alternatives `λ` to `μ` of `w 0 d(λ 0, μ 0) + w 1 d(λ 1, μ 1)` is its value at the
diagonal point `λ 0 = λ 1 = x(w) = ψ'(w 0 η(μ 0) + w 1 η(μ 1))`, which is not an alternative: the
infimum is approached, but not attained, by alternatives. -/
theorem iInf_cost_baiTask_two (hT : ∀ c, ¬ T =ᵐ[ρ] fun _ ↦ c)
    (hν : ∀ μ a, μ a ∈ ρ.expFamilyMeans T → ν μ a = ρ.expFamily T (ρ.natParam T (μ a)))
    (hμ : ∀ a, μ a ∈ ρ.expFamilyMeans T) (hμ01 : μ 0 ≠ μ 1) (hw : w ∈ simplex (Fin 2)) :
    ⨅ μ' ∈ ((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans T}).alternatives μ,
        ((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans T}).cost w μ' μ =
      ENNReal.ofReal (w 0 * ρ.expFamilyDiv T
          (deriv (cgf T ρ) (w 0 * ρ.natParam T (μ 0) + w 1 * ρ.natParam T (μ 1))) (μ 0) +
        w 1 * ρ.expFamilyDiv T
          (deriv (cgf T ρ) (w 0 * ρ.natParam T (μ 0) + w 1 * ρ.natParam T (μ 1))) (μ 1)) := by
  obtain ⟨hw_nonneg, hw_sum⟩ := mem_simplex_iff.1 hw
  rw [Fin.sum_univ_two] at hw_sum
  set x := deriv (cgf T ρ) (w 0 * ρ.natParam T (μ 0) + w 1 * ρ.natParam T (μ 1))
  have hx : x ∈ ρ.expFamilyMeans T := deriv_cgf_mem_expFamilyMeans
    (mul_natParam_add_mul_natParam_mem_interior (hμ 0) (hμ 1) (hw_nonneg 0) (hw_nonneg 1) hw_sum)
  have hw0 : 0 ≤ w := hw_nonneg
  rw [IdentTask.alternatives_restrict, IdentTask.cost_restrict]
  refine le_antisymm ?_ (le_iInf₂ fun μ' hμ' ↦ ?_)
  · -- the alternatives `(x + t (μ 1 - μ 0), x + t (μ 0 - μ 1))`, `t > 0`, tend to `(x, x)`
    set μ' : ℝ → Fin 2 → ℝ := fun t ↦ ![x + t * (μ 1 - μ 0), x + t * (μ 0 - μ 1)]
    have h_cont (a : Fin 2) : ContinuousAt (fun t ↦ μ' t a) 0 := by
      fin_cases a <;> simp only [μ'] <;> fun_prop
    have h0 (a : Fin 2) : μ' 0 a = x := by fin_cases a <;> simp [μ']
    have h_means : ∀ᶠ t in 𝓝 (0 : ℝ), ∀ a, μ' t a ∈ ρ.expFamilyMeans T := by
      refine Filter.eventually_all.2 fun a ↦ (h_cont a).eventually ?_
      simp only [h0]
      exact expFamilyMeans_mem_nhds hT hx
    have h_alt : ∀ t > 0, μ' t ∈ (baiTask ν id).alternatives μ := fun t ht ↦ by
      rw [mem_alternatives_baiTask_two_iff ν id hμ01]
      have h_sq : 0 < (μ 0 - μ 1) ^ 2 := by have := sub_ne_zero.2 hμ01; positivity
      simp only [id, μ', Matrix.cons_val_zero, Matrix.cons_val_one]
      nlinarith
    have h_tendsto : Tendsto (fun t ↦ ENNReal.ofReal (w 0 * ρ.expFamilyDiv T (μ' t 0) (μ 0) +
        w 1 * ρ.expFamilyDiv T (μ' t 1) (μ 1))) (𝓝[>] 0)
        (𝓝 (ENNReal.ofReal (w 0 * ρ.expFamilyDiv T x (μ 0) +
          w 1 * ρ.expFamilyDiv T x (μ 1)))) := by
      refine (ENNReal.continuous_ofReal.tendsto _).comp (Tendsto.mono_left ?_ nhdsWithin_le_nhds)
      have h_div (a : Fin 2) :
          ContinuousAt (fun t ↦ ρ.expFamilyDiv T (μ' t a) (μ a)) 0 :=
        ContinuousAt.comp_of_eq (hasDerivAt_expFamilyDiv_left hT hx (μ a)).continuousAt
          (h_cont a) (h0 a)
      have := ((h_div 0).tendsto.const_mul (w 0)).add ((h_div 1).tendsto.const_mul (w 1))
      simpa only [h0] using this
    refine ge_of_tendsto h_tendsto ?_
    filter_upwards [self_mem_nhdsWithin, nhdsWithin_le_nhds h_means] with t ht h_mem
    rw [← cost_baiTask_two ν hν hμ h_mem hw0]
    exact iInf₂_le (μ' t) ⟨h_alt t ht, h_mem⟩
  · -- every alternative costs at least the cost of some point of the diagonal
    obtain ⟨hμ'_alt, hμ'_mem⟩ := hμ'
    have h_prod := (mem_alternatives_baiTask_two_iff ν id hμ01).1 hμ'_alt
    obtain ⟨z, hz, hz0, hz1⟩ := exists_expFamilyDiv_le_and_expFamilyDiv_le hT (hμ'_mem 0)
      (hμ'_mem 1) (hμ 0) (hμ 1) h_prod.le
    rw [cost_baiTask_two ν hν hμ hμ'_mem hw0]
    refine ENNReal.ofReal_le_ofReal ?_
    calc w 0 * ρ.expFamilyDiv T x (μ 0) + w 1 * ρ.expFamilyDiv T x (μ 1)
    _ ≤ w 0 * ρ.expFamilyDiv T z (μ 0) + w 1 * ρ.expFamilyDiv T z (μ 1) :=
      mul_expFamilyDiv_add_mul_expFamilyDiv_left_le hT (hμ 0) (hμ 1) (hw_nonneg 0) (hw_nonneg 1)
        hw_sum hz
    _ ≤ w 0 * ρ.expFamilyDiv T (μ' 0) (μ 0) + w 1 * ρ.expFamilyDiv T (μ' 1) (μ 1) := by
      gcongr
      · exact hw_nonneg 0
      · exact hw_nonneg 1

/-- For every allocation `w` of the simplex, the cost of the alternatives of two-armed best arm
identification is at most the Chernoff information `d(x*, μ 0)` of the two arms, at the slope
`x* = (ψ(η(μ 0)) - ψ(η(μ 1))) / (η(μ 0) - η(μ 1))`. -/
theorem iInf_cost_baiTask_two_le (hT : ∀ c, ¬ T =ᵐ[ρ] fun _ ↦ c)
    (hν : ∀ μ a, μ a ∈ ρ.expFamilyMeans T → ν μ a = ρ.expFamily T (ρ.natParam T (μ a)))
    (hμ : ∀ a, μ a ∈ ρ.expFamilyMeans T) (hμ01 : μ 0 ≠ μ 1) (hw : w ∈ simplex (Fin 2)) :
    ⨅ μ' ∈ ((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans T}).alternatives μ,
        ((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans T}).cost w μ' μ ≤
      ENNReal.ofReal (ρ.expFamilyDiv T ((cgf T ρ (ρ.natParam T (μ 0)) -
        cgf T ρ (ρ.natParam T (μ 1))) / (ρ.natParam T (μ 0) - ρ.natParam T (μ 1))) (μ 0)) := by
  obtain ⟨hw_nonneg, hw_sum⟩ := mem_simplex_iff.1 hw
  rw [Fin.sum_univ_two] at hw_sum
  have hη : ρ.natParam T (μ 0) ≠ ρ.natParam T (μ 1) := natParam_ne_natParam hT (hμ 0) (hμ 1) hμ01
  rw [iInf_cost_baiTask_two ν hT hν hμ hμ01 hw]
  refine ENNReal.ofReal_le_ofReal ?_
  refine (mul_expFamilyDiv_add_mul_expFamilyDiv_left_le hT (hμ 0) (hμ 1) (hw_nonneg 0)
    (hw_nonneg 1) hw_sum (slope_cgf_natParam_mem_expFamilyMeans hT (hμ 0) (hμ 1) hμ01)).trans_eq ?_
  rw [← expFamilyDiv_slope_eq hη, ← add_mul, hw_sum, one_mul]

/-- The allocation `w*` with `w* 0 = (η(x*) - η(μ 1)) / (η(μ 0) - η(μ 1))` and `w* 1 = 1 - w* 0`
belongs to the simplex, and the cost of the alternatives of two-armed best arm identification at
`w*` is the Chernoff information `d(x*, μ 0)`. -/
theorem iInf_cost_baiTask_two_of_eq (hT : ∀ c, ¬ T =ᵐ[ρ] fun _ ↦ c)
    (hν : ∀ μ a, μ a ∈ ρ.expFamilyMeans T → ν μ a = ρ.expFamily T (ρ.natParam T (μ a)))
    (hμ : ∀ a, μ a ∈ ρ.expFamilyMeans T) (hμ01 : μ 0 ≠ μ 1) {w₀ : ℝ}
    (hw₀ : w₀ = (ρ.natParam T ((cgf T ρ (ρ.natParam T (μ 0)) - cgf T ρ (ρ.natParam T (μ 1))) /
      (ρ.natParam T (μ 0) - ρ.natParam T (μ 1))) - ρ.natParam T (μ 1)) /
        (ρ.natParam T (μ 0) - ρ.natParam T (μ 1))) :
    ![w₀, 1 - w₀] ∈ simplex (Fin 2) ∧
      ⨅ μ' ∈ ((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans T}).alternatives μ,
          ((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans T}).cost ![w₀, 1 - w₀] μ' μ =
        ENNReal.ofReal (ρ.expFamilyDiv T ((cgf T ρ (ρ.natParam T (μ 0)) -
          cgf T ρ (ρ.natParam T (μ 1))) / (ρ.natParam T (μ 0) - ρ.natParam T (μ 1))) (μ 0)) := by
  have hη : ρ.natParam T (μ 0) ≠ ρ.natParam T (μ 1) := natParam_ne_natParam hT (hμ 0) (hμ 1) hμ01
  have hx := slope_cgf_natParam_mem_expFamilyMeans hT (hμ 0) (hμ 1) hμ01
  have hw₀_mem := natParam_slope_sub_div_mem_Ioo hT (hμ 0) (hμ 1) hμ01
  rw [← hw₀] at hw₀_mem
  have hw : ![w₀, 1 - w₀] ∈ simplex (Fin 2) := mem_simplex_iff.2
    ⟨Fin.forall_fin_two.2 ⟨hw₀_mem.1.le, by simpa using hw₀_mem.2.le⟩, by simp [Fin.sum_univ_two]⟩
  refine ⟨hw, ?_⟩
  rw [iInf_cost_baiTask_two ν hT hν hμ hμ01 hw]
  have h_nat : ![w₀, 1 - w₀] 0 * ρ.natParam T (μ 0) + ![w₀, 1 - w₀] 1 * ρ.natParam T (μ 1) =
      ρ.natParam T ((cgf T ρ (ρ.natParam T (μ 0)) - cgf T ρ (ρ.natParam T (μ 1))) /
        (ρ.natParam T (μ 0) - ρ.natParam T (μ 1))) := by
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, hw₀]
    field_simp [sub_ne_zero.2 hη]
    ring
  rw [h_nat, deriv_cgf_natParam hx, ← expFamilyDiv_slope_eq hη, ← add_mul]
  simp

/-- **The optimal static proportions** [D23, Lemma 19]. For two-armed best arm identification with
arms in the exponential family of `ρ` and `T`, on the vectors of means of the family, and a
vector of means `μ` with `μ 0 ≠ μ 1`, the cost of the alternatives
`w ↦ inf_{λ ∈ Alt(μ)} ∑ a, w a d(λ a, μ a)` is maximal on the simplex at `w*` with
`w* 0 = (η(x*) - η(μ 1)) / (η(μ 0) - η(μ 1))` and `w* 1 = 1 - w* 0`, where
`x* = (ψ(η(μ 0)) - ψ(η(μ 1))) / (η(μ 0) - η(μ 1))`. -/
theorem isMaxOn_iInf_cost_baiTask_two (hT : ∀ c, ¬ T =ᵐ[ρ] fun _ ↦ c)
    (hν : ∀ μ a, μ a ∈ ρ.expFamilyMeans T → ν μ a = ρ.expFamily T (ρ.natParam T (μ a)))
    (hμ : ∀ a, μ a ∈ ρ.expFamilyMeans T) (hμ01 : μ 0 ≠ μ 1) {w₀ : ℝ}
    (hw₀ : w₀ = (ρ.natParam T ((cgf T ρ (ρ.natParam T (μ 0)) - cgf T ρ (ρ.natParam T (μ 1))) /
      (ρ.natParam T (μ 0) - ρ.natParam T (μ 1))) - ρ.natParam T (μ 1)) /
        (ρ.natParam T (μ 0) - ρ.natParam T (μ 1))) :
    IsMaxOn (fun w ↦
        ⨅ μ' ∈ ((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans T}).alternatives μ,
          ((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans T}).cost w μ' μ)
      (simplex (Fin 2)) ![w₀, 1 - w₀] :=
  isMaxOn_iff.2 fun _ hw ↦ (iInf_cost_baiTask_two_le ν hT hν hμ hμ01 hw).trans_eq
    (iInf_cost_baiTask_two_of_eq ν hT hν hμ hμ01 hw₀).2.symm

/-- **The static-proportions difficulty of two-armed best arm identification** [D23, Lemma 19].
For two arms in the exponential family of `ρ` and `T`, best arm identification on the vectors of
means of the family, and a vector of means `μ` with `μ 0 ≠ μ 1`, `H^{sp}(μ)⁻¹ = d(x*, μ 0)`, the
Chernoff information of the two arms, at `x* = (ψ(η(μ 0)) - ψ(η(μ 1))) / (η(μ 0) - η(μ 1))`. -/
theorem inv_staticDifficulty_baiTask_two (hT : ∀ c, ¬ T =ᵐ[ρ] fun _ ↦ c)
    (hν : ∀ μ a, μ a ∈ ρ.expFamilyMeans T → ν μ a = ρ.expFamily T (ρ.natParam T (μ a)))
    (hμ : ∀ a, μ a ∈ ρ.expFamilyMeans T) (hμ01 : μ 0 ≠ μ 1) :
    (((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans T}).staticDifficulty μ)⁻¹ =
      ENNReal.ofReal (ρ.expFamilyDiv T ((cgf T ρ (ρ.natParam T (μ 0)) -
        cgf T ρ (ρ.natParam T (μ 1))) / (ρ.natParam T (μ 0) - ρ.natParam T (μ 1))) (μ 0)) := by
  obtain ⟨hw, h_eq⟩ := iInf_cost_baiTask_two_of_eq ν hT hν hμ hμ01 rfl
  rw [IdentTask.inv_staticDifficulty]
  exact le_antisymm (iSup₂_le fun _ hw ↦ iInf_cost_baiTask_two_le ν hT hν hμ hμ01 hw)
    (le_iSup₂_of_le _ hw h_eq.ge)

/-- **Lower bound for two sub-Gaussian arms** [D23, Lemma 20]. In the setting of
`inv_staticDifficulty_baiTask_two`, if the statistic is `c`-sub-Gaussian around `μ a` under the
member of mean `μ a`, for both arms, then
`max (d(μ 0, μ 1)², d(μ 1, μ 0)²) / (2 c (η(μ 0) - η(μ 1))²) ≤ H^{sp}(μ)⁻¹`: the Chernoff point
`x*` is at distance `d(μ 0, μ 1) / |η(μ 0) - η(μ 1)|` from `μ 0` and
`d(μ 1, μ 0) / |η(μ 0) - η(μ 1)|` from `μ 1`. -/
theorem ofReal_div_le_inv_staticDifficulty_baiTask_two (hT : ∀ c, ¬ T =ᵐ[ρ] fun _ ↦ c)
    (hν : ∀ μ a, μ a ∈ ρ.expFamilyMeans T → ν μ a = ρ.expFamily T (ρ.natParam T (μ a)))
    (hμ : ∀ a, μ a ∈ ρ.expFamilyMeans T) (hμ01 : μ 0 ≠ μ 1) {c : ℝ≥0}
    (hsub : ∀ a, HasSubgaussianMGF (fun x ↦ T x - μ a) c (ρ.expFamily T (ρ.natParam T (μ a)))) :
    ENNReal.ofReal (max (ρ.expFamilyDiv T (μ 0) (μ 1) ^ 2) (ρ.expFamilyDiv T (μ 1) (μ 0) ^ 2) /
        (2 * c * (ρ.natParam T (μ 0) - ρ.natParam T (μ 1)) ^ 2)) ≤
      (((baiTask ν id).restrict {μ | ∀ a, μ a ∈ ρ.expFamilyMeans T}).staticDifficulty μ)⁻¹ := by
  have hη : ρ.natParam T (μ 0) ≠ ρ.natParam T (μ 1) := natParam_ne_natParam hT (hμ 0) (hμ 1) hμ01
  have hx := slope_cgf_natParam_mem_expFamilyMeans hT (hμ 0) (hμ 1) hμ01
  rw [inv_staticDifficulty_baiTask_two ν hT hν hμ hμ01]
  refine ENNReal.ofReal_le_ofReal ?_
  rw [← max_div_div_right (by positivity)]
  refine max_le ?_ ?_
  · calc ρ.expFamilyDiv T (μ 0) (μ 1) ^ 2 / (2 * c * (ρ.natParam T (μ 0) - ρ.natParam T (μ 1)) ^ 2)
    _ = ((cgf T ρ (ρ.natParam T (μ 0)) - cgf T ρ (ρ.natParam T (μ 1))) /
          (ρ.natParam T (μ 0) - ρ.natParam T (μ 1)) - μ 0) ^ 2 / (2 * c) := by
      rw [slope_cgf_natParam_eq_sub hη, sub_sub_cancel_left, neg_sq, div_pow, div_div,
        mul_comm (_ ^ 2)]
    _ ≤ _ := sq_div_le_expFamilyDiv_of_hasSubgaussianMGF hx (hμ 0) (hsub 0)
  · calc ρ.expFamilyDiv T (μ 1) (μ 0) ^ 2 / (2 * c * (ρ.natParam T (μ 0) - ρ.natParam T (μ 1)) ^ 2)
    _ = ((cgf T ρ (ρ.natParam T (μ 0)) - cgf T ρ (ρ.natParam T (μ 1))) /
          (ρ.natParam T (μ 0) - ρ.natParam T (μ 1)) - μ 1) ^ 2 / (2 * c) := by
      rw [slope_cgf_natParam_eq_add hη, add_sub_cancel_left, div_pow, div_div,
        mul_comm (_ ^ 2)]
    _ ≤ _ := sq_div_le_expFamilyDiv_of_hasSubgaussianMGF hx (hμ 1) (hsub 1)
    _ = _ := (expFamilyDiv_slope_eq hη).symm

/-! ### Gaussian and Bernoulli arms -/

/-- **Two Gaussian arms** [D23, Lemma 20]. For best arm identification with two Gaussian arms of
variance `σ2 ≠ 0` and a vector of means `μ` with `μ 0 ≠ μ 1`, the static-proportions difficulty is
`H^{sp}(μ) = 8 σ2 / (μ 0 - μ 1)²`: the Chernoff point is the midpoint of the two means. -/
theorem staticDifficulty_baiTask_gaussianBandit_two {σ2 : ℝ≥0} (hσ2 : σ2 ≠ 0) (hμ01 : μ 0 ≠ μ 1) :
    (baiTask (Bandits.gaussianBandit · σ2) id).staticDifficulty μ =
      ENNReal.ofReal (8 * σ2 / (μ 0 - μ 1) ^ 2) := by
  have hσ2' : (σ2 : ℝ) ≠ 0 := NNReal.coe_ne_zero.2 hσ2
  have hΔ : 0 < (μ 0 - μ 1) ^ 2 := by have := sub_ne_zero.2 hμ01; positivity
  have hT := not_ae_eq_const_gaussianReal 0 hσ2
  have hμ (a : Fin 2) := mem_expFamilyMeans_gaussianReal 0 hσ2 (μ a)
  have hη : (gaussianReal 0 σ2).natParam id (μ 0) ≠ (gaussianReal 0 σ2).natParam id (μ 1) :=
    natParam_ne_natParam hT (hμ 0) (hμ 1) hμ01
  have h := inv_staticDifficulty_baiTask_two (Bandits.gaussianBandit · σ2) hT
    (fun μ a _ ↦ by rw [Bandits.gaussianBandit_apply, expFamily_natParam_gaussianReal 0 hσ2]) hμ
    hμ01
  -- the Chernoff point is the midpoint `(μ 0 + μ 1) / 2`, at divergence `(μ 0 - μ 1)² / (8 σ2)`
  have h_val : (gaussianReal 0 σ2).expFamilyDiv id ((cgf id (gaussianReal 0 σ2)
      ((gaussianReal 0 σ2).natParam id (μ 0)) - cgf id (gaussianReal 0 σ2)
        ((gaussianReal 0 σ2).natParam id (μ 1))) / ((gaussianReal 0 σ2).natParam id (μ 0) -
          (gaussianReal 0 σ2).natParam id (μ 1))) (μ 0) = (μ 0 - μ 1) ^ 2 / (8 * σ2) := by
    rw [slope_cgf_natParam_eq_sub hη]
    simp only [expFamilyDiv_gaussianReal 0 hσ2, natParam_gaussianReal 0 hσ2]
    field_simp [sub_ne_zero.2 hμ01]
    ring
  rw [setOf_forall_mem_expFamilyMeans_gaussianReal 0 hσ2, IdentTask.restrict_univ, h_val] at h
  rw [← inv_inv ((baiTask (Bandits.gaussianBandit · σ2) id).staticDifficulty μ), h,
    ← ENNReal.ofReal_inv_of_pos (by positivity), inv_div]

/-- **Two Bernoulli arms** [D23, Lemma 9]. For best arm identification on the Bernoulli bandits
with two arms and means in `(0, 1)`, and a vector of means `μ` with `μ 0 ≠ μ 1`,
`H^{sp}(μ)⁻¹ = kl(z, μ 0) = kl(z, μ 1)`, the Chernoff information of the two Bernoulli laws, at
`z = log ((1 - μ 1) / (1 - μ 0)) / log (μ 0 (1 - μ 1) / ((1 - μ 0) μ 1))`. -/
theorem inv_staticDifficulty_baiTask_bernoulliBandit_two (hμ : ∀ a, μ a ∈ Ioo 0 1)
    (hμ01 : μ 0 ≠ μ 1) {z : ℝ}
    (hz : z = Real.log ((1 - μ 1) / (1 - μ 0)) / Real.log (μ 0 * (1 - μ 1) / ((1 - μ 0) * μ 1))) :
    (((baiTask (fun μ : Fin 2 → ℝ ↦ Bandits.bernoulliBandit fun c ↦
        projIcc 0 1 zero_le_one (μ c)) id).restrict
          {μ | ∀ c, μ c ∈ Ioo 0 1}).staticDifficulty μ)⁻¹ = klBer z (μ 0) ∧
      (((baiTask (fun μ : Fin 2 → ℝ ↦ Bandits.bernoulliBandit fun c ↦
        projIcc 0 1 zero_le_one (μ c)) id).restrict
          {μ | ∀ c, μ c ∈ Ioo 0 1}).staticDifficulty μ)⁻¹ = klBer z (μ 1) := by
  -- the Bernoulli laws of means in `(0, 1)` are the exponential family of `Ber(1/2)`
  set ρ := Ber((1 : ℝ), 0, unitInterval.sigmoid 0)
  have hmeans : ρ.expFamilyMeans id = Ioo 0 1 := expFamilyMeans_bernoulliMeasure_sigmoid 0
  have hT : ∀ c, ¬ id =ᵐ[ρ] fun _ ↦ c := not_ae_eq_const_bernoulliMeasure
    (by simp only [unitInterval.coe_sigmoid, Real.sigmoid_zero]; norm_num)
  have hμ' : ∀ a, μ a ∈ ρ.expFamilyMeans id := by rwa [hmeans]
  have hη : ρ.natParam id (μ 0) ≠ ρ.natParam id (μ 1) :=
    natParam_ne_natParam hT (hμ' 0) (hμ' 1) hμ01
  have h := inv_staticDifficulty_baiTask_two
    (fun μ : Fin 2 → ℝ ↦ Bandits.bernoulliBandit fun c ↦ projIcc 0 1 zero_le_one (μ c)) hT
    (fun μ a ha ↦ by
      rw [hmeans] at ha
      rw [Bandits.bernoulliBandit_apply, expFamily_natParam_bernoulliMeasure_sigmoid 0 ha,
        projIcc_of_mem _ (Ioo_subset_Icc_self ha)]) hμ' hμ01
  simp only [hmeans] at h
  -- the natural parameter of `m` is `log (m / (1 - m))`, and `ψ(η(m)) = log (1 / (2 (1 - m)))`
  have hξ (a : Fin 2) : ρ.natParam id (μ a) = Real.log (μ a / (1 - μ a)) := by
    have h_sig := deriv_cgf_natParam (hμ' a)
    rw [deriv_cgf_bernoulliMeasure_sigmoid, zero_add] at h_sig
    rw [← Real.log_sigmoid_div_one_sub (ρ.natParam id (μ a)), h_sig]
  have hψ (a : Fin 2) : cgf id ρ (ρ.natParam id (μ a)) = Real.log (1 / (2 * (1 - μ a))) := by
    have h1 : 0 < 1 - μ a := sub_pos.2 (hμ a).2
    rw [hξ, TauCeti.Probability.cgf_id_bernoulliMeasure, unitInterval.coe_sigmoid,
      Real.sigmoid_zero, Real.exp_log (div_pos (hμ a).1 h1)]
    congr 1
    field_simp
    ring
  have hx : (cgf id ρ (ρ.natParam id (μ 0)) - cgf id ρ (ρ.natParam id (μ 1))) /
      (ρ.natParam id (μ 0) - ρ.natParam id (μ 1)) = z := by
    have h0 : 0 < 1 - μ 0 := sub_pos.2 (hμ 0).2
    have h1 : 0 < 1 - μ 1 := sub_pos.2 (hμ 1).2
    rw [hψ, hψ, hξ, hξ, ← Real.log_div (by positivity) (by positivity),
      ← Real.log_div (div_pos (hμ 0).1 h0).ne' (div_pos (hμ 1).1 h1).ne', hz]
    congr 2 <;> field_simp
  have hz_mem : z ∈ Ioo 0 1 := by
    rw [← hx, ← hmeans]
    exact slope_cgf_natParam_mem_expFamilyMeans hT (hμ' 0) (hμ' 1) hμ01
  have h_kl (a : Fin 2) : klBer z (μ a) = ENNReal.ofReal (ρ.expFamilyDiv id z (μ a)) := by
    rw [expFamilyDiv_bernoulliMeasure_sigmoid 0 hz_mem (hμ a),
      klBer_eq_ofReal_klBerReal (Ioo_subset_Icc_self hz_mem) (Ioo_subset_Icc_self (hμ a))
        (klBer_ne_top (hμ a))]
  refine ⟨?_, ?_⟩
  · rw [h, hx, h_kl]
  · rw [h, expFamilyDiv_slope_eq hη, hx, h_kl]

end LMLExplore.Identification
