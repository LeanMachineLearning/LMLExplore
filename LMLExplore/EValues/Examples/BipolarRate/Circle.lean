/-!
# One observation without evidence, at a positive bipolar rate, on the circle

On the circle `UnitAddCircle = ℝ / ℤ` with Lebesgue measure `volume`, and for `ε ≤ 1`, consider
the i.i.d. null generated by the mixtures `(1 - ε) U + ε volume`, with `U` the uniform law
`uniformOn` on a finite coset `x₀ + (1 / N) ℤ` of the circle, written
`{x | x - x₀ ∈ AddSubgroup.zmultiples (1 / N)}` (for `N = 0` it is the point `x₀`, as for
`N = 1`, since `0⁻¹ = 0`). Then:

* one observation carries no evidence against the null: `maxLogGrowth volume S 1 = 0`, since
  Lebesgue measure is the average over `x₀` of the members `(1 - ε) δ_{x₀} + ε volume`;
* the bipolar rate and the smallest relative entropy from `volume` to the null are both
  `log (1 / ε)` (infinite for `ε = 0`).

So the bipolar rate equals the smallest relative entropy to the null, although, for `ε < 1`, the
smallest relative entropy, as a function of the law, is not lower semicontinuous at `volume` for
the topology of the integrals of bounded measurable functions, which
`ProbabilityTheory.bipolarRate_eq_klInf_of_forall_exists_forall_le` [RR26, Theorem 4.1]
assumes: the laws `(1 - ε) U + ε volume` approach `volume` in that topology (this is not proved
here), and one observation cannot tell them from `volume`. The larger null of the mixtures
`(1 - ε) F + ε volume` with `F` any finitely supported law has the same smallest relative entropy
but bipolar rate `0` (`ProbabilityTheory.bipolarRate_finitelySupported_mixtures_eq_zero`).

## Main statements

* `ProbabilityTheory.maxLogGrowth_one_coset_mixtures_eq_zero`: one observation carries no
  evidence.
* `ProbabilityTheory.bipolarRate_coset_mixtures`: the bipolar rate is `log (1 / ε)`.
* `ProbabilityTheory.klInf_coset_mixtures`: the smallest relative entropy from `volume` to
  the null is `log (1 / ε)`.

## Implementation notes

The lower bound on the bipolar rate tests the tuples whose pairwise differences are irrational,
which have probability `1` under `volume ^ n`. Under the `n`-fold product of a member of the null,
two coordinates drawn from the coset part differ by a rational, so such a tuple has at most one
coordinate in the coset: its probability is at most `n ε ^ (n - 1)`. The indicator of these
tuples divided by `n ε ^ (n - 1)` is an `n`-sample e-variable with expected logarithm
`(n - 1) log (1 / ε) - log n`.

The instance is [EVR26, Note 19]. Its statements and proofs are adapted from
`EValuesResearch/Results/RateVersusKL.lean` (commit `dd4072f`) in the paper project
`RemyDegenne/evalues_research` (same author), which defines the coset law and the null instead
of writing them in the statements.

## References

* [EVR26] *Answers to open questions in e-values and anytime-valid inference*, notes 01 to 34 and
  the Lean library `EValuesResearch` of github.com/RemyDegenne/evalues_research, 2026.
* [RR26] A. Ram and A. Ramdas, *The optimal betting wealth growth rate*, arXiv:2604.25280v1.
-/

public section

open MeasureTheory InformationTheory
open scoped ENNReal

namespace ProbabilityTheory

variable {ε : ℝ≥0∞}

/-! ### Rational differences -/

/-- The image of the rationals in the circle. -/
private def ratCircle : Set UnitAddCircle := Set.range fun q : ℚ ↦ ((q : ℝ) : UnitAddCircle)

/-- The tuples of points of the circle whose pairwise differences are irrational. -/
private def pairwiseIrrational (n : ℕ) : Set (Fin n → UnitAddCircle) :=
  {x | ∀ i j, i ≠ j → x i - x j ∉ ratCircle}

/-- The tuples with pairwise irrational differences form a measurable set. -/
private lemma measurableSet_pairwiseIrrational (n : ℕ) :
    MeasurableSet (pairwiseIrrational n) := by
  have h : pairwiseIrrational n =
      ⋂ i, ⋂ j, ⋂ (_ : i ≠ j), (fun x : Fin n → UnitAddCircle ↦ x i - x j) ⁻¹' ratCircleᶜ := by
    ext x
    simp [pairwiseIrrational]
  rw [h]
  exact .iInter fun i ↦ .iInter fun j ↦ .iInter fun _ ↦
    ((measurable_pi_apply i).sub (measurable_pi_apply j))
      (Set.countable_range _).measurableSet.compl

/-- An i.i.d. uniform sample on the circle has pairwise irrational differences almost surely. -/
private lemma volume_pi_compl_pairwiseIrrational (n : ℕ) :
    (Measure.pi fun _ : Fin n ↦ (volume : Measure UnitAddCircle)) (pairwiseIrrational n)ᶜ = 0 := by
  have h : (pairwiseIrrational n)ᶜ =
      ⋃ i, ⋃ j, ⋃ (_ : i ≠ j), {x : Fin n → UnitAddCircle | x i - x j ∈ ratCircle} := by
    ext x
    simp [pairwiseIrrational]
  rw [h]
  refine measure_iUnion_null fun i ↦ measure_iUnion_null fun j ↦ measure_iUnion_null fun hij ↦ ?_
  -- the pair of coordinates `(x i, x j)` has law `volume ⊗ volume`
  have hσ : Function.Injective ![i, j] := by
    intro a b hab
    fin_cases a <;> fin_cases b <;> simp_all [eq_comm]
  have hmp := (measurePreserving_finTwoArrow (volume : Measure UnitAddCircle)).comp
    (⟨by fun_prop, Measure.pi_map_comp_of_injective _ hσ⟩ :
      MeasurePreserving (fun x : Fin n → UnitAddCircle ↦ fun k ↦ x (![i, j] k))
        (Measure.pi fun _ ↦ volume) (Measure.pi fun _ ↦ volume))
  have hs : MeasurableSet {p : UnitAddCircle × UnitAddCircle | p.1 - p.2 ∈ ratCircle} :=
    (measurable_fst.sub measurable_snd) (Set.countable_range _).measurableSet
  have h := hmp.measure_preimage hs.nullMeasurableSet
  simp only [Set.preimage_ofPred_eq, Function.comp_apply, MeasurableEquiv.finTwoArrow_apply,
    Matrix.cons_val_zero, Matrix.cons_val_one] at h
  rw [h, Measure.prod_apply_symm hs]
  refine lintegral_eq_zero_of_ae_eq_zero (.of_forall fun y ↦ ?_)
  -- for fixed `y`, the points `x` with `x - y` rational form a countable set
  exact ((Set.countable_range _).preimage (sub_left_injective (b := y))).measure_zero _

/-- Under the `n`-fold product of a law that gives mass at least `1 - ε` to a set `C` whose
points differ by rationals, the tuples with pairwise irrational differences have at most one
coordinate in `C`, hence probability at most `n ε ^ (n - 1)`. -/
private lemma measure_pi_pairwiseIrrational_le {P : Measure UnitAddCircle}
    [IsProbabilityMeasure P] {C : Set UnitAddCircle} (hPC : P Cᶜ ≤ ε)
    (hC : ∀ a ∈ C, ∀ b ∈ C, a - b ∈ ratCircle) {n : ℕ} (hn : n ≠ 0) :
    (Measure.pi fun _ : Fin n ↦ P) (pairwiseIrrational n) ≤ n * ε ^ (n - 1) := by
  classical
  have hsub : pairwiseIrrational n ⊆
      ⋃ k, Set.univ.pi (Function.update (fun _ : Fin n ↦ Cᶜ) k Set.univ) := by
    intro x hx
    -- `k` is the coordinate in `C`, if there is one
    obtain ⟨k, hk⟩ : ∃ k, ∀ i ≠ k, x i ∉ C := by
      by_cases h : ∃ k, x k ∈ C
      · obtain ⟨k, hk⟩ := h
        exact ⟨k, fun i hik hi ↦ hx i k hik (hC _ hi _ hk)⟩
      · push Not at h
        exact ⟨⟨0, Nat.pos_of_ne_zero hn⟩, fun i _ ↦ h i⟩
    refine Set.mem_iUnion.2 ⟨k, fun i _ ↦ ?_⟩
    by_cases hik : i = k
    · subst hik
      simp
    · rw [Function.update_of_ne hik]
      exact hk i hik
  calc (Measure.pi fun _ : Fin n ↦ P) (pairwiseIrrational n)
  _ ≤ ∑ k, (Measure.pi fun _ : Fin n ↦ P)
      (Set.univ.pi (Function.update (fun _ : Fin n ↦ Cᶜ) k Set.univ)) :=
    (measure_mono hsub).trans (measure_iUnion_fintype_le _ _)
  _ ≤ ∑ _k : Fin n, ε ^ (n - 1) := by
    refine Finset.sum_le_sum fun k _ ↦ ?_
    rw [Measure.pi_pi]
    simp_rw [Function.apply_update (fun _ s ↦ P s)]
    have hcard : (Finset.univ \ {k}).card = n - 1 := by simp [Finset.card_sdiff]
    rw [Finset.prod_update_of_mem (Finset.mem_univ k), measure_univ, one_mul, Finset.prod_const,
      hcard]
    gcongr
  _ = n * ε ^ (n - 1) := by simp

/-- For a null whose members give mass at least `1 - ε` to sets whose points differ by
rationals, the indicator of the tuples with pairwise irrational differences, divided by
`n ε ^ (n - 1)`, gives the lower bound `log (1 / (n ε ^ (n - 1)))` on the growth of `n`
observations. -/
private lemma log_le_maxLogGrowth {S : Set (Measure UnitAddCircle)}
    (hS : ∀ P ∈ S, IsProbabilityMeasure P)
    (hSC : ∀ P ∈ S, ∃ C, P Cᶜ ≤ ε ∧ ∀ a ∈ C, ∀ b ∈ C, a - b ∈ ratCircle) {n : ℕ} (hn : n ≠ 0) :
    ENNReal.log ((n * ε ^ (n - 1))⁻¹) ≤ maxLogGrowth volume S n := by
  set c := ((n : ℝ≥0∞) * ε ^ (n - 1))⁻¹
  have hA := measurableSet_pairwiseIrrational n
  have hX : IsEVar ((pairwiseIrrational n).indicator fun _ ↦ c) (sampleNull S n) := by
    refine ⟨measurable_const.indicator hA, forall_mem_sampleNull.2 fun P hP ↦ ?_⟩
    have := hS P hP
    obtain ⟨C, hPC, hC⟩ := hSC P hP
    rw [lintegral_indicator_const hA]
    calc c * (Measure.pi fun _ : Fin n ↦ P) (pairwiseIrrational n)
    _ ≤ c * (n * ε ^ (n - 1)) := by gcongr; exact measure_pi_pairwiseIrrational_le hPC hC hn
    _ ≤ 1 := ENNReal.inv_mul_le_one _
  rw [maxLogGrowth_def]
  refine le_of_eq_of_le ?_ (hX.eintegral_log_le_maxEPower _)
  simpa [Function.comp_def, logUtility_apply] using
    (logUtility.eintegral_comp_indicator_const (volume_pi_compl_pairwiseIrrational n) c).symm

/-! ### The cosets -/

/-- The subgroup `(1 / N) ℤ` of the circle is contained in the image of the rationals. -/
private lemma zmultiples_subset_ratCircle (N : ℕ) :
    (AddSubgroup.zmultiples (((N : ℝ)⁻¹ : ℝ) : UnitAddCircle) : Set UnitAddCircle) ⊆
      ratCircle := by
  rintro _ ⟨k, rfl⟩
  refine ⟨(k : ℚ) / N, ?_⟩
  beta_reduce
  rw [← AddCircle.coe_zsmul, zsmul_eq_mul]
  congr 1
  push_cast
  ring

/-- The coset `x₀ + (1 / N) ℤ` of the circle is finite. -/
lemma finite_coset (x₀ : UnitAddCircle) (N : ℕ) :
    {x | x - x₀ ∈ AddSubgroup.zmultiples (((N : ℝ)⁻¹ : ℝ) : UnitAddCircle)}.Finite := by
  have h : IsOfFinAddOrder (((N : ℝ)⁻¹ : ℝ) : UnitAddCircle) := by
    rcases eq_or_ne N 0 with rfl | hN
    · simp
    refine isOfFinAddOrder_iff_nsmul_eq_zero.2 ⟨N, Nat.pos_of_ne_zero hN, ?_⟩
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul, mul_inv_cancel₀ (Nat.cast_ne_zero.2 hN)]
    exact AddCircle.coe_period 1
  have := h.finite_zmultiples
  exact (Set.toFinite _).preimage (sub_left_injective.injOn)

/-- The members of the coset null are probability measures. -/
lemma isProbabilityMeasure_coset_mixture (hε : ε ≤ 1) (x₀ : UnitAddCircle) (N : ℕ) :
    IsProbabilityMeasure ((1 - ε) • uniformOn {x | x - x₀ ∈ AddSubgroup.zmultiples
      (((N : ℝ)⁻¹ : ℝ) : UnitAddCircle)} + ε • volume) := by
  have := isProbabilityMeasure_uniformOn (finite_coset x₀ N) ⟨x₀, by simp⟩
  exact ⟨by simp [tsub_add_cancel_of_le hε]⟩

/-- For `N = 1`, the coset `x₀ + ℤ` of the circle is the point `x₀`. -/
private lemma uniformOn_coset_one (x₀ : UnitAddCircle) :
    uniformOn {x | x - x₀ ∈ AddSubgroup.zmultiples ((((1 : ℕ) : ℝ)⁻¹ : ℝ) : UnitAddCircle)} =
      Measure.dirac x₀ := by
  classical
  have h1 : ((1 : ℝ) : UnitAddCircle) = 0 := AddCircle.coe_period 1
  have h : {x | x - x₀ ∈ AddSubgroup.zmultiples ((((1 : ℕ) : ℝ)⁻¹ : ℝ) : UnitAddCircle)} =
      {x₀} := by
    ext x
    simp [h1, sub_eq_zero]
  ext t ht
  rw [h, uniformOn_singleton, Measure.dirac_apply' _ ht]
  by_cases hx : x₀ ∈ t <;> simp [hx]

/-! ### The coset null -/

/-- **One observation carries no evidence** against the null generated by the mixtures
`(1 - ε) U + ε volume` on the circle, with `U` uniform on a coset `x₀ + (1 / N) ℤ`: the maximal
expected logarithm of an e-variable under Lebesgue measure is `0`. -/
theorem maxLogGrowth_one_coset_mixtures_eq_zero (hε : ε ≤ 1) :
    maxLogGrowth volume {(1 - ε) • uniformOn {x | x - x₀ ∈ AddSubgroup.zmultiples
      (((N : ℝ)⁻¹ : ℝ) : UnitAddCircle)} + ε • volume |
      (x₀ : UnitAddCircle) (N : ℕ)} 1 = 0 := by
  rw [maxLogGrowth_one]
  refine maxEPower_eq_zero_of_mem_effectiveSet (by
    rintro _ ⟨x, N, rfl⟩
    exact (isProbabilityMeasure_coset_mixture hε x N).measure_univ.le) fun X hX ↦ ?_
  set c := ∫⁻ x, X x ∂(volume : Measure UnitAddCircle)
  -- Lebesgue measure is the average over `x` of the members `(1 - ε) δ_x + ε volume`
  have hx (x : UnitAddCircle) : (1 - ε) * X x + ε * c ≤ 1 := by
    have := isProbabilityMeasure_coset_mixture hε x 1
    have h := hX.lintegral_le_one ⟨x, 1, rfl⟩
    rw [uniformOn_coset_one] at h
    simpa [c, lintegral_add_measure, tsub_add_cancel_of_le hε] using h
  calc c
  _ = ((1 - ε) + ε) * c := by rw [tsub_add_cancel_of_le hε, one_mul]
  _ = ∫⁻ x, ((1 - ε) * X x + ε * c) ∂(volume : Measure UnitAddCircle) := by
    simp [c, lintegral_add_right _ measurable_const, lintegral_const_mul _ hX.measurable, add_mul]
  _ ≤ ∫⁻ _, 1 ∂(volume : Measure UnitAddCircle) := lintegral_mono hx
  _ = 1 := by simp

/-- The smallest relative entropy from Lebesgue measure on the circle to the mixtures
`(1 - ε) U + ε volume`, with `U` uniform on a coset `x₀ + (1 / N) ℤ`, is `log (1 / ε)`: each `U`
is singular to Lebesgue measure. -/
theorem klInf_coset_mixtures (hε : ε ≤ 1) :
    klInf volume {(1 - ε) • uniformOn {x | x - x₀ ∈ AddSubgroup.zmultiples
      (((N : ℝ)⁻¹ : ℝ) : UnitAddCircle)} + ε • volume |
      (x₀ : UnitAddCircle) (N : ℕ)} = ENNReal.log ε⁻¹ := by
  refine klInf_mixture_of_mutuallySingular ⟨_, 0, 0, rfl⟩ ?_ hε
  rintro _ ⟨x₀, N, rfl⟩
  have hfin := finite_coset x₀ N
  refine ⟨_, isProbabilityMeasure_uniformOn hfin ⟨x₀, by simp⟩,
    ⟨_, hfin.measurableSet.compl, ?_, ?_⟩, rfl⟩
  · exact (uniformOn_eq_zero_iff hfin).2 (Set.inter_compl_self _)
  · rw [compl_compl]
    exact hfin.measure_zero _

/-- The bipolar rate of Lebesgue measure on the circle against the mixtures `(1 - ε) U + ε volume`,
with `U` uniform on a coset `x₀ + (1 / N) ℤ`, is `log (1 / ε)`, the smallest relative entropy to
the null (`ProbabilityTheory.klInf_coset_mixtures`). -/
theorem bipolarRate_coset_mixtures (hε : ε ≤ 1) :
    bipolarRate volume {(1 - ε) • uniformOn {x | x - x₀ ∈ AddSubgroup.zmultiples
      (((N : ℝ)⁻¹ : ℝ) : UnitAddCircle)} + ε • volume |
      (x₀ : UnitAddCircle) (N : ℕ)} = ENNReal.log ε⁻¹ := by
  set S := {(1 - ε) • uniformOn {x | x - x₀ ∈ AddSubgroup.zmultiples
      (((N : ℝ)⁻¹ : ℝ) : UnitAddCircle)} + ε • volume | (x₀ : UnitAddCircle) (N : ℕ)}
  have hS : ∀ P ∈ S, IsProbabilityMeasure P := by
    rintro _ ⟨x₀, N, rfl⟩
    exact isProbabilityMeasure_coset_mixture hε x₀ N
  have hSC : ∀ P ∈ S, ∃ C, P Cᶜ ≤ ε ∧ ∀ a ∈ C, ∀ b ∈ C, a - b ∈ ratCircle := by
    rintro _ ⟨x₀, N, rfl⟩
    refine ⟨{x | x - x₀ ∈ AddSubgroup.zmultiples (((N : ℝ)⁻¹ : ℝ) : UnitAddCircle)}, ?_,
      fun a ha b hb ↦ zmultiples_subset_ratCircle N
        (by simpa using sub_mem (Set.mem_ofPred.1 ha) (Set.mem_ofPred.1 hb))⟩
    simp only [add_apply, smul_apply, smul_eq_mul,
      (uniformOn_eq_zero_iff (finite_coset x₀ N)).2 (Set.inter_compl_self _), mul_zero, zero_add]
    exact mul_le_of_le_one_right' prob_le_one
  exact le_antisymm ((bipolarRate_le_klInf volume hS).trans_eq
    (klInf_coset_mixtures hε))
    (log_inv_le_bipolarRate_of_forall_le_maxLogGrowth hε fun n hn ↦ log_le_maxLogGrowth hS hSC hn)

end ProbabilityTheory
