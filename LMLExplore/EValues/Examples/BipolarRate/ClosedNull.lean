/-!
# A weakly closed null on `ℕ` whose bipolar rate is below the smallest relative entropy

Let `Q` be a probability measure on `ℕ` that charges every point, for instance the law
`Q {x} = 2 ^ (-(x + 1))` (Mathlib's `geometricMeasure` with success probability `1 / 2`). For
`j : ℕ`, let `P_j = Q(· | ≠ j) / 2 + δ_{j + 1} / 2`, the law `Q` conditioned to avoid `j`, mixed
with the point mass at `j + 1`, and consider the i.i.d. null generated by the laws `P_j`. Then:

* no `P_j` charges `j`, which `Q` charges, so the smallest relative entropy `klInf` from `Q` to
  the null is infinite;
* the bipolar rate of `Q` against the null is `log 2`;
* the null is closed for the topology of weak convergence of probability measures on `ℕ`.

So the bipolar rate can be smaller than the smallest relative entropy for a weakly closed null
[EVR26, Note 42, Section 1]. The gap is a failure of the lower semicontinuity of
`R ↦ klInf R S` at `Q`, which [RR26, Theorem 4.1] and
`ProbabilityTheory.bipolarRate_eq_klInf_of_forall_exists_forall_le` assume, and not of
closedness: the laws `Q(· | ≠ j)` tend to `Q` and are at relative entropy less than `log 2` from
`P_j` (this is not proved here). On a space with finitely many measurable sets no null has a gap
(`ProbabilityTheory.bipolarRate_eq_klInf_of_finite_measurableSet`).

## Main statements

* `ProbabilityTheory.klInf_cond_dirac_mixtures`: the smallest relative entropy from `Q` to the
  null is infinite.
* `ProbabilityTheory.bipolarRate_cond_dirac_mixtures`: the bipolar rate is `log 2`.
* `ProbabilityTheory.isClosed_cond_dirac_mixtures`: the null is weakly closed, for every measure
  `Q` on `ℕ`.

## Implementation notes

The upper bound on the bipolar rate: `P_j ^ n` is at least `2 ^ (-n)` times the restriction of
`Q ^ n` to the samples that avoid `j`, so an `n`-sample e-variable has expectation at most `2 ^ n`
on these samples under `Q ^ n`; every sample avoids all large `j`, and Fatou's lemma gives
expectation at most `2 ^ n` under `Q ^ n`, and expected logarithm at most `n log 2` by Jensen's
inequality. The lower bound tests the masses of the points up to some `K` and of the numbers
above `K`, with `ProbabilityTheory.le_bipolarRate_of_forall_le_klInf`: a law `R` close to `Q`
charges every `j ≤ K`, which `P_j` does not, and gives a small mass to the numbers above `K`, to
which `P_j` gives mass at least `1 / 2` for `j > K`, so that `KL(R ‖ P_j)` is close to `log 2` at
least, by the Donsker–Varadhan inequality. The null is closed since `P_j` gives mass at most
`1 / 2` to the numbers up to `K` when `j ≥ K`: a weak limit of laws of the null is a weak limit of
finitely many of them.

The statements and proofs are adapted from `EValuesResearch/Results/FiniteAlphabetRate.lean`
(commit `9eee1f2`) in the paper project `RemyDegenne/evalues_research`, rewritten on the API of
LMLExplore. The source states them for the law `Q {x} = 2 ^ (-(x + 1))` only, with the laws
`P_j` for `j ≥ 1`, and defines the laws and the null instead of writing them in the
statements.

## References

* [RR26] A. Ram and A. Ramdas, *The optimal betting wealth growth rate*, arXiv:2604.25280v1.
* [EVR26] *Answers to open questions in e-values and anytime-valid inference*, notes and the Lean
  library `EValuesResearch` of github.com/RemyDegenne/evalues_research, 2026; written and refereed
  by AI agents: Note 42, *Four results that came out of the check of the book plan*, Section 1.
-/

public section

open MeasureTheory InformationTheory Filter
open scoped ENNReal NNReal Topology

namespace ProbabilityTheory

variable {Q : Measure ℕ}

/-- The law `P_j = Q(· | ≠ j) / 2 + δ_{j + 1} / 2` on `ℕ`. -/
private noncomputable def gapLaw (Q : Measure ℕ) (j : ℕ) : Measure ℕ :=
  (2⁻¹ : ℝ≥0∞) • Q[|{j}ᶜ] + (2⁻¹ : ℝ≥0∞) • Measure.dirac (j + 1)

/-- The law `P_j` is a finite measure. -/
private instance (Q : Measure ℕ) (j : ℕ) : IsFiniteMeasure (gapLaw Q j) := by
  refine ⟨?_⟩
  simp only [gapLaw, add_apply, smul_apply, smul_eq_mul]
  exact ENNReal.add_lt_top.2 ⟨ENNReal.mul_lt_top (by simp) (measure_lt_top _ _),
    ENNReal.mul_lt_top (by simp) (measure_lt_top _ _)⟩

/-- If `Q` is finite and charges every point, the law `P_j` is a probability measure. -/
private lemma isProbabilityMeasure_gapLaw [IsFiniteMeasure Q] (hQ : ∀ x, Q {x} ≠ 0) (j : ℕ) :
    IsProbabilityMeasure (gapLaw Q j) := by
  have := cond_isProbabilityMeasure (μ := Q) (s := {j}ᶜ)
    fun h ↦ hQ (j + 1) (measure_mono_null (by simp) h)
  refine ⟨?_⟩
  simp only [gapLaw, add_apply, smul_apply, measure_univ, smul_eq_mul, mul_one]
  exact ENNReal.inv_two_add_inv_two

/-- The law `P_j` does not charge the point `j`. -/
private lemma gapLaw_singleton_self (Q : Measure ℕ) (j : ℕ) : gapLaw Q j {j} = 0 := by
  simp [gapLaw, cond_apply (measurableSet_singleton j).compl]

/-- For `Q` of mass at most one, half of the restriction of `Q` to the complement of `j` is below
`P_j`. -/
private lemma smul_restrict_le_gapLaw [IsZeroOrProbabilityMeasure Q] (j : ℕ) :
    (2⁻¹ : ℝ≥0) • Q.restrict {j}ᶜ ≤ gapLaw Q j := by
  refine Measure.le_iff.2 fun s _ ↦ ?_
  simp only [gapLaw, add_apply, smul_apply, ProbabilityTheory.cond, ENNReal.smul_def,
    smul_eq_mul, ENNReal.coe_inv two_ne_zero, ENNReal.coe_ofNat]
  refine le_add_right (mul_le_mul_right ?_ _)
  exact le_mul_of_one_le_left zero_le (ENNReal.one_le_inv.2 prob_le_one)

/-- The law `P_j` gives mass at least `1/2` to every set that contains `j + 1`. -/
private lemma inv_two_le_gapLaw {j : ℕ} {B : Set ℕ} (hB : j + 1 ∈ B) :
    (2 : ℝ≥0∞)⁻¹ ≤ gapLaw Q j B := by
  simp only [gapLaw, add_apply, smul_apply, smul_eq_mul]
  refine le_add_left ?_
  rw [Measure.dirac_apply_of_mem hB, mul_one]

/-- The law `P_j` gives mass at most `1/2` to every set that avoids `j + 1`. -/
private lemma gapLaw_le_inv_two {j : ℕ} {B : Set ℕ} (hB : j + 1 ∉ B) :
    gapLaw Q j B ≤ (2 : ℝ≥0∞)⁻¹ := by
  simp only [gapLaw, add_apply, smul_apply, smul_eq_mul, Measure.dirac_apply,
    Set.indicator_of_notMem hB, mul_zero, add_zero]
  exact mul_le_of_le_one_right zero_le prob_le_one

/-! ### The smallest relative entropy is infinite -/

/-- If `Q` charges every point, the smallest relative entropy from `Q` to the null of the laws
`P_j = Q(· | ≠ j) / 2 + δ_{j + 1} / 2` is infinite, since `P_j` does not charge `j`
[EVR26, Note 42, Section 1]. -/
theorem klInf_cond_dirac_mixtures (hQ : ∀ x, Q {x} ≠ 0) :
    klInf Q (Set.range fun j : ℕ ↦
      (2⁻¹ : ℝ≥0∞) • Q[|{j}ᶜ] + (2⁻¹ : ℝ≥0∞) • Measure.dirac (j + 1)) = ⊤ := by
  rw [klInf_def]
  refine iInf₂_eq_top.2 ?_
  rintro _ ⟨j, rfl⟩
  exact klIntegral_of_not_ac fun hac ↦ hQ j (hac (gapLaw_singleton_self Q j))

/-! ### The bipolar rate is `log 2` -/

/-- Under the `n`-fold product of `Q`, an `n`-sample e-variable for the null of the laws `P_j`
has expectation at most `2 ^ n`: `P_j ^ n` is at least `2 ^ (-n)` times the restriction of
`Q ^ n` to the samples that avoid `j`, and every sample avoids all large `j`. -/
private lemma lintegral_pi_le [IsProbabilityMeasure Q] {n : ℕ} {M : (Fin n → ℕ) → ℝ≥0∞}
    (hM : IsEVar M (sampleNull (Set.range (gapLaw Q)) n)) :
    ∫⁻ x, M x ∂Measure.pi (fun _ : Fin n ↦ Q) ≤ 2 ^ n := by
  set Qn := Measure.pi fun _ : Fin n ↦ Q with hQn
  set A : ℕ → Set (Fin n → ℕ) := fun j ↦ Set.pi Set.univ fun _ ↦ ({j}ᶜ : Set ℕ) with hA
  have hA_meas (j : ℕ) : MeasurableSet (A j) :=
    .univ_pi fun _ ↦ (measurableSet_singleton j).compl
  have h_set (j : ℕ) : ∫⁻ x in A j, M x ∂Qn ≤ 2 ^ n := by
    have h_le : ((2⁻¹ : ℝ≥0) ^ n) • Qn.restrict (A j) ≤ Measure.pi fun _ : Fin n ↦ gapLaw Q j := by
      calc ((2⁻¹ : ℝ≥0) ^ n) • Qn.restrict (A j)
      _ = Measure.pi fun _ : Fin n ↦ (2⁻¹ : ℝ≥0) • Q.restrict {j}ᶜ := by
        rw [Measure.pi_const_smul, Fintype.card_fin, hQn, hA, Measure.restrict_pi_pi]
      _ ≤ Measure.pi fun _ : Fin n ↦ gapLaw Q j :=
        Measure.pi_mono fun _ ↦ smul_restrict_le_gapLaw j
    have h1 := (lintegral_mono' h_le le_rfl).trans
      (hM.lintegral_le_one (pi_mem_sampleNull (Set.mem_range_self j)))
    rw [lintegral_smul_measure, ENNReal.smul_def, smul_eq_mul, ENNReal.coe_pow,
      ENNReal.coe_inv two_ne_zero, ENNReal.coe_ofNat, mul_comm] at h1
    rw [← inv_inv ((2 : ℝ≥0∞) ^ n), ENNReal.inv_pow]
    exact ENNReal.le_inv_iff_mul_le.2 h1
  have h_ev (x : Fin n → ℕ) : ∀ᶠ j : ℕ in atTop, (A j).indicator M x = M x := by
    filter_upwards [eventually_gt_atTop (Finset.univ.sup x)] with j hj
    refine Set.indicator_of_mem (fun i _ ↦ ?_) M
    have hi : x i ≤ Finset.univ.sup x := Finset.le_sup (Finset.mem_univ i)
    simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
    omega
  calc ∫⁻ x, M x ∂Qn
  _ = ∫⁻ x, liminf (fun j : ℕ ↦ (A j).indicator M x) atTop ∂Qn :=
    lintegral_congr fun x ↦ (Tendsto.liminf_eq
      (tendsto_const_nhds.congr' ((h_ev x).mono fun _ h ↦ h.symm))).symm
  _ ≤ liminf (fun j : ℕ ↦ ∫⁻ x, (A j).indicator M x ∂Qn) atTop :=
    lintegral_liminf_le fun j ↦ hM.measurable.indicator (hA_meas j)
  _ ≤ 2 ^ n := by
    refine liminf_le_of_frequently_le' (Frequently.of_forall fun j ↦ ?_)
    rw [lintegral_indicator (hA_meas j)]
    exact h_set j

/-- The bipolar rate of `Q` against the null of the laws `P_j` is at most `log 2`. -/
private lemma bipolarRate_le_log_two [IsProbabilityMeasure Q] :
    bipolarRate Q (Set.range (gapLaw Q)) ≤ (Real.log 2 : ℝ) := by
  refine bipolarRate_le_iff.2 fun n _ ↦ ?_
  rw [maxLogGrowth_def, maxEPower_le_iff]
  intro M hM
  calc ∫ᵉ x, ENNReal.log (M x) ∂Measure.pi (fun _ : Fin n ↦ Q)
  _ ≤ logUtility (∫⁻ x, M x ∂Measure.pi fun _ : Fin n ↦ Q) :=
    Utility.eintegral_le_map logUtility hM.measurable.aemeasurable
  _ ≤ ENNReal.log (2 ^ n) := by
    rw [logUtility_apply]
    exact ENNReal.log_le_log (lintegral_pi_le hM)
  _ = n * ((Real.log 2 : ℝ) : EReal) := by
    rw [ENNReal.log_pow, ← ENNReal.ofReal_ofNat 2, ENNReal.log_ofReal_of_pos two_pos]

/-- For `K < j` and `T ≥ 0`, a probability measure `R` is at relative entropy at least
`log 2 - T R {x | K < x} - exp (-T)` from `P_j`, which gives mass at least `1/2` to the numbers
above `K`: the Donsker–Varadhan inequality for the function `-T 𝟙_{x > K}`. -/
private lemma ofReal_log_two_sub_le_klDiv_gapLaw [IsFiniteMeasure Q] (hQ : ∀ x, Q {x} ≠ 0)
    {R : Measure ℕ} [IsProbabilityMeasure R] {K j : ℕ} (hKj : K < j) {T : ℝ} (hT : 0 ≤ T) :
    ENNReal.ofReal (Real.log 2 - T * R.real {x | K < x} - Real.exp (-T)) ≤
      klDiv R (gapLaw Q j) := by
  have := isProbabilityMeasure_gapLaw hQ j
  set B : Set ℕ := {x | K < x} with hB_def
  have hB : MeasurableSet B := .of_discrete
  have hPB : 1 / 2 ≤ (gapLaw Q j).real B := by
    have hjB : j + 1 ∈ B := by
      simp only [hB_def, Set.mem_ofPred_eq]
      omega
    have h := ENNReal.toReal_mono (measure_ne_top (gapLaw Q j) _) (inv_two_le_gapLaw (Q := Q) hjB)
    rwa [ENNReal.toReal_inv, ENNReal.toReal_ofNat, ← one_div] at h
  set f : ℕ → ℝ := B.indicator fun _ ↦ -T with hf
  have hf_int : Integrable f R := (integrable_const _).indicator hB
  have h_exp : (fun x ↦ Real.exp (f x)) =
      fun x ↦ B.indicator (fun _ ↦ Real.exp (-T) - 1) x + 1 := by
    ext x
    by_cases hx : x ∈ B <;> simp [hf, hx]
  have hef_int : Integrable (fun x ↦ Real.exp (f x)) (gapLaw Q j) := by
    rw [h_exp]
    exact ((integrable_const _).indicator hB).add (integrable_const _)
  refine (ENNReal.ofReal_le_ofReal ?_).trans
    (TauCeti.ofReal_integral_sub_log_integral_exp_le_klDiv hf_int hef_int)
  have h1 : ∫ x, f x ∂R = -(T * R.real B) := by
    rw [hf, integral_indicator_const _ hB, smul_eq_mul]
    ring
  have h2 : ∫ x, Real.exp (f x) ∂(gapLaw Q j) = (Real.exp (-T) - 1) * (gapLaw Q j).real B + 1 := by
    rw [h_exp, integral_add ((integrable_const _).indicator hB) (integrable_const _),
      integral_indicator_const _ hB, integral_const, probReal_univ, smul_eq_mul, smul_eq_mul]
    ring
  have he : Real.exp (-T) ≤ 1 := Real.exp_le_one_iff.2 (by linarith)
  have he0 : 0 < Real.exp (-T) := Real.exp_pos _
  have h3 : (Real.exp (-T) - 1) * (gapLaw Q j).real B + 1 ≤ (1 + Real.exp (-T)) / 2 := by
    nlinarith
  have h4 : 0 < (Real.exp (-T) - 1) * (gapLaw Q j).real B + 1 := by
    nlinarith [measureReal_le_one (μ := gapLaw Q j) (s := B)]
  have h5 : Real.log ((Real.exp (-T) - 1) * (gapLaw Q j).real B + 1) ≤
      Real.exp (-T) - Real.log 2 := by
    calc Real.log ((Real.exp (-T) - 1) * (gapLaw Q j).real B + 1)
    _ ≤ Real.log ((1 + Real.exp (-T)) / 2) := Real.log_le_log h4 h3
    _ = Real.log (1 + Real.exp (-T)) - Real.log 2 := Real.log_div (by positivity) (by norm_num)
    _ ≤ Real.exp (-T) - Real.log 2 := by
      linarith [Real.log_le_sub_one_of_pos (by positivity : 0 < 1 + Real.exp (-T))]
  rw [h1, h2]
  linarith

/-- The bipolar rate of `Q` against the null of the laws `P_j` is at least `log 2`, when `Q`
charges every point: a law close to `Q` charges every small `j`, which `P_j` does not, and gives
a small mass to the large numbers, to which `P_j` gives mass at least `1/2` for `j` large. -/
private lemma log_two_le_bipolarRate [IsProbabilityMeasure Q] (hQ : ∀ x, Q {x} ≠ 0) :
    ((Real.log 2 : ℝ) : EReal) ≤ bipolarRate Q (Set.range (gapLaw Q)) := by
  have hS : ∀ P ∈ Set.range (gapLaw Q), IsProbabilityMeasure P := by
    rintro _ ⟨j, rfl⟩
    exact isProbabilityMeasure_gapLaw hQ j
  refine le_of_forall_lt_imp_le_of_dense fun c hc ↦ ?_
  rcases le_or_gt c 0 with hc0 | hc0
  · exact hc0.trans (bipolarRate_nonneg _ fun P hP ↦ (hS P hP).measure_univ.le)
  lift c to ℝ using ⟨hc.ne_top, ne_bot_of_gt hc0⟩
  have hc' : c < Real.log 2 := EReal.coe_lt_coe_iff.1 hc
  have hc0' : 0 < c := EReal.coe_pos.1 hc0
  -- `T` with `exp (-T) < (log 2 - c) / 2`, and `ρ` with `T ρ = (log 2 - c) / 2`
  have hη0 : 0 < Real.log 2 - c := by linarith
  obtain ⟨T, hT, hT0⟩ : ∃ T : ℝ, Real.exp (-T) < (Real.log 2 - c) / 2 ∧ 0 < T :=
    ((Real.tendsto_exp_neg_atTop_nhds_zero.eventually (gt_mem_nhds (half_pos hη0))).and
      (eventually_gt_atTop 0)).exists
  set ρ := (Real.log 2 - c) / (2 * T) with hρ
  have hρ0 : 0 < ρ := by positivity
  have hTρ : T * ρ = (Real.log 2 - c) / 2 := by
    rw [hρ]
    field_simp
  -- `K` such that `Q` gives mass less than `ρ / 2` to the numbers above `K`
  have h_anti : Antitone fun K : ℕ ↦ {x : ℕ | K < x} := fun K K' h x hx ↦ lt_of_le_of_lt h hx
  have h_tend := tendsto_measure_iInter_atTop (μ := Q)
    (fun K ↦ (MeasurableSet.of_discrete (s := {x : ℕ | K < x})).nullMeasurableSet) h_anti
    ⟨0, measure_ne_top _ _⟩
  have h_inter : ⋂ K : ℕ, {x : ℕ | K < x} = ∅ := by
    ext x
    simp only [Set.mem_iInter, Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, not_forall,
      not_lt]
    exact ⟨x, le_rfl⟩
  rw [h_inter, measure_empty] at h_tend
  obtain ⟨K, hK⟩ :=
    (h_tend.eventually (gt_mem_nhds (ENNReal.ofReal_pos.2 (half_pos hρ0)))).exists
  have hK' : Q.real {x : ℕ | K < x} < ρ / 2 :=
    (ENNReal.lt_ofReal_iff_toReal_lt (measure_ne_top _ _)).1 hK
  -- the test functions: the indicators of the points up to `K` and of the numbers above `K`,
  -- divided by their masses
  set s : Fin (K + 2) → Set ℕ := fun i ↦ if (i : ℕ) ≤ K then {(i : ℕ)} else {x | K < x} with hs
  have hQs (i : Fin (K + 2)) : 0 < Q.real (s i) := by
    obtain ⟨x, hx⟩ : ∃ x, x ∈ s i := by
      by_cases hi : (i : ℕ) ≤ K
      · exact ⟨i, by simp [hs, hi]⟩
      · exact ⟨K + 1, by simp [hs, hi]⟩
    exact (ENNReal.toReal_pos (hQ x) (measure_ne_top _ _)).trans_le
      (measureReal_mono (Set.singleton_subset_iff.2 hx))
  refine le_bipolarRate_of_forall_le_klInf Q _ hS (k := K + 2)
    (f := fun i ↦ (s i).indicator fun _ ↦ (Q.real (s i))⁻¹) (ε := 2⁻¹) (by norm_num)
    (fun i ↦ measurable_const.indicator .of_discrete) (fun i ↦ ⟨(Q.real (s i))⁻¹, fun x ↦ ?_⟩)
    fun R hR hRQ ↦ ?_
  · by_cases hx : x ∈ s i <;> simp [hx, abs_of_nonneg measureReal_nonneg]
  have hRQ' (i : Fin (K + 2)) : |R.real (s i) - Q.real (s i)| ≤ Q.real (s i) / 2 := by
    have h := hRQ i
    rw [integral_indicator_const _ .of_discrete, integral_indicator_const _ .of_discrete,
      smul_eq_mul, smul_eq_mul, ← sub_mul, abs_mul, abs_inv, abs_of_pos (hQs i),
      mul_inv_le_iff₀ (hQs i)] at h
    linarith
  refine le_klInf_iff.2 ?_
  rintro _ ⟨j, rfl⟩
  have := isProbabilityMeasure_gapLaw hQ j
  rw [klIntegral_eq_klDiv (by simp)]
  rcases le_or_gt j K with hjK | hjK
  · -- `R` charges `j` and `P_j` does not
    have hsj : s ⟨j, by omega⟩ = {j} := by simp [hs, hjK]
    have h1 := hRQ' ⟨j, by omega⟩
    have hQj := hQs ⟨j, by omega⟩
    rw [hsj] at h1 hQj
    have hRj : R {j} ≠ 0 := by
      intro h0
      have h2 : R.real {j} = 0 := by simp [measureReal_def, h0]
      rw [h2] at h1
      linarith [(abs_le.1 h1).1]
    rw [klDiv_of_not_ac fun hac ↦ hRj (hac (gapLaw_singleton_self Q j))]
    simp
  · -- `P_j` gives mass at least `1/2` to the numbers above `K`, and `R` at most `ρ`
    have hsB : s ⟨K + 1, by omega⟩ = {x | K < x} := by simp [hs]
    have h1 := hRQ' ⟨K + 1, by omega⟩
    rw [hsB] at h1
    have hRB : R.real {x : ℕ | K < x} ≤ ρ := by linarith [(abs_le.1 h1).2]
    calc (c : EReal)
    _ = ((ENNReal.ofReal c : ℝ≥0∞) : EReal) := by
      rw [EReal.coe_ennreal_ofReal, max_eq_left hc0'.le]
    _ ≤ (klDiv R (gapLaw Q j) : EReal) := by
      refine EReal.coe_ennreal_le_coe_ennreal_iff.2 ((ENNReal.ofReal_le_ofReal ?_).trans
        (ofReal_log_two_sub_le_klDiv_gapLaw hQ hjK hT0.le))
      nlinarith [mul_le_mul_of_nonneg_left hRB hT0.le]

/-- If `Q` is a probability measure on `ℕ` that charges every point, the bipolar rate of `Q`
against the null of the laws `P_j = Q(· | ≠ j) / 2 + δ_{j + 1} / 2` is `log 2`, while the
smallest relative entropy from `Q` to the null is infinite (`klInf_cond_dirac_mixtures`)
[EVR26, Note 42, Section 1]. -/
theorem bipolarRate_cond_dirac_mixtures [IsProbabilityMeasure Q] (hQ : ∀ x, Q {x} ≠ 0) :
    bipolarRate Q (Set.range fun j : ℕ ↦
      (2⁻¹ : ℝ≥0∞) • Q[|{j}ᶜ] + (2⁻¹ : ℝ≥0∞) • Measure.dirac (j + 1)) = (Real.log 2 : ℝ) :=
  le_antisymm bipolarRate_le_log_two (log_two_le_bipolarRate hQ)

/-! ### The null is weakly closed -/

/-- For every measure `Q` on `ℕ`, the laws `P_j = Q(· | ≠ j) / 2 + δ_{j + 1} / 2` form a closed set
for the topology of weak convergence of probability measures on `ℕ` [EVR26, Note 42, Section 1]:
`P_j` gives mass at most `1 / 2` to the numbers up to `K` when `j ≥ K`. -/
theorem isClosed_cond_dirac_mixtures (Q : Measure ℕ) :
    IsClosed {μ : ProbabilityMeasure ℕ | (μ : Measure ℕ) ∈ Set.range fun j : ℕ ↦
      (2⁻¹ : ℝ≥0∞) • Q[|{j}ᶜ] + (2⁻¹ : ℝ≥0∞) • Measure.dirac (j + 1)} := by
  change IsClosed {μ : ProbabilityMeasure ℕ | (μ : Measure ℕ) ∈ Set.range (gapLaw Q)}
  refine isClosed_of_closure_subset fun μ hμ ↦ ?_
  -- `μ` gives mass more than `1/2` to the numbers up to some `K`
  have h_mono : Monotone fun K : ℕ ↦ {x : ℕ | x ≤ K} := fun K K' h x hx ↦ le_trans hx h
  have h_tend := tendsto_measure_iUnion_atTop (μ := (μ : Measure ℕ)) h_mono
  have h_union : ⋃ K : ℕ, {x : ℕ | x ≤ K} = Set.univ := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq, Set.mem_univ, iff_true]
    exact ⟨x, le_rfl⟩
  rw [h_union, measure_univ] at h_tend
  obtain ⟨K, hK⟩ := (h_tend.eventually
    (lt_mem_nhds (ENNReal.inv_lt_one.2 ENNReal.one_lt_two))).exists
  -- the measures with that property form an open set, which contains no `P_j` with `j ≥ K`
  set U : Set (ProbabilityMeasure ℕ) := {ν | (2⁻¹ : ℝ≥0) < ν {x : ℕ | x ≤ K}} with hU
  have hU_open : IsOpen U := by
    refine isOpen_lt continuous_const (continuous_iff_continuousAt.2 fun ν ↦ ?_)
    exact ProbabilityMeasure.tendsto_measure_of_isClopen_of_tendsto tendsto_id
      (isClopen_discrete _)
  have h_coe (ν : ProbabilityMeasure ℕ) (hν : ν ∈ U) :
      (2⁻¹ : ℝ≥0∞) < (ν : Measure ℕ) {x : ℕ | x ≤ K} := by
    rw [← ProbabilityMeasure.ennreal_coeFn_eq_coeFn_toMeasure]
    have h := ENNReal.coe_lt_coe.2 hν
    rwa [ENNReal.coe_inv two_ne_zero, ENNReal.coe_ofNat] at h
  have hμU : μ ∈ U := by
    rw [hU, Set.mem_ofPred_eq, ← ENNReal.coe_lt_coe,
      ProbabilityMeasure.ennreal_coeFn_eq_coeFn_toMeasure, ENNReal.coe_inv two_ne_zero,
      ENNReal.coe_ofNat]
    exact hK
  have h_closure :
      μ ∈ closure (U ∩ {ν : ProbabilityMeasure ℕ | (ν : Measure ℕ) ∈ Set.range (gapLaw Q)}) :=
    hU_open.inter_closure ⟨hμU, hμ⟩
  -- so `μ` is in the closure of the finite set of the `P_j` with `j < K`
  set F : Set (ProbabilityMeasure ℕ) := {ν | (ν : Measure ℕ) ∈ gapLaw Q '' Set.Iio K} with hF
  have hF_fin : F.Finite :=
    Set.Finite.preimage ProbabilityMeasure.toMeasure_injective.injOn
      ((Set.finite_Iio K).image (gapLaw Q))
  have h_sub : U ∩ {ν : ProbabilityMeasure ℕ | (ν : Measure ℕ) ∈ Set.range (gapLaw Q)} ⊆ F := by
    rintro ν ⟨hνU, j, hjν⟩
    refine ⟨j, Set.mem_Iio.2 ?_, hjν⟩
    by_contra hjK
    have hC : gapLaw Q j {x : ℕ | x ≤ K} ≤ 2⁻¹ :=
      gapLaw_le_inv_two (by simp only [Set.mem_ofPred_eq]; omega)
    have h := h_coe ν hνU
    rw [← hjν] at h
    exact absurd (h.trans_le hC) (lt_irrefl _)
  obtain ⟨j, -, hjμ⟩ := closure_minimal h_sub hF_fin.isClosed h_closure
  exact ⟨j, hjμ⟩

end ProbabilityTheory
