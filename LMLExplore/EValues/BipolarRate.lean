module

public import LMLExplore.Analysis.Subadditive
public import Statlib.Divergence.KullbackLeibler.CondKL
public import Statlib.EValues.Product
public import Statlib.EValues.RIPr

/-!
# The optimal growth rate of e-variables against an i.i.d. null

For a law `Q₁` on `𝓧` (the alternative) and a set `S₁` of laws on `𝓧` (the null), the
`n`-sample e-variables are the e-variables for the `n`-fold products `P ^ n` of the members `P`
of `S₁`. Their maximal expected logarithm under `Q₁ ^ n`, `maxLogGrowth Q₁ S₁ n`, is Statlib's
`maxUtility` with `logUtility`, which Statlib's duality
(`maxUtility_eq_iInf_klIntegral_effectiveSet`) writes as the reverse information projection of
`Q₁ ^ n` onto the effective null of the `n`-sample null. It is superadditive in `n`, so that
`maxLogGrowth Q₁ S₁ n / n` converges to its supremum, the bipolar rate `bipolarRate Q₁ S₁`: the
optimal growth rate of the evidence against the i.i.d. null, per observation. It is at most the
smallest relative entropy `⨅ P ∈ S₁, klDiv Q₁ P` from `Q₁` to the null, and can be smaller
(Ram and Ramdas, Proposition 5.4).

The statements assume that `Q₁` is a probability measure and that the members of the null are
finite measures (probability measures for the comparison with the relative entropy), and nothing
else: no domination, convexity or compactness.

## Main definitions

* `ProbabilityTheory.maxLogGrowth Q₁ S₁ n`: the maximal expected logarithm, under the `n`-fold
  product of `Q₁`, of the e-variables for the `n`-fold products of the members of `S₁`.
* `ProbabilityTheory.bipolarRate Q₁ S₁`: the supremum over `n ≥ 1` of `maxLogGrowth Q₁ S₁ n / n`.

## Main statements

* `ProbabilityTheory.maxLogGrowth_add_le`: `maxLogGrowth Q₁ S₁` is superadditive [RR26, Lemma 3.2].
* `ProbabilityTheory.tendsto_maxLogGrowth_div_bipolarRate`: `maxLogGrowth Q₁ S₁ n / n` tends to
  the bipolar rate [RR26, Lemma 3.2].
* `ProbabilityTheory.maxLogGrowth_le_mul_bipolarRate`:
  `maxLogGrowth Q₁ S₁ n ≤ n * bipolarRate Q₁ S₁` for `n ≠ 0`.
* `ProbabilityTheory.maxLogGrowth_anti`, `ProbabilityTheory.bipolarRate_anti`: both are antitone
  in the null.
* `ProbabilityTheory.maxLogGrowth_le_mul_klDiv`, `ProbabilityTheory.bipolarRate_le_iInf_klDiv`:
  the bipolar rate is at most the smallest relative entropy from `Q₁` to the null
  [RR26, proof of Theorem 4.1].

## References

* [RR26] A. Ram and A. Ramdas, *The optimal betting wealth growth rate*, arXiv:2604.25280v1.
-/

@[expose] public section

open MeasureTheory Filter InformationTheory
open scoped ENNReal Topology

namespace ProbabilityTheory

variable {𝓧 : Type*} {m𝓧 : MeasurableSpace 𝓧} {Q₁ P : Measure 𝓧} {S₁ T₁ : Set (Measure 𝓧)}
  {n : ℕ}

/-- The maximal expected logarithm of an `n`-sample e-variable for the i.i.d. laws of `S₁`, under
the `n`-fold product of `Q₁`: the supremum of `∫ᵉ x, log (E x) ∂Q₁ ^ n` over the functions
`E : (Fin n → 𝓧) → ℝ≥0∞` that are e-variables for `{P ^ n | P ∈ S₁}`. -/
noncomputable def maxLogGrowth (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) (n : ℕ) : EReal :=
  maxUtility (Measure.pi fun _ : Fin n ↦ Q₁) ((fun P ↦ Measure.pi fun _ : Fin n ↦ P) '' S₁)
    logUtility

/-- The bipolar rate of `Q₁` against the i.i.d. null generated by `S₁`: the supremum over `n ≥ 1`
of the maximal expected logarithm of an `n`-sample e-variable, divided by `n`. It is also the limit
of these normalized values [RR26, Lemma 3.2] (`tendsto_maxLogGrowth_div_bipolarRate`), and Ram
and Ramdas show that it is the optimal growth rate of e-processes against the null. -/
noncomputable def bipolarRate (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) : EReal :=
  ⨆ n : ℕ, maxLogGrowth Q₁ S₁ (n + 1) / ((n + 1 : ℕ) : EReal)

/-- The maximal expected logarithm of an `n`-sample e-variable is nonnegative, as the constant `1`
is an e-variable. -/
lemma maxLogGrowth_nonneg (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) (n : ℕ) :
    0 ≤ maxLogGrowth Q₁ S₁ n :=
  maxUtility_nonneg _

/-- The maximal expected logarithm of an `n`-sample e-variable is antitone in the null. -/
@[gcongr]
lemma maxLogGrowth_anti (h : S₁ ⊆ T₁) : maxLogGrowth Q₁ T₁ n ≤ maxLogGrowth Q₁ S₁ n :=
  maxUtility_anti (Set.image_mono h)

/-- With one observation, `maxLogGrowth` is the maximal expected logarithm of an e-variable. -/
lemma maxLogGrowth_one (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) :
    maxLogGrowth Q₁ S₁ 1 = maxUtility Q₁ S₁ logUtility := by
  rcases isEmpty_or_nonempty 𝓧 with h𝓧 | h𝓧
  · -- on an empty space every measure is `0`, and both sides vanish
    have h0 {Ω : Type _} [MeasurableSpace Ω] (T : Set (Measure Ω)) :
        maxUtility 0 T logUtility = 0 :=
      le_antisymm (iSup₂_le fun _ _ ↦ (eintegral_zero_measure _).le) (maxUtility_nonneg _)
    rw [maxLogGrowth, Measure.eq_zero_of_isEmpty (Measure.pi fun _ : Fin 1 ↦ Q₁),
      Measure.eq_zero_of_isEmpty Q₁, h0, h0]
  set e := (MeasurableEquiv.funUnique (Fin 1) 𝓧).symm
  have h_map (P : Measure 𝓧) : P.map e = Measure.pi fun _ : Fin 1 ↦ P :=
    (measurePreserving_funUnique P (Fin 1)).symm.map_eq
  rw [← e.measurableEmbedding.maxUtility_map_eq, h_map, maxLogGrowth]
  congr 1
  ext μ
  simp only [Set.mem_image, Set.mem_ofPred_eq, h_map]

/-- **Superadditivity** of the maximal expected logarithm of e-variables for an i.i.d. null
[RR26, Lemma 3.2]: the product of an `m`-sample e-variable and an `n`-sample e-variable, on
disjoint blocks of observations, is an `m + n`-sample e-variable (Statlib's `IsEVar.prod`, through
`maxUtility_prod_eq_add`). -/
theorem maxLogGrowth_add_le (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁]
    (hS₁ : ∀ P ∈ S₁, IsFiniteMeasure P) (m n : ℕ) :
    maxLogGrowth Q₁ S₁ m + maxLogGrowth Q₁ S₁ n ≤ maxLogGrowth Q₁ S₁ (m + n) := by
  -- split the first `m + n` observations into the first `m` and the last `n`
  let e : (Fin (m + n) → 𝓧) ≃ᵐ (Fin m → 𝓧) × (Fin n → 𝓧) :=
    (MeasurableEquiv.piCongrLeft (fun _ ↦ 𝓧) finSumFinEquiv).symm.trans
      (MeasurableEquiv.sumPiEquivProdPi fun _ ↦ 𝓧)
  have h_map (P : Measure 𝓧) [SigmaFinite P] :
      (Measure.pi fun _ : Fin (m + n) ↦ P).map e =
        (Measure.pi fun _ : Fin m ↦ P).prod (Measure.pi fun _ : Fin n ↦ P) :=
    ((measurePreserving_sumPiEquivProdPi fun _ ↦ P).comp
      ((measurePreserving_piCongrLeft (fun _ ↦ P) finSumFinEquiv).symm _)).map_eq
  have h_fin (k : ℕ) :
      ∀ μ ∈ (fun P ↦ Measure.pi fun _ : Fin k ↦ P) '' S₁, IsFiniteMeasure μ := by
    rintro _ ⟨P, hP, rfl⟩
    have := hS₁ P hP
    infer_instance
  calc maxLogGrowth Q₁ S₁ m + maxLogGrowth Q₁ S₁ n
  _ = maxUtility ((Measure.pi fun _ : Fin m ↦ Q₁).prod (Measure.pi fun _ : Fin n ↦ Q₁))
      (Set.image2 Measure.prod ((fun P ↦ Measure.pi fun _ : Fin m ↦ P) '' S₁)
        ((fun P ↦ Measure.pi fun _ : Fin n ↦ P) '' S₁)) logUtility :=
    (maxUtility_prod_eq_add _ _ (h_fin m) (h_fin n)).symm
  _ ≤ maxUtility ((Measure.pi fun _ : Fin (m + n) ↦ Q₁).map e)
      {μ.map e | μ ∈ (fun P ↦ Measure.pi fun _ : Fin (m + n) ↦ P) '' S₁} logUtility := by
    rw [h_map]
    refine maxUtility_anti ?_
    rintro _ ⟨_, ⟨P, hP, rfl⟩, rfl⟩
    have := hS₁ P hP
    exact ⟨_, ⟨P, hP, rfl⟩, _, ⟨P, hP, rfl⟩, (h_map P).symm⟩
  _ ≤ maxLogGrowth Q₁ S₁ (m + n) := maxUtility_map_le _ e.measurable

/-- The maximal expected logarithm of an `n`-sample e-variable is at most `n` times the bipolar
rate, for `n ≠ 0`. -/
lemma maxLogGrowth_le_mul_bipolarRate (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) (hn : n ≠ 0) :
    maxLogGrowth Q₁ S₁ n ≤ n * bipolarRate Q₁ S₁ := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
  have h := le_iSup (fun k : ℕ ↦ maxLogGrowth Q₁ S₁ (k + 1) / ((k + 1 : ℕ) : EReal)) k
  rwa [EReal.div_le_iff_le_mul (by exact_mod_cast k.succ_pos) (EReal.natCast_ne_top _)] at h

/-- The bipolar rate is nonnegative. -/
lemma bipolarRate_nonneg (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) : 0 ≤ bipolarRate Q₁ S₁ :=
  le_iSup_of_le 0 (EReal.div_nonneg (maxLogGrowth_nonneg _ _ _) (by positivity))

/-- The bipolar rate is antitone in the null. -/
@[gcongr]
lemma bipolarRate_anti (h : S₁ ⊆ T₁) : bipolarRate Q₁ T₁ ≤ bipolarRate Q₁ S₁ :=
  iSup_mono fun _ ↦ EReal.div_le_div_right_of_nonneg (by positivity) (maxLogGrowth_anti h)

/-- **Fekete's lemma** for the maximal expected logarithm of e-variables for an i.i.d. null:
`maxLogGrowth Q₁ S₁ n / n` tends to its supremum, the bipolar rate [RR26, Lemma 3.2]. The limit
may be `⊤`. -/
theorem tendsto_maxLogGrowth_div_bipolarRate (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁]
    (hS₁ : ∀ P ∈ S₁, IsFiniteMeasure P) :
    Tendsto (fun n : ℕ ↦ maxLogGrowth Q₁ S₁ n / n) atTop (𝓝 (bipolarRate Q₁ S₁)) :=
  EReal.tendsto_div_iSup_of_superadditive
    (fun _ _ ↦ ne_bot_of_le_ne_bot EReal.zero_ne_bot (maxLogGrowth_nonneg _ _ _))
    (maxLogGrowth_add_le Q₁ hS₁)

/-- The maximal expected logarithm of an `n`-sample e-variable is at most `n` times the relative
entropy from `Q₁` to any member `P` of the null: this is its value for the null `{P}`, by Statlib's
`maxUtility_singleton_eq_klDiv` and the tensorization of the relative entropy
[RR26, proof of Theorem 4.1]. -/
lemma maxLogGrowth_le_mul_klDiv (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁] (hP : P ∈ S₁)
    [IsProbabilityMeasure P] (n : ℕ) :
    maxLogGrowth Q₁ S₁ n ≤ n * (klDiv Q₁ P : EReal) := by
  calc maxLogGrowth Q₁ S₁ n
  _ ≤ maxUtility (Measure.pi fun _ : Fin n ↦ Q₁) {Measure.pi fun _ : Fin n ↦ P} logUtility :=
    maxUtility_anti (Set.singleton_subset_iff.2 ⟨P, hP, rfl⟩)
  _ = n * (klDiv Q₁ P : EReal) := by
    rw [maxUtility_singleton_eq_klDiv, klDiv_pi_const, Fintype.card_fin, EReal.coe_ennreal_mul,
      ENNReal.toEReal_natCast]

/-- The bipolar rate is at most the relative entropy from `Q₁` to any member of the null. -/
lemma bipolarRate_le_klDiv (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁] (hP : P ∈ S₁)
    [IsProbabilityMeasure P] :
    bipolarRate Q₁ S₁ ≤ klDiv Q₁ P :=
  iSup_le fun n ↦ (EReal.div_le_iff_le_mul (by exact_mod_cast n.succ_pos)
    (EReal.natCast_ne_top _)).2 (maxLogGrowth_le_mul_klDiv Q₁ hP (n + 1))

/-- The bipolar rate is at most the smallest relative entropy from `Q₁` to the null,
$\mathrm{KL}_{\inf}(Q_1,\mathcal P_1)$ [RR26, proof of Theorem 4.1]. The inequality can be
strict. -/
theorem bipolarRate_le_iInf_klDiv (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁]
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P) :
    bipolarRate Q₁ S₁ ≤ (⨅ P ∈ S₁, klDiv Q₁ P : ℝ≥0∞) := by
  rw [← EReal.coe_toENNReal (bipolarRate_nonneg Q₁ S₁), EReal.coe_ennreal_le_coe_ennreal_iff]
  refine le_iInf₂ fun P hP ↦ ?_
  have := hS₁ P hP
  rw [← EReal.toENNReal_coe (x := klDiv Q₁ P)]
  exact EReal.toENNReal_le_toENNReal (bipolarRate_le_klDiv Q₁ hP)

end ProbabilityTheory
