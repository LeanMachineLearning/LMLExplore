/-! ### The null -/

/-- The **one-sided conditionally `1`-sub-Gaussian null** on `ℕ → ℝ`: the probability measures
under which, for every `k` and every `l ≥ 0`, the conditional expectation of
`exp (l X_k - l ^ 2 / 2)` given the observations before `k` is at most `1`, in the set-integral
form. -/
def oneSidedCondSubgaussianNull : Set (Measure (ℕ → ℝ)) :=
  {P | IsProbabilityMeasure P ∧ ∀ (k : ℕ) (l : ℝ), 0 ≤ l → ∀ s : Set (ℕ → ℝ),
    MeasurableSet[Filtration.naturalLT (fun i (ω : ℕ → ℝ) ↦ ω i) measurable_pi_apply k] s →
    ∫⁻ ω in s, ENNReal.ofReal (Real.exp (l * ω k - l ^ 2 / 2)) ∂P ≤ P s}

/-- Membership in the one-sided conditionally `1`-sub-Gaussian null. -/
theorem mem_oneSidedCondSubgaussianNull_iff {P : Measure (ℕ → ℝ)} :
    P ∈ oneSidedCondSubgaussianNull ↔ IsProbabilityMeasure P ∧ ∀ (k : ℕ) (l : ℝ), 0 ≤ l →
      ∀ s : Set (ℕ → ℝ),
        MeasurableSet[Filtration.naturalLT (fun i (ω : ℕ → ℝ) ↦ ω i) measurable_pi_apply k] s →
        ∫⁻ ω in s, ENNReal.ofReal (Real.exp (l * ω k - l ^ 2 / 2)) ∂P ≤ P s :=
  Iff.rfl

/-- The members of the one-sided conditionally `1`-sub-Gaussian null are probability measures. -/
theorem isProbabilityMeasure_of_mem_oneSidedCondSubgaussianNull {P : Measure (ℕ → ℝ)}
    (hP : P ∈ oneSidedCondSubgaussianNull) : IsProbabilityMeasure P :=
  hP.1

/-! ### The one-step null -/

/-- The **one-sided `1`-sub-Gaussian null** on the line: the null generated by the constraints
`x ↦ exp (l x - l ^ 2 / 2) - 1` for `l ≥ 0`, that is, the probability measures `μ` with
`∫ exp (l x - l ^ 2 / 2) ∂μ ≤ 1` for every `l ≥ 0` (`mem_oneSidedSubgaussianNull_iff`). -/
noncomputable def oneSidedSubgaussianNull : Set (Measure ℝ) :=
  constraintNull (range fun l : Ici (0 : ℝ) ↦ fun x ↦ Real.exp (l * x - l ^ 2 / 2) - 1)

/-- Membership in the one-sided `1`-sub-Gaussian null on the line: a probability measure belongs
to it when every exponential `exp (l x - l ^ 2 / 2)`, `l ≥ 0`, has mean at most `1`. -/
theorem mem_oneSidedSubgaussianNull_iff {μ : Measure ℝ} :
    μ ∈ oneSidedSubgaussianNull ↔ IsProbabilityMeasure μ ∧ ∀ l : ℝ, 0 ≤ l →
      ∫⁻ x, ENNReal.ofReal (Real.exp (l * x - l ^ 2 / 2)) ∂μ ≤ 1 := by
  rw [oneSidedSubgaussianNull, mem_constraintNull_range_iff, Subtype.forall]
  refine and_congr_right fun hμ ↦ forall₂_congr fun l _ ↦ ?_
  have h0 : 0 ≤ᵐ[μ] fun x ↦ Real.exp (l * x - l ^ 2 / 2) :=
    ae_of_all _ fun _ ↦ (Real.exp_pos _).le
  have hint : Integrable (fun x ↦ Real.exp (l * x - l ^ 2 / 2) - 1) μ ↔
      Integrable (fun x ↦ Real.exp (l * x - l ^ 2 / 2)) μ := by
    simp_rw [sub_eq_add_neg]
    exact integrable_add_const_iff
  rw [hint]
  constructor
  · rintro ⟨hi, hle⟩
    rw [integral_sub hi (integrable_const 1), integral_const, probReal_univ, one_smul,
      sub_nonpos] at hle
    rw [← ofReal_integral_eq_lintegral_ofReal hi h0, ← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal hle
  · intro hle
    have hi : Integrable (fun x ↦ Real.exp (l * x - l ^ 2 / 2)) μ :=
      ⟨by fun_prop, (hasFiniteIntegral_iff_ofReal h0).2 (hle.trans_lt ENNReal.one_lt_top)⟩
    refine ⟨hi, ?_⟩
    rw [← ofReal_integral_eq_lintegral_ofReal hi h0, ENNReal.ofReal_le_one] at hle
    rw [integral_sub hi (integrable_const 1), integral_const, probReal_univ, one_smul,
      sub_nonpos]
    exact hle

/-- The completion step: a finitely supported measure with exponential means below `1` becomes a
probability measure with exponential means at most `1` after a slight shrinking and the addition
of a far negative atom. -/
private lemma exists_completion {ι : Type*} (s : Finset ι) {w y : ι → ℝ} (hw : ∀ i, 0 ≤ w i)
    (hW : ∀ l : ℝ, 0 ≤ l → ∑ i ∈ s, w i * Real.exp (l * y i - l ^ 2 / 2) < 1) {η : ℝ}
    (hη0 : 0 < η) (hη1 : η < 1) :
    ∃ z : ℝ, ∀ l : ℝ, 0 ≤ l → ∑ i ∈ s, (1 - η) * w i * Real.exp (l * y i - l ^ 2 / 2) +
      (1 - (1 - η) * ∑ i ∈ s, w i) * Real.exp (l * z - l ^ 2 / 2) ≤ 1 := by
  set S := ∑ i ∈ s, w i with hSdef
  have hS1 : S < 1 := by simpa using hW 0 le_rfl
  have hS0 : 0 ≤ S := Finset.sum_nonneg fun i _ ↦ hw i
  set s₁ := (1 - η) * S with hs₁def
  set m := 1 - s₁ with hmdef
  have hs₁ : 0 ≤ s₁ := mul_nonneg (by linarith) hS0
  have hs₁1 : s₁ ≤ 1 - η := by nlinarith
  set a := ∑ i ∈ s, |y i| with hadef
  have ha : 0 ≤ a := Finset.sum_nonneg fun i _ ↦ abs_nonneg _
  have hya : ∀ i ∈ s, y i ≤ a := fun i hi ↦
    (le_abs_self _).trans (Finset.single_le_sum (fun j _ ↦ abs_nonneg (y j)) hi)
  set l₁ := Real.log (1 + m / 2) / (a + 1) with hl₁def
  have hl₁ : 0 < l₁ := div_pos (Real.log_pos (by linarith)) (by linarith)
  set c := min η (1 / 2) with hcdef
  have hc0 : 0 < c := lt_min hη0 (by norm_num)
  have hc2 : c ≤ 1 / 2 := min_le_right _ _
  have hcη : c ≤ η := min_le_left _ _
  set z := Real.log c / l₁ with hzdef
  have hz : l₁ * z = Real.log c := by rw [hzdef]; field_simp
  have hz0 : z ≤ 0 := div_nonpos_of_nonpos_of_nonneg (Real.log_nonpos hc0.le (by linarith)) hl₁.le
  have hexpz : Real.exp (l₁ * z) = c := by rw [hz, Real.exp_log hc0]
  have hexpa : Real.exp (l₁ * a) ≤ 1 + m / 2 := by
    calc Real.exp (l₁ * a) ≤ Real.exp (l₁ * (a + 1)) := Real.exp_le_exp.2 (by nlinarith)
      _ = 1 + m / 2 := by
          rw [show l₁ * (a + 1) = Real.log (1 + m / 2) by rw [hl₁def]; field_simp]
          exact Real.exp_log (by linarith)
  refine ⟨z, fun l hl ↦ ?_⟩
  have hsum : ∑ i ∈ s, (1 - η) * w i * Real.exp (l * y i - l ^ 2 / 2) =
      (1 - η) * ∑ i ∈ s, w i * Real.exp (l * y i - l ^ 2 / 2) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ ↦ by ring
  rw [hsum]
  have hez := Real.exp_pos (l * z - l ^ 2 / 2)
  rcases le_total l₁ l with h | h
  · -- for large `l`, the far negative atom contributes at most `η`
    have h1 := hW l hl
    have h2 : Real.exp (l * z - l ^ 2 / 2) ≤ c :=
      calc Real.exp (l * z - l ^ 2 / 2) ≤ Real.exp (l₁ * z) := Real.exp_le_exp.2 (by nlinarith)
        _ = c := hexpz
    have e1 : (1 - η) * ∑ i ∈ s, w i * Real.exp (l * y i - l ^ 2 / 2) ≤ (1 - η) * 1 :=
      mul_le_mul_of_nonneg_left h1.le (by linarith)
    have e2 : m * Real.exp (l * z - l ^ 2 / 2) ≤ 1 * η :=
      (mul_le_mul_of_nonneg_right (by linarith : m ≤ 1) hez.le).trans
        (by rw [one_mul, one_mul]; linarith)
    linarith
  · -- for small `l`, the bound is convex in `l` and holds at `0` and at `l₁`
    set θ := l / l₁ with hθdef
    have hθ0 : 0 ≤ θ := div_nonneg hl hl₁.le
    have hθ1 : θ ≤ 1 := div_le_one_of_le₀ h hl₁.le
    have hconv : ∀ b : ℝ, Real.exp (l * b) ≤ θ * Real.exp (l₁ * b) + (1 - θ) := by
      intro b
      have := convexOn_exp.2 (Set.mem_univ (l₁ * b)) (Set.mem_univ 0) hθ0
        (by linarith : 0 ≤ 1 - θ) (by ring)
      simp only [smul_eq_mul, mul_zero, add_zero, Real.exp_zero, mul_one] at this
      convert this using 2
      rw [hθdef]
      field_simp
    have hfirst : ∑ i ∈ s, w i * Real.exp (l * y i - l ^ 2 / 2) ≤ S * Real.exp (l * a) := by
      rw [hSdef, Finset.sum_mul]
      refine Finset.sum_le_sum fun i hi ↦ ?_
      gcongr
      · exact hw i
      · nlinarith [hya i hi]
    have hsecond : Real.exp (l * z - l ^ 2 / 2) ≤ Real.exp (l * z) :=
      Real.exp_le_exp.2 (by nlinarith)
    have hz' := hconv z
    rw [hexpz] at hz'
    have f1 : (1 - η) * ∑ i ∈ s, w i * Real.exp (l * y i - l ^ 2 / 2) ≤ s₁ * Real.exp (l * a) := by
      rw [hs₁def, mul_assoc]
      exact mul_le_mul_of_nonneg_left hfirst (by linarith)
    have f2 : m * Real.exp (l * z - l ^ 2 / 2) ≤ m * Real.exp (l * z) :=
      mul_le_mul_of_nonneg_left hsecond (by linarith)
    have g1 : Real.exp (l * a) ≤ θ * (1 + m / 2) + (1 - θ) := (hconv a).trans (by nlinarith)
    have g2 : Real.exp (l * z) ≤ θ * (1 / 2) + (1 - θ) := hz'.trans (by nlinarith)
    have f3 := mul_le_mul_of_nonneg_left g1 hs₁
    have f4 := mul_le_mul_of_nonneg_left g2 (by linarith : 0 ≤ m)
    have key : s₁ * (θ * (1 + m / 2) + (1 - θ)) + m * (θ * (1 / 2) + (1 - θ)) =
        1 + θ * m * (s₁ - 1) / 2 := by rw [hmdef]; ring
    have : θ * m * (s₁ - 1) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (mul_nonneg hθ0 (by linarith)) (by linarith)
    linarith

/-- The completion step as a finitely supported member of the one-step null: a finitely
supported measure with exponential means below `1`, shrunk by `1 - η` and completed by a far
negative atom, is a one-sided `1`-sub-Gaussian probability law. -/
private lemma exists_mem_oneSidedSubgaussianNull_of_lt_one {α : Type*} [Fintype α] {w : α → ℝ}
    (hw : ∀ k, 0 ≤ w k) (y : α → ℝ)
    (hW : ∀ l : ℝ, 0 ≤ l → ∑ k, w k * Real.exp (l * y k - l ^ 2 / 2) < 1) {η : ℝ} (hη0 : 0 < η)
    (hη1 : η < 1) :
    ∃ z : ℝ, (∑ k, ENNReal.ofReal ((1 - η) * w k) • Measure.dirac (y k) +
        ENNReal.ofReal (1 - (1 - η) * ∑ k, w k) • Measure.dirac z) ∈ oneSidedSubgaussianNull ∧
      (∑ k, ENNReal.ofReal ((1 - η) * w k) • Measure.dirac (y k) +
        ENNReal.ofReal (1 - (1 - η) * ∑ k, w k) • Measure.dirac z)
          (↑(insert z (Finset.univ.image y)))ᶜ = 0 := by
  obtain ⟨z, hz⟩ := exists_completion Finset.univ hw hW hη0 hη1
  have hS1 : ∑ k, w k < 1 := by simpa using hW 0 le_rfl
  set m := 1 - (1 - η) * ∑ k, w k with hmdef
  have hm0 : 0 ≤ m := by nlinarith [Finset.sum_nonneg fun k (_ : k ∈ Finset.univ) ↦ hw k]
  have hcw : ∀ k, 0 ≤ (1 - η) * w k := fun k ↦ mul_nonneg (by linarith) (hw k)
  have hsum : ∑ k, (1 - η) * w k = 1 - m := by rw [hmdef, ← Finset.mul_sum]; ring
  have hΦ : ∀ f ∈ range fun l : Ici (0 : ℝ) ↦ fun x ↦ Real.exp (l * x - l ^ 2 / 2) - 1,
      Measurable f := by
    rintro _ ⟨l, rfl⟩
    fun_prop
  -- the completed measure, indexed by `Option α` with the far negative atom at `none`
  have hw' : ∀ k : Option α, 0 ≤ k.elim m fun k ↦ (1 - η) * w k := fun k ↦ by
    cases k
    exacts [hm0, hcw _]
  have hP : ∑ k, ENNReal.ofReal ((1 - η) * w k) • Measure.dirac (y k) +
      ENNReal.ofReal m • Measure.dirac z = ∑ k : Option α,
        ENNReal.ofReal (k.elim m fun k ↦ (1 - η) * w k) • Measure.dirac (k.elim z y) := by
    rw [Fintype.sum_option, add_comm]
    rfl
  refine ⟨z, ?_, by simp⟩
  rw [hP, oneSidedSubgaussianNull, sum_smul_dirac_mem_constraintNull_iff hΦ hw',
    Fintype.sum_option]
  refine ⟨by simp only [Option.elim_none, Option.elim_some, hsum]; ring, ?_⟩
  rintro _ ⟨⟨l, hl⟩, rfl⟩
  have := hz l hl
  rw [Fintype.sum_option]
  simp only [Option.elim_none, Option.elim_some, mul_sub, mul_one, Finset.sum_sub_distrib, hsum]
  linarith

/-- Every point is charged by a finitely supported one-sided `1`-sub-Gaussian probability law: a
small mass at the point, completed by a far negative atom. -/
private lemma exists_mem_oneSidedSubgaussianNull_measure_singleton_pos (y : ℝ) :
    ∃ μ ∈ oneSidedSubgaussianNull, (∃ S : Finset ℝ, μ (↑S)ᶜ = 0) ∧ 0 < μ {y} := by
  set w : ℝ := Real.exp (-(y ^ 2 / 2)) / 2 with hw
  have hw0 : 0 < w := by positivity
  have hW : ∀ l : ℝ, 0 ≤ l → ∑ _k : Unit, w * Real.exp (l * y - l ^ 2 / 2) < 1 := by
    intro l _
    have h : Real.exp (l * y - l ^ 2 / 2) ≤ Real.exp (y ^ 2 / 2) :=
      Real.exp_le_exp.2 (by nlinarith [sq_nonneg (l - y)])
    have h' : w * Real.exp (y ^ 2 / 2) = 1 / 2 := by
      rw [hw, div_mul_eq_mul_div, ← Real.exp_add]; simp
    simp only [Finset.univ_unique, Finset.sum_singleton]
    nlinarith
  obtain ⟨z, hP, hS⟩ := exists_mem_oneSidedSubgaussianNull_of_lt_one (w := fun _ : Unit ↦ w)
    (fun _ ↦ hw0.le) (fun _ ↦ y) hW (η := 1 / 2) (by norm_num) (by norm_num)
  refine ⟨_, hP, ⟨_, hS⟩, ?_⟩
  rw [add_apply]
  refine lt_of_lt_of_le ?_ le_self_add
  simp only [Finset.univ_unique, Finset.sum_singleton, smul_apply,
    Measure.dirac_apply_of_mem (Set.mem_singleton y), smul_eq_mul, mul_one]
  exact ENNReal.ofReal_pos.2 (by positivity)

/-! ### One-step domination by a mixture of exponentials -/

/-- The exponential kernel on the extended line: `exp (l x - l ^ 2 / 2)` at a real `l ≥ 0`, `1` at
a real `l ≤ 0` and at `⊥`, and `0` at `⊤`. -/
private noncomputable def expKernel (l : EReal) (x : ℝ) : ℝ :=
  if l = ⊤ then 0 else Real.exp (max l.toReal 0 * x - max l.toReal 0 ^ 2 / 2)

/-- The exponential kernel is nonnegative. -/
private lemma expKernel_nonneg (l : EReal) (x : ℝ) : 0 ≤ expKernel l x := by
  unfold expKernel; split_ifs <;> positivity

/-- The exponential kernel at a real parameter `t ≥ 0`. -/
private lemma expKernel_coe_of_nonneg {t : ℝ} (ht : 0 ≤ t) (x : ℝ) :
    expKernel t x = Real.exp (t * x - t ^ 2 / 2) := by
  simp [expKernel, max_eq_left ht]

/-- The exponential kernel is continuous in its parameter on the extended line. -/
private lemma continuous_expKernel (x : ℝ) : Continuous fun l ↦ expKernel l x := by
  have hc : Continuous fun t : ℝ ↦ expKernel t x := by
    simp only [expKernel, EReal.coe_ne_top, ↓reduceIte, EReal.toReal_coe]
    fun_prop
  refine continuous_iff_continuousAt.2 fun l ↦ ?_
  induction l using EReal.rec with
  | bot =>
    rw [← continuousWithinAt_compl_self, ContinuousWithinAt, EReal.nhdsWithin_bot]
    refine tendsto_map'_iff.2 (tendsto_const_nhds.congr' ?_)
    filter_upwards [eventually_le_atBot 0] with t ht
    simp [expKernel, max_eq_right ht]
  | coe t => exact EReal.isOpenEmbedding_coe.continuousAt_iff.1 hc.continuousAt
  | top =>
    rw [← continuousWithinAt_compl_self, ContinuousWithinAt, EReal.nhdsWithin_top]
    refine tendsto_map'_iff.2 ?_
    have hlim : Tendsto (fun t : ℝ ↦ t * x - t ^ 2 / 2) atTop atBot := by
      refine tendsto_atBot_mono' _ ?_ (tendsto_neg_atTop_atBot (G := ℝ))
      filter_upwards [eventually_ge_atTop (2 * (|x| + 1))] with t ht
      nlinarith [abs_nonneg x, le_abs_self x]
    simp only [expKernel, ↓reduceIte]
    refine (Real.tendsto_exp_atBot.comp hlim).congr' ?_
    filter_upwards [eventually_ge_atTop 0] with t ht
    simp [max_eq_left ht]

/-- The exponential kernel at `x`, as a bounded continuous function of its parameter. -/
private noncomputable def expBCF (x : ℝ) : EReal →ᵇ ℝ :=
  BoundedContinuousFunction.mkOfCompact ⟨fun l ↦ expKernel l x, continuous_expKernel x⟩

/-- Each section of the exponential kernel is integrable against a finite measure. -/
private lemma integrable_expKernel (π : FiniteMeasure EReal) (x : ℝ) :
    Integrable (fun l ↦ expKernel l x) (π : Measure EReal) :=
  (expBCF x).integrable _

/-- The exponential kernel is at most the exponential at the positive part of its parameter, with
`⊤` sent to `0`. -/
private lemma expKernel_le (l : EReal) (x : ℝ) :
    expKernel l x ≤ Real.exp ((l.toReal.toNNReal : ℝ) * x - (l.toReal.toNNReal : ℝ) ^ 2 / 2) := by
  unfold expKernel
  split_ifs
  · positivity
  · simp [Real.coe_toNNReal']

/-- The vector `(∫ e (l, y) ∂π(l))_{y ∈ F}` of a mixing measure `π`. -/
private noncomputable def expVec (F : Finset ℝ) (π : FiniteMeasure EReal) : F → ℝ :=
  fun y ↦ ∫ l, expKernel l y ∂(π : Measure EReal)

/-- The vector of a mixing measure depends continuously on it. -/
private lemma continuous_expVec (F : Finset ℝ) : Continuous (expVec F) :=
  continuous_pi fun y ↦ FiniteMeasure.continuous_integral_boundedContinuousFunction (expBCF y)

/-- The vector of a nonnegative combination of mixing measures. -/
private lemma expVec_add_smul (F : Finset ℝ) (π₁ π₂ : FiniteMeasure EReal) {a b : ℝ} (ha : 0 ≤ a)
    (hb : 0 ≤ b) :
    expVec F (a.toNNReal • π₁ + b.toNNReal • π₂) = a • expVec F π₁ + b • expVec F π₂ := by
  funext y
  simp only [expVec, FiniteMeasure.toMeasure_add, FiniteMeasure.toMeasure_smul, Pi.add_apply,
    Pi.smul_apply, smul_eq_mul]
  rw [integral_add_measure, integral_smul_nnreal_measure, integral_smul_nnreal_measure]
  · simp only [NNReal.smul_def, Real.coe_toNNReal _ ha, Real.coe_toNNReal _ hb, smul_eq_mul]
  · exact (integrable_expKernel π₁ y).smul_measure_nnreal
  · exact (integrable_expKernel π₂ y).smul_measure_nnreal

/-- The vector of a Dirac mass at a real `t ≥ 0`. -/
private lemma expVec_dirac (F : Finset ℝ) {t : ℝ} (ht : 0 ≤ t) :
    expVec F ⟨Measure.dirac (t : EReal), inferInstance⟩ =
      fun y : F ↦ Real.exp (t * y - t ^ 2 / 2) := by
  funext y; simp [expVec, integral_dirac, expKernel_coe_of_nonneg ht]

/-- The vectors dominated by the vector of a mixing measure of mass at most `1` form a closed set,
as the projection of a closed set along the compact space of such mixing measures. -/
private lemma isClosed_setOf_le_expVec (F : Finset ℝ) :
    IsClosed {v : F → ℝ | ∃ π : FiniteMeasure EReal, π.mass ≤ 1 ∧ v ≤ expVec F π} := by
  have hT : CompactSpace {π : FiniteMeasure EReal // π.mass ≤ 1} :=
    isCompact_iff_compactSpace.1 (isCompact_setOfPred_finiteMeasure_le_of_compactSpace EReal 1)
  have heq : {v : F → ℝ | ∃ π : FiniteMeasure EReal, π.mass ≤ 1 ∧ v ≤ expVec F π} =
      Prod.fst '' {p : (F → ℝ) × {π : FiniteMeasure EReal // π.mass ≤ 1} |
        p.1 ≤ expVec F p.2.1} := by
    ext v
    exact ⟨fun ⟨π, hπ1, hπ⟩ ↦ ⟨(v, ⟨π, hπ1⟩), hπ, rfl⟩,
      fun ⟨⟨_, π⟩, hπ, h⟩ ↦ ⟨π.1, π.2, h ▸ hπ⟩⟩
  rw [heq]
  exact isClosedMap_fst_of_compactSpace _ (isClosed_le continuous_fst
    ((continuous_expVec F).comp (continuous_subtype_val.comp continuous_snd)))

/-- The vectors dominated by the vector of a mixing measure of mass at most `1` form a convex
set. -/
private lemma convex_setOf_le_expVec (F : Finset ℝ) :
    Convex ℝ {v : F → ℝ | ∃ π : FiniteMeasure EReal, π.mass ≤ 1 ∧ v ≤ expVec F π} := by
  rintro v₁ ⟨π₁, hπ₁, h₁⟩ v₂ ⟨π₂, hπ₂, h₂⟩ a b ha hb hab
  refine ⟨a.toNNReal • π₁ + b.toNNReal • π₂, ?_, ?_⟩
  · rw [FiniteMeasure.mass_add, FiniteMeasure.mass_smul, FiniteMeasure.mass_smul, smul_eq_mul,
      smul_eq_mul]
    calc a.toNNReal * π₁.mass + b.toNNReal * π₂.mass ≤ a.toNNReal * 1 + b.toNNReal * 1 := by
          gcongr
      _ = 1 := by rw [mul_one, mul_one, ← Real.toNNReal_add ha hb, hab, Real.toNNReal_one]
  · rw [expVec_add_smul F π₁ π₂ ha hb]
    exact add_le_add (smul_le_smul_of_nonneg_left h₁ ha) (smul_le_smul_of_nonneg_left h₂ hb)

/-- The completion step on a finite set of points: a function whose mean is at most `1` under
every finitely supported one-sided `1`-sub-Gaussian law has mean at most `1` under every
nonnegative weighting `w` of the points whose exponential means are all below `1`. Otherwise, for
`η := (S - 1) / (2 S)` with `S` the mean of `f`, completing `(1 - η) w` into a member of the
one-step null gives a law under which `f` has mean at least `(1 - η) S > 1`. -/
private lemma not_one_lt_sum_mul_toReal_of_forall_lintegral_le_one {f : ℝ → ℝ≥0∞}
    (hf : ∀ μ ∈ oneSidedSubgaussianNull, ∀ S : Finset ℝ, μ (↑S)ᶜ = 0 → ∫⁻ x, f x ∂μ ≤ 1)
    (hfin : ∀ x, f x ≠ ⊤) {F : Finset ℝ} {w : F → ℝ} (hw : ∀ i, 0 ≤ w i)
    (hW : ∀ l : ℝ, 0 ≤ l → ∑ i : F, w i * Real.exp (l * i - l ^ 2 / 2) < 1) :
    ¬ 1 < ∑ i : F, w i * (f i).toReal := by
  set Sf := ∑ i : F, w i * (f i).toReal with hSfdef
  intro hSf
  set η := (Sf - 1) / (2 * Sf) with hηdef
  have hη0 : 0 < η := div_pos (by linarith) (by linarith)
  have hη1 : η < 1 := by rw [hηdef, div_lt_one (by linarith)]; linarith
  have hηS : 1 < (1 - η) * Sf := by
    have : (1 - η) * Sf = (Sf + 1) / 2 := by rw [hηdef]; field_simp; ring
    rw [this]; linarith
  obtain ⟨z, hPmem, hPsupp⟩ :=
    exists_mem_oneSidedSubgaussianNull_of_lt_one hw (fun i : F ↦ (i : ℝ)) hW hη0 hη1
  have hfP := hf _ hPmem _ hPsupp
  have hcw : ∀ i, 0 ≤ (1 - η) * w i := fun i ↦ mul_nonneg (by linarith) (hw i)
  have hlow : ENNReal.ofReal ((1 - η) * Sf) ≤ ∫⁻ x, f x ∂(∑ i : F,
      ENNReal.ofReal ((1 - η) * w i) • Measure.dirac (i : ℝ) +
      ENNReal.ofReal (1 - (1 - η) * ∑ i : F, w i) • Measure.dirac z) := by
    rw [lintegral_add_measure, LMLExplore.lintegral_sum_smul_dirac]
    refine le_trans ?_ le_self_add
    rw [hSfdef, Finset.mul_sum, ENNReal.ofReal_sum_of_nonneg fun i _ ↦
      mul_nonneg (by linarith) (mul_nonneg (hw i) ENNReal.toReal_nonneg)]
    refine le_of_eq (Finset.sum_congr rfl fun i _ ↦ ?_)
    rw [← mul_assoc, ENNReal.ofReal_mul (hcw i), ENNReal.ofReal_toReal (hfin i)]
  have := hlow.trans hfP
  rw [ENNReal.ofReal_le_one] at this
  linarith

/-- One-step domination on a finite set of points: a function whose mean is at most `1` under
every finitely supported one-sided `1`-sub-Gaussian law is dominated there by a mixture of
exponentials with a mixing measure of mass at most `1`. Otherwise a separating functional gives a
finitely supported measure with exponential means below `1` under which the function has mean
above `1`, and the completion step makes it a member of the one-step null. -/
private lemma exists_le_expVec {f : ℝ → ℝ≥0∞}
    (hf : ∀ μ ∈ oneSidedSubgaussianNull, ∀ S : Finset ℝ, μ (↑S)ᶜ = 0 → ∫⁻ x, f x ∂μ ≤ 1)
    (hfin : ∀ x, f x ≠ ⊤) (F : Finset ℝ) :
    ∃ π : FiniteMeasure EReal, π.mass ≤ 1 ∧ (fun y : F ↦ (f y).toReal) ≤ expVec F π := by
  set C : Set (F → ℝ) := {v | ∃ π : FiniteMeasure EReal, π.mass ≤ 1 ∧ v ≤ expVec F π}
  -- the goal is, by definition of `C`, that the vector of the values of `f` lies in `C`
  change (fun y : F ↦ (f y).toReal) ∈ C
  by_contra hv₀
  obtain ⟨φ, u, hφ, hu⟩ := geometric_hahn_banach_closed_point (s := C)
    (convex_setOf_le_expVec F) (isClosed_setOf_le_expVec F) hv₀
  have hle0 : ∀ v : F → ℝ, v ≤ 0 → v ∈ C := fun v hv ↦
    ⟨0, by simp, fun y ↦ (hv y).trans (by simp [expVec])⟩
  have hu0 : 0 < u := by simpa using hφ 0 (hle0 0 le_rfl)
  set q : F → ℝ := fun i ↦ φ (fun j ↦ if i = j then 1 else 0) with hq
  have hφsum : ∀ v, φ v = ∑ i : F, v i * q i := fun v ↦ by
    simpa [smul_eq_mul] using LinearMap.pi_apply_eq_sum_univ (φ : (F → ℝ) →ₗ[ℝ] ℝ) v
  have hq0 : ∀ i, 0 ≤ q i := fun i ↦ by
    have hi : (fun j ↦ if i = j then (1 : ℝ) else 0) = Pi.single i 1 :=
      funext fun j ↦ by simp only [Pi.single_apply, @eq_comm _ j i]
    rw [hq]
    dsimp only
    rw [hi]
    exact LinearMap.apply_single_nonneg_of_forall_nonpos_lt (φ : (F → ℝ) →ₗ[ℝ] ℝ)
      (fun v hv ↦ hφ v (hle0 v hv)) i
  have hexp : ∀ l : ℝ, 0 ≤ l → ∑ i : F, Real.exp (l * i - l ^ 2 / 2) * q i < u := by
    intro l hl
    have := hφ _ ⟨⟨Measure.dirac (l : EReal), inferInstance⟩, by simp [FiniteMeasure.mass],
      le_of_eq (expVec_dirac F hl).symm⟩
    rwa [hφsum] at this
  have hpos : u < ∑ i : F, (f i).toReal * q i := by rw [← hφsum]; exact hu
  -- the separating functional, divided by `u`, is a measure with exponential means below `1`
  -- under which `f` has mean above `1`, which the completion step rules out
  refine not_one_lt_sum_mul_toReal_of_forall_lintegral_le_one hf hfin
    (w := fun i ↦ q i / u) (fun i ↦ div_nonneg (hq0 i) hu0.le) (fun l hl ↦ ?_) ?_
  · simp_rw [div_mul_eq_mul_div, ← Finset.sum_div, mul_comm (q _)]
    exact (div_lt_one hu0).2 (hexp l hl)
  · simp_rw [div_mul_eq_mul_div, ← Finset.sum_div, mul_comm (q _)]
    exact (one_lt_div hu0).2 hpos

/-- **One-step domination** for the one-sided `1`-sub-Gaussian null: a function `f : ℝ → ℝ≥0∞`,
measurable or not, whose mean is at most `1` under every finitely supported member of
`oneSidedSubgaussianNull` is dominated at every point `x` by a mixture
`∫ exp (l x - l ^ 2 / 2) ∂π(l)` of the exponentials, for a mixing measure `π` on `[0, ∞)` of mass
at most `1`. This is the one-sided `1`-sub-Gaussian case of [LRR26, Theorem 4.3], with validity
required only under the finitely supported laws. -/
theorem exists_le_lintegral_exp_of_forall_lintegral_le_one {f : ℝ → ℝ≥0∞}
    (hf : ∀ μ ∈ oneSidedSubgaussianNull, (∃ S : Finset ℝ, μ (↑S)ᶜ = 0) → ∫⁻ x, f x ∂μ ≤ 1) :
    ∃ π : Measure ℝ≥0, π univ ≤ 1 ∧ ∀ x, f x ≤
      ∫⁻ l, ENNReal.ofReal (Real.exp ((l : ℝ) * x - (l : ℝ) ^ 2 / 2)) ∂π := by
  replace hf : ∀ μ ∈ oneSidedSubgaussianNull, ∀ S : Finset ℝ, μ (↑S)ᶜ = 0 →
      ∫⁻ x, f x ∂μ ≤ 1 := fun μ hμ S hS ↦ hf μ hμ ⟨S, hS⟩
  have hfin : ∀ x, f x ≠ ⊤ := by
    intro x
    obtain ⟨μ, hμ, ⟨S, hS⟩, hpos⟩ := exists_mem_oneSidedSubgaussianNull_measure_singleton_pos x
    have h : f x * μ {x} ≤ 1 := (mul_measure_singleton_le_lintegral f x).trans (hf μ hμ S hS)
    intro htop
    rw [htop, ENNReal.top_mul hpos.ne'] at h
    exact absurd h (by simp)
  have hK := isCompact_setOfPred_finiteMeasure_le_of_compactSpace EReal 1
  set t : ℝ → Set (FiniteMeasure EReal) := fun x ↦
    {π | (f x).toReal ≤ ∫ l, expKernel l x ∂(π : Measure EReal)}
  have ht : ∀ x, IsClosed (t x) := fun x ↦ isClosed_le continuous_const
    (FiniteMeasure.continuous_integral_boundedContinuousFunction (expBCF x))
  have hfip : ∀ u : Finset ℝ,
      ({π : FiniteMeasure EReal | π.mass ≤ 1} ∩ ⋂ i ∈ u, t i).Nonempty := by
    intro u
    obtain ⟨π, hπ1, hπ⟩ := exists_le_expVec hf hfin u
    exact ⟨π, hπ1, Set.mem_iInter₂.2 fun x hx ↦ hπ ⟨x, hx⟩⟩
  obtain ⟨π, hπK, hπt⟩ := hK.inter_iInter_nonempty t ht hfip
  set g : EReal → ℝ≥0 := fun l ↦ l.toReal.toNNReal with hgdef
  have hg : Measurable g := measurable_real_toNNReal.comp measurable_ereal_toReal
  refine ⟨(π : Measure EReal).map g, ?_, fun x ↦ ?_⟩
  · rw [Measure.map_apply hg MeasurableSet.univ, Set.preimage_univ,
      ← FiniteMeasure.ennreal_mass]
    exact_mod_cast hπK
  · rw [lintegral_map (by fun_prop) hg]
    calc f x = ENNReal.ofReal (f x).toReal := (ENNReal.ofReal_toReal (hfin x)).symm
      _ ≤ ENNReal.ofReal (∫ l, expKernel l x ∂(π : Measure EReal)) :=
          ENNReal.ofReal_le_ofReal (Set.mem_iInter.1 hπt x)
      _ = ∫⁻ l, ENNReal.ofReal (expKernel l x) ∂(π : Measure EReal) :=
          ofReal_integral_eq_lintegral_ofReal (integrable_expKernel π x)
            (ae_of_all _ fun l ↦ expKernel_nonneg l x)
      _ ≤ _ := lintegral_mono fun l ↦ ENNReal.ofReal_le_ofReal (expKernel_le l x)

/-! ### The tree envelope -/

/-- A law on paths after a history `ω` of length `k`: it agrees almost surely with `ω` on the
first `k` coordinates and satisfies the conditional one-sided sub-Gaussian constraint at every
time `n ≥ k`. -/
private structure IsTreeLaw (k : ℕ) (ω : ℕ → ℝ) (Q : Measure (ℕ → ℝ)) : Prop where
  /-- The law is a probability measure. -/
  isProbabilityMeasure : IsProbabilityMeasure Q
  /-- The law agrees almost surely with `ω` on the first `k` coordinates. -/
  ae_prefix : ∀ᵐ ω' ∂Q, ∀ i < k, ω' i = ω i
  /-- The conditional one-sided sub-Gaussian constraint at every time `n ≥ k`. -/
  constraint : ∀ n, k ≤ n → ∀ l : ℝ, 0 ≤ l → ∀ s : Set (ℕ → ℝ),
    MeasurableSet[Filtration.naturalLT (fun i (ω : ℕ → ℝ) ↦ ω i) measurable_pi_apply n] s →
    ∫⁻ ω' in s, ENNReal.ofReal (Real.exp (l * ω' n - l ^ 2 / 2)) ∂Q ≤ Q s

/-- A strategy after a history `ω` of length `k`: a finitely supported law after `ω` and a bounded
stopping time that does not stop before time `k - 1`. -/
private structure IsStrategy (k : ℕ) (ω : ℕ → ℝ) (p : Measure (ℕ → ℝ) × ((ℕ → ℝ) → ℕ)) :
    Prop where
  /-- The law is a law after `ω`. -/
  isTreeLaw : IsTreeLaw k ω p.1
  /-- The time is a stopping time. -/
  isStoppingTime :
    IsStoppingTime (Filtration.piLE (X := fun _ : ℕ ↦ ℝ)) (fun ω' ↦ (p.2 ω' : WithTop ℕ))
  /-- The time does not stop before time `k - 1`. -/
  le_time : ∀ ω', k - 1 ≤ p.2 ω'
  /-- The law is carried by a finite set. -/
  exists_finset : ∃ T : Finset (ℕ → ℝ), p.1 (↑T)ᶜ = 0
  /-- The time is bounded. -/
  bddAbove : ∃ N, ∀ ω', p.2 ω' ≤ N

/-- A strategy after `ω` is a strategy after every history with the same first `k`
coordinates. -/
private lemma IsStrategy.of_prefix {k : ℕ} {ω ω' : ℕ → ℝ} (h : ∀ i < k, ω i = ω' i)
    {p : Measure (ℕ → ℝ) × ((ℕ → ℝ) → ℕ)} (hp : IsStrategy k ω p) : IsStrategy k ω' p :=
  { hp with isTreeLaw := { hp.isTreeLaw with
      ae_prefix := hp.isTreeLaw.ae_prefix.mono fun _ h' i hi ↦ (h' i hi).trans (h i hi) } }

/-- The envelope of a process `E` after a history `ω` of length `k`: the best mean of `E` at a
bounded stopping time under a finitely supported member of the null continuing that history. -/
private noncomputable def envelope (E : ℕ → (ℕ → ℝ) → ℝ≥0∞) (k : ℕ) (ω : ℕ → ℝ) : ℝ≥0∞ :=
  ⨆ (p) (_ : IsStrategy k ω p), ∫⁻ ω', E (p.2 ω') ω' ∂p.1

/-- The mean of `E` under a strategy is at most the envelope. -/
private lemma lintegral_le_envelope (E : ℕ → (ℕ → ℝ) → ℝ≥0∞) {k : ℕ} {ω : ℕ → ℝ}
    {p : Measure (ℕ → ℝ) × ((ℕ → ℝ) → ℕ)} (hp : IsStrategy k ω p) :
    ∫⁻ ω', E (p.2 ω') ω' ∂p.1 ≤ envelope E k ω :=
  le_iSup₂ (f := fun p (_ : IsStrategy k ω p) ↦ ∫⁻ ω', E (p.2 ω') ω' ∂p.1) p hp

/-- The envelope after a history only depends on its first `k` coordinates. -/
private lemma envelope_congr (E : ℕ → (ℕ → ℝ) → ℝ≥0∞) {k : ℕ} {ω ω' : ℕ → ℝ}
    (h : ∀ i < k, ω i = ω' i) : envelope E k ω = envelope E k ω' := by
  have : ∀ p, IsStrategy k ω p ↔ IsStrategy k ω' p := fun _ ↦
    ⟨IsStrategy.of_prefix h, IsStrategy.of_prefix fun i hi ↦ (h i hi).symm⟩
  simp only [envelope, this]

/-- The path `ω` continued by zeros after time `k`. -/
private def extendZero (k : ℕ) (ω : ℕ → ℝ) : ℕ → ℝ := fun i ↦ if i ≤ k then ω i else 0

/-- Stopping at once under the Dirac mass at the history continued by zeros is a strategy. -/
private lemma isStrategy_dirac_extendZero (k : ℕ) (ω : ℕ → ℝ) :
    IsStrategy (k + 1) ω (Measure.dirac (extendZero k ω), fun _ ↦ k) := by
  refine ⟨⟨inferInstance, ?_, fun n hn l _ s _ ↦ ?_⟩, isStoppingTime_const _ _, fun _ ↦ by simp,
    ⟨{extendZero k ω}, ?_⟩, ⟨k, fun _ ↦ le_rfl⟩⟩
  · rw [ae_dirac_eq, Filter.eventually_pure]
    intro i hi
    simp [extendZero, Nat.lt_succ_iff.1 hi]
  · have hle : ∀ᵐ ω' ∂(Measure.dirac (extendZero k ω)).restrict s,
        ENNReal.ofReal (Real.exp (l * ω' n - l ^ 2 / 2)) ≤ 1 := by
      refine ae_restrict_of_ae ?_
      rw [ae_dirac_eq]
      simp only [Filter.eventually_pure, extendZero, show ¬ n ≤ k by omega, ↓reduceIte,
        mul_zero, zero_sub]
      exact ENNReal.ofReal_le_one.2 (Real.exp_le_one_iff.2 (by nlinarith [sq_nonneg l]))
    calc ∫⁻ ω' in s, ENNReal.ofReal (Real.exp (l * ω' n - l ^ 2 / 2))
          ∂Measure.dirac (extendZero k ω)
        ≤ ∫⁻ _ in s, 1 ∂Measure.dirac (extendZero k ω) := lintegral_mono_ae hle
      _ = Measure.dirac (extendZero k ω) s := by simp
  · rw [Finset.coe_singleton, Measure.dirac_apply' _ (measurableSet_singleton _).compl]
    simp

/-- The envelope after `k + 1` observations dominates a process that only depends at time `k` on
the coordinates up to `k`. -/
private lemma le_envelope_succ {E : ℕ → (ℕ → ℝ) → ℝ≥0∞} (hE : ∀ n, DependsOn (E n) (Iic n))
    (k : ℕ) (ω : ℕ → ℝ) : E k ω ≤ envelope E (k + 1) ω := by
  refine le_trans (le_of_eq ?_) (lintegral_le_envelope E (isStrategy_dirac_extendZero k ω))
  simp only [lintegral_dirac]
  exact hE k fun i hi ↦ by simp [extendZero, Set.mem_Iic.1 hi]

/-- Under a strategy after `update ω k y`, the coordinate `k` is almost surely `y`. -/
private lemma ae_coord_eq_of_isStrategy {k : ℕ} {ω : ℕ → ℝ} {y : ℝ}
    {p : Measure (ℕ → ℝ) × ((ℕ → ℝ) → ℕ)}
    (hp : IsStrategy (k + 1) (Function.update ω k y) p) : ∀ᵐ ω' ∂p.1, ω' k = y :=
  hp.isTreeLaw.ae_prefix.mono fun ω' h ↦ by rw [h k (Nat.lt_succ_self k), Function.update_self]

/-- The grafted stopping time: on the paths whose coordinate `k` is a point `y ∈ S`, the stopping
time `τ y`, and `k` elsewhere. -/
private noncomputable def graftTime (k : ℕ) (S : Finset ℝ) (τ : ℝ → (ℕ → ℝ) → ℕ)
    (ω' : ℕ → ℝ) : ℕ :=
  if ω' k ∈ S then τ (ω' k) ω' else k

/-- The grafted time is a stopping time. -/
private lemma isStoppingTime_graftTime {k : ℕ} {S : Finset ℝ} {τ : ℝ → (ℕ → ℝ) → ℕ}
    (hτ : ∀ y, IsStoppingTime (Filtration.piLE (X := fun _ : ℕ ↦ ℝ))
      (fun ω' ↦ (τ y ω' : WithTop ℕ)))
    (hτk : ∀ y ω', k ≤ τ y ω') :
    IsStoppingTime (Filtration.piLE (X := fun _ : ℕ ↦ ℝ))
      (fun ω' ↦ (graftTime k S τ ω' : WithTop ℕ)) := by
  intro m
  simp only [Nat.cast_withTop, WithTop.coe_le_coe]
  by_cases hm : k ≤ m
  · have heq : {ω' : ℕ → ℝ | graftTime k S τ ω' ≤ m} =
        (⋃ y ∈ S, {ω' : ℕ → ℝ | ω' k = y} ∩ {ω' | τ y ω' ≤ m}) ∪ {ω' | ω' k ∉ S} := by
      ext ω'
      simp only [graftTime, Set.mem_ofPred_eq, Set.mem_union, Set.mem_iUnion, Set.mem_inter_iff,
        exists_prop]
      by_cases h : ω' k ∈ S
      · simp only [h, ↓reduceIte, not_true_eq_false, or_false]
        exact ⟨fun h' ↦ ⟨_, h, rfl, h'⟩, fun ⟨y, _, hy, h'⟩ ↦ hy ▸ h'⟩
      · simp only [h, ↓reduceIte, hm, not_false_eq_true, or_true]
    rw [heq]
    have hA : MeasurableSet[Filtration.piLE (X := fun _ : ℕ ↦ ℝ) m]
        (⋃ y ∈ S, {ω' : ℕ → ℝ | ω' k = y} ∩ {ω' | τ y ω' ≤ m}) := by
      refine Finset.measurableSet_biUnion _ fun y _ ↦ ?_
      refine (Filtration.measurable_piLE_apply (X := fun _ : ℕ ↦ ℝ) hm
        (measurableSet_singleton y)).inter ?_
      simpa only [Nat.cast_withTop, WithTop.coe_le_coe] using hτ y m
    exact hA.union
      (Filtration.measurable_piLE_apply (X := fun _ : ℕ ↦ ℝ) hm (S.measurableSet.compl))
  · have heq : {ω' : ℕ → ℝ | graftTime k S τ ω' ≤ m} = ∅ := by
      ext ω'
      simp only [graftTime, Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, not_le]
      split_ifs
      · exact lt_of_lt_of_le (by omega) (hτk _ ω')
      · omega
    rw [heq]
    exact @MeasurableSet.empty _ (Filtration.piLE (X := fun _ : ℕ ↦ ℝ) m)

/-- The grafted law: the mixture of the laws `(g y).1`, for `y ∈ S`, with the weights `P {y}`. -/
private noncomputable def graftLaw (S : Finset ℝ) (P : Measure ℝ)
    (g : ℝ → Measure (ℕ → ℝ) × ((ℕ → ℝ) → ℕ)) : Measure (ℕ → ℝ) :=
  ∑ y ∈ S, P {y} • (g y).1

/-- The integral against the grafted law is the mixture of the integrals against the laws
`(g y).1`. -/
private lemma lintegral_graftLaw (S : Finset ℝ) (P : Measure ℝ)
    (g : ℝ → Measure (ℕ → ℝ) × ((ℕ → ℝ) → ℕ)) (F : (ℕ → ℝ) → ℝ≥0∞) :
    ∫⁻ ω', F ω' ∂graftLaw S P g = ∑ y ∈ S, P {y} * ∫⁻ ω', F ω' ∂(g y).1 := by
  rw [graftLaw, lintegral_finsetSum_measure]
  simp only [lintegral_smul_measure, smul_eq_mul]

/-- Grafting: strategies after the histories `update ω k y`, for `y` in the support `S` of a
finitely supported one-sided sub-Gaussian law `P`, combine into a strategy after `ω`. -/
private lemma isStrategy_graft {k : ℕ} {ω : ℕ → ℝ} {P : Measure ℝ}
    (hP : P ∈ oneSidedSubgaussianNull) {S : Finset ℝ} (hS : P (↑S)ᶜ = 0)
    (g : ℝ → Measure (ℕ → ℝ) × ((ℕ → ℝ) → ℕ))
    (hg : ∀ y, IsStrategy (k + 1) (Function.update ω k y) (g y)) :
    IsStrategy k ω (graftLaw S P g, graftTime k S fun y ↦ (g y).2) := by
  have := (mem_oneSidedSubgaussianNull_iff.1 hP).1
  have hprob : ∀ y, IsProbabilityMeasure (g y).1 := fun y ↦ (hg y).isTreeLaw.isProbabilityMeasure
  set Q := graftLaw S P g with hQ
  have hQint := lintegral_graftLaw S P g
  have hQprob : IsProbabilityMeasure Q := by
    constructor
    have h1 := hQint fun _ ↦ 1
    simp only [lintegral_const, measure_univ, mul_one, one_mul] at h1
    have h2 := lintegral_eq_sum_of_measure_compl_eq_zero hS fun _ ↦ 1
    simp only [lintegral_const, measure_univ, one_mul] at h2
    rw [h1, ← h2]
  have hQpre : ∀ᵐ ω' ∂Q, ∀ i < k, ω' i = ω i := by
    rw [hQ, graftLaw, ae_finsetSum_measure_iff]
    intro y _
    refine Measure.ae_smul_measure ((hg y).isTreeLaw.ae_prefix.mono fun ω' h i hi ↦ ?_) _
    rw [h i (by omega), Function.update_of_ne (by omega)]
  choose T hT using fun y ↦ (hg y).exists_finset
  choose N hN using fun y ↦ (hg y).bddAbove
  classical
  refine ⟨⟨hQprob, hQpre, fun n hn l hl s hs ↦ ?_⟩,
    isStoppingTime_graftTime (fun y ↦ (hg y).isStoppingTime)
      (fun y ω' ↦ by have := (hg y).le_time ω'; omega),
    fun ω' ↦ ?_, ⟨S.biUnion T, ?_⟩, ⟨k + ∑ y ∈ S, N y, fun ω' ↦ ?_⟩⟩
  · have hs' : MeasurableSet s := (Filtration.naturalLT _ _).le n s hs
    rcases hn.lt_or_eq with hn | rfl
    · -- after the grafted round, the constraint holds under each continuation
      rw [← lintegral_indicator hs', hQint]
      calc ∑ y ∈ S, P {y} * ∫⁻ ω', s.indicator (fun ω' ↦
            ENNReal.ofReal (Real.exp (l * ω' n - l ^ 2 / 2))) ω' ∂(g y).1
          ≤ ∑ y ∈ S, P {y} * (g y).1 s := by
            refine Finset.sum_le_sum fun y _ ↦ mul_le_mul_right ?_ _
            rw [lintegral_indicator hs']
            exact (hg y).isTreeLaw.constraint n hn l hl s hs
        _ = Q s := by simp [hQ, graftLaw]
    · -- at the grafted round, the constraint is that of `P`
      have hs' := Filtration.naturalLT_eval_le_comap k s hs
      rw [setLIntegral_eq_ite_of_ae_prefix hQpre hs', measure_eq_ite_of_ae_prefix hQpre hs',
        measure_univ]
      split_ifs
      · rw [hQint]
        calc ∑ y ∈ S, P {y} * ∫⁻ ω', ENNReal.ofReal (Real.exp (l * ω' k - l ^ 2 / 2)) ∂(g y).1
            = ∑ y ∈ S, ENNReal.ofReal (Real.exp (l * y - l ^ 2 / 2)) * P {y} := by
              refine Finset.sum_congr rfl fun y _ ↦ ?_
              rw [lintegral_congr_ae ((ae_coord_eq_of_isStrategy (hg y)).mono fun ω' h ↦
                by rw [h]), lintegral_const, measure_univ, mul_one, mul_comm]
          _ = ∫⁻ x, ENNReal.ofReal (Real.exp (l * x - l ^ 2 / 2)) ∂P :=
              (lintegral_eq_sum_of_measure_compl_eq_zero hS _).symm
          _ ≤ 1 := (mem_oneSidedSubgaussianNull_iff.1 hP).2 l hl
      · exact le_rfl
  · dsimp only [graftTime]
    split_ifs
    · have := (hg (ω' k)).le_time ω'
      omega
    · omega
  · simp only [hQ, graftLaw, sum_apply, smul_apply, smul_eq_mul]
    refine Finset.sum_eq_zero fun y hy ↦ mul_eq_zero_of_right _ (measure_mono_null
      (Set.compl_subset_compl.2 (Finset.coe_subset.2 (Finset.subset_biUnion_of_mem T hy))) (hT y))
  · dsimp only [graftTime]
    split_ifs with h
    · exact (hN _ ω').trans ((Finset.single_le_sum (fun y _ ↦ Nat.zero_le (N y)) h).trans
        (Nat.le_add_left _ _))
    · exact Nat.le_add_right _ _

/-- The mean of the process at the grafted stopping time under the grafted law. -/
private lemma lintegral_graft {E : ℕ → (ℕ → ℝ) → ℝ≥0∞} {k : ℕ} {ω : ℕ → ℝ} {P : Measure ℝ}
    {S : Finset ℝ} (g : ℝ → Measure (ℕ → ℝ) × ((ℕ → ℝ) → ℕ))
    (hg : ∀ y, IsStrategy (k + 1) (Function.update ω k y) (g y)) :
    ∫⁻ ω', E (graftTime k S (fun y ↦ (g y).2) ω') ω' ∂graftLaw S P g =
      ∑ y ∈ S, P {y} * ∫⁻ ω', E ((g y).2 ω') ω' ∂(g y).1 := by
  rw [lintegral_graftLaw]
  refine Finset.sum_congr rfl fun y hy ↦ ?_
  congr 1
  refine lintegral_congr_ae ((ae_coord_eq_of_isStrategy (hg y)).mono fun ω' h ↦ ?_)
  simp only [graftTime, h, hy, ↓reduceIte]

/-- Concatenation: the mean of the envelope after one more observation, under a finitely
supported one-sided sub-Gaussian law, is at most the current envelope. -/
private lemma lintegral_envelope_update_le (E : ℕ → (ℕ → ℝ) → ℝ≥0∞) {k : ℕ} (ω : ℕ → ℝ)
    {P : Measure ℝ} (hP : P ∈ oneSidedSubgaussianNull) {S : Finset ℝ} (hS : P (↑S)ᶜ = 0) :
    ∫⁻ y, envelope E (k + 1) (Function.update ω k y) ∂P ≤ envelope E k ω := by
  classical
  rw [lintegral_eq_sum_of_measure_compl_eq_zero hS]
  let St : ℝ → Type := fun y ↦ {p // IsStrategy (k + 1) (Function.update ω k y) p}
  have g₀ : ∀ y, St y := fun y ↦
    ⟨_, isStrategy_dirac_extendZero k (Function.update ω k y)⟩
  let val : (y : ℝ) → St y → ℝ≥0∞ := fun y p ↦ ∫⁻ ω', E (p.1.2 ω') ω' ∂p.1.1
  have hW : ∀ y, envelope E (k + 1) (Function.update ω k y) * P {y} =
      ⨆ g : (∀ y, St y), val y (g y) * P {y} := by
    intro y
    rw [envelope, iSup_subtype', ENNReal.iSup_mul]
    refine le_antisymm (iSup_le fun p ↦ ?_) (iSup_le fun g ↦ le_iSup (fun p : St y ↦
      val y p * P {y}) (g y))
    exact le_iSup_of_le (Function.update g₀ y p) (by rw [Function.update_self])
  simp_rw [hW]
  rw [ENNReal.finsetSum_iSup fun g₁ g₂ ↦ ⟨fun y ↦ if val y (g₁ y) ≤ val y (g₂ y) then g₂ y
    else g₁ y, fun y ↦ by
      dsimp only
      split_ifs with h
      · exact ⟨by gcongr, le_rfl⟩
      · exact ⟨le_rfl, by gcongr; exact le_of_not_ge h⟩⟩]
  refine iSup_le fun g ↦ ?_
  have hmem := isStrategy_graft hP hS (fun y ↦ (g y).1) (fun y ↦ (g y).2)
  calc ∑ y ∈ S, val y (g y) * P {y} = ∫⁻ ω', E (graftTime k S (fun y ↦ (g y).1.2) ω') ω'
        ∂graftLaw S P (fun y ↦ (g y).1) := by
        rw [lintegral_graft (fun y ↦ (g y).1) (fun y ↦ (g y).2)]
        exact Finset.sum_congr rfl fun y _ ↦ mul_comm _ _
    _ ≤ envelope E k ω := lintegral_le_envelope E hmem

/-- A mixture of the exponentials with a mixing measure of mass at most `1` is finite. -/
private lemma lintegral_exp_ne_top {π : Measure ℝ≥0} (hπ : π univ ≤ 1) (y : ℝ) :
    ∫⁻ l, ENNReal.ofReal (Real.exp ((l : ℝ) * y - (l : ℝ) ^ 2 / 2)) ∂π ≠ ⊤ := by
  refine ne_top_of_le_ne_top (b := ∫⁻ _, ENNReal.ofReal (Real.exp (y ^ 2 / 2)) ∂π) ?_
    (lintegral_mono fun l ↦ ENNReal.ofReal_le_ofReal (Real.exp_le_exp.2 ?_))
  · rw [lintegral_const]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ne_top_of_le_ne_top ENNReal.one_ne_top hπ)
  · nlinarith [sq_nonneg ((l : ℝ) - y)]

/-- One step: when the envelope after a history `ω` of length `k` is neither `0` nor `⊤`, the
envelope after one more observation `y` is at most the current envelope times a mixture of
exponentials at `y`, with a mixing measure of mass at most `1`. -/
private lemma exists_envelope_succ_le_mul (E : ℕ → (ℕ → ℝ) → ℝ≥0∞) {k : ℕ} {ω : ℕ → ℝ}
    (h0 : envelope E k ω ≠ 0) (htop : envelope E k ω ≠ ⊤) :
    ∃ π : Measure ℝ≥0, π univ ≤ 1 ∧ ∀ y, envelope E (k + 1) (Function.update ω k y) ≤
      envelope E k ω * ∫⁻ l, ENNReal.ofReal (Real.exp ((l : ℝ) * y - (l : ℝ) ^ 2 / 2)) ∂π := by
  obtain ⟨π, hπ1, hπ⟩ := exists_le_lintegral_exp_of_forall_lintegral_le_one
    (f := fun y ↦ envelope E (k + 1) (Function.update ω k y) / envelope E k ω)
    fun P hP ⟨S, hS⟩ ↦ by
      simp_rw [div_eq_mul_inv]
      rw [lintegral_mul_const' _ _ (ENNReal.inv_ne_top.2 h0), ← div_eq_mul_inv]
      exact ENNReal.div_le_of_le_mul
        (by rw [one_mul]; exact lintegral_envelope_update_le E (k := k) ω hP hS)
  refine ⟨π, hπ1, fun y ↦ ?_⟩
  have := hπ y
  rwa [ENNReal.div_le_iff h0 htop, mul_comm] at this

/-- After a history whose envelope is `0`, the envelope stays `0` after one more observation:
every point is charged by a finitely supported law of the one-step null. -/
private lemma envelope_succ_update_eq_zero (E : ℕ → (ℕ → ℝ) → ℝ≥0∞) {k : ℕ} {ω : ℕ → ℝ}
    (h0 : envelope E k ω = 0) (y : ℝ) :
    envelope E (k + 1) (Function.update ω k y) = 0 := by
  obtain ⟨μ, hμ, ⟨S, hS⟩, hpos⟩ := exists_mem_oneSidedSubgaussianNull_measure_singleton_pos y
  have hle := (mul_measure_singleton_le_lintegral
    (fun x ↦ envelope E (k + 1) (Function.update ω k x)) y).trans
      ((lintegral_envelope_update_le E ω hμ hS).trans_eq h0)
  exact (mul_eq_zero.1 (nonpos_iff_eq_zero.1 hle)).resolve_right hpos.ne'

/-- Selection and induction: a process that only depends at time `n` on the coordinates up to
`n`, and whose envelope is at most `1` at the root, is dominated on every path by a product of
one-step mixtures of exponentials whose mixing measures, of mass at most `1`, depend only on the
past. The mixing measures are chosen by the axiom of choice. -/
private lemma exists_le_prod_of_envelope_le_one {E : ℕ → (ℕ → ℝ) → ℝ≥0∞}
    (hadapt : ∀ n, DependsOn (E n) (Iic n)) (h0 : ∀ ω, envelope E 0 ω ≤ 1) :
    ∃ π : ℕ → (ℕ → ℝ) → Measure ℝ≥0, (∀ n ω, π n ω univ ≤ 1) ∧
      (∀ n, DependsOn (π n) (Iio n)) ∧
      ∀ n ω, E n ω ≤ ∏ k ∈ Finset.range (n + 1),
        ∫⁻ l, ENNReal.ofReal (Real.exp ((l : ℝ) * ω k - (l : ℝ) ^ 2 / 2)) ∂π k ω := by
  classical
  set W := envelope E with hWdef
  set h : Measure ℝ≥0 → ℝ → ℝ≥0∞ := fun π y ↦
    ∫⁻ l, ENNReal.ofReal (Real.exp ((l : ℝ) * y - (l : ℝ) ^ 2 / 2)) ∂π with hhdef
  have hstep : ∀ k (ω : ℕ → ℝ), W k ω ≠ 0 → W k ω ≠ ⊤ → ∃ π : Measure ℝ≥0,
      π univ ≤ 1 ∧ ∀ y, W (k + 1) (Function.update ω k y) ≤ W k ω * h π y :=
    fun k ω h0 htop ↦ exists_envelope_succ_le_mul E h0 htop
  have hzero : ∀ k (ω : ℕ → ℝ), W k ω = 0 → ∀ y, W (k + 1) (Function.update ω k y) = 0 :=
    fun _ _ h0 ↦ envelope_succ_update_eq_zero E h0
  let ρ : ℕ → (ℕ → ℝ) → Measure ℝ≥0 := fun k ω ↦
    if hk : W k ω ≠ 0 ∧ W k ω ≠ ⊤ then Classical.choose (hstep k ω hk.1 hk.2) else 0
  have hρ1 : ∀ k ω, ρ k ω univ ≤ 1 := by
    intro k ω
    simp only [ρ]
    split_ifs with hk
    · exact (Classical.choose_spec (hstep k ω hk.1 hk.2)).1
    · simp
  have hρ : ∀ k ω, W k ω ≠ ⊤ → ∀ y,
      W (k + 1) (Function.update ω k y) ≤ W k ω * h (ρ k ω) y := by
    intro k ω htop y
    by_cases h0 : W k ω = 0
    · rw [hzero k ω h0 y]
      exact bot_le
    · have hk : W k ω ≠ 0 ∧ W k ω ≠ ⊤ := ⟨h0, htop⟩
      simp only [ρ, hk, ne_eq, not_false_eq_true, and_self, ↓reduceDIte]
      exact (Classical.choose_spec (hstep k ω hk.1 hk.2)).2 y
  -- the mixing measure of round `k` is the one chosen at the truncated history
  let trunc : ℕ → (ℕ → ℝ) → ℕ → ℝ := fun k ω i ↦ if i < k then ω i else 0
  refine ⟨fun k ω ↦ ρ k (trunc k ω), fun n ω ↦ hρ1 _ _, fun n ω ω' hωω' ↦ ?_, ?_⟩
  · have : trunc n ω = trunc n ω' := funext fun i ↦ by
      simp only [trunc]
      split_ifs with hi
      · exact hωω' i hi
      · rfl
    simp only [this]
  have hmain : ∀ k ω, W k ω ≤ ∏ s ∈ Finset.range k, h (ρ s (trunc s ω)) (ω s) := by
    intro k
    induction k with
    | zero => intro ω; simpa using h0 ω
    | succ k ih =>
      intro ω
      have hfin : W k ω ≠ ⊤ := ne_top_of_le_ne_top (ENNReal.prod_ne_top fun s _ ↦
        lintegral_exp_ne_top (hρ1 _ _) _) (ih ω)
      have h1 : W k (trunc k ω) = W k ω := envelope_congr E fun i hi ↦ by simp [trunc, hi]
      have h2 : W (k + 1) (Function.update (trunc k ω) k (ω k)) = W (k + 1) ω := by
        refine envelope_congr E fun i hi ↦ ?_
        rcases (Nat.lt_succ_iff.1 hi).lt_or_eq with hi' | rfl
        · rw [Function.update_of_ne hi'.ne]
          simp [trunc, hi']
        · rw [Function.update_self]
      calc W (k + 1) ω = W (k + 1) (Function.update (trunc k ω) k (ω k)) := h2.symm
        _ ≤ W k (trunc k ω) * h (ρ k (trunc k ω)) (ω k) :=
            hρ k (trunc k ω) (h1 ▸ hfin) (ω k)
        _ = W k ω * h (ρ k (trunc k ω)) (ω k) := by rw [h1]
        _ ≤ (∏ s ∈ Finset.range k, h (ρ s (trunc s ω)) (ω s)) * h (ρ k (trunc k ω)) (ω k) := by
            gcongr
            exact ih ω
        _ = ∏ s ∈ Finset.range (k + 1), h (ρ s (trunc s ω)) (ω s) :=
            (Finset.prod_range_succ _ _).symm
  intro n ω
  exact (le_envelope_succ hadapt n ω).trans (hmain (n + 1) ω)

/-! ### Domination of e-processes -/

/-- **Domination by predictable products of mixtures** [EVR26, Note 12, Theorem 4]. Let `E` be a
process on `ℕ → ℝ` that only depends at time `n` on the observations up to `n`, with no
measurability, and whose mean at every bounded stopping time of `Filtration.piLE` is at most `1`
under every finitely supported member of the one-sided conditionally `1`-sub-Gaussian null. Then
`E` is dominated, at every time `n` and on every path `ω`, by
`∏ k ≤ n, ∫ exp (l ω_k - l ^ 2 / 2) ∂π_k(l)`, for mixing measures `π k ω` on `[0, ∞)` of mass at
most `1` that depend only on the observations before `k`. No measurability of `π k` in the past
observations is asserted. -/
theorem exists_le_prod_lintegral_exp_of_forall_lintegral_le_one {E : ℕ → (ℕ → ℝ) → ℝ≥0∞}
    (hadapt : ∀ n, DependsOn (E n) (Iic n))
    (hE : ∀ Q ∈ oneSidedCondSubgaussianNull, (∃ T : Finset (ℕ → ℝ), Q (↑T)ᶜ = 0) →
      ∀ τ : (ℕ → ℝ) → ℕ, IsStoppingTime (Filtration.piLE (X := fun _ : ℕ ↦ ℝ))
        (fun ω ↦ (τ ω : WithTop ℕ)) → (∃ N, ∀ ω, τ ω ≤ N) → ∫⁻ ω, E (τ ω) ω ∂Q ≤ 1) :
    ∃ π : ℕ → (ℕ → ℝ) → Measure ℝ≥0, (∀ n ω, π n ω univ ≤ 1) ∧
      (∀ n, DependsOn (π n) (Iio n)) ∧
      ∀ n ω, E n ω ≤ ∏ k ∈ Finset.range (n + 1),
        ∫⁻ l, ENNReal.ofReal (Real.exp ((l : ℝ) * ω k - (l : ℝ) ^ 2 / 2)) ∂π k ω :=
  exists_le_prod_of_envelope_le_one hadapt fun _ ↦ iSup₂_le fun p hp ↦
    hE p.1 ⟨hp.isTreeLaw.isProbabilityMeasure, fun n l hl s hs ↦
      hp.isTreeLaw.constraint n (Nat.zero_le n) l hl s hs⟩ hp.exists_finset p.2 hp.isStoppingTime
      hp.bddAbove

/-- **Domination of e-processes by predictable products of mixtures** [EVR26, Note 12,
Theorem 4]. Every e-process for the one-sided conditionally `1`-sub-Gaussian null and the
filtration `Filtration.piLE` is dominated, at every time `n` and on every path `ω`, by
`∏ k ≤ n, ∫ exp (l ω_k - l ^ 2 / 2) ∂π_k(l)`, for mixing measures `π k ω` on `[0, ∞)` of mass at
most `1` that depend only on the observations before `k`. -/
theorem IsEProcess.exists_le_prod_lintegral_exp {E : ℕ → (ℕ → ℝ) → ℝ≥0∞}
    (hE : IsEProcess E (Filtration.piLE (X := fun _ : ℕ ↦ ℝ)) oneSidedCondSubgaussianNull) :
    ∃ π : ℕ → (ℕ → ℝ) → Measure ℝ≥0, (∀ n ω, π n ω univ ≤ 1) ∧
      (∀ n, DependsOn (π n) (Iio n)) ∧
      ∀ n ω, E n ω ≤ ∏ k ∈ Finset.range (n + 1),
        ∫⁻ l, ENNReal.ofReal (Real.exp ((l : ℝ) * ω k - (l : ℝ) ^ 2 / 2)) ∂π k ω :=
  exists_le_prod_lintegral_exp_of_forall_lintegral_le_one (fun n ↦ (hE.adapted n).dependsOn_of_piLE)
    fun Q hQ _ τ hτ _ ↦ by
      have := hQ.1
      exact hE.lintegral_le_one hτ hQ

end ProbabilityTheory
