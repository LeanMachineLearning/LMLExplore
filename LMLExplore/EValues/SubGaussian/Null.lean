import LMLExplore.Probability.Moments.SubGaussian.Basic

/-!
# The sub-Gaussian nulls

For a variance parameter `σ2 : ℝ≥0`, the **two-sided `σ2`-sub-Gaussian null** on the line is the
set of probability measures `μ` with `∫ exp (l x - σ2 l ^ 2 / 2) ∂μ ≤ 1` for every real `l`, and
the **one-sided `σ2`-sub-Gaussian null** asks it only for `l ≥ 0`. Both are nulls generated by
infinitely many constraints (`ProbabilityTheory.constraintNull`), the functions
`x ↦ exp (l x - σ2 l ^ 2 / 2) - 1`, so that the theory of constraint nulls applies to them
[LRR26, §4]. Their e-variables for the variance `1` are described in
`LMLExplore.EValues.SubGaussian.CompleteClass` (two-sided) and
`LMLExplore.EValues.SubGaussian.SequentialCompleteClass` (one-sided).

The two-sided null is the set of probability measures under which the identity is
`σ2`-sub-Gaussian in Mathlib's sense, `HasSubgaussianMGF id σ2 μ`, and the laws of the line that
are `σ2`-sub-Gaussian around their mean (`LMLExplore.Identification.subgaussianLaws`) are those
whose centred law lies in it. The one-sided null contains the two-sided one, and the two-sided
null is the set of laws that lie in the one-sided null together with their reflection
`x ↦ -x`. Both grow with the variance parameter, and contain the centred Gaussian law of
variance `σ2`.

## Main definitions

* `ProbabilityTheory.subgaussianNull σ2`: the two-sided `σ2`-sub-Gaussian null.
* `ProbabilityTheory.oneSidedSubgaussianNull σ2`: the one-sided `σ2`-sub-Gaussian null.

## Main statements

* `ProbabilityTheory.mem_subgaussianNull_iff`, `ProbabilityTheory.mem_oneSidedSubgaussianNull_iff`:
  membership through the means of the exponentials, in `ℝ≥0∞`.
* `ProbabilityTheory.mem_subgaussianNull_iff_hasSubgaussianMGF`: the two-sided null is the set of
  probability measures under which the identity is `σ2`-sub-Gaussian.
* `ProbabilityTheory.subgaussianNull_eq_inter_map_neg`: the two-sided null is the set of laws in
  the one-sided null whose reflection is in the one-sided null.
* `ProbabilityTheory.mem_oneSidedSubgaussianNull_of_forall_rat`: rational exponents suffice for
  the one-sided null.

## References

* [LRR26] M. Larsson, A. Ramdas and J. Ruf, *Testing hypotheses generated by constraints*, Math.
  Oper. Res. (2026), arXiv:2504.02974v5.
-/

public section

open MeasureTheory Filter Topology Set
open scoped ENNReal NNReal

namespace ProbabilityTheory

variable {σ2 τ2 : ℝ≥0} {μ : Measure ℝ}

/-! ### Definitions -/

/-- The **two-sided `σ2`-sub-Gaussian null** on the line: the null generated by the constraints
`x ↦ exp (l x - σ2 l ^ 2 / 2) - 1` for real `l`, that is, the probability measures `μ` with
`∫ exp (l x - σ2 l ^ 2 / 2) ∂μ ≤ 1` for every real `l` (`mem_subgaussianNull_iff`), or with
`HasSubgaussianMGF id σ2 μ` (`mem_subgaussianNull_iff_hasSubgaussianMGF`). -/
noncomputable def subgaussianNull (σ2 : ℝ≥0) : Set (Measure ℝ) :=
  constraintNull (range fun l : ℝ ↦ fun x ↦ Real.exp (l * x - σ2 * l ^ 2 / 2) - 1)

lemma subgaussianNull_def (σ2 : ℝ≥0) :
    subgaussianNull σ2 =
      constraintNull (range fun l : ℝ ↦ fun x ↦ Real.exp (l * x - σ2 * l ^ 2 / 2) - 1) :=
  (rfl)

/-- The **one-sided `σ2`-sub-Gaussian null** on the line: the null generated by the constraints
`x ↦ exp (l x - σ2 l ^ 2 / 2) - 1` for `l ≥ 0`, that is, the probability measures `μ` with
`∫ exp (l x - σ2 l ^ 2 / 2) ∂μ ≤ 1` for every `l ≥ 0` (`mem_oneSidedSubgaussianNull_iff`). -/
noncomputable def oneSidedSubgaussianNull (σ2 : ℝ≥0) : Set (Measure ℝ) :=
  constraintNull (range fun l : Ici (0 : ℝ) ↦ fun x ↦ Real.exp (l * x - σ2 * l ^ 2 / 2) - 1)

lemma oneSidedSubgaussianNull_def (σ2 : ℝ≥0) :
    oneSidedSubgaussianNull σ2 =
      constraintNull (range fun l : Ici (0 : ℝ) ↦ fun x ↦ Real.exp (l * x - σ2 * l ^ 2 / 2) - 1) :=
  (rfl)

/-! ### Membership -/

/-- Under a probability measure, the constraint `exp (l x - σ2 l ^ 2 / 2) - 1` is integrable with
a nonpositive integral exactly when the exponential has mean at most `1`. -/
private lemma integrable_and_integral_exp_sub_one_nonpos_iff [IsProbabilityMeasure μ]
    (σ2 : ℝ≥0) (l : ℝ) :
    (Integrable (fun x ↦ Real.exp (l * x - σ2 * l ^ 2 / 2) - 1) μ ∧
        ∫ x, (Real.exp (l * x - σ2 * l ^ 2 / 2) - 1) ∂μ ≤ 0) ↔
      ∫⁻ x, ENNReal.ofReal (Real.exp (l * x - σ2 * l ^ 2 / 2)) ∂μ ≤ 1 := by
  have h0 : 0 ≤ᵐ[μ] fun x ↦ Real.exp (l * x - σ2 * l ^ 2 / 2) :=
    ae_of_all _ fun _ ↦ (Real.exp_pos _).le
  have hint : Integrable (fun x ↦ Real.exp (l * x - σ2 * l ^ 2 / 2) - 1) μ ↔
      Integrable (fun x ↦ Real.exp (l * x - σ2 * l ^ 2 / 2)) μ := by
    simp_rw [sub_eq_add_neg _ (1 : ℝ)]
    exact integrable_add_const_iff
  rw [hint]
  refine ⟨fun ⟨hi, hle⟩ ↦ ?_, fun hle ↦ ?_⟩
  · rw [integral_sub hi (integrable_const 1), integral_const, probReal_univ, one_smul,
      sub_nonpos] at hle
    rw [← ofReal_integral_eq_lintegral_ofReal hi h0]
    exact ENNReal.ofReal_le_one.2 hle
  · have hi : Integrable (fun x ↦ Real.exp (l * x - σ2 * l ^ 2 / 2)) μ :=
      ⟨by fun_prop, (hasFiniteIntegral_iff_ofReal h0).2 (hle.trans_lt ENNReal.one_lt_top)⟩
    rw [← ofReal_integral_eq_lintegral_ofReal hi h0, ENNReal.ofReal_le_one] at hle
    refine ⟨hi, ?_⟩
    rw [integral_sub hi (integrable_const 1), integral_const, probReal_univ, one_smul,
      sub_nonpos]
    exact hle

/-- Membership in the two-sided `σ2`-sub-Gaussian null: a probability measure belongs to it when
every exponential `exp (l x - σ2 l ^ 2 / 2)`, `l` real, has mean at most `1`. -/
theorem mem_subgaussianNull_iff :
    μ ∈ subgaussianNull σ2 ↔ IsProbabilityMeasure μ ∧ ∀ l : ℝ,
      ∫⁻ x, ENNReal.ofReal (Real.exp (l * x - σ2 * l ^ 2 / 2)) ∂μ ≤ 1 := by
  rw [subgaussianNull_def, mem_constraintNull_range_iff]
  exact and_congr_right fun _ ↦ forall_congr' fun l ↦
    integrable_and_integral_exp_sub_one_nonpos_iff σ2 l

/-- Membership in the one-sided `σ2`-sub-Gaussian null: a probability measure belongs to it when
every exponential `exp (l x - σ2 l ^ 2 / 2)`, `l ≥ 0`, has mean at most `1`. -/
theorem mem_oneSidedSubgaussianNull_iff :
    μ ∈ oneSidedSubgaussianNull σ2 ↔ IsProbabilityMeasure μ ∧ ∀ l : ℝ, 0 ≤ l →
      ∫⁻ x, ENNReal.ofReal (Real.exp (l * x - σ2 * l ^ 2 / 2)) ∂μ ≤ 1 := by
  rw [oneSidedSubgaussianNull_def, mem_constraintNull_range_iff, Subtype.forall]
  exact and_congr_right fun _ ↦ forall₂_congr fun l _ ↦
    integrable_and_integral_exp_sub_one_nonpos_iff σ2 l

/-- The members of the two-sided sub-Gaussian null are probability measures. -/
theorem isProbabilityMeasure_of_mem_subgaussianNull (hμ : μ ∈ subgaussianNull σ2) :
    IsProbabilityMeasure μ :=
  (mem_subgaussianNull_iff.1 hμ).1

/-- The members of the one-sided sub-Gaussian null are probability measures. -/
theorem isProbabilityMeasure_of_mem_oneSidedSubgaussianNull
    (hμ : μ ∈ oneSidedSubgaussianNull σ2) : IsProbabilityMeasure μ :=
  (mem_oneSidedSubgaussianNull_iff.1 hμ).1

/-- **The two-sided null is the null of sub-Gaussian laws**: a measure belongs to the two-sided
`σ2`-sub-Gaussian null exactly when it is a probability measure under which the identity is
`σ2`-sub-Gaussian, `∫ exp (l x) ∂μ ≤ exp (σ2 l ^ 2 / 2)` for every real `l`. -/
theorem mem_subgaussianNull_iff_hasSubgaussianMGF :
    μ ∈ subgaussianNull σ2 ↔ IsProbabilityMeasure μ ∧ HasSubgaussianMGF id σ2 μ := by
  rw [subgaussianNull_def, mem_constraintNull_range_iff]
  refine and_congr_right fun _ ↦ ⟨fun h ↦ ?_, fun h l ↦ ?_⟩
  · refine HasSubgaussianMGF.of_lintegral_le aemeasurable_id fun l ↦ ?_
    -- `exp (l x) = exp (l x - σ2 l ^ 2 / 2) * exp (σ2 l ^ 2 / 2)`
    have hle := (integrable_and_integral_exp_sub_one_nonpos_iff σ2 l).1 (h l)
    have hexp (x : ℝ) : ENNReal.ofReal (Real.exp (l * id x)) =
        ENNReal.ofReal (Real.exp (l * x - σ2 * l ^ 2 / 2)) *
          ENNReal.ofReal (Real.exp (σ2 * l ^ 2 / 2)) := by
      rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← Real.exp_add, sub_add_cancel, id]
    simp_rw [hexp]
    rw [lintegral_mul_const _ (by fun_prop)]
    exact mul_le_of_le_one_left zero_le hle
  · have hi : Integrable (fun x ↦ Real.exp (l * x - σ2 * l ^ 2 / 2)) μ :=
      h.integrable_exp_mul_sub l
    refine ⟨hi.sub (integrable_const 1), ?_⟩
    rw [integral_sub hi (integrable_const 1), integral_const, probReal_univ, one_smul, sub_nonpos]
    exact h.integral_exp_mul_sub_le_one l

/-! ### Relations between the nulls -/

/-- The two-sided sub-Gaussian null is contained in the one-sided one. -/
theorem subgaussianNull_subset_oneSidedSubgaussianNull (σ2 : ℝ≥0) :
    subgaussianNull σ2 ⊆ oneSidedSubgaussianNull σ2 := by
  rw [subgaussianNull_def, oneSidedSubgaussianNull_def]
  refine constraintNull_anti ?_
  rintro _ ⟨l, rfl⟩
  exact ⟨l, rfl⟩

/-- A larger variance parameter gives a larger two-sided sub-Gaussian null. -/
theorem subgaussianNull_mono : Monotone subgaussianNull := by
  intro σ2 τ2 h μ hμ
  rw [mem_subgaussianNull_iff] at hμ ⊢
  refine ⟨hμ.1, fun l ↦ (lintegral_mono fun x ↦ ?_).trans (hμ.2 l)⟩
  gcongr

/-- A larger variance parameter gives a larger one-sided sub-Gaussian null. -/
theorem oneSidedSubgaussianNull_mono : Monotone oneSidedSubgaussianNull := by
  intro σ2 τ2 h μ hμ
  rw [mem_oneSidedSubgaussianNull_iff] at hμ ⊢
  refine ⟨hμ.1, fun l hl ↦ (lintegral_mono fun x ↦ ?_).trans (hμ.2 l hl)⟩
  gcongr

/-- **Two sides from one.** A measure belongs to the two-sided `σ2`-sub-Gaussian null exactly when
it belongs to the one-sided null together with its reflection `x ↦ -x`: the exponents `l < 0` of
`μ` are the exponents `-l > 0` of the reflection. -/
theorem subgaussianNull_eq_inter_map_neg (σ2 : ℝ≥0) :
    subgaussianNull σ2 =
      oneSidedSubgaussianNull σ2 ∩ {μ | μ.map Neg.neg ∈ oneSidedSubgaussianNull σ2} := by
  ext μ
  simp only [mem_inter_iff, mem_ofPred_eq, mem_subgaussianNull_iff,
    mem_oneSidedSubgaussianNull_iff]
  -- the exponent `l` of the reflection is the exponent `-l` of `μ`
  have hmap (l : ℝ) : ∫⁻ x, ENNReal.ofReal (Real.exp (l * x - σ2 * l ^ 2 / 2)) ∂μ.map Neg.neg =
      ∫⁻ x, ENNReal.ofReal (Real.exp (-l * x - σ2 * (-l) ^ 2 / 2)) ∂μ := by
    rw [lintegral_map (by fun_prop) measurable_neg]
    simp [neg_mul, mul_neg]
  simp_rw [hmap]
  refine ⟨fun ⟨hμ, h⟩ ↦ ⟨⟨hμ, fun l _ ↦ h l⟩, inferInstance, fun l _ ↦ h (-l)⟩,
    fun ⟨⟨hμ, h⟩, _, h'⟩ ↦ ⟨hμ, fun l ↦ ?_⟩⟩
  rcases le_total 0 l with hl | hl
  · exact h l hl
  · simpa using h' (-l) (neg_nonneg.2 hl)

/-! ### Members -/

/-- The point mass at `0` belongs to the two-sided sub-Gaussian null. -/
@[simp]
theorem dirac_zero_mem_subgaussianNull (σ2 : ℝ≥0) : Measure.dirac 0 ∈ subgaussianNull σ2 := by
  refine mem_subgaussianNull_iff.2 ⟨inferInstance, fun l ↦ ?_⟩
  rw [lintegral_dirac' _ (by fun_prop), mul_zero, zero_sub, ENNReal.ofReal_le_one,
    Real.exp_le_one_iff, neg_nonpos]
  positivity

/-- The centred Gaussian law of variance `σ2` belongs to the two-sided `σ2`-sub-Gaussian null, the
exponentials `exp (l x - σ2 l ^ 2 / 2)` having mean exactly `1` under it. -/
@[simp]
theorem gaussianReal_mem_subgaussianNull (σ2 : ℝ≥0) :
    gaussianReal 0 σ2 ∈ subgaussianNull σ2 :=
  mem_subgaussianNull_iff_hasSubgaussianMGF.2 ⟨inferInstance,
    ⟨integrable_exp_mul_gaussianReal, fun t ↦ by simp [mgf_id_gaussianReal]⟩⟩

/-- **Rational exponents suffice.** A probability measure on the line belongs to the one-sided
`σ2`-sub-Gaussian null as soon as every exponential `exp (q x - σ2 q ^ 2 / 2)` with a rational
`q ≥ 0` has mean at most `1`. -/
theorem mem_oneSidedSubgaussianNull_of_forall_rat [IsProbabilityMeasure μ]
    (h : ∀ q : ℚ, 0 ≤ (q : ℝ) →
      ∫⁻ x, ENNReal.ofReal (Real.exp (q * x - σ2 * q ^ 2 / 2)) ∂μ ≤ 1) :
    μ ∈ oneSidedSubgaussianNull σ2 := by
  refine mem_oneSidedSubgaussianNull_iff.2 ⟨inferInstance, fun l hl ↦ ?_⟩
  -- Fatou's lemma along rationals decreasing to `l`
  obtain ⟨u, -, hlu, hu⟩ := Real.exists_seq_rat_strictAnti_tendsto l
  calc ∫⁻ x, ENNReal.ofReal (Real.exp (l * x - σ2 * l ^ 2 / 2)) ∂μ
      = ∫⁻ x, liminf (fun n ↦ ENNReal.ofReal (Real.exp (u n * x - σ2 * u n ^ 2 / 2))) atTop ∂μ := by
        refine lintegral_congr fun x ↦ (Tendsto.liminf_eq ?_).symm
        exact ENNReal.tendsto_ofReal ((Real.continuous_exp.tendsto _).comp
          ((hu.mul_const x).sub (((hu.pow 2).const_mul _).div_const 2)))
    _ ≤ liminf (fun n ↦ ∫⁻ x, ENNReal.ofReal (Real.exp (u n * x - σ2 * u n ^ 2 / 2)) ∂μ) atTop :=
        lintegral_liminf_le fun n ↦ by fun_prop
    _ ≤ 1 := liminf_le_of_frequently_le' (.of_forall fun n ↦ h (u n) (hl.trans (hlu n).le))

end ProbabilityTheory
