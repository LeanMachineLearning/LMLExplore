/-! ### The compensated kernel -/

/-- The **compensated kernel** of the two-sided sub-Gaussian null, with its parameter `l` on the
extended line: `(1 + l ^ 2) / l ^ 2 * (exp (l x - l ^ 2 / 2) - 1 - l x / (1 + l ^ 2))` at a
nonzero real `l`, `(x ^ 2 - 1) / 2` at `l = 0`, and `-1` at `l = ⊥` and `l = ⊤`. It is the
continuous extension in `l` of its values at the nonzero reals. -/
noncomputable def subGaussianCompensatedExp (l : EReal) (x : ℝ) : ℝ :=
  if l = ⊥ ∨ l = ⊤ then -1
  else if l = 0 then (x ^ 2 - 1) / 2
  else (1 + l.toReal ^ 2) / l.toReal ^ 2 *
    (exp (l.toReal * x - l.toReal ^ 2 / 2) - 1 - l.toReal * x / (1 + l.toReal ^ 2))

/-- The compensated kernel at `⊤`. -/
@[simp]
theorem subGaussianCompensatedExp_top (x : ℝ) : subGaussianCompensatedExp ⊤ x = -1 := by
  simp [subGaussianCompensatedExp]

/-- The compensated kernel at `⊥`. -/
@[simp]
theorem subGaussianCompensatedExp_bot (x : ℝ) : subGaussianCompensatedExp ⊥ x = -1 := by
  simp [subGaussianCompensatedExp]

/-- The compensated kernel at the parameter `0`. -/
@[simp]
theorem subGaussianCompensatedExp_zero_left (x : ℝ) :
    subGaussianCompensatedExp 0 x = (x ^ 2 - 1) / 2 := by
  simp [subGaussianCompensatedExp]

/-- The compensated kernel at a nonzero real parameter. -/
theorem subGaussianCompensatedExp_coe {t : ℝ} (ht : t ≠ 0) (x : ℝ) :
    subGaussianCompensatedExp t x =
      (1 + t ^ 2) / t ^ 2 * (exp (t * x - t ^ 2 / 2) - 1 - t * x / (1 + t ^ 2)) := by
  simp [subGaussianCompensatedExp, ht]

/-- The compensated kernel at a nonzero real parameter, in a form suited to limits. -/
private lemma subGaussianCompensatedExp_coe' {t : ℝ} (ht : t ≠ 0) (x : ℝ) :
    subGaussianCompensatedExp t x =
      (1 + (t ^ 2)⁻¹) * exp (t * x - t ^ 2 / 2) - (1 + (t ^ 2)⁻¹) - x * t⁻¹ := by
  rw [subGaussianCompensatedExp_coe ht]
  field_simp
  ring

/-- At a real parameter `t`, the constraint `exp (t x - t ^ 2 / 2) - 1` of the null is a
combination of the compensated kernel and of `x`. -/
theorem exp_sub_one_eq_mul_subGaussianCompensatedExp_add (t x : ℝ) :
    exp (t * x - t ^ 2 / 2) - 1 =
      t ^ 2 / (1 + t ^ 2) * subGaussianCompensatedExp t x + t / (1 + t ^ 2) * x := by
  rcases eq_or_ne t 0 with rfl | ht
  · simp
  rw [subGaussianCompensatedExp_coe ht]
  field_simp
  ring

/-- The third-order Taylor bound for the compensated kernel near the parameter `0`. -/
private lemma abs_subGaussianCompensatedExp_sub_le {t x : ℝ} (hu : |t * x - t ^ 2 / 2| ≤ 1) :
    |subGaussianCompensatedExp t x -
        (t * x - 1 / 2 - t ^ 2 / 2 + (1 + t ^ 2) * (x - t / 2) ^ 2 / 2)| ≤
      (1 + t ^ 2) * |t| * |x - t / 2| ^ 3 := by
  rcases eq_or_ne t 0 with rfl | ht
  · simp only [EReal.coe_zero, subGaussianCompensatedExp_zero_left]
    ring_nf
    simp
  set u := t * x - t ^ 2 / 2 with hu_def
  have hR := Real.exp_bound hu (n := 3) (by norm_num)
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.factorial] at hR
  norm_num at hR
  have hkey : subGaussianCompensatedExp t x -
      (t * x - 1 / 2 - t ^ 2 / 2 + (1 + t ^ 2) * (x - t / 2) ^ 2 / 2) =
      (1 + t ^ 2) / t ^ 2 * (exp u - (1 + u + u ^ 2 / 2)) := by
    rw [subGaussianCompensatedExp_coe ht, hu_def]
    field_simp
    ring
  have hut : |u| = |t| * |x - t / 2| := by
    rw [← abs_mul]; congr 1; rw [hu_def]; ring
  rw [hkey, abs_mul, abs_of_pos (by positivity : 0 < (1 + t ^ 2) / t ^ 2)]
  calc (1 + t ^ 2) / t ^ 2 * |exp u - (1 + u + u ^ 2 / 2)|
      ≤ (1 + t ^ 2) / t ^ 2 * |u| ^ 3 := by
        gcongr
        refine (le_of_eq_of_le ?_ hR).trans ?_
        · congr 1
        · nlinarith [pow_nonneg (abs_nonneg u) 3]
    _ = (1 + t ^ 2) * |t| * |x - t / 2| ^ 3 := by
        rw [hut, mul_pow]
        have : |t| ^ 3 = t ^ 2 * |t| := by
          rw [pow_succ, sq_abs]
        rw [this]
        field_simp

/-- The compensated kernel is continuous at the real parameter `0`. -/
private lemma continuousAt_subGaussianCompensatedExp_zero (x : ℝ) :
    ContinuousAt (fun t : ℝ ↦ subGaussianCompensatedExp t x) 0 := by
  set p : ℝ → ℝ := fun t ↦ t * x - 1 / 2 - t ^ 2 / 2 + (1 + t ^ 2) * (x - t / 2) ^ 2 / 2
  have hp : Continuous p := by fun_prop
  have h0 : subGaussianCompensatedExp ((0 : ℝ) : EReal) x = p 0 := by
    simp only [EReal.coe_zero, subGaussianCompensatedExp_zero_left, p]
    ring
  have hG : Tendsto (fun t : ℝ ↦ subGaussianCompensatedExp t x - p t) (𝓝 0) (𝓝 0) := by
    refine squeeze_zero_norm' ?_ (?_ : Tendsto (fun t : ℝ ↦ (1 + t ^ 2) * |t| * |x - t / 2| ^ 3)
      (𝓝 0) (𝓝 0))
    · have hu : Tendsto (fun t : ℝ ↦ t * x - t ^ 2 / 2) (𝓝 0) (𝓝 0) := by
        have : Continuous (fun t : ℝ ↦ t * x - t ^ 2 / 2) := by fun_prop
        simpa using this.tendsto 0
      filter_upwards [hu (Metric.closedBall_mem_nhds 0 one_pos)] with t ht
      rw [Real.norm_eq_abs]
      exact abs_subGaussianCompensatedExp_sub_le (by simpa using ht)
    · have : Continuous (fun t : ℝ ↦ (1 + t ^ 2) * |t| * |x - t / 2| ^ 3) := by fun_prop
      simpa using this.tendsto 0
  have : Tendsto (fun t : ℝ ↦ subGaussianCompensatedExp t x) (𝓝 0) (𝓝 (p 0)) := by
    simpa using hG.add (hp.tendsto 0)
  rw [ContinuousAt, h0]
  exact this

/-- The compensated kernel is continuous in a real parameter. -/
private lemma continuous_subGaussianCompensatedExp_coe (x : ℝ) :
    Continuous fun t : ℝ ↦ subGaussianCompensatedExp t x := by
  refine continuous_iff_continuousAt.2 fun t ↦ ?_
  rcases eq_or_ne t 0 with rfl | ht
  · exact continuousAt_subGaussianCompensatedExp_zero x
  have hc : ContinuousAt (fun t : ℝ ↦ (1 + (t ^ 2)⁻¹) * exp (t * x - t ^ 2 / 2) -
      (1 + (t ^ 2)⁻¹) - x * t⁻¹) t := by
    have h2 : t ^ 2 ≠ 0 := pow_ne_zero 2 ht
    fun_prop (disch := assumption)
  refine hc.congr ?_
  filter_upwards [eventually_ne_nhds ht] with s hs
  rw [subGaussianCompensatedExp_coe' hs]

/-- `t x - t ^ 2 / 2` tends to `-∞` as `t` tends to `+∞`. -/
private lemma tendsto_mul_sub_sq_div_two_atTop (x : ℝ) :
    Tendsto (fun t : ℝ ↦ t * x - t ^ 2 / 2) atTop atBot := by
  refine tendsto_atBot_mono' _ ?_ (tendsto_neg_atTop_atBot (G := ℝ))
  filter_upwards [eventually_ge_atTop (2 * (|x| + 1))] with t ht
  nlinarith [abs_nonneg x, le_abs_self x]

/-- `t x - t ^ 2 / 2` tends to `-∞` as `t` tends to `-∞`. -/
private lemma tendsto_mul_sub_sq_div_two_atBot (x : ℝ) :
    Tendsto (fun t : ℝ ↦ t * x - t ^ 2 / 2) atBot atBot := by
  refine tendsto_atBot_mono' _ ?_ (tendsto_id (α := ℝ))
  filter_upwards [eventually_le_atBot (-2 * (|x| + 1))] with t ht
  simp only [id]
  nlinarith [abs_nonneg x, neg_abs_le x]

/-- The compensated kernel tends to `-1` as its parameter tends to `+∞`. -/
private lemma tendsto_subGaussianCompensatedExp_atTop (x : ℝ) :
    Tendsto (fun t : ℝ ↦ subGaussianCompensatedExp t x) atTop (𝓝 (-1)) := by
  have h1 : Tendsto (fun t : ℝ ↦ (t ^ 2)⁻¹) atTop (𝓝 0) :=
    tendsto_inv_atTop_zero.comp (tendsto_pow_atTop two_ne_zero)
  have h2 : Tendsto (fun t : ℝ ↦ exp (t * x - t ^ 2 / 2)) atTop (𝓝 0) :=
    tendsto_exp_atBot.comp (tendsto_mul_sub_sq_div_two_atTop x)
  have h3 : Tendsto (fun t : ℝ ↦ x * t⁻¹) atTop (𝓝 0) := by
    simpa using tendsto_inv_atTop_zero.const_mul x
  have := ((((tendsto_const_nhds (x := (1 : ℝ))).add h1).mul h2).sub
    ((tendsto_const_nhds (x := (1 : ℝ))).add h1)).sub h3
  rw [show (1 + 0) * 0 - (1 + 0) - 0 = (-1 : ℝ) by norm_num] at this
  refine this.congr' ?_
  filter_upwards [eventually_ne_atTop 0] with t ht
  rw [subGaussianCompensatedExp_coe' ht]

/-- The compensated kernel tends to `-1` as its parameter tends to `-∞`. -/
private lemma tendsto_subGaussianCompensatedExp_atBot (x : ℝ) :
    Tendsto (fun t : ℝ ↦ subGaussianCompensatedExp t x) atBot (𝓝 (-1)) := by
  have h1 : Tendsto (fun t : ℝ ↦ (t ^ 2)⁻¹) atBot (𝓝 0) :=
    tendsto_inv_atTop_zero.comp (tendsto_pow_atTop two_ne_zero |>.comp tendsto_neg_atBot_atTop
      |>.congr fun t ↦ by simp)
  have h2 : Tendsto (fun t : ℝ ↦ exp (t * x - t ^ 2 / 2)) atBot (𝓝 0) :=
    tendsto_exp_atBot.comp (tendsto_mul_sub_sq_div_two_atBot x)
  have h3 : Tendsto (fun t : ℝ ↦ x * t⁻¹) atBot (𝓝 0) := by
    simpa using tendsto_inv_atBot_zero.const_mul x
  have := ((((tendsto_const_nhds (x := (1 : ℝ))).add h1).mul h2).sub
    ((tendsto_const_nhds (x := (1 : ℝ))).add h1)).sub h3
  rw [show (1 + 0) * 0 - (1 + 0) - 0 = (-1 : ℝ) by norm_num] at this
  refine this.congr' ?_
  filter_upwards [eventually_ne_atBot 0] with t ht
  rw [subGaussianCompensatedExp_coe' ht]

/-- A real function on the extended line is continuous when its restriction to the reals is
continuous, with limits at `±∞` equal to its values at `⊤` and `⊥`. -/
private lemma continuous_of_continuous_coe_of_tendsto {G : EReal → ℝ}
    (hG : Continuous fun t : ℝ ↦ G t) (htop : Tendsto (fun t : ℝ ↦ G t) atTop (𝓝 (G ⊤)))
    (hbot : Tendsto (fun t : ℝ ↦ G t) atBot (𝓝 (G ⊥))) : Continuous G := by
  refine continuous_iff_continuousAt.2 fun l ↦ ?_
  induction l using EReal.rec with
  | bot =>
    rw [← continuousWithinAt_compl_self, ContinuousWithinAt, EReal.nhdsWithin_bot]
    exact tendsto_map'_iff.2 hbot
  | coe t => exact EReal.isOpenEmbedding_coe.continuousAt_iff.1 hG.continuousAt
  | top =>
    rw [← continuousWithinAt_compl_self, ContinuousWithinAt, EReal.nhdsWithin_top]
    exact tendsto_map'_iff.2 htop

/-- The compensated kernel is continuous in its parameter on the extended line. -/
theorem continuous_subGaussianCompensatedExp (x : ℝ) :
    Continuous fun l ↦ subGaussianCompensatedExp l x :=
  continuous_of_continuous_coe_of_tendsto (continuous_subGaussianCompensatedExp_coe x)
    (by simpa using tendsto_subGaussianCompensatedExp_atTop x)
    (by simpa using tendsto_subGaussianCompensatedExp_atBot x)

/-- The compensated kernel is jointly measurable. -/
theorem measurable_subGaussianCompensatedExp :
    Measurable (Function.uncurry subGaussianCompensatedExp) := by
  unfold subGaussianCompensatedExp
  refine Measurable.ite ?_ measurable_const (Measurable.ite ?_ ?_ ?_)
  · exact (measurableSet_singleton ⊥ |>.union (measurableSet_singleton ⊤)).preimage measurable_fst
  · exact (measurableSet_singleton 0).preimage measurable_fst
  · fun_prop
  · have : Measurable fun p : EReal × ℝ ↦ p.1.toReal := measurable_ereal_toReal.comp measurable_fst
    fun_prop

/-- The compensated kernel is at least `-3 / 2`. -/
theorem neg_three_halves_le_subGaussianCompensatedExp (l : EReal) (x : ℝ) :
    -3 / 2 ≤ subGaussianCompensatedExp l x := by
  induction l using EReal.rec with
  | bot => norm_num
  | top => norm_num
  | coe t =>
    rcases eq_or_ne t 0 with rfl | ht
    · simp only [EReal.coe_zero, subGaussianCompensatedExp_zero_left]
      nlinarith [sq_nonneg x]
    have ht2 : 0 < t ^ 2 := by positivity
    have hexp := add_one_le_exp (t * x - t ^ 2 / 2 + log (1 + t ^ 2))
    rw [exp_add, exp_log (by positivity)] at hexp
    rw [subGaussianCompensatedExp_coe ht, div_mul_eq_mul_div, le_div_iff₀ ht2]
    have h1 : (1 + t ^ 2) * (exp (t * x - t ^ 2 / 2) - 1 - t * x / (1 + t ^ 2)) =
        exp (t * x - t ^ 2 / 2) * (1 + t ^ 2) - (1 + t ^ 2) - t * x := by
      field_simp
    rw [h1]
    nlinarith [log_nonneg (by nlinarith : (1 : ℝ) ≤ 1 + t ^ 2)]

/-- At `x = 0`, the compensated kernel is at most `-1 / 2`. -/
theorem subGaussianCompensatedExp_zero_right_le (l : EReal) :
    subGaussianCompensatedExp l 0 ≤ -1 / 2 := by
  induction l using EReal.rec with
  | bot => norm_num
  | top => norm_num
  | coe t =>
    rcases eq_or_ne t 0 with rfl | ht
    · norm_num
    have ht2 : 0 < t ^ 2 := by positivity
    set s := t ^ 2 / 2 with hs
    have hE : exp (-s) * (1 + s) ≤ 1 := by
      rw [exp_neg, inv_mul_le_iff₀ (exp_pos s)]
      linarith [add_one_le_exp s]
    have hE1 : exp (-s) ≤ 1 := exp_le_one_iff.2 (by linarith [show 0 ≤ s by positivity])
    rw [subGaussianCompensatedExp_coe ht]
    simp only [mul_zero, zero_sub, zero_div, sub_zero]
    rw [div_mul_eq_mul_div, div_le_iff₀ ht2, show t ^ 2 = 2 * s by rw [hs]; ring,
      show -(2 * s / 2) = -s by ring]
    nlinarith [exp_pos (-s)]

/-! ### Validity -/

section Validity

variable {μ : Measure ℝ}

/-- `cosh v` is at least `1 + v ^ 2 / 2`. -/
private lemma one_add_sq_div_two_le_cosh (v : ℝ) : 1 + v ^ 2 / 2 ≤ cosh v := by
  have h1 : cosh v = 2 * sinh (v / 2) ^ 2 + 1 := by
    conv_lhs => rw [show v = 2 * (v / 2) by ring]
    rw [cosh_two_mul, cosh_sq]
    ring
  have h2 : (v / 2) ^ 2 ≤ sinh (v / 2) ^ 2 := by
    rcases le_total 0 (v / 2) with h | h
    · nlinarith [self_le_sinh_iff.2 h]
    · nlinarith [sinh_le_self_iff.2 h]
  rw [h1]
  nlinarith

/-- A sub-Gaussian law integrates its moment generating function, in the form of a Bochner
integral. -/
private lemma integral_exp_mul_le (hμ : HasSubgaussianMGF id 1 μ) (t : ℝ) :
    ∫ x, exp (t * x) ∂μ ≤ exp (t ^ 2 / 2) := by
  simpa [mgf] using hμ.mgf_le t

/-- A `1`-sub-Gaussian probability law has mean `0`. -/
private lemma integral_id_eq_zero [IsProbabilityMeasure μ] (hμ : HasSubgaussianMGF id 1 μ) :
    ∫ x, x ∂μ = 0 := by
  simpa using (hμ.hasSubexponentialMGF 0).integral_eq_zero

/-- A `1`-sub-Gaussian probability law has second moment at most `1`, since
`t ^ 2 ∫ x ^ 2 ≤ 2 (exp (t ^ 2 / 2) - 1) ≤ t ^ 2 exp (t ^ 2 / 2)` for every real `t`. -/
private lemma integral_sq_le_one [IsProbabilityMeasure μ] (hμ : HasSubgaussianMGF id 1 μ) :
    ∫ x, x ^ 2 ∂μ ≤ 1 := by
  have hx2 : Integrable (fun x ↦ x ^ 2) μ := (hμ.memLp 2).integrable_sq
  have key : ∀ s : ℝ, 0 < s → ∫ x, x ^ 2 ∂μ ≤ exp (s ^ 2 / 2) := by
    intro s hs
    have he : ∀ t : ℝ, Integrable (fun x ↦ exp (t * x)) μ := hμ.integrable_exp_mul
    have hint : Integrable (fun x ↦ exp (s * x) + exp ((-s) * x)) μ := (he s).add (he (-s))
    have h1 : s ^ 2 * ∫ x, x ^ 2 ∂μ ≤ 2 * exp (s ^ 2 / 2) - 2 := by
      rw [← integral_const_mul]
      calc ∫ x, s ^ 2 * x ^ 2 ∂μ ≤ ∫ x, (exp (s * x) + exp ((-s) * x) - 2) ∂μ := by
            refine integral_mono (hx2.const_mul _) (hint.sub (integrable_const 2)) fun x ↦ ?_
            have h' := one_add_sq_div_two_le_cosh (s * x)
            rw [cosh_eq] at h'
            simp only [neg_mul]
            nlinarith
        _ ≤ 2 * exp (s ^ 2 / 2) - 2 := by
            rw [integral_sub hint (integrable_const 2), integral_add (he s) (he (-s))]
            have := integral_exp_mul_le hμ s
            have := integral_exp_mul_le hμ (-s)
            simp only [integral_const, probReal_univ, smul_eq_mul, one_mul, neg_sq] at *
            linarith
    have h3 : exp (s ^ 2 / 2) - 1 ≤ s ^ 2 / 2 * exp (s ^ 2 / 2) := by
      nlinarith [add_one_le_exp (-(s ^ 2 / 2)), exp_pos (s ^ 2 / 2),
        show exp (-(s ^ 2 / 2)) * exp (s ^ 2 / 2) = 1 by rw [← exp_add]; simp]
    have hs2 : 0 < s ^ 2 := by positivity
    refine le_of_mul_le_mul_left ?_ hs2
    nlinarith
  have hlim : Tendsto (fun s : ℝ ↦ exp (s ^ 2 / 2)) (𝓝[>] 0) (𝓝 1) := by
    have : Continuous (fun s : ℝ ↦ exp (s ^ 2 / 2)) := by fun_prop
    simpa using tendsto_nhdsWithin_of_tendsto_nhds (this.tendsto 0)
  exact ge_of_tendsto hlim (eventually_nhdsWithin_of_forall fun s hs ↦ key s hs)

/-- Under a `1`-sub-Gaussian law, every section of the compensated kernel is integrable. -/
theorem integrable_subGaussianCompensatedExp (hμ : HasSubgaussianMGF id 1 μ) (l : EReal) :
    Integrable (fun x ↦ subGaussianCompensatedExp l x) μ := by
  have : IsFiniteMeasure μ := by
    have h := hμ.integrable_exp_mul 0
    simp only [zero_mul, exp_zero] at h
    exact (integrable_const_iff.1 h).resolve_left one_ne_zero
  induction l using EReal.rec with
  | bot => simp
  | top => simp
  | coe t =>
    rcases eq_or_ne t 0 with rfl | ht
    · have hsq : Integrable (fun x : ℝ ↦ x ^ 2) μ := (hμ.memLp 2).integrable_sq
      simpa using (hsq.sub (integrable_const 1)).div_const 2
    simp_rw [subGaussianCompensatedExp_coe' ht]
    have hid : Integrable (fun x : ℝ ↦ x) μ := hμ.integrable
    exact ((((hμ.integrable_exp_mul t).const_mul (exp (-(t ^ 2 / 2)))).congr
      (ae_of_all _ fun x ↦ by simp [← exp_add, sub_eq_add_neg, add_comm])).const_mul _ |>.sub
      (integrable_const _)).sub (hid.mul_const _)

/-- Under a `1`-sub-Gaussian probability law, every section of the compensated kernel has a
nonpositive mean. -/
theorem integral_subGaussianCompensatedExp_nonpos [IsProbabilityMeasure μ]
    (hμ : HasSubgaussianMGF id 1 μ) (l : EReal) :
    ∫ x, subGaussianCompensatedExp l x ∂μ ≤ 0 := by
  induction l using EReal.rec with
  | bot => simp
  | top => simp
  | coe t =>
    rcases eq_or_ne t 0 with rfl | ht
    · have hsq : Integrable (fun x : ℝ ↦ x ^ 2) μ := (hμ.memLp 2).integrable_sq
      simp only [EReal.coe_zero, subGaussianCompensatedExp_zero_left]
      rw [integral_div, integral_sub hsq (integrable_const 1)]
      simp only [integral_const, probReal_univ, smul_eq_mul, one_mul]
      linarith [integral_sq_le_one hμ]
    have hk : ∀ x, subGaussianCompensatedExp t x =
        (1 + t ^ 2) / t ^ 2 * (exp (t * x - t ^ 2 / 2) - 1) - t⁻¹ * x := by
      intro x
      rw [exp_sub_one_eq_mul_subGaussianCompensatedExp_add]
      field_simp
      ring
    have he : Integrable (fun x ↦ exp (t * x - t ^ 2 / 2)) μ :=
      ((hμ.integrable_exp_mul t).const_mul (exp (-(t ^ 2 / 2)))).congr
        (ae_of_all _ fun x ↦ by simp [← exp_add, sub_eq_add_neg, add_comm])
    have hmean := integral_id_eq_zero hμ
    have hexp : ∫ x, exp (t * x - t ^ 2 / 2) ∂μ ≤ 1 := by
      have h := integral_exp_mul_le hμ t
      calc ∫ x, exp (t * x - t ^ 2 / 2) ∂μ = exp (-(t ^ 2 / 2)) * ∫ x, exp (t * x) ∂μ := by
            rw [← integral_const_mul]
            simp [← exp_add, sub_eq_add_neg, add_comm]
        _ ≤ exp (-(t ^ 2 / 2)) * exp (t ^ 2 / 2) := by gcongr
        _ = 1 := by rw [← exp_add]; simp
    have hid : Integrable (fun x : ℝ ↦ x) μ := hμ.integrable
    have h1 : Integrable (fun x ↦ (1 + t ^ 2) / t ^ 2 * (exp (t * x - t ^ 2 / 2) - 1)) μ :=
      (he.sub (integrable_const 1)).const_mul _
    simp_rw [hk]
    rw [integral_sub h1 (hid.const_mul _),
      integral_const_mul, integral_const_mul, integral_sub he (integrable_const 1)]
    simp only [hmean, integral_const, probReal_univ, smul_eq_mul, one_mul, mul_zero, sub_zero]
    exact mul_nonpos_of_nonneg_of_nonpos (by positivity) (by linarith)

end Validity

/-- **Validity of the complete class.** Every nonnegative function `1 + a x + ∫ k (l, x) ∂ν(l)`,
for a real `a` and a finite measure `ν` on the extended line, is an e-variable for the two-sided
`1`-sub-Gaussian null. -/
theorem isEVar_ofReal_one_add_integral_subGaussianCompensatedExp (a : ℝ) (ν : Measure EReal)
    [IsFiniteMeasure ν] (h : ∀ x, 0 ≤ 1 + a * x + ∫ l, subGaussianCompensatedExp l x ∂ν) :
    IsEVar (fun x ↦ ENNReal.ofReal (1 + a * x + ∫ l, subGaussianCompensatedExp l x ∂ν))
      {μ : Measure ℝ | IsProbabilityMeasure μ ∧ HasSubgaussianMGF id 1 μ} := by
  have hmeas : Measurable fun p : ℝ × EReal ↦ subGaussianCompensatedExp p.2 p.1 :=
    measurable_subGaussianCompensatedExp.comp measurable_swap
  have hJm : Measurable fun x ↦ ∫ l, subGaussianCompensatedExp l x ∂ν :=
    (StronglyMeasurable.integral_prod_right (ν := ν)
      (f := fun (x : ℝ) (l : EReal) ↦ subGaussianCompensatedExp l x)
        hmeas.stronglyMeasurable).measurable
  refine IsEVar.of_lintegral_le_one ?_ (by fun_prop) fun μ hμ' ↦ ?_
  · exact fun μ hμ ↦ hμ.1
  obtain ⟨hμ1, hμ⟩ := hμ'
  -- integrability on the product, through the lower bound `-3 / 2` and Tonelli's theorem
  have hlow : ∀ p : ℝ × EReal, 0 ≤ subGaussianCompensatedExp p.2 p.1 + 3 / 2 := fun p ↦ by
    linarith [neg_three_halves_le_subGaussianCompensatedExp p.2 p.1]
  have hpos : Integrable (fun p : ℝ × EReal ↦ subGaussianCompensatedExp p.2 p.1 + 3 / 2)
      (μ.prod ν) := by
    refine ⟨(hmeas.add_const _).aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_ofReal (ae_of_all _ hlow),
      lintegral_prod_symm _ (hmeas.add_const _).ennreal_ofReal.aemeasurable]
    calc ∫⁻ l, ∫⁻ x, ENNReal.ofReal (subGaussianCompensatedExp l x + 3 / 2) ∂μ ∂ν
        ≤ ∫⁻ _, ENNReal.ofReal (3 / 2) ∂ν := by
          refine lintegral_mono fun l ↦ ?_
          have hl := integrable_subGaussianCompensatedExp hμ l
          have hl' : Integrable (fun x ↦ subGaussianCompensatedExp l x + 3 / 2) μ :=
            hl.add (integrable_const _)
          rw [← ofReal_integral_eq_lintegral_ofReal hl'
            (ae_of_all _ fun x ↦ hlow (x, l)), integral_add hl (integrable_const _)]
          simp only [integral_const, probReal_univ, smul_eq_mul, one_mul]
          exact ENNReal.ofReal_le_ofReal
            (by linarith [integral_subGaussianCompensatedExp_nonpos hμ l])
      _ < ⊤ := by simp [ENNReal.mul_lt_top]
  have hint : Integrable (Function.uncurry fun (x : ℝ) (l : EReal) ↦ subGaussianCompensatedExp l x)
      (μ.prod ν) := by
    refine (hpos.add (integrable_const (3 / 2 : ℝ))).mono' hmeas.aestronglyMeasurable
      (ae_of_all _ fun p ↦ ?_)
    have := neg_three_halves_le_subGaussianCompensatedExp p.2 p.1
    simp only [Function.uncurry, Real.norm_eq_abs, Pi.add_apply]
    rw [abs_le]
    constructor <;> linarith
  have hJ : Integrable (fun x ↦ ∫ l, subGaussianCompensatedExp l x ∂ν) μ :=
    hint.integral_prod_left
  have hJle : ∫ x, ∫ l, subGaussianCompensatedExp l x ∂ν ∂μ ≤ 0 := by
    rw [integral_integral_swap hint]
    exact integral_nonpos fun l ↦ integral_subGaussianCompensatedExp_nonpos hμ l
  have hid : Integrable (fun x : ℝ ↦ x) μ := hμ.integrable
  have hx : Integrable (fun x ↦ a * x) μ := hid.const_mul a
  have h1 : Integrable (fun x : ℝ ↦ 1 + a * x) μ := (integrable_const 1).add hx
  have h2 : Integrable (fun x ↦ 1 + a * x + ∫ l, subGaussianCompensatedExp l x ∂ν) μ := h1.add hJ
  rw [← ofReal_integral_eq_lintegral_ofReal h2 (ae_of_all _ h), ENNReal.ofReal_le_one,
    integral_add h1 hJ, integral_add (integrable_const 1) hx, integral_const_mul]
  have hmean := integral_id_eq_zero hμ
  simp only [hmean, integral_const, probReal_univ, smul_eq_mul, one_mul, mul_zero, add_zero]
  linarith

/-! ### Finitely supported members of the null -/

section FiniteSupport

variable {α : Type*} [Fintype α] {w : α → ℝ}

/-- A finite weighted sum of Dirac masses with nonnegative weights summing to `1` is a probability
measure. -/
private lemma isProbabilityMeasure_sum_smul_dirac (hw : ∀ k, 0 ≤ w k) (hw1 : ∑ k, w k = 1)
    (y : α → ℝ) : IsProbabilityMeasure (∑ k, ENNReal.ofReal (w k) • Measure.dirac (y k)) := by
  constructor
  simp [← ENNReal.ofReal_sum_of_nonneg fun k _ ↦ hw k, hw1]

/-- A finitely supported law whose moment generating function is at most `exp (t ^ 2 / 2)` at
every `t` is `1`-sub-Gaussian. -/
private lemma hasSubgaussianMGF_sum_smul_dirac (hw : ∀ k, 0 ≤ w k) (y : α → ℝ)
    (h : ∀ t, ∑ k, w k * exp (t * y k) ≤ exp (t ^ 2 / 2)) :
    HasSubgaussianMGF id 1 (∑ k, ENNReal.ofReal (w k) • Measure.dirac (y k)) where
  integrable_exp_mul t := integrable_finsetSum_measure.2 fun k _ ↦
    (integrable_dirac' (by fun_prop : Measurable fun x : ℝ ↦ exp (t * id x)).stronglyMeasurable
      (by simp)).smul_measure ENNReal.ofReal_ne_top
  mgf_le t := by
    rw [mgf, LMLExplore.integral_sum_smul_dirac hw
      (by fun_prop : Measurable fun x : ℝ ↦ exp (t * id x)).stronglyMeasurable]
    simpa using h t

/-- A finite weighted sum of Dirac masses at points of `s` gives no mass to the complement of
`s`. -/
private lemma sum_smul_dirac_compl_eq_zero {y : α → ℝ} {s : Finset ℝ} (hs : ∀ k, y k ∈ s) :
    (∑ k, ENNReal.ofReal (w k) • Measure.dirac (y k)) (↑s)ᶜ = 0 := by
  simp [Measure.dirac_apply' _ s.measurableSet.compl, hs]

/-- The moment generating function of a sum of `n` independent signs is `cosh ^ n`. -/
private lemma sum_inv_two_pow_mul_exp_mul_sum_sign (n : ℕ) (a : ℝ) :
    ∑ σ : Fin n → Bool, (2 ^ n : ℝ)⁻¹ * exp (a * ∑ i, if σ i then (1 : ℝ) else -1) =
      cosh a ^ n := by
  have h1 : ∀ σ : Fin n → Bool, exp (a * ∑ i, if σ i then (1 : ℝ) else -1) =
      ∏ i, exp (a * if σ i then 1 else -1) := by
    intro σ; rw [Finset.mul_sum, exp_sum]
  simp_rw [h1]
  rw [← Finset.mul_sum,
    ← Fintype.prod_sum (fun (_ : Fin n) (b : Bool) ↦ exp (a * if b then 1 else -1))]
  simp only [Fintype.sum_bool, ↓reduceIte, mul_one, Bool.false_eq_true, mul_neg,
    Finset.prod_const, Finset.card_univ, Fintype.card_fin, cosh_eq]
  rw [div_pow, inv_mul_eq_div]

/-- Every point `y` is charged by a finitely supported `1`-sub-Gaussian law: the law of `y / n`
times a sum of `n ≥ y ^ 2` independent signs. -/
private lemma exists_measure_singleton_pos (y : ℝ) :
    ∃ μ : Measure ℝ, IsProbabilityMeasure μ ∧ HasSubgaussianMGF id 1 μ ∧
      (∃ s : Finset ℝ, μ (↑s)ᶜ = 0) ∧ 0 < μ {y} := by
  set n : ℕ := ⌈y ^ 2⌉₊ + 1 with hn
  have hn0 : (0 : ℝ) < n := by positivity
  have hny : y ^ 2 ≤ n := by
    rw [hn]; push_cast; linarith [Nat.le_ceil (y ^ 2)]
  set c : ℝ := y / n with hc
  set x : (Fin n → Bool) → ℝ := fun σ ↦ c * ∑ i, if σ i then (1 : ℝ) else -1 with hx
  have hw : ∀ σ : Fin n → Bool, 0 ≤ (2 ^ n : ℝ)⁻¹ := fun _ ↦ by positivity
  refine ⟨∑ σ, ENNReal.ofReal (2 ^ n : ℝ)⁻¹ • Measure.dirac (x σ),
    isProbabilityMeasure_sum_smul_dirac hw ?_ x, hasSubgaussianMGF_sum_smul_dirac hw x
      fun t ↦ ?_, ⟨Finset.univ.image x, sum_smul_dirac_compl_eq_zero fun σ ↦
        Finset.mem_image_of_mem _ (Finset.mem_univ σ)⟩, ?_⟩
  · simp [Finset.card_univ]
  · simp_rw [hx, ← mul_assoc]
    rw [sum_inv_two_pow_mul_exp_mul_sum_sign]
    calc cosh (t * c) ^ n ≤ exp ((t * c) ^ 2 / 2) ^ n := by
          gcongr
          exact cosh_le_exp_half_sq _
      _ = exp (n * ((t * c) ^ 2 / 2)) := (exp_nat_mul _ _).symm
      _ ≤ exp (t ^ 2 / 2) := by
          gcongr
          have h1 : (n : ℝ) * ((t * c) ^ 2 / 2) = t ^ 2 / 2 * (y ^ 2 / n) := by
            rw [hc]; field_simp
          have h2 : y ^ 2 / n ≤ 1 := (div_le_one hn0).2 hny
          rw [h1]
          nlinarith [sq_nonneg t]
  · have hy : x (fun _ ↦ true) = y := by simp [hx, hc]
    calc (0 : ℝ≥0∞) < ENNReal.ofReal (2 ^ n : ℝ)⁻¹ * Measure.dirac (x fun _ ↦ true) {y} := by
          simp [hy]
      _ ≤ ∑ σ, ENNReal.ofReal (2 ^ n : ℝ)⁻¹ * Measure.dirac (x σ) {y} :=
          Finset.single_le_sum (f := fun σ ↦ ENNReal.ofReal (2 ^ n : ℝ)⁻¹ *
            Measure.dirac (x σ) {y}) (fun _ _ ↦ bot_le) (Finset.mem_univ _)
      _ = _ := by simp

/-- A function whose mean is at most `1` under every finitely supported `1`-sub-Gaussian law is
finite everywhere. -/
private lemma ne_top_of_forall_lintegral_le_one {E : ℝ → ℝ≥0∞}
    (hE : ∀ μ : Measure ℝ, IsProbabilityMeasure μ → HasSubgaussianMGF id 1 μ →
      (∃ s : Finset ℝ, μ (↑s)ᶜ = 0) → ∫⁻ x, E x ∂μ ≤ 1) (x : ℝ) :
    E x ≠ ⊤ := by
  obtain ⟨μ, hμ1, hμ, hs, hpos⟩ := exists_measure_singleton_pos x
  have h : E x * μ {x} ≤ 1 :=
    calc E x * μ {x} = ∫⁻ y in {x}, E y ∂μ := (lintegral_singleton _ _).symm
      _ ≤ ∫⁻ y, E y ∂μ := setLIntegral_le_lintegral _ _
      _ ≤ 1 := hE μ hμ1 hμ hs
  intro htop
  rw [htop, ENNReal.top_mul hpos.ne'] at h
  exact absurd h (by simp)

end FiniteSupport

/-! ### Completeness -/

/-- The compensated kernel at `x`, as a bounded continuous function of its parameter. -/
private noncomputable def compensatedExpBCF (x : ℝ) : EReal →ᵇ ℝ :=
  BoundedContinuousFunction.mkOfCompact
    ⟨fun l ↦ subGaussianCompensatedExp l x, continuous_subGaussianCompensatedExp x⟩

/-- Evaluation of the compensated kernel as a bounded continuous function. -/
private lemma compensatedExpBCF_apply (x : ℝ) (l : EReal) :
    compensatedExpBCF x l = subGaussianCompensatedExp l x :=
  rfl

/-- Each section of the compensated kernel is integrable against a finite measure. -/
private lemma integrable_subGaussianCompensatedExp_finiteMeasure (ν : FiniteMeasure EReal)
    (x : ℝ) : Integrable (fun l ↦ subGaussianCompensatedExp l x) (ν : Measure EReal) :=
  (compensatedExpBCF x).integrable _

/-- The integral of a section of the compensated kernel is at most the mass times the sup norm
of the section. -/
private lemma abs_integral_subGaussianCompensatedExp_le (ν : FiniteMeasure EReal) (x : ℝ) :
    |∫ l, subGaussianCompensatedExp l x ∂(ν : Measure EReal)| ≤
      ν.mass * ‖compensatedExpBCF x‖ := by
  simpa [compensatedExpBCF_apply] using
    BoundedContinuousFunction.norm_integral_le_mul_norm (ν : Measure EReal) (compensatedExpBCF x)

/-- Lower bounds on the parameters `(a, ν)` at the points `0` and `±1` bound the mass of `ν` and
the drift `a`. -/
private lemma mass_le_and_abs_le_of_le {a R : ℝ} {ν : FiniteMeasure EReal}
    (h0 : -R ≤ ∫ l, subGaussianCompensatedExp l 0 ∂(ν : Measure EReal))
    (h1 : -R ≤ a + ∫ l, subGaussianCompensatedExp l 1 ∂(ν : Measure EReal))
    (hm1 : -R ≤ -a + ∫ l, subGaussianCompensatedExp l (-1) ∂(ν : Measure EReal)) :
    (ν.mass : ℝ) ≤ 2 * R ∧
      |a| ≤ R + 2 * R * (‖compensatedExpBCF 1‖ + ‖compensatedExpBCF (-1)‖) := by
  have hmass : ∫ l, subGaussianCompensatedExp l 0 ∂(ν : Measure EReal) ≤ -(ν.mass : ℝ) / 2 := by
    calc ∫ l, subGaussianCompensatedExp l 0 ∂(ν : Measure EReal)
        ≤ ∫ _, (-1 / 2 : ℝ) ∂(ν : Measure EReal) :=
          integral_mono (integrable_subGaussianCompensatedExp_finiteMeasure ν 0)
            (integrable_const _) subGaussianCompensatedExp_zero_right_le
      _ = -(ν.mass : ℝ) / 2 := by
          rw [integral_const, smul_eq_mul, FiniteMeasure.measureReal_eq_coe_coeFn]
          change (ν.mass : ℝ) * _ = _
          ring
  have hm : (ν.mass : ℝ) ≤ 2 * R := by linarith
  have hb1 := abs_integral_subGaussianCompensatedExp_le ν 1
  have hbm1 := abs_integral_subGaussianCompensatedExp_le ν (-1)
  have p1 := mul_le_mul_of_nonneg_right hm (norm_nonneg (compensatedExpBCF 1))
  have pm1 := mul_le_mul_of_nonneg_right hm (norm_nonneg (compensatedExpBCF (-1)))
  have hm0 : (0 : ℝ) ≤ ν.mass := ν.mass.2
  rw [abs_le] at hb1 hbm1
  refine ⟨hm, abs_le.2 ⟨?_, ?_⟩⟩ <;> nlinarith [norm_nonneg (compensatedExpBCF 1),
    norm_nonneg (compensatedExpBCF (-1))]

/-- The vector `(a y + ∫ k (l, y) ∂ν(l))_{y ∈ A}` of the parameters `θ = (a, ν)`. -/
private noncomputable def compensatedExpVec (A : Finset ℝ) (θ : ℝ × FiniteMeasure EReal) :
    A → ℝ :=
  fun y ↦ θ.1 * y + ∫ l, subGaussianCompensatedExp l y ∂(θ.2 : Measure EReal)

/-- The vector of the parameters depends continuously on them. -/
private lemma continuous_compensatedExpVec (A : Finset ℝ) : Continuous (compensatedExpVec A) :=
  continuous_pi fun y ↦ (continuous_fst.mul continuous_const).add
    ((FiniteMeasure.continuous_integral_boundedContinuousFunction
      (compensatedExpBCF y)).comp continuous_snd)

/-- The vector of a nonnegative combination of parameters. -/
private lemma compensatedExpVec_add_smul (A : Finset ℝ) (θ₁ θ₂ : ℝ × FiniteMeasure EReal)
    {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    compensatedExpVec A (a * θ₁.1 + b * θ₂.1, a.toNNReal • θ₁.2 + b.toNNReal • θ₂.2) =
      a • compensatedExpVec A θ₁ + b • compensatedExpVec A θ₂ := by
  funext y
  simp only [compensatedExpVec, FiniteMeasure.toMeasure_add, FiniteMeasure.toMeasure_smul,
    Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  rw [integral_add_measure, integral_smul_nnreal_measure, integral_smul_nnreal_measure]
  · simp only [NNReal.smul_def, Real.coe_toNNReal _ ha, Real.coe_toNNReal _ hb, smul_eq_mul]
    ring
  · exact (integrable_subGaussianCompensatedExp_finiteMeasure θ₁.2 y).smul_measure_nnreal
  · exact (integrable_subGaussianCompensatedExp_finiteMeasure θ₂.2 y).smul_measure_nnreal

/-- The vector of the parameters `(0, 0)` is zero. -/
private lemma compensatedExpVec_zero (A : Finset ℝ) : compensatedExpVec A (0, 0) = 0 := by
  funext y; simp [compensatedExpVec]

/-- The vector of a drift `a` and a Dirac mass at `l`. -/
private lemma compensatedExpVec_dirac (A : Finset ℝ) (a : ℝ) (l : EReal) :
    compensatedExpVec A (a, ⟨Measure.dirac l, inferInstance⟩) =
      fun y : A ↦ a * (y : ℝ) + subGaussianCompensatedExp l y := by
  funext y; simp [compensatedExpVec, integral_dirac]

/-- The set of vectors dominated by a continuous family is closed, when the parameters of the
dominating elements of bounded vectors lie in a compact set. -/
private lemma isClosed_setOf_exists_le {ι T : Type*} [Finite ι] [TopologicalSpace T]
    {Φ : T → ι → ℝ} (hΦ : Continuous Φ)
    (hK : ∀ R : ℝ, ∃ K : Set T, IsCompact K ∧
      ∀ t (v : ι → ℝ), (∀ i, |v i| ≤ R) → v ≤ Φ t → t ∈ K) :
    IsClosed {v : ι → ℝ | ∃ t, v ≤ Φ t} := by
  have := Fintype.ofFinite ι
  refine closure_subset_iff_isClosed.1 fun w hw ↦ ?_
  obtain ⟨K, hKc, hKmem⟩ := hK (‖w‖ + 1)
  have hKcl : IsClosed {v : ι → ℝ | ∃ t ∈ K, v ≤ Φ t} := by
    have := isCompact_iff_compactSpace.1 hKc
    have heq : {v : ι → ℝ | ∃ t ∈ K, v ≤ Φ t} =
        Prod.fst '' {p : (ι → ℝ) × K | p.1 ≤ Φ p.2} := by
      ext v
      constructor
      · rintro ⟨t, htK, hv⟩
        exact ⟨(v, ⟨t, htK⟩), hv, rfl⟩
      · rintro ⟨⟨v', t⟩, hv, rfl⟩
        exact ⟨t, t.2, hv⟩
    rw [heq]
    exact isClosedMap_fst_of_compactSpace _
      (isClosed_le continuous_fst (hΦ.comp (continuous_subtype_val.comp continuous_snd)))
  have hsub : Metric.ball w 1 ∩ {v | ∃ t, v ≤ Φ t} ⊆ {v | ∃ t ∈ K, v ≤ Φ t} := by
    rintro v ⟨hv, t, ht⟩
    refine ⟨t, hKmem t v (fun i ↦ ?_) ht, ht⟩
    have h1 := norm_le_pi_norm v i
    have h2 := norm_sub_norm_le v w
    rw [Metric.mem_ball, dist_eq_norm] at hv
    rw [← Real.norm_eq_abs]
    linarith
  obtain ⟨t, -, ht⟩ := hKcl.closure_subset
    (closure_mono hsub (Metric.isOpen_ball.inter_closure ⟨Metric.mem_ball_self one_pos, hw⟩))
  exact ⟨t, ht⟩

/-- Completeness on a finite set of points containing `0` and `±1`: a function whose mean is at
most `1` under every finitely supported `1`-sub-Gaussian law is dominated there by some
`1 + a x + ∫ k (l, x) ∂ν(l)`. The proof separates the point from the closed convex cone of the
dominated vectors, and reads a finitely supported member of the null off the separating
functional. -/
private lemma exists_le_compensatedExpVec {E : ℝ → ℝ≥0∞}
    (hE : ∀ μ : Measure ℝ, IsProbabilityMeasure μ → HasSubgaussianMGF id 1 μ →
      (∃ s : Finset ℝ, μ (↑s)ᶜ = 0) → ∫⁻ x, E x ∂μ ≤ 1)
    (A : Finset ℝ) (h0 : (0 : ℝ) ∈ A) (h1 : (1 : ℝ) ∈ A) (hm1 : (-1 : ℝ) ∈ A) :
    ∃ θ : ℝ × FiniteMeasure EReal, (fun y : A ↦ (E y).toReal - 1) ≤ compensatedExpVec A θ := by
  have hfin := ne_top_of_forall_lintegral_le_one hE
  set C : Set (A → ℝ) := {v | ∃ θ, v ≤ compensatedExpVec A θ} with hC
  have hconv : Convex ℝ C := by
    rintro v₁ ⟨θ₁, h₁⟩ v₂ ⟨θ₂, h₂⟩ a b ha hb -
    refine ⟨(a * θ₁.1 + b * θ₂.1, a.toNNReal • θ₁.2 + b.toNNReal • θ₂.2), ?_⟩
    rw [compensatedExpVec_add_smul A θ₁ θ₂ ha hb]
    exact add_le_add (smul_le_smul_of_nonneg_left h₁ ha) (smul_le_smul_of_nonneg_left h₂ hb)
  have hcone : ∀ v ∈ C, ∀ c : ℝ, 0 ≤ c → c • v ∈ C := by
    rintro v ⟨θ, hθ⟩ c hc
    refine ⟨(c * θ.1 + 0 * θ.1, c.toNNReal • θ.2 + (0 : ℝ).toNNReal • θ.2), ?_⟩
    rw [compensatedExpVec_add_smul A θ θ hc le_rfl, zero_smul, add_zero]
    exact smul_le_smul_of_nonneg_left hθ hc
  have hclosed : IsClosed C := by
    refine isClosed_setOf_exists_le (continuous_compensatedExpVec A) fun R ↦ ?_
    set M := R + 2 * R * (‖compensatedExpBCF 1‖ + ‖compensatedExpBCF (-1)‖)
    refine ⟨Set.Icc (-M) M ×ˢ {ν | ν.mass ≤ (2 * R).toNNReal},
      isCompact_Icc.prod (isCompact_setOfPred_finiteMeasure_le_of_compactSpace EReal _),
      fun θ v hv hθ ↦ ?_⟩
    have hle : ∀ y : A, -R ≤ compensatedExpVec A θ y :=
      fun y ↦ (neg_le_of_abs_le (hv y)).trans (hθ y)
    have hR : 0 ≤ R := (abs_nonneg _).trans (hv ⟨0, h0⟩)
    have h0' := hle ⟨0, h0⟩
    have h1' := hle ⟨1, h1⟩
    have hm1' := hle ⟨-1, hm1⟩
    simp only [compensatedExpVec, mul_zero, zero_add, mul_one, mul_neg] at h0' h1' hm1'
    have := mass_le_and_abs_le_of_le h0' h1' hm1'
    exact ⟨abs_le.1 this.2, (Real.le_toNNReal_iff_coe_le (by linarith)).2 this.1⟩
  by_contra hv₀
  obtain ⟨φ, u, hφ, hu⟩ := geometric_hahn_banach_closed_point hconv hclosed hv₀
  have hu0 : 0 < u := by simpa using hφ 0 ⟨(0, 0), by rw [compensatedExpVec_zero]⟩
  have hφC : ∀ v ∈ C, φ v ≤ 0 := by
    intro v hv
    by_contra hpos
    have hpos' : 0 < φ v := lt_of_not_ge hpos
    have := hφ ((u / φ v + 1) • v) (hcone v hv _ (by positivity))
    rw [map_smul, smul_eq_mul, add_mul, div_mul_cancel₀ _ hpos'.ne'] at this
    linarith
  set q : A → ℝ := fun i ↦ φ (fun j ↦ if i = j then 1 else 0) with hq
  have hφsum : ∀ v, φ v = ∑ i : A, v i * q i := fun v ↦ by
    simpa [smul_eq_mul] using LinearMap.pi_apply_eq_sum_univ (φ : (A → ℝ) →ₗ[ℝ] ℝ) v
  have hq0 : ∀ i, 0 ≤ q i := by
    intro i
    have := hφC (-(fun j ↦ if i = j then (1 : ℝ) else 0)) ⟨(0, 0), by
      rw [compensatedExpVec_zero]
      intro j
      simp only [Pi.neg_apply, Pi.zero_apply, neg_nonpos]
      split_ifs <;> norm_num⟩
    rw [map_neg] at this
    linarith
  have hmean : ∑ i : A, (i : ℝ) * q i = 0 := by
    have h1' := hφC (fun j : A ↦ (j : ℝ)) ⟨(1, 0), fun j ↦ by simp [compensatedExpVec]⟩
    have h2' := hφC (fun j : A ↦ -(j : ℝ)) ⟨(-1, 0), fun j ↦ by simp [compensatedExpVec]⟩
    rw [hφsum] at h1' h2'
    simp only [neg_mul, Finset.sum_neg_distrib] at h2'
    linarith
  have hker : ∀ l : EReal, ∑ i : A, subGaussianCompensatedExp l i * q i ≤ 0 := by
    intro l
    have := hφC (fun j : A ↦ subGaussianCompensatedExp l j)
      ⟨(0, ⟨Measure.dirac l, inferInstance⟩), by
        rw [compensatedExpVec_dirac]; intro j; simp⟩
    rwa [hφsum] at this
  -- the separating functional is a finitely supported member of the null
  have hpos : 0 < ∑ i : A, ((E i).toReal - 1) * q i := by rw [← hφsum]; linarith
  set Q := ∑ i : A, q i with hQ
  have hQ0 : 0 < Q := by
    rcases (Finset.sum_nonneg fun i _ ↦ hq0 i : 0 ≤ Q).lt_or_eq with h | h
    · exact h
    · exfalso
      have h' := (Finset.sum_eq_zero_iff_of_nonneg fun i _ ↦ hq0 i).1 h.symm
      have : ∑ i : A, ((E i).toReal - 1) * q i = 0 :=
        Finset.sum_eq_zero fun i hi ↦ by rw [h' i hi, mul_zero]
      linarith
  have hexp : ∀ t : ℝ, ∑ i : A, q i * exp (t * i) ≤ Q * exp (t ^ 2 / 2) := by
    intro t
    have h1 : ∑ i : A, (exp (t * i - t ^ 2 / 2) - 1) * q i ≤ 0 := by
      have h := mul_nonpos_of_nonneg_of_nonpos (by positivity : 0 ≤ t ^ 2 / (1 + t ^ 2))
        (hker t)
      calc ∑ i : A, (exp (t * i - t ^ 2 / 2) - 1) * q i
          = t ^ 2 / (1 + t ^ 2) * ∑ i : A, subGaussianCompensatedExp t i * q i +
            t / (1 + t ^ 2) * ∑ i : A, (i : ℝ) * q i := by
            simp_rw [exp_sub_one_eq_mul_subGaussianCompensatedExp_add, Finset.mul_sum,
              ← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl fun i _ ↦ by ring
        _ ≤ 0 := by rw [hmean, mul_zero, add_zero]; exact h
    have h2 : ∀ i : A, (exp (t * i - t ^ 2 / 2) - 1) * q i =
        exp (-(t ^ 2 / 2)) * (q i * exp (t * i)) - q i := by
      intro i; rw [sub_eq_add_neg (t * _), exp_add]; ring
    simp_rw [h2] at h1
    rw [Finset.sum_sub_distrib, ← Finset.mul_sum, ← hQ] at h1
    calc ∑ i : A, q i * exp (t * i)
        = exp (t ^ 2 / 2) * (exp (-(t ^ 2 / 2)) * ∑ i : A, q i * exp (t * i)) := by
          rw [← mul_assoc, ← exp_add]; simp
      _ ≤ exp (t ^ 2 / 2) * Q := by gcongr; linarith
      _ = Q * exp (t ^ 2 / 2) := mul_comm _ _
  have hw : ∀ i, 0 ≤ q i / Q := fun i ↦ div_nonneg (hq0 i) hQ0.le
  have hsum1 : ∑ i : A, q i / Q = 1 := by rw [← Finset.sum_div, div_self hQ0.ne']
  set P : Measure ℝ := ∑ i : A, ENNReal.ofReal (q i / Q) • Measure.dirac (i : ℝ) with hP
  have hP1 : IsProbabilityMeasure P := isProbabilityMeasure_sum_smul_dirac hw hsum1 _
  have hPsg : HasSubgaussianMGF id 1 P := by
    refine hasSubgaussianMGF_sum_smul_dirac hw _ fun t ↦ ?_
    calc ∑ i : A, q i / Q * exp (t * i) = (∑ i : A, q i * exp (t * i)) / Q := by
          rw [Finset.sum_div]
          exact Finset.sum_congr rfl fun i _ ↦ by ring
      _ ≤ exp (t ^ 2 / 2) := by rw [div_le_iff₀ hQ0]; linarith [hexp t]
  have hEP := hE P hP1 hPsg ⟨A, sum_smul_dirac_compl_eq_zero fun i ↦ i.2⟩
  rw [hP, lintegral_finsetSum_measure] at hEP
  simp only [lintegral_smul_measure, lintegral_dirac, smul_eq_mul] at hEP
  have hconv' : ∑ i : A, ENNReal.ofReal (q i / Q) * E i =
      ENNReal.ofReal (∑ i : A, q i / Q * (E i).toReal) := by
    rw [ENNReal.ofReal_sum_of_nonneg fun i _ ↦ mul_nonneg (hw i) ENNReal.toReal_nonneg]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [ENNReal.ofReal_mul (hw i), ENNReal.ofReal_toReal (hfin i)]
  rw [hconv', ENNReal.ofReal_le_one] at hEP
  have hrw : ∑ i : A, ((E i).toReal - 1) * q i =
      Q * (∑ i : A, q i / Q * (E i).toReal - 1) := by
    rw [mul_sub, Finset.mul_sum, mul_one]
    simp only [sub_mul, Finset.sum_sub_distrib, one_mul]
    congr 1
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    field_simp
  rw [hrw] at hpos
  nlinarith

/-- **Completeness of the class.** Every function `E : ℝ → ℝ≥0∞`, measurable or not, whose mean
is at most `1` under every finitely supported `1`-sub-Gaussian probability law is dominated at
every point by a nonnegative function `1 + a x + ∫ k (l, x) ∂ν(l)`, for a real `a` and a finite
measure `ν` on the extended line. -/
theorem exists_le_ofReal_one_add_integral_subGaussianCompensatedExp {E : ℝ → ℝ≥0∞}
    (hE : ∀ μ : Measure ℝ, IsProbabilityMeasure μ → HasSubgaussianMGF id 1 μ →
      (∃ s : Finset ℝ, μ (↑s)ᶜ = 0) → ∫⁻ x, E x ∂μ ≤ 1) :
    ∃ (a : ℝ) (ν : Measure EReal), IsFiniteMeasure ν ∧
      (∀ x, 0 ≤ 1 + a * x + ∫ l, subGaussianCompensatedExp l x ∂ν) ∧
      ∀ x, E x ≤ ENNReal.ofReal (1 + a * x + ∫ l, subGaussianCompensatedExp l x ∂ν) := by
  have hfin := ne_top_of_forall_lintegral_le_one hE
  set M := 1 + 2 * 1 * (‖compensatedExpBCF 1‖ + ‖compensatedExpBCF (-1)‖)
  set K : Set (ℝ × FiniteMeasure EReal) := Set.Icc (-M) M ×ˢ {ν | ν.mass ≤ 2}
  have hK : IsCompact K :=
    isCompact_Icc.prod (isCompact_setOfPred_finiteMeasure_le_of_compactSpace EReal 2)
  set t : ℝ → Set (ℝ × FiniteMeasure EReal) := fun x ↦
    {θ | (E x).toReal ≤ 1 + θ.1 * x + ∫ l, subGaussianCompensatedExp l x ∂(θ.2 : Measure EReal)}
  have ht : ∀ x, IsClosed (t x) := fun x ↦ isClosed_le continuous_const
    ((continuous_const.add (continuous_fst.mul continuous_const)).add
      ((FiniteMeasure.continuous_integral_boundedContinuousFunction (compensatedExpBCF x)).comp
        continuous_snd))
  have hfip : ∀ u : Finset ℝ, (K ∩ ⋂ i ∈ u, t i).Nonempty := by
    intro u
    set A : Finset ℝ := insert 0 (insert 1 (insert (-1) u)) with hA
    obtain ⟨θ, hθ⟩ := exists_le_compensatedExpVec hE A (by simp [A]) (by simp [A]) (by simp [A])
    have hy : ∀ y ∈ A, (E y).toReal ≤
        1 + θ.1 * y + ∫ l, subGaussianCompensatedExp l y ∂(θ.2 : Measure EReal) := by
      intro y hy
      have := hθ ⟨y, hy⟩
      simp only [compensatedExpVec] at this
      linarith
    have h0 := hy 0 (by simp [A])
    have h1 := hy 1 (by simp [A])
    have hm1 := hy (-1) (by simp [A])
    have hb := mass_le_and_abs_le_of_le (a := θ.1) (R := 1) (ν := θ.2)
      (by linarith [ENNReal.toReal_nonneg (a := E 0)])
      (by linarith [ENNReal.toReal_nonneg (a := E 1)])
      (by linarith [ENNReal.toReal_nonneg (a := E (-1))])
    have h2 : (θ.2.mass : ℝ) ≤ 2 := by linarith [hb.1]
    refine ⟨θ, ⟨abs_le.1 hb.2, ?_⟩, Set.mem_iInter₂.2 fun x hx ↦ hy x (by simp [A, hx])⟩
    exact_mod_cast h2
  obtain ⟨θ, -, hθt⟩ := hK.inter_iInter_nonempty t ht hfip
  refine ⟨θ.1, θ.2, inferInstance, fun x ↦ ?_, fun x ↦ ?_⟩
  · exact ENNReal.toReal_nonneg.trans (Set.mem_iInter.1 hθt x)
  · rw [← ENNReal.ofReal_toReal (hfin x)]
    exact ENNReal.ofReal_le_ofReal (Set.mem_iInter.1 hθt x)

/-- **The complete class.** Every e-variable for the two-sided `1`-sub-Gaussian null is dominated
at every point by a nonnegative function `1 + a x + ∫ k (l, x) ∂ν(l)`, for a real `a` and a
finite measure `ν` on the extended line. -/
theorem IsEVar.exists_le_ofReal_one_add_integral_subGaussianCompensatedExp {E : ℝ → ℝ≥0∞}
    (hE : IsEVar E {μ : Measure ℝ | IsProbabilityMeasure μ ∧ HasSubgaussianMGF id 1 μ}) :
    ∃ (a : ℝ) (ν : Measure EReal), IsFiniteMeasure ν ∧
      (∀ x, 0 ≤ 1 + a * x + ∫ l, subGaussianCompensatedExp l x ∂ν) ∧
      ∀ x, E x ≤ ENNReal.ofReal (1 + a * x + ∫ l, subGaussianCompensatedExp l x ∂ν) :=
  ProbabilityTheory.exists_le_ofReal_one_add_integral_subGaussianCompensatedExp fun _ hμ1 hμ _ ↦
    hE.lintegral_le_one ⟨hμ1, hμ⟩

end ProbabilityTheory
