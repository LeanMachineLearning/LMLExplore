section General

variable {𝓧 ι : Type*} {m𝓧 : MeasurableSpace 𝓧} [Fintype ι] [DecidableEq ι]

/-- The expectation under `P ^ M` of the V-statistic of `H` over the first `M` observations is at
least `M (M - 1) ⋯ (M - n + 1)` times `M⁻ⁿ` times the expectation of `H` under `P ^ n`: the
terms of the V-statistic with distinct indices all have that expectation. -/
private lemma descFactorial_mul_lintegral_pi_le (P : Measure 𝓧) [IsProbabilityMeasure P]
    {H : (ι → 𝓧) → ℝ≥0∞} (hH : Measurable H) (M : ℕ) :
    (M.descFactorial (Fintype.card ι) : ℝ≥0∞) * ∫⁻ x, H x ∂(Measure.pi fun _ : ι ↦ P) ≤
      ∫⁻ y, ∑ i : ι → Fin M, H (y ∘ i) ∂(Measure.pi fun _ : Fin M ↦ P) := by
  have hcomp (i : ι → Fin M) : Measurable fun y : Fin M → 𝓧 ↦ H (y ∘ i) :=
    hH.comp (Measurable.of_eval fun k ↦ measurable_pi_apply (i k))
  -- each term with distinct indices has the expectation of `H` under `P ^ n`
  have h_emb (e : ι ↪ Fin M) :
      ∫⁻ y, H (y ∘ e) ∂(Measure.pi fun _ : Fin M ↦ P) = ∫⁻ x, H x ∂(Measure.pi fun _ : ι ↦ P) := by
    rw [← Measure.pi_map_comp_of_injective (fun _ : Fin M ↦ P) e.injective,
      lintegral_map hH (Measurable.of_eval fun k ↦ measurable_pi_apply (e k))]
    simp only [Function.comp_def]
  rw [lintegral_finsetSum _ fun i _ ↦ hcomp i]
  calc (M.descFactorial (Fintype.card ι) : ℝ≥0∞) * ∫⁻ x, H x ∂(Measure.pi fun _ : ι ↦ P)
  _ = ∑ e : ι ↪ Fin M, ∫⁻ y, H (y ∘ e) ∂(Measure.pi fun _ : Fin M ↦ P) := by
    simp only [h_emb, sum_const, card_univ, Fintype.card_embedding_eq, Fintype.card_fin,
      nsmul_eq_mul]
  _ = ∑ i ∈ univ.map ⟨fun e : ι ↪ Fin M ↦ (e : ι → Fin M), DFunLike.coe_injective⟩,
      ∫⁻ y, H (y ∘ i) ∂(Measure.pi fun _ : Fin M ↦ P) := by
    rw [sum_map, Function.Embedding.coeFn_mk]
  _ ≤ ∑ i : ι → Fin M, ∫⁻ y, H (y ∘ i) ∂(Measure.pi fun _ : Fin M ↦ P) :=
    sum_le_sum_of_subset (subset_univ _)

/-- **The e-variables of an i.i.d. sample are those with V-statistics at most `1`.** On any
measurable space, a function `H` of a finite number `n` of observations has expectation at most
`1` under the i.i.d. law of every probability measure exactly when it is measurable and, for
every finite sample `y` of size `M > 0`, its V-statistic `M⁻ⁿ ∑_{i ∈ [M]ⁿ} H (y ∘ i)` is at most
`1` [EVR26, Note 11, Proposition 3]. -/
theorem isEVar_pi_iff_sum_comp_le_one (H : (ι → 𝓧) → ℝ≥0∞) :
    IsEVar H ((fun P : Measure 𝓧 ↦ Measure.pi fun _ : ι ↦ P) '' {P | IsProbabilityMeasure P}) ↔
      Measurable H ∧ ∀ M : ℕ, 0 < M → ∀ y : Fin M → 𝓧,
        (M : ℝ≥0∞)⁻¹ ^ Fintype.card ι * ∑ i : ι → Fin M, H (y ∘ i) ≤ 1 := by
  refine ⟨fun hE ↦ ⟨hE.measurable, fun M hM y ↦ ?_⟩, fun ⟨hH, hV⟩ ↦ ⟨hH, ?_⟩⟩
  · -- the V-statistic is the expectation under the i.i.d. law of the empirical measure
    have : Nonempty (Fin M) := ⟨⟨0, hM⟩⟩
    have h := lintegral_pi_empiricalMeasureOfFintype (ι := ι) y hE.measurable
    rw [Fintype.card_fin] at h
    rw [← h]
    exact hE.lintegral_le_one ⟨_, inferInstance, rfl⟩
  · rintro _ ⟨P, hP, rfl⟩
    have : IsProbabilityMeasure P := hP
    set I := ∫⁻ x, H x ∂(Measure.pi fun _ : ι ↦ P)
    -- for every `M > 0`, `I * (M (M - 1) ⋯ (M - n + 1) / Mⁿ) ≤ 1`
    have hM (M : ℕ) (hM : 0 < M) :
        I * ((M.descFactorial (Fintype.card ι) : ℝ≥0∞) * (M : ℝ≥0∞)⁻¹ ^ Fintype.card ι) ≤ 1 := by
      calc I * ((M.descFactorial (Fintype.card ι) : ℝ≥0∞) * (M : ℝ≥0∞)⁻¹ ^ Fintype.card ι)
      _ = (M : ℝ≥0∞)⁻¹ ^ Fintype.card ι * ((M.descFactorial (Fintype.card ι) : ℝ≥0∞) * I) := by
        ring
      _ ≤ (M : ℝ≥0∞)⁻¹ ^ Fintype.card ι *
          ∫⁻ y, ∑ i : ι → Fin M, H (y ∘ i) ∂(Measure.pi fun _ : Fin M ↦ P) := by
        gcongr
        exact descFactorial_mul_lintegral_pi_le P hH M
      _ = ∫⁻ y, (M : ℝ≥0∞)⁻¹ ^ Fintype.card ι * ∑ i : ι → Fin M, H (y ∘ i)
          ∂(Measure.pi fun _ : Fin M ↦ P) := by
        exact (lintegral_const_mul _ (Finset.measurable_fun_sum _ fun i _ ↦
          hH.comp (Measurable.of_eval fun k ↦ measurable_pi_apply (i k)))).symm
      _ ≤ ∫⁻ _, 1 ∂(Measure.pi fun _ : Fin M ↦ P) := lintegral_mono fun y ↦ hV M hM y
      _ = 1 := by simp
    have h := ENNReal.Tendsto.const_mul (ENNReal.tendsto_descFactorial_mul_inv_pow (Fintype.card ι))
      (a := I) (.inl one_ne_zero)
    rw [mul_one] at h
    exact le_of_tendsto h (eventually_atTop.2 ⟨1, fun M hM' ↦ hM M hM'⟩)

end General

section Finite

variable {V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq ι]

/-- On a finite alphabet, the polynomial `∑ e, (∏ i, u (e i)) * H e` of two observations, for
finite weights `u` and a finite `H`, is the quadratic form of the matrix of the values of `H` at
the vector of the weights. -/
private lemma sum_finTwo_prod_mul_eq_ofReal {u : V → ℝ≥0∞} (hu : ∀ v, u v ≠ ⊤)
    {H : (Fin 2 → V) → ℝ≥0∞} (hH : ∀ x, H x ≠ ⊤) :
    ∑ e : Fin 2 → V, (∏ i, u (e i)) * H e =
      ENNReal.ofReal ((fun v ↦ (u v).toReal) ⬝ᵥ
        Matrix.of (fun a b ↦ (H ![a, b]).toReal) *ᵥ fun v ↦ (u v).toReal) := by
  have h_fin : ∀ e : Fin 2 → V, (∏ i, u (e i)) * H e ≠ ⊤ := fun e ↦
    ENNReal.mul_ne_top (ENNReal.prod_ne_top fun i _ ↦ hu (e i)) (hH e)
  rw [← ENNReal.ofReal_toReal (ENNReal.sum_ne_top.2 fun e _ ↦ h_fin e),
    ENNReal.toReal_sum fun e _ ↦ h_fin e,
    ← (finTwoArrowEquiv V).symm.sum_comp, Fintype.sum_prod_type]
  congr 1
  simp only [dotProduct, mulVec, Matrix.of_apply, Finset.mul_sum, Fin.prod_univ_two,
    ENNReal.toReal_mul]
  refine sum_congr rfl fun a _ ↦ sum_congr rfl fun b _ ↦ ?_
  simp only [finTwoArrowEquiv_symm_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_fin_one]
  ring

/-- A real probability vector, as weights in `ℝ≥0∞`. -/
private lemma exists_sum_eq_one_toReal_eq {w : V → ℝ} (hw : 0 ≤ w) (hw₁ : ∑ v, w v = 1) :
    ∃ u : V → ℝ≥0∞, ∑ v, u v = 1 ∧ (fun v ↦ (u v).toReal) = w := by
  refine ⟨fun v ↦ ENNReal.ofReal (w v), ?_, funext fun v ↦ ENNReal.toReal_ofReal (hw v)⟩
  rw [← ENNReal.ofReal_sum_of_nonneg fun v _ ↦ hw v, hw₁, ENNReal.ofReal_one]

/-- Weights in `ℝ≥0∞` that sum to `1` are finite, and form a real probability vector. -/
private lemma toReal_of_sum_eq_one {u : V → ℝ≥0∞} (hu : ∑ v, u v = 1) :
    (∀ v, u v ≠ ⊤) ∧ 0 ≤ (fun v ↦ (u v).toReal) ∧ ∑ v, (u v).toReal = 1 := by
  have hfin : ∀ v, u v ≠ ⊤ := fun v ↦ ne_top_of_le_ne_top (hu ▸ ENNReal.one_ne_top)
    (single_le_sum (fun _ _ ↦ zero_le) (mem_univ v))
  refine ⟨hfin, fun v ↦ ENNReal.toReal_nonneg, ?_⟩
  rw [← ENNReal.toReal_sum fun v _ ↦ hfin v, hu, ENNReal.toReal_one]

variable [MeasurableSpace V] [MeasurableSingletonClass V]

/-- **The e-variables of an i.i.d. sample on a finite alphabet.** On a finite alphabet, the
expectation of `H` under the i.i.d. law of a probability vector `u` is the polynomial
`∑ e, (∏ i, u (e i)) * H e`, so `H` is an e-variable for the i.i.d. laws exactly when this
polynomial is at most `1` on the simplex. -/
theorem isEVar_pi_iff_sum_prod_mul_le_one (H : (ι → V) → ℝ≥0∞) :
    IsEVar H ((fun P : Measure V ↦ Measure.pi fun _ : ι ↦ P) '' {P | IsProbabilityMeasure P}) ↔
      ∀ u : V → ℝ≥0∞, ∑ v, u v = 1 → ∑ e : ι → V, (∏ i, u (e i)) * H e ≤ 1 := by
  have h_int (W : Measure V) [IsFiniteMeasure W] :
      ∫⁻ x, H x ∂(Measure.pi fun _ : ι ↦ W) = ∑ e : ι → V, (∏ i, W {e i}) * H e := by
    rw [lintegral_fintype]
    simp only [Measure.pi_singleton, mul_comm]
  refine ⟨fun hE u hu ↦ ?_, fun h ↦ ⟨.of_discrete, ?_⟩⟩
  · -- the probability measure with masses `u`
    set W : Measure V := Measure.sum fun v ↦ u v • Measure.dirac v
    have hW : ∀ v, W {v} = u v := fun v ↦ Measure.sum_smul_dirac_singleton
    have : IsProbabilityMeasure W := ⟨by
      rw [← hu, ← coe_univ, ← sum_measure_singleton]
      exact sum_congr rfl fun v _ ↦ hW v⟩
    have h := hE.lintegral_le_one ⟨W, this, rfl⟩
    rw [h_int] at h
    simpa only [hW] using h
  · rintro _ ⟨W, hW, rfl⟩
    have : IsProbabilityMeasure W := hW
    rw [h_int]
    refine h (fun v ↦ W {v}) ?_
    rw [sum_measure_singleton, coe_univ, measure_univ]

/-- **The e-variables of two i.i.d. observations on a finite alphabet are given by copositive
matrices.** A function `H` of two observations on a finite alphabet is an e-variable for the
i.i.d. laws exactly when it is finite and the matrix `J - A_H` is copositive, where `J` is the
matrix of ones and `A_H a b = H ![a, b]`: `w ⬝ᵥ A_H *ᵥ w ≤ (∑ v, w v) ^ 2` for every nonnegative
vector `w` [EVR26, Note 11, Proposition 3]. The quadratic form, hence the condition, depends only
on the symmetrization of `A_H`. -/
theorem isEVar_pi_finTwo_iff_dotProduct_mulVec_le (H : (Fin 2 → V) → ℝ≥0∞) :
    IsEVar H ((fun P : Measure V ↦ Measure.pi fun _ : Fin 2 ↦ P) '' {P | IsProbabilityMeasure P}) ↔
      (∀ x, H x ≠ ⊤) ∧ ∀ w : V → ℝ, 0 ≤ w →
        w ⬝ᵥ Matrix.of (fun a b ↦ (H ![a, b]).toReal) *ᵥ w ≤ (∑ v, w v) ^ 2 := by
  classical
  rw [isEVar_pi_iff_sum_prod_mul_le_one]
  refine ⟨fun h ↦ ?_, fun ⟨hH, hq⟩ u hu ↦ ?_⟩
  · -- `H` is finite: the uniform law on the two observations of `x` charges `x`
    have hH : ∀ x, H x ≠ ⊤ := by
      intro x hx
      set u : V → ℝ≥0∞ := fun v ↦ (if v = x 0 then 2⁻¹ else 0) + if v = x 1 then 2⁻¹ else 0
      have hu : ∑ v, u v = 1 := by
        simp only [u, sum_add_distrib, sum_ite_eq', mem_univ, ↓reduceIte,
          ENNReal.inv_two_add_inv_two]
      have h_le : (∏ i, u (x i)) * H x ≤ 1 :=
        (single_le_sum (fun _ _ ↦ zero_le) (mem_univ x)).trans (h u hu)
      rw [hx, ENNReal.mul_top (prod_ne_zero_iff.2 fun i _ ↦ by fin_cases i <;> simp [u])] at h_le
      exact absurd h_le (by simp)
    refine ⟨hH, fun w hw ↦ ?_⟩
    -- normalize `w` to a probability vector
    rcases (sum_nonneg fun v _ ↦ hw v).eq_or_lt with hs | hs
    · have hw0 : w = 0 := funext fun v ↦ (sum_eq_zero_iff_of_nonneg fun v _ ↦ hw v).1
        hs.symm v (mem_univ v)
      simp [hw0]
    set s := ∑ v, w v
    have hws : 0 ≤ s⁻¹ • w := smul_nonneg (inv_nonneg.2 hs.le) hw
    obtain ⟨u, hu, hu_eq⟩ := exists_sum_eq_one_toReal_eq hws (by
      simp only [Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum]
      exact inv_mul_cancel₀ hs.ne')
    have h_le := h u hu
    rw [sum_finTwo_prod_mul_eq_ofReal (toReal_of_sum_eq_one hu).1 hH, hu_eq,
      ENNReal.ofReal_le_one, mulVec_smul, dotProduct_smul, smul_dotProduct, smul_eq_mul,
      smul_eq_mul] at h_le
    have hs2 : 0 < s ^ 2 := by positivity
    calc w ⬝ᵥ Matrix.of (fun a b ↦ (H ![a, b]).toReal) *ᵥ w
    _ = s ^ 2 * (s⁻¹ * (s⁻¹ * (w ⬝ᵥ Matrix.of (fun a b ↦ (H ![a, b]).toReal) *ᵥ w))) := by
      field_simp
    _ ≤ s ^ 2 * 1 := by gcongr
    _ = s ^ 2 := mul_one _
  · obtain ⟨hfin, hw, hw₁⟩ := toReal_of_sum_eq_one hu
    rw [sum_finTwo_prod_mul_eq_ofReal hfin hH, ENNReal.ofReal_le_one]
    simpa [hw₁] using hq _ hw

end Finite

/-- **Graph e-variables** [EVR26, Note 11, Theorem 4]. For a nonempty finite graph `G` with
clique number `ω`, `c` times the indicator that two i.i.d. observations are adjacent in `G` is an
e-variable for the i.i.d. laws of all probability measures on the vertices exactly when
`c ≤ ω / (ω - 1)`. For `ω = 1` the graph has no edge and the right side is `1 / 0 = ⊤`. The
largest probability that two i.i.d. vertices are adjacent is `(ω - 1) / ω`, by the Motzkin–Straus
theorem. -/
theorem isEVar_mul_indicator_adj_iff {V : Type*} [Finite V] [Nonempty V] [MeasurableSpace V]
    [MeasurableSingletonClass V] (G : SimpleGraph V) (c : ℝ≥0∞) :
    IsEVar (fun x : Fin 2 → V ↦ c * Set.indicator {x : Fin 2 → V | G.Adj (x 0) (x 1)} 1 x)
        ((fun W : Measure V ↦ Measure.pi fun _ : Fin 2 ↦ W) '' {W | IsProbabilityMeasure W}) ↔
      c ≤ (G.cliqueNum : ℝ≥0∞) / ((G.cliqueNum : ℝ≥0∞) - 1) := by
  classical
  have := Fintype.ofFinite V
  have hω₀ : (0 : ℝ) < G.cliqueNum := by
    exact_mod_cast Nat.pos_of_ne_zero G.cliqueNum_ne_zero_of_finite
  -- the right side is the inverse of the Motzkin–Straus bound `(ω - 1) / ω`
  have h_rhs : (G.cliqueNum : ℝ≥0∞) / ((G.cliqueNum : ℝ≥0∞) - 1) =
      (ENNReal.ofReal ((G.cliqueNum - 1) / G.cliqueNum))⁻¹ := by
    rw [ENNReal.ofReal_div_of_pos hω₀, ENNReal.ofReal_sub _ zero_le_one, ENNReal.ofReal_one,
      ENNReal.ofReal_natCast, ENNReal.inv_div (.inl (by simp))
      (.inl (by exact_mod_cast G.cliqueNum_ne_zero_of_finite))]
  -- the expectation under the i.i.d. law of weights `u` is `c` times the quadratic form of the
  -- adjacency matrix
  have h_sum (u : V → ℝ≥0∞) (hu : ∀ v, u v ≠ ⊤) :
      ∑ e : Fin 2 → V, (∏ i, u (e i)) *
          (c * Set.indicator {x : Fin 2 → V | G.Adj (x 0) (x 1)} 1 e) =
        c * ENNReal.ofReal ((fun v ↦ (u v).toReal) ⬝ᵥ G.adjMatrix ℝ *ᵥ fun v ↦ (u v).toReal) := by
    have h_mat : Matrix.of (fun a b ↦
        (Set.indicator {x : Fin 2 → V | G.Adj (x 0) (x 1)} (1 : (Fin 2 → V) → ℝ≥0∞)
          ![a, b]).toReal) = G.adjMatrix ℝ := by
      ext a b
      by_cases hab : G.Adj a b <;> simp [Set.indicator_apply, hab]
    rw [← h_mat, ← sum_finTwo_prod_mul_eq_ofReal hu fun x ↦ by
      by_cases hx : G.Adj (x 0) (x 1) <;> simp [hx], Finset.mul_sum]
    exact sum_congr rfl fun e _ ↦ by ring
  rw [isEVar_pi_iff_sum_prod_mul_le_one, h_rhs, ENNReal.le_inv_iff_mul_le]
  constructor
  · intro h
    obtain ⟨w, hw, hw₁, hw_eq⟩ := G.exists_dotProduct_adjMatrix_mulVec_eq
    obtain ⟨u, hu, hu_eq⟩ := exists_sum_eq_one_toReal_eq hw hw₁
    have h_le := h u hu
    rwa [h_sum u (toReal_of_sum_eq_one hu).1, hu_eq, hw_eq] at h_le
  · intro hc u hu
    obtain ⟨hfin, hw, hw₁⟩ := toReal_of_sum_eq_one hu
    rw [h_sum u hfin]
    refine le_trans ?_ hc
    gcongr
    exact G.dotProduct_adjMatrix_mulVec_le _ hw hw₁

end ProbabilityTheory
