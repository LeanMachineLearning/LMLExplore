/-!
# The optimal growth rate of e-variables against an i.i.d. null

For a law `Q₁` on `𝓧` (the alternative) and a set `S₁` of laws on `𝓧` (the null), the
`n`-sample e-variables are the e-variables for the `n`-fold products `P ^ n` of the members `P`
of `S₁`. Their maximal expected logarithm under `Q₁ ^ n`,
`maxLogGrowth Q₁ S₁ n`, is the largest e-power `maxEPower` of the `n`-sample null, which the
duality (`maxEPower_eq_klInf_effectiveSet`) writes as the smallest relative entropy from `Q₁ ^ n`
to the effective null of the `n`-sample null. It is superadditive in `n`, so that
`maxLogGrowth Q₁ S₁ n / n` converges to its supremum, the bipolar rate `bipolarRate Q₁ S₁`: the
optimal growth rate of the evidence against the i.i.d. null, per observation. It is at most the
smallest relative entropy `klInf Q₁ S₁` from `Q₁` to the null, and can be smaller
(Ram and Ramdas, Proposition 5.4).

The statements assume that `Q₁` is a probability measure and that the members of the null have
mass at most `1` (probability measures for the comparison with the relative entropy), and nothing
else: no domination, convexity or compactness.

## Main definitions

* `ProbabilityTheory.maxLogGrowth Q₁ S₁ n`: the maximal expected logarithm, under the `n`-fold
  product of `Q₁`, of the e-variables for the `n`-fold products of the members of `S₁`.
* `ProbabilityTheory.bipolarRate Q₁ S₁`: the supremum over `n ≥ 1` of `maxLogGrowth Q₁ S₁ n / n`.

## Main statements

* `ProbabilityTheory.maxLogGrowth_add_le`: `maxLogGrowth Q₁ S₁` is superadditive [RR26, Lemma 3.2].
* `ProbabilityTheory.tendsto_maxLogGrowth_div_bipolarRate`: `maxLogGrowth Q₁ S₁ n / n` tends to
  the bipolar rate [RR26, Lemma 3.2].
* `ProbabilityTheory.maxLogGrowth_le_mul_bipolarRate`:
  `maxLogGrowth Q₁ S₁ n ≤ n * bipolarRate Q₁ S₁` for `n ≠ 0`.
* `ProbabilityTheory.mul_maxLogGrowth_one_le`: `n * maxLogGrowth Q₁ S₁ 1 ≤ maxLogGrowth Q₁ S₁ n`.
* `ProbabilityTheory.maxLogGrowth_one_le_bipolarRate`: the growth of one observation is at most
  the bipolar rate.
* `ProbabilityTheory.maxLogGrowth_anti`, `ProbabilityTheory.bipolarRate_anti`: both are antitone
  in the null.
* `ProbabilityTheory.maxLogGrowth_le_mul_klDiv`, `ProbabilityTheory.bipolarRate_le_klInf`:
  the bipolar rate is at most the smallest relative entropy from `Q₁` to the null
  [RR26, proof of Theorem 4.1].
* `ProbabilityTheory.bipolarRate_singleton`: for a simple null `{P}`, the bipolar rate is
  `klDiv Q₁ P`.
* `ProbabilityTheory.le_bipolarRate_of_tendsto`: a lower bound on the bipolar rate from real lower
  bounds on `maxLogGrowth Q₁ S₁ (n + 1)` whose quotients by `n + 1` converge.
* `ProbabilityTheory.log_inv_le_bipolarRate_of_forall_le_maxLogGrowth`: for `ε ≤ 1`, the lower
  bound `log (1 / ε)` on the bipolar rate from the lower bounds `log (1 / (n ε ^ (n - 1)))` on
  `maxLogGrowth Q₁ S₁ n`.
* `ProbabilityTheory.le_maxLogGrowth_of_ofReal_exp_mul_le_one`: the lower bound on the growth of
  `m` observations given by the e-variable `1/2 + (1/2) e ^ t 1_A`, valid when
  `e ^ t P ^ m (A) ≤ 1` for every member `P` of the null.

## References

* [RR26] A. Ram and A. Ramdas, *The optimal betting wealth growth rate*, arXiv:2604.25280v1.
-/

public section

open MeasureTheory Filter InformationTheory
open scoped ENNReal Topology

namespace ProbabilityTheory

variable {𝓧 : Type*} {m𝓧 : MeasurableSpace 𝓧} {Q₁ P : Measure 𝓧} {S₁ T₁ : Set (Measure 𝓧)}
  {n : ℕ}

/-- The maximal expected logarithm of an `n`-sample e-variable for the i.i.d. laws of `S₁`, under
the `n`-fold product of `Q₁`: the supremum of `∫ᵉ x, log (E x) ∂Q₁ ^ n` over the functions
`E : (Fin n → 𝓧) → ℝ≥0∞` that are e-variables for `{P ^ n | P ∈ S₁}`. -/
noncomputable def maxLogGrowth (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) (n : ℕ) : EReal :=
  maxEPower (Measure.pi fun _ : Fin n ↦ Q₁) ((fun P ↦ Measure.pi fun _ : Fin n ↦ P) '' S₁)

/-- The bipolar rate of `Q₁` against the i.i.d. null generated by `S₁`: the supremum over `n ≥ 1`
of the maximal expected logarithm of an `n`-sample e-variable, divided by `n`. It is also the limit
of these normalized values [RR26, Lemma 3.2] (`tendsto_maxLogGrowth_div_bipolarRate`), and Ram
and Ramdas show that it is the optimal growth rate of e-processes against the null. -/
noncomputable def bipolarRate (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) : EReal :=
  ⨆ n : ℕ, maxLogGrowth Q₁ S₁ (n + 1) / ((n + 1 : ℕ) : EReal)

lemma maxLogGrowth_def (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) (n : ℕ) :
    maxLogGrowth Q₁ S₁ n = maxEPower (Measure.pi fun _ : Fin n ↦ Q₁)
      ((fun P ↦ Measure.pi fun _ : Fin n ↦ P) '' S₁) :=
  (rfl)

lemma bipolarRate_def (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) :
    bipolarRate Q₁ S₁ = ⨆ n : ℕ, maxLogGrowth Q₁ S₁ (n + 1) / ((n + 1 : ℕ) : EReal) :=
  (rfl)

/-- The `k`-fold products of the members of a set of measures of mass at most `1` have mass at
most `1`. -/
lemma measure_univ_le_one_of_mem_image_pi (hS₁ : ∀ P ∈ S₁, P Set.univ ≤ 1) (k : ℕ) :
    ∀ μ ∈ (fun P ↦ Measure.pi fun _ : Fin k ↦ P) '' S₁, μ Set.univ ≤ 1 := by
  rintro _ ⟨P, hP, rfl⟩
  have : IsFiniteMeasure P := ⟨(hS₁ P hP).trans_lt ENNReal.one_lt_top⟩
  rw [Measure.pi_univ]
  exact Finset.prod_le_one fun _ _ ↦ hS₁ P hP

/-- The maximal expected logarithm of an `n`-sample e-variable, for a null of measures of mass at
most `1`, is nonnegative, as the constant `1` is an e-variable. -/
lemma maxLogGrowth_nonneg (Q₁ : Measure 𝓧) (hS₁ : ∀ P ∈ S₁, P Set.univ ≤ 1) (n : ℕ) :
    0 ≤ maxLogGrowth Q₁ S₁ n :=
  maxEPower_nonneg _ (measure_univ_le_one_of_mem_image_pi hS₁ n)

/-- The normalized maximal expected logarithm of an `n`-sample e-variable is at most the bipolar
rate, for `n ≠ 0`. -/
lemma maxLogGrowth_div_le_bipolarRate (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) (hn : n ≠ 0) :
    maxLogGrowth Q₁ S₁ n / n ≤ bipolarRate Q₁ S₁ := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
  exact le_iSup (fun k : ℕ ↦ maxLogGrowth Q₁ S₁ (k + 1) / ((k + 1 : ℕ) : EReal)) k

/-- The bipolar rate is at most `c` if and only if `maxLogGrowth Q₁ S₁ n ≤ n * c` for every
`n ≠ 0`. -/
lemma bipolarRate_le_iff {c : EReal} :
    bipolarRate Q₁ S₁ ≤ c ↔ ∀ n ≠ 0, maxLogGrowth Q₁ S₁ n ≤ n * c := by
  have h (n : ℕ) (hn : n ≠ 0) : maxLogGrowth Q₁ S₁ n / n ≤ c ↔ maxLogGrowth Q₁ S₁ n ≤ n * c :=
    EReal.div_le_iff_le_mul (by exact_mod_cast Nat.pos_of_ne_zero hn) (EReal.natCast_ne_top _)
  refine ⟨fun hc n hn ↦ (h n hn).1 ((maxLogGrowth_div_le_bipolarRate Q₁ S₁ hn).trans hc),
    fun hc ↦ ?_⟩
  exact iSup_le fun n ↦ (h _ n.succ_ne_zero).2 (hc _ n.succ_ne_zero)

/-- The maximal expected logarithm of an `n`-sample e-variable is antitone in the null. -/
@[gcongr]
lemma maxLogGrowth_anti (h : S₁ ⊆ T₁) : maxLogGrowth Q₁ T₁ n ≤ maxLogGrowth Q₁ S₁ n :=
  maxEPower_anti (Set.image_mono h)

/-- With one observation, `maxLogGrowth` is the largest e-power of the null. -/
@[simp]
lemma maxLogGrowth_one (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) :
    maxLogGrowth Q₁ S₁ 1 = maxEPower Q₁ S₁ := by
  rw [maxLogGrowth_def]
  rcases isEmpty_or_nonempty 𝓧 with h𝓧 | h𝓧
  · -- on an empty space every measure is `0`, and both sides vanish
    rw [Measure.eq_zero_of_isEmpty (Measure.pi fun _ : Fin 1 ↦ Q₁),
      Measure.eq_zero_of_isEmpty Q₁, maxEPower_zero_measure, maxEPower_zero_measure]
  set e := (MeasurableEquiv.funUnique (Fin 1) 𝓧).symm
  have h_map (P : Measure 𝓧) : P.map e = Measure.pi fun _ : Fin 1 ↦ P :=
    (measurePreserving_funUnique P (Fin 1)).symm.map_eq
  rw [← e.measurableEmbedding.maxEPower_map_eq, h_map]
  congr 1
  ext μ
  simp only [Set.mem_image, Set.mem_ofPred_eq, h_map]

/-- **Superadditivity** of the maximal expected logarithm of e-variables for an i.i.d. null
[RR26, Lemma 3.2]: the product of an `m`-sample e-variable and an `n`-sample e-variable, on
disjoint blocks of observations, is an `m + n`-sample e-variable (Statlib's `IsEVar.prod`, through
`maxEPower_prod_eq_add`). -/
theorem maxLogGrowth_add_le (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁]
    (hS₁ : ∀ P ∈ S₁, P Set.univ ≤ 1) (m n : ℕ) :
    maxLogGrowth Q₁ S₁ m + maxLogGrowth Q₁ S₁ n ≤ maxLogGrowth Q₁ S₁ (m + n) := by
  -- split the first `m + n` observations into the first `m` and the last `n`
  let e : (Fin (m + n) → 𝓧) ≃ᵐ (Fin m → 𝓧) × (Fin n → 𝓧) :=
    (MeasurableEquiv.piCongrLeft (fun _ ↦ 𝓧) finSumFinEquiv).symm.trans
      (MeasurableEquiv.sumPiEquivProdPi fun _ ↦ 𝓧)
  have h_map (P : Measure 𝓧) [SigmaFinite P] :
      (Measure.pi fun _ : Fin (m + n) ↦ P).map e =
        (Measure.pi fun _ : Fin m ↦ P).prod (Measure.pi fun _ : Fin n ↦ P) :=
    ((measurePreserving_sumPiEquivProdPi fun _ ↦ P).comp
      ((measurePreserving_piCongrLeft (fun _ ↦ P) finSumFinEquiv).symm _)).map_eq
  calc maxLogGrowth Q₁ S₁ m + maxLogGrowth Q₁ S₁ n
  _ = maxEPower ((Measure.pi fun _ : Fin m ↦ Q₁).prod (Measure.pi fun _ : Fin n ↦ Q₁))
      (Set.image2 Measure.prod ((fun P ↦ Measure.pi fun _ : Fin m ↦ P) '' S₁)
        ((fun P ↦ Measure.pi fun _ : Fin n ↦ P) '' S₁)) :=
    by rw [maxLogGrowth_def, maxLogGrowth_def, maxEPower_prod_eq_add
      (measure_univ_le_one_of_mem_image_pi hS₁ m) (measure_univ_le_one_of_mem_image_pi hS₁ n)]
  _ ≤ maxEPower ((Measure.pi fun _ : Fin (m + n) ↦ Q₁).map e)
      {μ.map e | μ ∈ (fun P ↦ Measure.pi fun _ : Fin (m + n) ↦ P) '' S₁} := by
    rw [h_map]
    refine maxEPower_anti ?_
    rintro _ ⟨_, ⟨P, hP, rfl⟩, rfl⟩
    have : IsFiniteMeasure P := ⟨(hS₁ P hP).trans_lt ENNReal.one_lt_top⟩
    exact ⟨_, ⟨P, hP, rfl⟩, _, ⟨P, hP, rfl⟩, (h_map P).symm⟩
  _ ≤ maxLogGrowth Q₁ S₁ (m + n) := by
    rw [maxLogGrowth_def]
    exact maxEPower_map_le _ e.measurable

/-- The maximal expected logarithm of an `n`-sample e-variable is at most `n` times the bipolar
rate, for `n ≠ 0`. -/
lemma maxLogGrowth_le_mul_bipolarRate (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) (hn : n ≠ 0) :
    maxLogGrowth Q₁ S₁ n ≤ n * bipolarRate Q₁ S₁ :=
  bipolarRate_le_iff.1 le_rfl n hn

/-- The maximal expected logarithm of an `n`-sample e-variable is at least `n` times that of one
observation: superadditivity, iterated. -/
theorem mul_maxLogGrowth_one_le (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁]
    (hS₁ : ∀ P ∈ S₁, P Set.univ ≤ 1) (n : ℕ) :
    n * maxLogGrowth Q₁ S₁ 1 ≤ maxLogGrowth Q₁ S₁ n := by
  cases n with
  | zero => simpa using maxLogGrowth_nonneg Q₁ hS₁ 0
  | succ q =>
    simpa [EReal.nsmul_eq_mul] using
      EReal.nsmul_le_of_superadditive (maxLogGrowth_add_le Q₁ hS₁) 1 q

/-- The maximal expected logarithm of a one-observation e-variable is at most the bipolar
rate. -/
theorem maxLogGrowth_one_le_bipolarRate (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) :
    maxLogGrowth Q₁ S₁ 1 ≤ bipolarRate Q₁ S₁ := by
  simpa using maxLogGrowth_div_le_bipolarRate Q₁ S₁ one_ne_zero

/-- The bipolar rate of a null of measures of mass at most `1` is nonnegative. -/
lemma bipolarRate_nonneg (Q₁ : Measure 𝓧) (hS₁ : ∀ P ∈ S₁, P Set.univ ≤ 1) :
    0 ≤ bipolarRate Q₁ S₁ :=
  (EReal.div_nonneg (maxLogGrowth_nonneg _ hS₁ _) (by positivity)).trans
    (maxLogGrowth_div_le_bipolarRate Q₁ S₁ one_ne_zero)

/-- A finite bipolar rate, of a null of measures of mass at most `1`, is the coercion of its real
value. -/
lemma coe_toReal_bipolarRate (hS₁ : ∀ P ∈ S₁, P Set.univ ≤ 1) (hd : bipolarRate Q₁ S₁ ≠ ⊤) :
    ((bipolarRate Q₁ S₁).toReal : EReal) = bipolarRate Q₁ S₁ :=
  EReal.coe_toReal hd (ne_bot_of_le_ne_bot EReal.zero_ne_bot (bipolarRate_nonneg Q₁ hS₁))

/-- The bipolar rate is antitone in the null. -/
@[gcongr]
lemma bipolarRate_anti (h : S₁ ⊆ T₁) : bipolarRate Q₁ T₁ ≤ bipolarRate Q₁ S₁ :=
  bipolarRate_le_iff.2 fun _ hn ↦ (maxLogGrowth_anti h).trans
    (maxLogGrowth_le_mul_bipolarRate Q₁ S₁ hn)

/-- **Fekete's lemma** for the maximal expected logarithm of e-variables for an i.i.d. null:
`maxLogGrowth Q₁ S₁ n / n` tends to its supremum, the bipolar rate [RR26, Lemma 3.2]. The limit
may be `⊤`. -/
theorem tendsto_maxLogGrowth_div_bipolarRate (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁]
    (hS₁ : ∀ P ∈ S₁, P Set.univ ≤ 1) :
    Tendsto (fun n : ℕ ↦ maxLogGrowth Q₁ S₁ n / n) atTop (𝓝 (bipolarRate Q₁ S₁)) :=
  bipolarRate_def Q₁ S₁ ▸ EReal.tendsto_div_iSup_of_superadditive
    (fun _ _ ↦ ne_bot_of_le_ne_bot EReal.zero_ne_bot (maxLogGrowth_nonneg _ hS₁ _))
    (maxLogGrowth_add_le Q₁ hS₁)

/-- The maximal expected logarithm of an `n`-sample e-variable is at most `n` times the relative
entropy from `Q₁` to any member `P` of the null: this is its value for the null `{P}`, by
`maxEPower_singleton_eq_klDiv` and the tensorization of the relative entropy
[RR26, proof of Theorem 4.1]. -/
lemma maxLogGrowth_le_mul_klDiv (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁] (hP : P ∈ S₁)
    [IsProbabilityMeasure P] (n : ℕ) :
    maxLogGrowth Q₁ S₁ n ≤ n * (klDiv Q₁ P : EReal) := by
  calc maxLogGrowth Q₁ S₁ n
  _ ≤ maxEPower (Measure.pi fun _ : Fin n ↦ Q₁) {Measure.pi fun _ : Fin n ↦ P} :=
    maxEPower_anti (Set.singleton_subset_iff.2 ⟨P, hP, rfl⟩)
  _ = n * (klDiv Q₁ P : EReal) := by
    rw [maxEPower_singleton_eq_klDiv, klDiv_pi_const]
    simp

/-- The bipolar rate is at most the relative entropy from `Q₁` to any member of the null. -/
lemma bipolarRate_le_klDiv (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁] (hP : P ∈ S₁)
    [IsProbabilityMeasure P] :
    bipolarRate Q₁ S₁ ≤ klDiv Q₁ P :=
  bipolarRate_le_iff.2 fun n _ ↦ maxLogGrowth_le_mul_klDiv Q₁ hP n

/-- The bipolar rate is at most the smallest relative entropy from `Q₁` to the null,
$\mathrm{KL}_{\inf}(Q_1,\mathcal P_1)$ [RR26, proof of Theorem 4.1]. The inequality can be
strict. -/
theorem bipolarRate_le_klInf (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁]
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P) :
    bipolarRate Q₁ S₁ ≤ klInf Q₁ S₁ := by
  rw [klInf_eq_iInf_klDiv fun P hP ↦ by simp [(hS₁ P hP).measure_univ]]
  exact le_iInf₂ fun P hP ↦
    have := hS₁ P hP
    bipolarRate_le_klDiv Q₁ hP

/-- The bipolar rate against a simple null `{P}` is the relative entropy `klDiv Q₁ P`. -/
@[simp]
theorem bipolarRate_singleton (Q₁ P : Measure 𝓧) [IsProbabilityMeasure Q₁]
    [IsProbabilityMeasure P] :
    bipolarRate Q₁ {P} = klDiv Q₁ P := by
  refine le_antisymm (bipolarRate_le_klDiv Q₁ (Set.mem_singleton P)) ?_
  rw [← maxEPower_singleton_eq_klDiv, ← maxLogGrowth_one]
  exact maxLogGrowth_one_le_bipolarRate Q₁ {P}

/-- A real lower bound on the growth of `n + 1` observations, divided by `n + 1`, that converges
to `L` gives the lower bound `L` on the bipolar rate. -/
lemma le_bipolarRate_of_tendsto {r : ℕ → ℝ} {L : ℝ}
    (hr : ∀ n, (r n : EReal) ≤ maxLogGrowth Q₁ S₁ (n + 1))
    (hlim : Tendsto (fun n : ℕ ↦ r n / (n + 1)) atTop (𝓝 L)) :
    (L : EReal) ≤ bipolarRate Q₁ S₁ := by
  refine le_of_tendsto' (EReal.tendsto_coe.2 hlim) fun n ↦ ?_
  have h : ((r n / (n + 1) : ℝ) : EReal) = (r n : EReal) / ((n + 1 : ℕ) : EReal) := by
    rw [EReal.coe_div]
    norm_cast
  rw [h]
  exact (EReal.div_le_div_right_of_nonneg (by positivity) (hr n)).trans
    (maxLogGrowth_div_le_bipolarRate Q₁ S₁ n.succ_ne_zero)

/-- If the growth of `n` observations is at least `log (1 / (n ε ^ (n - 1)))` for every `n ≠ 0`,
the bipolar rate is at least `log (1 / ε)`: the term `log n` is negligible against `n`. For
`ε = 0`, two observations already give infinite growth. -/
lemma log_inv_le_bipolarRate_of_forall_le_maxLogGrowth {ε : ℝ≥0∞} (hε : ε ≤ 1)
    (h : ∀ n : ℕ, n ≠ 0 → ENNReal.log (((n : ℝ≥0∞) * ε ^ (n - 1))⁻¹) ≤ maxLogGrowth Q₁ S₁ n) :
    ENNReal.log ε⁻¹ ≤ bipolarRate Q₁ S₁ := by
  rcases eq_or_ne ε 0 with rfl | hε0
  · have h2 := h 2 two_ne_zero
    simp only [Nat.add_one_sub_one, pow_one, mul_zero, ENNReal.inv_zero, ENNReal.log_top,
      top_le_iff] at h2
    refine le_trans ?_ (maxLogGrowth_div_le_bipolarRate _ _ two_ne_zero)
    rw [h2, ENNReal.inv_zero, ENNReal.log_top,
      EReal.top_div_of_pos_ne_top (by norm_num) (EReal.natCast_ne_top 2)]
  -- for `ε > 0`, the growth of `n + 1` observations is at least `n log (1 / ε) - log (n + 1)`
  set e := ε.toReal
  have hε_top : ε ≠ ⊤ := ne_top_of_le_ne_top ENNReal.one_ne_top hε
  have he0 : 0 < e := ENNReal.toReal_pos hε0 hε_top
  have hεe : ε = ENNReal.ofReal e := (ENNReal.ofReal_toReal hε_top).symm
  have hlog : ENNReal.log ε⁻¹ = (Real.log e⁻¹ : EReal) := by
    rw [hεe, ← ENNReal.ofReal_inv_of_pos he0, ENNReal.log_ofReal_of_pos (inv_pos.2 he0)]
  rw [hlog]
  refine le_bipolarRate_of_tendsto (r := fun n ↦ n * Real.log e⁻¹ - Real.log (n + 1))
    (fun n ↦ le_trans (le_of_eq ?_) (h (n + 1) n.succ_ne_zero)) ?_
  · -- move to `ℝ`, where the identity is `Real.log` of a product
    have hpos : 0 < ((n : ℝ) + 1) * e ^ n := by positivity
    have hcast : ((n + 1 : ℕ) : ℝ≥0∞) * ε ^ (n + 1 - 1) =
        ENNReal.ofReal (((n : ℝ) + 1) * e ^ n) := by
      rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow he0.le, ← hεe]
      norm_cast
    rw [hcast, ← ENNReal.ofReal_inv_of_pos hpos, ENNReal.log_ofReal_of_pos (inv_pos.2 hpos),
      EReal.coe_eq_coe_iff]
    simp only [Real.log_inv]
    rw [Real.log_mul (by positivity) (by positivity), Real.log_pow]
    ring
  · have h1 : Tendsto (fun n : ℕ ↦ (n : ℝ) / (n + 1)) atTop (𝓝 1) :=
      tendsto_natCast_div_add_atTop 1
    have h2 : Tendsto (fun n : ℕ ↦ Real.log ((n : ℝ) + 1) / ((n : ℝ) + 1)) atTop (𝓝 0) := by
      have := (Real.tendsto_pow_log_div_mul_add_atTop 1 0 1 one_ne_zero).comp
        (tendsto_atTop_add_const_right atTop (1 : ℝ) tendsto_natCast_atTop_atTop)
      simpa [Function.comp_def] using this
    convert (h1.const_mul (Real.log e⁻¹)).sub h2 using 2 with n
    · field_simp
    · simp

/-- The e-variable `1/2 + (1/2) e ^ t 1_A` on `m` observations, valid when `e ^ t P ^ m (A) ≤ 1`
for every member `P` of the null, gives the lower bound `t Q ^ m (A) - log 2` on the growth of `m`
observations. -/
lemma le_maxLogGrowth_of_ofReal_exp_mul_le_one (Q : Measure 𝓧) [IsProbabilityMeasure Q]
    {S : Set (Measure 𝓧)} (hS : ∀ P ∈ S, IsProbabilityMeasure P) {m : ℕ}
    {A : Set (Fin m → 𝓧)} (hA : MeasurableSet A) {t : ℝ}
    (hP : ∀ P ∈ S, ENNReal.ofReal (Real.exp t) * (Measure.pi fun _ : Fin m ↦ P) A ≤ 1) :
    ((t * (Measure.pi fun _ : Fin m ↦ Q).real A - Real.log 2 : ℝ) : EReal) ≤
      maxLogGrowth Q S m := by
  set Qm := Measure.pi fun _ : Fin m ↦ Q
  set b := ENNReal.ofReal (Real.exp t)
  set X : (Fin m → 𝓧) → ℝ≥0∞ := fun x ↦ 2⁻¹ + 2⁻¹ * A.indicator (fun _ ↦ b) x
  have hXm : Measurable X := measurable_const.add (measurable_const.mul
    (measurable_const.indicator hA))
  have hX : IsEVar X ((fun P ↦ Measure.pi fun _ : Fin m ↦ P) '' S) := by
    refine ⟨hXm, ?_⟩
    · rintro _ ⟨P, hPS, rfl⟩
      have := hS P hPS
      calc ∫⁻ x, X x ∂(Measure.pi fun _ : Fin m ↦ P)
      _ = 2⁻¹ + 2⁻¹ * (b * (Measure.pi fun _ : Fin m ↦ P) A) := by
        simp [X, lintegral_add_right _ ((measurable_const.indicator hA).const_mul _),
          lintegral_const_mul _ (measurable_const.indicator hA), lintegral_indicator_const hA]
      _ ≤ 2⁻¹ + 2⁻¹ * 1 := by gcongr; exact hP P hPS
      _ = 1 := by rw [mul_one, ENNReal.inv_two_add_inv_two]
  set g : (Fin m → 𝓧) → ℝ := fun x ↦ A.indicator (fun _ ↦ t) x - Real.log 2
  have hg (x : Fin m → 𝓧) : ENNReal.ofReal (Real.exp (g x)) ≤ X x := by
    by_cases hx : x ∈ A
    · simp only [g, X, Set.indicator_of_mem hx]
      rw [Real.exp_sub, Real.exp_log two_pos, ENNReal.ofReal_div_of_pos two_pos,
        ENNReal.ofReal_ofNat, div_eq_mul_inv, mul_comm]
      exact le_add_self
    · simp only [g, X, Set.indicator_of_notMem hx, zero_sub, Real.exp_neg, Real.exp_log two_pos,
        mul_zero, add_zero]
      rw [ENNReal.ofReal_inv_of_pos two_pos, ENNReal.ofReal_ofNat]
  have hgi : Integrable g Qm := ((integrable_const t).indicator hA).sub (integrable_const _)
  calc ((t * Qm.real A - Real.log 2 : ℝ) : EReal)
  _ = ∫ᵉ x, (g x : EReal) ∂Qm := by
    rw [eintegral_eq_integral hgi]
    simp [g, integral_sub ((integrable_const t).indicator hA) (integrable_const _),
      integral_indicator_const _ hA, mul_comm]
  _ ≤ ∫ᵉ x, ENNReal.log (X x) ∂Qm := eintegral_mono fun x ↦ by
    calc (g x : EReal)
    _ = ENNReal.log (ENNReal.ofReal (Real.exp (g x))) := by
      rw [ENNReal.log_ofReal_exp]
    _ ≤ ENNReal.log (X x) := ENNReal.log_monotone (hg x)
  _ ≤ maxLogGrowth Q S m := by
    rw [maxLogGrowth_def]
    exact hX.eintegral_log_le_maxEPower _

end ProbabilityTheory
