/-!
# The bipolar rate equals the smallest relative entropy under lower semicontinuity

The bipolar rate `bipolarRate Q S` of a probability measure `Q` against an i.i.d. null `S` is at
most the smallest relative entropy `⨅ P ∈ S, klDiv Q P` from `Q` to the null
(`ProbabilityTheory.bipolarRate_le_iInf_klDiv`). This file proves that they are equal when the
smallest relative entropy to the null, as a function of the law, is lower semicontinuous at `Q`
for the topology generated by the integrals of bounded measurable functions [RR26, Theorem 4.1].
That topology is finer than the topology of weak convergence, so lower semicontinuity for weak
convergence, which [RR26] assumes on a Polish space, is a special case; no topology on the
sample space is needed here.

The semicontinuity is stated with neighbourhoods: for every `c` below the smallest relative
entropy from `Q` to `S`, there are finitely many bounded measurable functions `f i` and `ε > 0`
such that every probability measure `R` whose integrals of the `f i` are within `ε` of those of
`Q` is at relative entropy at least `c` from every member of `S`.

## Main statements

* `ProbabilityTheory.sum_klDiv_map_eval_le`: the relative entropy from a law on `Fin n → 𝓧` to
  an i.i.d. law is at least the sum of the relative entropies of its marginals.
* `ProbabilityTheory.klDiv_cond_le`: the relative entropy from `μ` conditioned on `A` to `μ` is at
  most `log (1 / μ A)`.
* `ProbabilityTheory.ofReal_exp_mul_measure_pi_le_one`: a Sanov-type bound for the empirical
  averages of finitely many bounded functions under an i.i.d. law.
* `ProbabilityTheory.bipolarRate_eq_iInf_klDiv_of_forall_exists_forall_le`: the bipolar rate
  equals the smallest relative entropy to the null under the semicontinuity above.

## Implementation notes

The lower bound is a Sanov-type argument with blocks of length one. The probability under `P ^ m`
that the empirical averages of the test functions lie in the neighbourhood is at most
`exp (- m c)`: condition `P ^ m` on that event, and use the superadditivity of the relative
entropy over the coordinates and its convexity. The indicator of the event, multiplied by
`exp (m c)`, is then an `m`-sample e-variable, and the weak law of large numbers under `Q ^ m`,
from Chebyshev's inequality, gives its expected logarithm.

## References

* [RR26] A. Ram and A. Ramdas, *The optimal betting wealth growth rate*, arXiv:2604.25280v1.
-/

public section

open MeasureTheory InformationTheory Filter
open scoped ENNReal NNReal Topology

namespace ProbabilityTheory

variable {𝓧 : Type*} {m𝓧 : MeasurableSpace 𝓧}

/-! ### Bounds on the bipolar rate -/

/-- The bipolar rate is at most the smallest relative entropy from `Q` to the null, with the
infimum taken in `EReal`: the form of `bipolarRate_le_iInf_klDiv` used in this file. -/
lemma bipolarRate_le_iInf_coe_klDiv (Q : Measure 𝓧) [IsProbabilityMeasure Q] (S : Set (Measure 𝓧))
    (hS : ∀ P ∈ S, IsProbabilityMeasure P) :
    bipolarRate Q S ≤ ⨅ P ∈ S, ((klDiv Q P : ℝ≥0∞) : EReal) :=
  le_iInf₂ fun P hP ↦ have := hS P hP; bipolarRate_le_klDiv Q hP

/-- A real lower bound on the growth of `n + 1` observations, divided by `n + 1`, that converges
to `L` gives the lower bound `L` on the bipolar rate. -/
lemma le_bipolarRate_of_tendsto {Q : Measure 𝓧} {S : Set (Measure 𝓧)} {r : ℕ → ℝ} {L : ℝ}
    (hr : ∀ n, (r n : EReal) ≤ maxLogGrowth Q S (n + 1))
    (hlim : Tendsto (fun n : ℕ ↦ r n / (n + 1)) atTop (𝓝 L)) :
    (L : EReal) ≤ bipolarRate Q S := by
  rw [bipolarRate_def]
  refine le_of_tendsto' (EReal.tendsto_coe.2 hlim) fun n ↦ ?_
  refine le_trans ?_ (le_iSup _ n)
  have h : ((r n / (n + 1) : ℝ) : EReal) = (r n : EReal) / ((n + 1 : ℕ) : EReal) := by
    rw [EReal.coe_div]
    norm_cast
  rw [h]
  exact EReal.div_le_div_right_of_nonneg (by positivity) (hr n)

/-! ### Relative entropy of marginals and of conditional laws -/

/-- The relative entropy to a product law is at least the sum of the relative entropies of the
two marginals. -/
lemma klDiv_fst_add_klDiv_snd_le {𝓨 : Type*} {m𝓨 : MeasurableSpace 𝓨} (R : Measure (𝓧 × 𝓨))
    [IsProbabilityMeasure R] (P : Measure 𝓧) (P' : Measure 𝓨) [IsProbabilityMeasure P]
    [IsProbabilityMeasure P'] :
    klDiv R.fst P + klDiv R.snd P' ≤ klDiv R (P.prod P') := by
  have h := maxUtility_fst_add_maxUtility_snd_le R (S := {P}) (T := {P'})
    (fun μ hμ ↦ by rw [Set.mem_singleton_iff.1 hμ]; infer_instance)
    (fun μ hμ ↦ by rw [Set.mem_singleton_iff.1 hμ]; infer_instance)
  rwa [Set.image2_singleton, maxUtility_singleton_eq_klDiv, maxUtility_singleton_eq_klDiv,
    maxUtility_singleton_eq_klDiv, ← EReal.coe_ennreal_add,
    EReal.coe_ennreal_le_coe_ennreal_iff] at h

/-- The relative entropy from a law on `𝓧 ^ n` to an i.i.d. law is at least the sum of the
relative entropies of its marginals. -/
lemma sum_klDiv_map_eval_le (P : Measure 𝓧) [IsProbabilityMeasure P] (n : ℕ)
    (μ : Measure (Fin n → 𝓧)) [IsProbabilityMeasure μ] :
    ∑ j, klDiv (μ.map fun x ↦ x j) P ≤ klDiv μ (Measure.pi fun _ ↦ P) := by
  induction n with
  | zero => simp
  | succ n ih =>
    set e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) ↦ 𝓧) 0
    set R := μ.map e
    have hpi : (Measure.pi fun _ : Fin (n + 1) ↦ P).map e =
        P.prod (Measure.pi fun _ : Fin n ↦ P) :=
      (measurePreserving_piFinSuccAbove (fun _ : Fin (n + 1) ↦ P) 0).map_eq
    have hKL : klDiv R (P.prod (Measure.pi fun _ : Fin n ↦ P)) =
        klDiv μ (Measure.pi fun _ ↦ P) := by
      rw [← hpi]
      refine le_antisymm (klDiv_map_le _ _ e.measurable) ?_
      have h := klDiv_map_le R ((Measure.pi fun _ : Fin (n + 1) ↦ P).map e) e.symm.measurable
      rwa [e.map_symm_map, e.map_symm_map] at h
    have hfst : R.fst = μ.map fun x ↦ x 0 := by
      rw [Measure.fst, Measure.map_map measurable_fst e.measurable]
      rfl
    have hsnd : R.snd = μ.map fun x j ↦ x j.succ := by
      rw [Measure.snd, Measure.map_map measurable_snd e.measurable]
      rfl
    have hmarg (j : Fin n) : R.snd.map (fun x ↦ x j) = μ.map fun x ↦ x j.succ := by
      rw [hsnd, Measure.map_map (by fun_prop) (by fun_prop)]
      rfl
    calc ∑ j, klDiv (μ.map fun x ↦ x j) P
    _ = klDiv R.fst P + ∑ j : Fin n, klDiv (R.snd.map fun x ↦ x j) P := by
      rw [Fin.sum_univ_succ, hfst]
      simp_rw [hmarg]
    _ ≤ klDiv R.fst P + klDiv R.snd (Measure.pi fun _ : Fin n ↦ P) := by
      gcongr
      exact ih R.snd
    _ ≤ klDiv R (P.prod (Measure.pi fun _ : Fin n ↦ P)) := klDiv_fst_add_klDiv_snd_le R P _
    _ = klDiv μ (Measure.pi fun _ ↦ P) := hKL

/-- The relative entropy from the law `μ` conditioned on `A` to `μ` is at most `log (1 / μ A)`. -/
lemma klDiv_cond_le {μ : Measure 𝓧} [IsProbabilityMeasure μ] {A : Set 𝓧} (hμA : μ A ≠ 0) :
    ((klDiv (μ[|A]) μ : ℝ≥0∞) : EReal) ≤ ENNReal.log (μ A)⁻¹ := by
  have := cond_isProbabilityMeasure hμA
  rw [← maxUtility_singleton_eq_klDiv]
  refine iSup₂_le fun X hX ↦ ?_
  calc ∫ᵉ x, (logUtility ∘ X) x ∂μ[|A]
  _ ≤ logUtility (∫⁻ x, X x ∂μ[|A]) :=
    Utility.eintegral_le_map logUtility hX.measurable.aemeasurable
  _ ≤ ENNReal.log (μ A)⁻¹ := by
    refine ENNReal.log_monotone ?_
    rw [ProbabilityTheory.cond, lintegral_smul_measure, smul_eq_mul]
    calc (μ A)⁻¹ * ∫⁻ x, X x ∂μ.restrict A
    _ ≤ (μ A)⁻¹ * 1 := by
      gcongr
      exact (setLIntegral_le_lintegral A X).trans
        ((hX.lintegral_le_measure_univ μ rfl).trans_eq measure_univ)
    _ = (μ A)⁻¹ := mul_one _

/-! ### A Sanov-type bound and the law of large numbers -/

/-- The tuples whose empirical averages of the measurable functions `f i` are within `ε` of the
`a i` form a measurable set. -/
lemma measurableSet_setOf_forall_abs_avg_sub_le {k : ℕ} {f : Fin k → 𝓧 → ℝ}
    (hf : ∀ i, Measurable (f i)) (a : Fin k → ℝ) (ε : ℝ) (m : ℕ) :
    MeasurableSet {x : Fin m → 𝓧 | ∀ i, |(∑ j, f i (x j)) / m - a i| ≤ ε} := by
  simp only [Set.ofPred_forall]
  exact MeasurableSet.iInter fun i ↦ measurableSet_le (continuous_abs.measurable.comp
    (((Finset.measurable_sum _ fun j _ ↦ (hf i).comp (measurable_pi_apply j)).div_const _).sub_const
      _)) measurable_const

/-- The integral against the average of the marginals of `μ` is the integral of the empirical
average against `μ`. -/
lemma integral_sum_smul_map_eval {m : ℕ} (μ : Measure (Fin m → 𝓧))
    [IsProbabilityMeasure μ] {g : 𝓧 → ℝ} (hg : Measurable g) {C : ℝ} (hgC : ∀ x, |g x| ≤ C) :
    ∫ x, g x ∂(∑ j : Fin m, (((m : ℝ≥0)⁻¹ : ℝ≥0) : ℝ≥0∞) • μ.map fun x ↦ x j) =
      ∫ x, (∑ j, g (x j)) / m ∂μ := by
  have hint (ν : Measure 𝓧) [IsFiniteMeasure ν] : Integrable g ν :=
    Integrable.of_bound hg.aestronglyMeasurable C (Eventually.of_forall fun x ↦ hgC x)
  rw [integral_finsetSum_measure fun j _ ↦ (hint _).smul_measure ENNReal.coe_ne_top]
  have hj (j : Fin m) : ∫ x, g x ∂(μ.map fun x ↦ x j) = ∫ x, g (x j) ∂μ :=
    integral_map (measurable_pi_apply j).aemeasurable hg.aestronglyMeasurable
  simp_rw [integral_smul_measure, hj]
  have hs : ∫ x, ∑ j, g (x j) ∂μ = ∑ j, ∫ x, g (x j) ∂μ :=
    integral_finsetSum _ fun j _ ↦ Integrable.of_bound
      (hg.comp (measurable_pi_apply j)).aestronglyMeasurable C (Eventually.of_forall fun x ↦ hgC _)
  rw [integral_div, hs]
  simp [div_eq_inv_mul, Finset.mul_sum]

/-- **Sanov-type bound.** If every law `R` whose integrals of the bounded functions `f i` are
within `ε` of `a i` is at relative entropy at least `c ≥ 0` from `P`, then the probability under
`P ^ m` that the empirical averages of the `f i` are within `ε` of the `a i` is at most
`exp (- m c)`. -/
lemma ofReal_exp_mul_measure_pi_le_one {k : ℕ} {f : Fin k → 𝓧 → ℝ} (hf : ∀ i, Measurable (f i))
    {C : Fin k → ℝ} (hfC : ∀ i x, |f i x| ≤ C i) {a : Fin k → ℝ} {ε c : ℝ} (hc : 0 ≤ c)
    {P : Measure 𝓧} [IsProbabilityMeasure P]
    (hU : ∀ R : Measure 𝓧, IsProbabilityMeasure R → (∀ i, |∫ x, f i x ∂R - a i| ≤ ε) →
      ENNReal.ofReal c ≤ klDiv R P) {m : ℕ} (hm : m ≠ 0) :
    ENNReal.ofReal (Real.exp (m * c)) *
      (Measure.pi fun _ : Fin m ↦ P) {x | ∀ i, |(∑ j, f i (x j)) / m - a i| ≤ ε} ≤ 1 := by
  set A := {x : Fin m → 𝓧 | ∀ i, |(∑ j, f i (x j)) / m - a i| ≤ ε}
  set Pm := Measure.pi fun _ : Fin m ↦ P
  have hA : MeasurableSet A := measurableSet_setOf_forall_abs_avg_sub_le hf a ε m
  rcases eq_or_ne (Pm A) 0 with h0 | h0
  · simp [h0]
  set μ := Pm[|A]
  have : IsProbabilityMeasure μ := cond_isProbabilityMeasure h0
  have hm0 : (m : ℝ≥0∞) ≠ 0 := Nat.cast_ne_zero.2 hm
  set w : Fin m → ℝ≥0 := fun _ ↦ (m : ℝ≥0)⁻¹
  have hw : ∑ j, w j = 1 := by
    simp [w, Finset.card_univ, mul_inv_cancel₀ (Nat.cast_ne_zero.2 hm : (m : ℝ≥0) ≠ 0)]
  set R := ∑ j, (w j : ℝ≥0∞) • μ.map fun x ↦ x j
  have hR : IsProbabilityMeasure R := ⟨by
    simp [R, w, ENNReal.coe_inv (Nat.cast_ne_zero.2 hm : (m : ℝ≥0) ≠ 0),
      ENNReal.mul_inv_cancel hm0 (ENNReal.natCast_ne_top m)]⟩
  have hRU (i : Fin k) : |∫ x, f i x ∂R - a i| ≤ ε := by
    rw [integral_sum_smul_map_eval μ (hf i) (hfC i)]
    have hint : Integrable (fun x : Fin m → 𝓧 ↦ (∑ j, f i (x j)) / m) μ :=
      ((integrable_finsetSum _ fun j _ ↦ Integrable.of_bound
        ((hf i).comp (measurable_pi_apply j)).aestronglyMeasurable (C i)
        (Eventually.of_forall fun x ↦ hfC i _))).div_const _
    have heq : ∫ x, (∑ j, f i (x j)) / m ∂μ - a i = ∫ x, ((∑ j, f i (x j)) / m - a i) ∂μ := by
      rw [integral_sub hint (integrable_const _), integral_const, probReal_univ, one_smul]
    rw [heq, ← Real.norm_eq_abs]
    refine (norm_integral_le_of_norm_le_const (C := ε) ?_).trans (by simp)
    filter_upwards [ae_cond_mem hA] with x hx
    simpa [Real.norm_eq_abs] using hx i
  have h1 : (m : ℝ≥0∞) * ENNReal.ofReal c ≤ klDiv μ Pm := by
    calc (m : ℝ≥0∞) * ENNReal.ofReal c
    _ ≤ m * klDiv R P := by gcongr; exact hU R hR hRU
    _ ≤ m * ∑ j, (w j : ℝ≥0∞) * klDiv (μ.map fun x ↦ x j) P := by
      gcongr
      exact klDiv_sum_smul_left_le hw
    _ = ∑ j, klDiv (μ.map fun x ↦ x j) P := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      rw [← mul_assoc, ENNReal.coe_inv (Nat.cast_ne_zero.2 hm : (m : ℝ≥0) ≠ 0),
        ENNReal.coe_natCast, ENNReal.mul_inv_cancel hm0 (ENNReal.natCast_ne_top m), one_mul]
    _ ≤ klDiv μ Pm := sum_klDiv_map_eval_le P m μ
  rw [← ENNReal.le_inv_iff_mul_le, ← ENNReal.log_le_log_iff,
    ENNReal.log_ofReal_of_pos (Real.exp_pos _), Real.log_exp]
  calc ((m * c : ℝ) : EReal)
  _ = ((ENNReal.ofReal (m * c) : ℝ≥0∞) : EReal) := by
    rw [EReal.coe_ennreal_ofReal, max_eq_left (by positivity)]
  _ = (((m : ℝ≥0∞) * ENNReal.ofReal c : ℝ≥0∞) : EReal) := by
    rw [ENNReal.ofReal_mul (Nat.cast_nonneg _), ENNReal.ofReal_natCast]
  _ ≤ (klDiv μ Pm : EReal) := EReal.coe_ennreal_le_coe_ennreal_iff.2 h1
  _ ≤ ENNReal.log (Pm A)⁻¹ := klDiv_cond_le h0

/-- **Weak law of large numbers**, by Chebyshev's inequality: the probability that the empirical
average of a function bounded by `C` deviates by more than `ε` from its mean is at most
`C ^ 2 / (m ε ^ 2)`. -/
lemma measure_pi_lt_abs_avg_sub_le {g : 𝓧 → ℝ} (hg : Measurable g) {C : ℝ} (hgC : ∀ x, |g x| ≤ C)
    (Q : Measure 𝓧) [IsProbabilityMeasure Q] {ε : ℝ} (hε : 0 < ε) {m : ℕ} (hm : m ≠ 0) :
    (Measure.pi fun _ : Fin m ↦ Q) {x | ε < |(∑ j, g (x j)) / m - ∫ y, g y ∂Q|} ≤
      ENNReal.ofReal (C ^ 2 / (m * ε ^ 2)) := by
  set Qm := Measure.pi fun _ : Fin m ↦ Q
  set X : (Fin m → 𝓧) → ℝ := fun x ↦ ∑ j, g (x j) with hX_def
  have hm' : (0 : ℝ) < m := Nat.cast_pos.2 (Nat.pos_of_ne_zero hm)
  have hgL (j : Fin m) : MemLp (fun x : Fin m → 𝓧 ↦ g (x j)) 2 Qm :=
    MemLp.of_bound (hg.comp (measurable_pi_apply j)).aestronglyMeasurable C
      (Eventually.of_forall fun x ↦ hgC _)
  have hXL : MemLp X 2 Qm := memLp_finsetSum _ fun j _ ↦ hgL j
  have hEX : ∫ x, X x ∂Qm = m * ∫ y, g y ∂Q := by
    have hj (j : Fin m) : ∫ x, g (x j) ∂Qm = ∫ y, g y ∂Q := by
      rw [← integral_map (measurable_pi_apply j).aemeasurable hg.aestronglyMeasurable]
      congr 1
      exact (measurePreserving_eval (fun _ : Fin m ↦ Q) j).map_eq
    rw [integral_finsetSum _ fun j _ ↦ (hgL j).integrable one_le_two]
    simp [hj]
  have hVar : Var[X; Qm] ≤ m * C ^ 2 := by
    have h := variance_sum_pi (μ := fun _ : Fin m ↦ Q) (X := fun _ ↦ g)
      fun _ ↦ MemLp.of_bound hg.aestronglyMeasurable C (Eventually.of_forall hgC)
    have hX : X = ∑ j : Fin m, fun x : Fin m → 𝓧 ↦ g (x j) := by
      ext x
      simp [X]
    rw [hX, h, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    gcongr
    have hb := variance_le_sq_of_bounded (μ := Q) (a := -C) (b := C)
      (Eventually.of_forall fun x ↦ abs_le.1 (hgC x)) hg.aemeasurable
    convert hb using 1
    ring
  calc Qm {x | ε < |(∑ j, g (x j)) / m - ∫ y, g y ∂Q|}
  _ ≤ Qm {x | m * ε ≤ |X x - ∫ x, X x ∂Qm|} := by
    refine measure_mono fun x hx ↦ ?_
    simp only [Set.mem_ofPred_eq] at hx ⊢
    have h : (∑ j, g (x j)) / m - ∫ y, g y ∂Q = (X x - ∫ x, X x ∂Qm) / m := by
      rw [hEX, hX_def]
      field_simp
    rw [h, abs_div, abs_of_pos hm', lt_div_iff₀ hm'] at hx
    linarith
  _ ≤ ENNReal.ofReal (Var[X; Qm] / (m * ε) ^ 2) :=
    meas_ge_le_variance_div_sq hXL (by positivity)
  _ ≤ ENNReal.ofReal (C ^ 2 / (m * ε ^ 2)) := by
    refine ENNReal.ofReal_le_ofReal ?_
    calc Var[X; Qm] / (m * ε) ^ 2
    _ ≤ m * C ^ 2 / (m * ε) ^ 2 := by gcongr
    _ = C ^ 2 / (m * ε ^ 2) := by field_simp

/-- The e-variable `1/2 + (1/2) e ^ t 1_A`, valid when `e ^ t P (A) ≤ 1` for every member `P` of
the null, gives the lower bound `t Q (A) - log 2` on the growth of `m` observations. -/
lemma le_maxLogGrowth_of_ofReal_exp_mul_le_one (Q : Measure 𝓧) [IsProbabilityMeasure Q]
    {S : Set (Measure 𝓧)} (hS : ∀ P ∈ S, IsProbabilityMeasure P) {m : ℕ}
    {A : Set (Fin m → 𝓧)} (hA : MeasurableSet A) {t : ℝ}
    (hP : ∀ P ∈ S, ENNReal.ofReal (Real.exp t) * (Measure.pi fun _ : Fin m ↦ P) A ≤ 1) :
    ((t * (Measure.pi fun _ : Fin m ↦ Q).real A - Real.log 2 : ℝ) : EReal) ≤
      maxLogGrowth Q S m := by
  set Qm := Measure.pi fun _ : Fin m ↦ Q
  set b := ENNReal.ofReal (Real.exp t)
  set X : (Fin m → 𝓧) → ℝ≥0∞ := fun x ↦ 2⁻¹ + 2⁻¹ * A.indicator (fun _ ↦ b) x
  have hXm : Measurable X := measurable_const.add (measurable_const.mul
    (measurable_const.indicator hA))
  have hX : IsEVar X ((fun P ↦ Measure.pi fun _ : Fin m ↦ P) '' S) := by
    refine IsEVar.of_lintegral_le_one ?_ hXm ?_
    · rintro _ ⟨P, hP, rfl⟩
      have := hS P hP
      infer_instance
    · rintro _ ⟨P, hPS, rfl⟩
      have := hS P hPS
      calc ∫⁻ x, X x ∂(Measure.pi fun _ : Fin m ↦ P)
      _ = 2⁻¹ + 2⁻¹ * (b * (Measure.pi fun _ : Fin m ↦ P) A) := by
        simp only [X]
        rw [lintegral_add_right _ ((measurable_const.indicator hA).const_mul _),
          lintegral_const, measure_univ, mul_one,
          lintegral_const_mul _ (measurable_const.indicator hA), lintegral_indicator_const hA]
      _ ≤ 2⁻¹ + 2⁻¹ * 1 := by gcongr; exact hP P hPS
      _ = 1 := by rw [mul_one, ENNReal.inv_two_add_inv_two]
  set g : (Fin m → 𝓧) → ℝ := fun x ↦ A.indicator (fun _ ↦ t) x - Real.log 2
  have hg (x : Fin m → 𝓧) : ENNReal.ofReal (Real.exp (g x)) ≤ X x := by
    by_cases hx : x ∈ A
    · simp only [g, X, Set.indicator_of_mem hx]
      rw [Real.exp_sub, Real.exp_log two_pos, ENNReal.ofReal_div_of_pos two_pos,
        ENNReal.ofReal_ofNat, div_eq_mul_inv, mul_comm]
      exact le_add_self
    · simp only [g, X, Set.indicator_of_notMem hx, zero_sub, Real.exp_neg, Real.exp_log two_pos,
        mul_zero, add_zero]
      rw [ENNReal.ofReal_inv_of_pos two_pos, ENNReal.ofReal_ofNat]
  have hgi : Integrable g Qm := ((integrable_const t).indicator hA).sub (integrable_const _)
  calc ((t * Qm.real A - Real.log 2 : ℝ) : EReal)
  _ = ∫ᵉ x, (g x : EReal) ∂Qm := by
    rw [eintegral_eq_integral hgi, integral_sub ((integrable_const t).indicator hA)
      (integrable_const _), integral_indicator_const _ hA, integral_const, probReal_univ,
      smul_eq_mul, one_smul, mul_comm]
  _ ≤ ∫ᵉ x, (logUtility ∘ X) x ∂Qm := eintegral_mono fun x ↦ by
    calc (g x : EReal)
    _ = ENNReal.log (ENNReal.ofReal (Real.exp (g x))) := by
      rw [ENNReal.log_ofReal_of_pos (Real.exp_pos _), Real.log_exp]
    _ ≤ (logUtility ∘ X) x := ENNReal.log_monotone (hg x)
  _ ≤ maxLogGrowth Q S m := by
    rw [maxLogGrowth_def]
    exact hX.eintegral_le_maxUtility _ _

/-- If the smallest relative entropy to `S` is lower semicontinuous at `Q` for the topology of
integrals of bounded measurable functions, in the sense of neighbourhoods, then the bipolar rate
of `Q` against `S` equals the smallest relative entropy from `Q` to `S` [RR26, Theorem 4.1]. The
test functions need only be bounded, by any constant, and measurable: no topology on `𝓧` is
used, and lower semicontinuity for weak convergence is a special case. -/
theorem bipolarRate_eq_iInf_klDiv_of_forall_exists_forall_le (Q : Measure 𝓧)
    [IsProbabilityMeasure Q] (S : Set (Measure 𝓧)) (hS : ∀ P ∈ S, IsProbabilityMeasure P)
    (h : ∀ c : EReal, c < ⨅ P ∈ S, ((klDiv Q P : ℝ≥0∞) : EReal) →
      ∃ (k : ℕ) (f : Fin k → 𝓧 → ℝ) (ε : ℝ), 0 < ε ∧ (∀ i, Measurable (f i)) ∧
        (∀ i, ∃ C, ∀ x, |f i x| ≤ C) ∧ ∀ R : Measure 𝓧, IsProbabilityMeasure R →
          (∀ i, |∫ x, f i x ∂R - ∫ x, f i x ∂Q| ≤ ε) →
          c ≤ ⨅ P ∈ S, ((klDiv R P : ℝ≥0∞) : EReal)) :
    bipolarRate Q S = ⨅ P ∈ S, ((klDiv Q P : ℝ≥0∞) : EReal) := by
  refine le_antisymm (bipolarRate_le_iInf_coe_klDiv Q S hS)
    (le_of_forall_lt_imp_le_of_dense fun c hc ↦ ?_)
  rcases le_or_gt c 0 with hc0 | hc0
  · exact hc0.trans (bipolarRate_nonneg Q S)
  obtain ⟨k, f, ε, hε, hfm, hfC, hU⟩ := h c hc
  choose C hC using hfC
  obtain ⟨c, rfl⟩ : ∃ r : ℝ, (r : EReal) = c :=
    ⟨c.toReal, EReal.coe_toReal hc.ne_top (ne_bot_of_gt hc0)⟩
  have hc0' : 0 < c := by exact_mod_cast hc0
  -- every law in the neighbourhood is at relative entropy at least `c` from every null law
  have hU' (P : Measure 𝓧) (hP : P ∈ S) (R : Measure 𝓧) (hR : IsProbabilityMeasure R)
      (hRf : ∀ i, |∫ x, f i x ∂R - ∫ x, f i x ∂Q| ≤ ε) : ENNReal.ofReal c ≤ klDiv R P := by
    have := (hU R hR hRf).trans (iInf₂_le P hP)
    rwa [← max_eq_left hc0'.le, ← EReal.coe_ennreal_ofReal,
      EReal.coe_ennreal_le_coe_ennreal_iff] at this
  set A : ∀ m : ℕ, Set (Fin m → 𝓧) :=
    fun m ↦ {x | ∀ i, |(∑ j, f i (x j)) / m - ∫ y, f i y ∂Q| ≤ ε} with hA_def
  set D := ∑ i, C i ^ 2 / ε ^ 2
  -- the law of large numbers under `Q`
  have hQA (m : ℕ) (hm : m ≠ 0) : 1 - D / m ≤ (Measure.pi fun _ : Fin m ↦ Q).real (A m) := by
    have hcompl : (A m)ᶜ = ⋃ i, {x : Fin m → 𝓧 | ε < |(∑ j, f i (x j)) / m - ∫ y, f i y ∂Q|} := by
      ext x
      simp [A]
    have hle : (Measure.pi fun _ : Fin m ↦ Q) (A m)ᶜ ≤ ENNReal.ofReal (D / m) := by
      rw [hcompl]
      refine (measure_iUnion_fintype_le _ _).trans ?_
      calc ∑ i, (Measure.pi fun _ : Fin m ↦ Q)
            {x : Fin m → 𝓧 | ε < |(∑ j, f i (x j)) / m - ∫ y, f i y ∂Q|}
      _ ≤ ∑ i, ENNReal.ofReal (C i ^ 2 / (m * ε ^ 2)) :=
        Finset.sum_le_sum fun i _ ↦ measure_pi_lt_abs_avg_sub_le (hfm i) (hC i) Q hε hm
      _ = ENNReal.ofReal (D / m) := by
        rw [← ENNReal.ofReal_sum_of_nonneg fun i _ ↦ by positivity]
        congr 1
        simp only [D, Finset.sum_div]
        refine Finset.sum_congr rfl fun i _ ↦ ?_
        field_simp
    have h := ENNReal.toReal_le_of_le_ofReal (by positivity) hle
    rw [← measureReal_def, probReal_compl_eq_one_sub
      (measurableSet_setOf_forall_abs_avg_sub_le hfm _ ε m)] at h
    linarith
  refine le_bipolarRate_of_tendsto (r := fun n ↦ (n + 1) * c * (1 - D / (n + 1)) - Real.log 2)
    (fun n ↦ ?_) ?_
  · have hsan (P : Measure 𝓧) (hP : P ∈ S) :=
      have := hS P hP
      ofReal_exp_mul_measure_pi_le_one hfm hC hc0'.le (hU' P hP) (m := n + 1) n.succ_ne_zero
    refine le_trans ?_ (le_maxLogGrowth_of_ofReal_exp_mul_le_one Q hS
      (measurableSet_setOf_forall_abs_avg_sub_le hfm _ ε (n + 1)) hsan)
    have h := hQA (n + 1) n.succ_ne_zero
    simp only [hA_def] at h
    refine EReal.coe_le_coe_iff.2 ?_
    have hnc : 0 ≤ ((n + 1 : ℕ) : ℝ) * c := by positivity
    have hn1 : ((n + 1 : ℕ) : ℝ) = (n : ℝ) + 1 := by push_cast; ring
    rw [hn1] at hnc h ⊢
    nlinarith
  · have h0 := tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)
    have h1 := (tendsto_const_nhds (x := c)).sub (h0.const_mul (c * D + Real.log 2))
    rw [mul_zero, sub_zero] at h1
    refine h1.congr fun n ↦ ?_
    field_simp
    ring

end ProbabilityTheory
