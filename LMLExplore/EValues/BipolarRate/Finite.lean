module

public import LMLExplore.EValues.BipolarRate.Basic
import LMLExplore.EValues.BipolarRate.Semicontinuity
import LMLExplore.InformationTheory.KullbackLeibler.Basic

/-!
# The bipolar rate on a finite alphabet

On a measurable space with finitely many measurable sets, in particular on a finite type with any
σ-algebra, the bipolar rate of a probability measure `Q` against the i.i.d. null generated by a
set `S` of probability measures equals the smallest relative entropy `klInf Q S` from `Q` to `S`
[EVR26, Note 42, Theorem 6]. Nothing is asked of `S`: it need not be closed or convex, its members
need not dominate `Q`, and `klInf Q S` may be infinite. [RR26, Theorem 4.1] gives the equality
when `klInf Q S` is finite and lower semicontinuous at `Q` for the weak topology, for instance for
a weakly compact null. So a null and an alternative for which the bipolar rate is smaller than
`klInf Q S` live on a space with infinitely many measurable sets; for a closed null on `ℕ` with
such a gap, see `LMLExplore.EValues.Examples.BipolarRate.ClosedNull`.

## Main statements

* `ProbabilityTheory.bipolarRate_eq_klInf_of_finite_measurableSet`: the equality on a measurable
  space with finitely many measurable sets.
* `ProbabilityTheory.bipolarRate_eq_klInf_of_finite`: the equality on a finite type.

## Implementation notes

The lower bound on the bipolar rate follows from the lower semicontinuity criterion
`ProbabilityTheory.le_bipolarRate_of_forall_abs_measureReal_sub_le` [RR26, Theorem 4.1], whose
hypothesis holds at `Q` for every null and every level below `klInf Q S`. The proof does not go
through the compactness of the simplex. On a finite σ-algebra, for `t < 1`, every probability
measure `R` whose masses of the measurable sets charged by `Q` are close enough to those under `Q`,
in relative error, is at least `t • Q`. Then `t KL(Q ‖ P) ≤ KL(R ‖ P) + h(t)` for every `P`, with
`h` the binary entropy (`InformationTheory.mul_klDiv_le_klDiv_add_binEntropy`), and `t` close to
`1` gives the semicontinuity at every level below `klInf Q S`. The statements and proofs are adapted
from `EValuesResearch/Results/FiniteAlphabetRate.lean` (commit `9eee1f2`) in the paper project
`RemyDegenne/evalues_research`, rewritten on the API of LMLExplore, with `klInf` in place of the
infimum of `klDiv`.

## References

* [RR26] A. Ram and A. Ramdas, *The optimal betting wealth growth rate*, arXiv:2604.25280v1.
* [EVR26] *Answers to open questions in e-values and anytime-valid inference*, notes and the Lean
  library `EValuesResearch` of github.com/RemyDegenne/evalues_research, 2026; written and refereed
  by AI agents: Note 42, *Four results that came out of the check of the book plan*, Theorem 6.
-/

public section

open MeasureTheory InformationTheory Filter
open scoped ENNReal NNReal Topology

namespace ProbabilityTheory

variable {𝓧 : Type*} {m𝓧 : MeasurableSpace 𝓧}

/-- On a space with finitely many measurable sets, for `t < 1`, the probability measures whose
masses of the measurable sets charged by `Q` are within the relative error `1 - t` of those under
`Q` are at least `t • Q`. -/
private lemma exists_forall_smul_le (Q : Measure 𝓧) [IsFiniteMeasure Q]
    (h𝓧 : {s : Set 𝓧 | MeasurableSet s}.Finite) {t : ℝ≥0} (ht : t < 1) :
    ∃ (k : ℕ) (s : Fin k → Set 𝓧) (ε : ℝ), (∀ i, MeasurableSet (s i)) ∧
      (∀ i, 0 < Q.real (s i)) ∧ 0 < ε ∧ ∀ R : Measure 𝓧, IsProbabilityMeasure R →
        (∀ i, |R.real (s i) - Q.real (s i)| ≤ ε * Q.real (s i)) → t • Q ≤ R := by
  set F : Set (Set 𝓧) := {s | MeasurableSet s ∧ 0 < Q.real s} with hF
  obtain ⟨k, e, he⟩ := (h𝓧.subset fun s (hs : s ∈ F) ↦ hs.1).fin_embedding
  have he_mem (i : Fin k) : e i ∈ F := he ▸ Set.mem_range_self i
  refine ⟨k, e, 1 - t, fun i ↦ (he_mem i).1, fun i ↦ (he_mem i).2,
    sub_pos.2 (by exact_mod_cast ht), fun R _ hRQ ↦ Measure.le_iff.2 fun s hs ↦ ?_⟩
  rw [smul_apply, ENNReal.smul_def, smul_eq_mul]
  rcases eq_or_ne (Q s) 0 with h0 | h0
  · simp [h0]
  obtain ⟨i, rfl⟩ : ∃ i, e i = s := by
    rw [← Set.mem_range, he]
    exact ⟨hs, ENNReal.toReal_pos h0 (measure_ne_top _ _)⟩
  have h := hRQ i
  rw [← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_toReal (measure_ne_top Q (e i)),
    ← ENNReal.ofReal_toReal (measure_ne_top R (e i)), ← ENNReal.ofReal_mul t.coe_nonneg]
  refine ENNReal.ofReal_le_ofReal ?_
  simp only [← measureReal_def]
  linarith [(abs_le.1 h).1]

/-- **The bipolar rate on a space with finitely many measurable sets.** If the σ-algebra of `𝓧`
is finite, the bipolar rate of a probability measure `Q` against a set `S` of probability measures
equals the smallest relative entropy `klInf Q S` from `Q` to `S` [EVR26, Note 42, Theorem 6].
Nothing is asked of `S`: it need not be closed or convex, its members need not dominate `Q`, and
`klInf Q S` may be infinite. -/
theorem bipolarRate_eq_klInf_of_finite_measurableSet (Q : Measure 𝓧) [IsProbabilityMeasure Q]
    (S : Set (Measure 𝓧)) (hS : ∀ P ∈ S, IsProbabilityMeasure P)
    (h𝓧 : {s : Set 𝓧 | MeasurableSet s}.Finite) :
    bipolarRate Q S = klInf Q S := by
  refine le_antisymm (bipolarRate_le_klInf Q hS) (le_of_forall_lt_imp_le_of_dense fun c hc ↦ ?_)
  -- it suffices to find `t < 1` such that the laws above `t • Q` are at least `c` from `S`
  suffices ∃ t : ℝ≥0, t < 1 ∧
      ∀ R : Measure 𝓧, IsProbabilityMeasure R → t • Q ≤ R → c ≤ klInf R S by
    obtain ⟨t, ht, hct⟩ := this
    obtain ⟨k, s, ε, hs, hQs, hε, hU⟩ := exists_forall_smul_le Q h𝓧 ht
    exact le_bipolarRate_of_forall_abs_measureReal_sub_le Q S hS hs hQs hε
      fun R hR hRs ↦ hct R hR (hU R hR hRs)
  rcases le_or_gt c 0 with hc0 | hc0
  · exact ⟨0, zero_lt_one, fun R hR _ ↦
      hc0.trans (klInf_nonneg fun P hP ↦ by have := hS P hP; simp)⟩
  -- a real level `b` between `c` and `klInf Q S`
  obtain ⟨b, hcb, hb⟩ := exists_between hc
  lift c to ℝ using ⟨(hcb.trans hb).ne_top, ne_bot_of_gt hc0⟩
  lift b to ℝ using ⟨hb.ne_top, ne_bot_of_gt hcb⟩
  have hc0' : 0 < c := EReal.coe_pos.1 hc0
  have hcb' : c < b := EReal.coe_lt_coe_iff.1 hcb
  have hb0 : 0 < b := hc0'.trans hcb'
  -- a weight `t < 1` with `c < t b - h(t)`
  obtain ⟨t, ⟨ht0, ht1⟩, ht⟩ : ∃ t : ℝ, t ∈ Set.Ioo 0 1 ∧ c < t * b - Real.binEntropy t := by
    have hcont : Continuous fun t : ℝ ↦ t * b - Real.binEntropy t := by fun_prop
    have h1 : c < 1 * b - Real.binEntropy 1 := by simpa using hcb'
    have hev : ∀ᶠ t in 𝓝[<] (1 : ℝ), c < t * b - Real.binEntropy t :=
      (hcont.continuousAt.eventually (lt_mem_nhds h1)).filter_mono nhdsWithin_le_nhds
    obtain ⟨t, h1, h2⟩ := (hev.and (Ioo_mem_nhdsLT zero_lt_one)).exists
    exact ⟨t, h2, h1⟩
  lift t to ℝ≥0 using ht0.le
  refine ⟨t, by exact_mod_cast ht1, fun R hR hle ↦ ?_⟩
  refine le_klInf_iff.2 fun P hP ↦ ?_
  have := hS P hP
  rw [klIntegral_eq_klDiv (by simp)]
  by_cases htop : klDiv R P = ∞
  · simp [htop]
  -- `t KL(Q ‖ P) ≤ KL(R ‖ P) + h(t)`, and `b ≤ KL(Q ‖ P)`
  have hbP : ENNReal.ofReal b ≤ klDiv Q P := by
    rw [← EReal.coe_ennreal_le_coe_ennreal_iff, EReal.coe_ennreal_ofReal, max_eq_left hb0.le,
      ← klIntegral_eq_klDiv (by simp)]
    exact hb.le.trans (klInf_le_klIntegral hP)
  have h1 := (mul_le_mul_right hbP _).trans (mul_klDiv_le_klDiv_add_binEntropy (ξ := P) hle)
  have h2 := ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨htop, ENNReal.ofReal_ne_top⟩) h1
  simp [ENNReal.toReal_add htop, hb0.le, Real.binEntropy_nonneg ht0.le ht1.le] at h2
  rw [← ENNReal.ofReal_toReal htop, EReal.coe_ennreal_ofReal]
  exact EReal.coe_le_coe_iff.2 (le_max_of_le_left (by linarith))

/-- **The bipolar rate on a finite alphabet.** On a finite type, with any σ-algebra, the bipolar
rate of a probability measure `Q` against a set `S` of probability measures equals the smallest
relative entropy `klInf Q S` from `Q` to `S` [EVR26, Note 42, Theorem 6]. -/
theorem bipolarRate_eq_klInf_of_finite [Finite 𝓧] (Q : Measure 𝓧) [IsProbabilityMeasure Q]
    (S : Set (Measure 𝓧)) (hS : ∀ P ∈ S, IsProbabilityMeasure P) :
    bipolarRate Q S = klInf Q S :=
  bipolarRate_eq_klInf_of_finite_measurableSet Q S hS (Set.toFinite _)

end ProbabilityTheory
