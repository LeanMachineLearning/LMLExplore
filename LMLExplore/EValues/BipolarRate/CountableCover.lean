module

public import LMLExplore.EValues.BipolarRate.Basic

/-!
# The bipolar rate along countable covers of the null

For a law `Q` and a set `S` of laws, the bipolar rate `d(Q, S) = bipolarRate Q S` is the optimal
growth rate of the evidence against the i.i.d. null generated by `S`, uniformly over `S`. Splitting
the null into countably many pieces and testing against each piece separately can only increase
the rate of each piece. The supremum over the countable covers `S = ⋃ m, c m` of the smallest rate
of a piece,

  `d_σ(Q, S) = ⨆ (c : ℕ → Set (Measure 𝓧)) (_ : ⋃ m, c m = S), ⨅ m, d(Q, c m)`,

is the constant of the lower bound on the number of observations of an informative source made by
an algorithm that is consistent at each instance rather than uniformly over the instances
[EVR26, Note 47, Theorem 1]: the pieces are the instances at which the algorithm satisfies a given
bound, and they cover the null without any uniformity. It lies between the bipolar rate and the
smallest relative entropy, `d ≤ d_σ ≤ klInf`, and it is `klInf` for a countable null, covered by its
singletons, while the bipolar rate of a countable null can be smaller [EVR26, Note 44].

## Main definitions

* `ProbabilityTheory.sigmaBipolarRate Q S`: the rate `d_σ(Q, S)` along countable covers of `S`.

## Main statements

* `ProbabilityTheory.iInf_bipolarRate_le_sigmaBipolarRate`: every countable family of sets
  covering `S` has a smallest bipolar rate at most `d_σ(Q, S)`.
* `ProbabilityTheory.bipolarRate_le_sigmaBipolarRate`: `d(Q, S) ≤ d_σ(Q, S)`.
* `ProbabilityTheory.sigmaBipolarRate_le_klInf`: `d_σ(Q, S) ≤ klInf Q S`.
* `ProbabilityTheory.sigmaBipolarRate_eq_klInf_of_countable`: `d_σ(Q, S) = klInf Q S` for a
  countable null `S`, the countable case of [EVR26, Note 47, Theorem 4].

## References

* [EVR26] the research notes of the paper project `RemyDegenne/evalues_research`: Note 47,
  `results/47-regret-constants-one-sided-models.md`, Sections 1, 2 and 4, and Note 44,
  `results/44-regret-pointwise-and-uniform-consistency.md`.
-/

public section

open MeasureTheory InformationTheory

namespace ProbabilityTheory

variable {𝓧 : Type*} {m𝓧 : MeasurableSpace 𝓧} {Q P : Measure 𝓧} {S T : Set (Measure 𝓧)}

/-- The bipolar rate of `Q` against `S` along countable covers, written `d_σ(Q, S)` in
[EVR26, Note 47]: the supremum, over the countable covers `S = ⋃ m, c m` of the null, of the
smallest bipolar rate `⨅ m, bipolarRate Q (c m)` of a piece. -/
noncomputable def sigmaBipolarRate (Q : Measure 𝓧) (S : Set (Measure 𝓧)) : EReal :=
  ⨆ (c : ℕ → Set (Measure 𝓧)) (_ : ⋃ m, c m = S), ⨅ m, bipolarRate Q (c m)

lemma sigmaBipolarRate_def (Q : Measure 𝓧) (S : Set (Measure 𝓧)) :
    sigmaBipolarRate Q S =
      ⨆ (c : ℕ → Set (Measure 𝓧)) (_ : ⋃ m, c m = S), ⨅ m, bipolarRate Q (c m) :=
  (rfl)

/-- Every countable family of sets that covers `S`, with pieces that may be larger than their
intersections with `S`, has a smallest bipolar rate at most `d_σ(Q, S)`. -/
lemma iInf_bipolarRate_le_sigmaBipolarRate {c : ℕ → Set (Measure 𝓧)} (h : S ⊆ ⋃ m, c m) :
    ⨅ m, bipolarRate Q (c m) ≤ sigmaBipolarRate Q S := by
  -- the pieces `c m ∩ S` cover `S` exactly and have larger rates
  refine (iInf_mono fun m ↦ bipolarRate_anti Set.inter_subset_left).trans
    (le_iSup₂_of_le (fun m ↦ c m ∩ S) ?_ le_rfl)
  rw [← Set.iUnion_inter, Set.inter_eq_right.2 h]

/-- `d_σ(Q, S) ≤ x` if and only if every countable family of sets covering `S` has a smallest
bipolar rate at most `x`. -/
lemma sigmaBipolarRate_le_iff {x : EReal} :
    sigmaBipolarRate Q S ≤ x ↔ ∀ c : ℕ → Set (Measure 𝓧), S ⊆ ⋃ m, c m →
      ⨅ m, bipolarRate Q (c m) ≤ x :=
  ⟨fun h _ hc ↦ (iInf_bipolarRate_le_sigmaBipolarRate hc).trans h,
    fun h ↦ iSup₂_le fun c hc ↦ h c hc.ge⟩

/-- The bipolar rate is at most the rate along countable covers: `d(Q, S) ≤ d_σ(Q, S)`, from the
cover of `S` by itself. -/
lemma bipolarRate_le_sigmaBipolarRate (Q : Measure 𝓧) (S : Set (Measure 𝓧)) :
    bipolarRate Q S ≤ sigmaBipolarRate Q S := by
  simpa using iInf_bipolarRate_le_sigmaBipolarRate (Q := Q) (c := fun _ ↦ S)
    (by rw [Set.iUnion_const])

/-- The rate along countable covers is nonnegative against a null of measures of mass at most
one, as is the bipolar rate. -/
lemma sigmaBipolarRate_nonneg (Q : Measure 𝓧) (hS : ∀ P ∈ S, P Set.univ ≤ 1) :
    0 ≤ sigmaBipolarRate Q S :=
  (bipolarRate_nonneg Q hS).trans (bipolarRate_le_sigmaBipolarRate Q S)

/-- Against the empty null, the rate along countable covers is `⊤`, as is the bipolar rate. -/
@[simp]
lemma sigmaBipolarRate_empty (Q : Measure 𝓧) [IsProbabilityMeasure Q] :
    sigmaBipolarRate Q ∅ = ⊤ :=
  eq_top_iff.2 ((bipolarRate_empty Q).symm.le.trans (bipolarRate_le_sigmaBipolarRate Q ∅))

/-- The rate along countable covers is antitone in the null. -/
@[gcongr]
lemma sigmaBipolarRate_anti (h : S ⊆ T) : sigmaBipolarRate Q T ≤ sigmaBipolarRate Q S :=
  sigmaBipolarRate_le_iff.2 fun _ hc ↦ iInf_bipolarRate_le_sigmaBipolarRate (h.trans hc)

/-- The rate along countable covers is at most the smallest relative entropy:
`d_σ(Q, S) ≤ klInf Q S`, since the piece of a cover that contains `P` has a bipolar rate at most
`klDiv Q P`. -/
theorem sigmaBipolarRate_le_klInf (Q : Measure 𝓧) [IsProbabilityMeasure Q]
    (hS : ∀ P ∈ S, IsProbabilityMeasure P) :
    sigmaBipolarRate Q S ≤ klInf Q S := by
  rw [klInf_eq_iInf_klDiv fun P hP ↦ by simp [(hS P hP).measure_univ]]
  refine sigmaBipolarRate_le_iff.2 fun c hc ↦ le_iInf₂ fun P hP ↦ ?_
  obtain ⟨m, hm⟩ := Set.mem_iUnion.1 (hc hP)
  have := hS P hP
  exact (iInf_le _ m).trans (bipolarRate_le_klDiv Q hm)

/-- **The rate along countable covers of a countable null**, the case of a countable null of
[EVR26, Note 47, Theorem 4]: for a countable null `S` of probability measures,
`d_σ(Q, S) = klInf Q S`, from the cover of `S` by its singletons. The general statement of that
theorem, on countably generated spaces, is not proved here. The bipolar rate `d(Q, S)` of a
countable null can be smaller [EVR26, Note 44]. -/
theorem sigmaBipolarRate_eq_klInf_of_countable (Q : Measure 𝓧) [IsProbabilityMeasure Q]
    (hS : ∀ P ∈ S, IsProbabilityMeasure P) (hSc : S.Countable) :
    sigmaBipolarRate Q S = klInf Q S := by
  refine le_antisymm (sigmaBipolarRate_le_klInf Q hS) ?_
  rcases S.eq_empty_or_nonempty with rfl | hne
  · simp
  obtain ⟨f, rfl⟩ := hSc.exists_eq_range hne
  have hf (m : ℕ) : IsProbabilityMeasure (f m) := hS _ (Set.mem_range_self m)
  rw [klInf_eq_iInf_klDiv fun P hP ↦ by simp [(hS P hP).measure_univ], iInf_range]
  refine le_of_eq_of_le (iInf_congr fun m ↦ (bipolarRate_singleton Q (f m)).symm)
    (iInf_bipolarRate_le_sigmaBipolarRate ?_)
  rw [Set.iUnion_singleton_eq_range]

/-- Against a simple null `{P}`, the rate along countable covers is the relative entropy
`klDiv Q P`, as is the bipolar rate. -/
@[simp]
theorem sigmaBipolarRate_singleton (Q P : Measure 𝓧) [IsProbabilityMeasure Q]
    [IsProbabilityMeasure P] :
    sigmaBipolarRate Q {P} = klDiv Q P := by
  rw [sigmaBipolarRate_eq_klInf_of_countable Q (by simpa) (Set.countable_singleton P),
    klInf_eq_iInf_klDiv (by simp [measure_univ]), iInf_singleton]

end ProbabilityTheory
