module

public import LMLExplore.EValues.BipolarRate.Basic
public import LMLExplore.EValues.EProcess.Basic
public import LMLExplore.Probability.Process.Filtration
public import LMLExplore.Probability.ProductMeasure

/-!
# E-processes for an i.i.d. null grow at most at the bipolar rate, in expectation

Let `S₁` be a set of probability measures on `𝓧` (the null) and `Q₁` a probability measure on `𝓧`
(the alternative). The observations are the coordinates of `ℕ → 𝓧`, with the i.i.d. laws
`Measure.infinitePi fun _ ↦ P`, `P ∈ S₁`, and the filtration `Filtration.piLT`, whose σ-algebra at
time `n` is generated by the `n` observations `0, …, n - 1`. A function of the first `n`
observations, that is, a function measurable at time `n` of `Filtration.piLT`, with expectation at
most one under the null is an `n`-sample e-variable. So its expected logarithm under the i.i.d. law
of `Q₁` is at most `maxLogGrowth Q₁ S₁ n`, hence at most `n * bipolarRate Q₁ S₁` for `n ≠ 0`. The
value at time `n` of an e-process is such a function: no e-process grows faster than the bipolar
rate, in expectation [RR26, Lemma 3.3].

The first `n` observations are `MeasureTheory.initSeg n`, whose law under an i.i.d. sequence is the
product law (`MeasureTheory.measurePreserving_initSeg`), and time `n` of `Filtration.piLT` is the
σ-algebra that `initSeg n` generates (`MeasureTheory.Filtration.piLT_eq_comap_initSeg`).

## Main statements

* `ProbabilityTheory.exists_isEVar_eq_comp_initSeg`: a function of the first `n` observations that
  is an e-variable for the i.i.d. null is an `n`-sample e-variable composed with `initSeg n`.
* `ProbabilityTheory.IsEVar.eintegral_log_le_maxLogGrowth`: such a function has expected logarithm
  at most `maxLogGrowth Q₁ S₁ n` under the i.i.d. law of `Q₁`.
* `ProbabilityTheory.IsEProcess.eintegral_log_le_maxLogGrowth`,
  `ProbabilityTheory.IsEProcess.eintegral_log_le_mul_bipolarRate`: the bound for the value of an
  e-process at time `n`, by `maxLogGrowth Q₁ S₁ n` and by `n * bipolarRate Q₁ S₁`.
* `ProbabilityTheory.IsEProcess.eintegral_log_div_le_bipolarRate`,
  `ProbabilityTheory.IsEProcess.limsup_eintegral_log_div_le_bipolarRate`: the expected logarithm
  of an e-process at time `n`, divided by the number `n` of observations it has seen, is at most the
  bipolar rate, and so is its `limsup` [RR26, Lemma 3.3].

## References

* [RR26] A. Ram and A. Ramdas, *The optimal betting wealth growth rate*, arXiv:2604.25280v1.
-/

public section

open MeasureTheory Filter
open scoped ENNReal Topology

namespace ProbabilityTheory

variable {𝓧 : Type*} {m𝓧 : MeasurableSpace 𝓧} {Q₁ : Measure 𝓧} {S₁ : Set (Measure 𝓧)}

/-! ### Functions of the first observations as e-variables of a sample -/

/-- A function of the first `n` observations (measurable at time `n` of `Filtration.piLT`) that is
an e-variable for the i.i.d. laws of the members of `S₁` is an `n`-sample e-variable, composed with
the initial segment. -/
lemma exists_isEVar_eq_comp_initSeg (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P)
    {F : (ℕ → 𝓧) → ℝ≥0∞} {n : ℕ} (hF : Measurable[Filtration.piLT n] F)
    (hFe : IsEVar F (iidNull S₁)) :
    ∃ G : (Fin n → 𝓧) → ℝ≥0∞, IsEVar G (sampleNull S₁ n) ∧ F = G ∘ initSeg n := by
  rw [Filtration.piLT_eq_comap_initSeg] at hF
  obtain ⟨G, hG, rfl⟩ := hF.exists_eq_measurable_comp
  refine ⟨G, ?_, rfl⟩
  rwa [← mapNull_initSeg_iidNull hS₁ n, isEVar_mapNull_iff (measurable_initSeg n) hG]

/-- A function of the first `n` observations (measurable at time `n` of `Filtration.piLT`) that is
an e-variable for the i.i.d. laws of the members of `S₁` has expected logarithm, under the i.i.d.
law of `Q₁`, at most the maximal expected logarithm of an `n`-sample e-variable. -/
theorem IsEVar.eintegral_log_le_maxLogGrowth (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁]
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P) {F : (ℕ → 𝓧) → ℝ≥0∞} {n : ℕ}
    (hFe : IsEVar F (iidNull S₁)) (hF : Measurable[Filtration.piLT n] F) :
    ∫ᵉ ω, ENNReal.log (F ω) ∂Measure.infinitePi (fun _ : ℕ ↦ Q₁) ≤ maxLogGrowth Q₁ S₁ n := by
  obtain ⟨G, hGe, rfl⟩ := exists_isEVar_eq_comp_initSeg hS₁ hF hFe
  calc ∫ᵉ ω, ENNReal.log ((G ∘ initSeg n) ω) ∂Measure.infinitePi (fun _ : ℕ ↦ Q₁)
  _ = ∫ᵉ x, ENNReal.log (G x) ∂Measure.pi (fun _ : Fin n ↦ Q₁) := by
    rw [← (measurePreserving_initSeg Q₁ n).map_eq,
      eintegral_map hGe.measurable.ennreal_log (measurable_initSeg n)]
    simp only [Function.comp_apply]
  _ ≤ maxLogGrowth Q₁ S₁ n := by
    rw [maxLogGrowth_def]
    exact hGe.eintegral_log_le_maxEPower _

/-! ### E-processes -/

variable {E : ℕ → (ℕ → 𝓧) → ℝ≥0∞}

/-- The value at time `n` of an e-process for the i.i.d. laws of the members of `S₁`, in the
filtration `Filtration.piLT` of the observations, has expected logarithm under the i.i.d. law of
`Q₁` at most the maximal expected logarithm of an `n`-sample e-variable: at time `n` the process has
seen `n` observations. -/
theorem IsEProcess.eintegral_log_le_maxLogGrowth (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁]
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P)
    (hE : IsEProcess E (Filtration.piLT (X := fun _ : ℕ ↦ 𝓧)) (iidNull S₁)) (n : ℕ) :
    ∫ᵉ ω, ENNReal.log (E n ω) ∂Measure.infinitePi (fun _ : ℕ ↦ Q₁) ≤ maxLogGrowth Q₁ S₁ n :=
  (hE.isEVar n).eintegral_log_le_maxLogGrowth Q₁ hS₁ (hE.adapted n)

/-- The value at a time `n ≠ 0` of an e-process for an i.i.d. null, in the filtration
`Filtration.piLT` of the observations, has expected logarithm, under the i.i.d. law of `Q₁`, at
most `n` times the bipolar rate [RR26, Lemma 3.3]. -/
theorem IsEProcess.eintegral_log_le_mul_bipolarRate (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁]
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P)
    (hE : IsEProcess E (Filtration.piLT (X := fun _ : ℕ ↦ 𝓧)) (iidNull S₁)) {n : ℕ}
    (hn : n ≠ 0) :
    ∫ᵉ ω, ENNReal.log (E n ω) ∂Measure.infinitePi (fun _ : ℕ ↦ Q₁) ≤
      (n : EReal) * bipolarRate Q₁ S₁ :=
  (hE.eintegral_log_le_maxLogGrowth Q₁ hS₁ n).trans (maxLogGrowth_le_mul_bipolarRate Q₁ S₁ hn)

/-- The expected logarithm of an e-process for an i.i.d. null at a time `n ≠ 0`, in the filtration
`Filtration.piLT` of the observations, per observation seen, is at most the bipolar rate. -/
theorem IsEProcess.eintegral_log_div_le_bipolarRate (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁]
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P)
    (hE : IsEProcess E (Filtration.piLT (X := fun _ : ℕ ↦ 𝓧)) (iidNull S₁)) {n : ℕ}
    (hn : n ≠ 0) :
    (∫ᵉ ω, ENNReal.log (E n ω) ∂Measure.infinitePi (fun _ : ℕ ↦ Q₁)) / (n : EReal) ≤
      bipolarRate Q₁ S₁ :=
  (EReal.div_le_iff_le_mul (by exact_mod_cast Nat.pos_of_ne_zero hn) (EReal.natCast_ne_top _)).2
    (hE.eintegral_log_le_mul_bipolarRate Q₁ hS₁ hn)

/-- No e-process for an i.i.d. null grows faster than the bipolar rate, in expectation: the
expected logarithm at time `n` under the i.i.d. law of `Q₁`, divided by the number `n` of
observations seen in the filtration `Filtration.piLT`, has `limsup` at most the bipolar rate
[RR26, Lemma 3.3]. -/
theorem IsEProcess.limsup_eintegral_log_div_le_bipolarRate (Q₁ : Measure 𝓧)
    [IsProbabilityMeasure Q₁] (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P)
    (hE : IsEProcess E (Filtration.piLT (X := fun _ : ℕ ↦ 𝓧)) (iidNull S₁)) :
    limsup (fun n : ℕ ↦ (∫ᵉ ω, ENNReal.log (E n ω) ∂Measure.infinitePi (fun _ : ℕ ↦ Q₁)) /
      (n : EReal)) atTop ≤ bipolarRate Q₁ S₁ :=
  limsup_le_of_le (by isBoundedDefault) ((eventually_ne_atTop 0).mono fun _ hn ↦
    hE.eintegral_log_div_le_bipolarRate Q₁ hS₁ hn)

end ProbabilityTheory
