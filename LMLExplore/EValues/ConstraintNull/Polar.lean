module

public import LMLExplore.EValues.ConstraintNull.CompleteClass
public import LMLExplore.EValues.Null.Polar

/-!
# Constraint nulls and polar nulls

A null can be presented in two ways: by real constraints `f` with `∫ f ∂μ ≤ 0`
(`ProbabilityTheory.constraintNull`), or by bets `Y : 𝓧 → ℝ≥0∞` with `∫⁻ Y ∂μ ≤ 1`
(`ProbabilityTheory.polarNull`). This file relates the two. For a set `𝓔₀` of measurable bets with
finite values, the null generated by the constraints `Y - 1`, `Y ∈ 𝓔₀`, is the set of probability
measures of the polar of `𝓔₀`. The inclusion of the polar side in the constraint side needs no
finiteness, but the equality does: the constraint `Y - 1` does not see the value `∞`, and for the
single bet `Y = ∞` the constraint is `-1`, satisfied by every probability measure, while no
probability measure gives `∞` an expectation at most `1`.

Through this bridge, the complete class theorem for finitely many constraints [LRR26, Theorem 3.1]
describes the e-variables for the probability measures of the polar of finitely many finite
measurable bets `Y i`: they are the measurable functions quasi-surely below some
`c + ∑ i, π i * Y i` with `π i ≥ 0`, `c + ∑ i, π i ≤ 1` and `c + ∑ i, π i * Y i` quasi-surely
nonnegative. The constant `c` may be negative: the mass of a probability measure is an equality
constraint, so the constant bet `1` may be bet against as well as on.

## Main statements

* `ProbabilityTheory.polarNull_inter_subset_constraintNull`: the probability measures of the
  polar of measurable bets satisfy the constraints `Y - 1`.
* `ProbabilityTheory.constraintNull_image_toReal_sub_one`,
  `ProbabilityTheory.constraintNull_range_toReal_sub_one`: for measurable bets with finite values,
  the null generated by the constraints `Y - 1` is the set of probability measures of the polar.
* `ProbabilityTheory.constraintNull_image_toReal_sub_one_singleton_top_ne`: finiteness cannot be
  dropped.
* `ProbabilityTheory.isEVar_polarNull_range_inter_iff`: the complete class theorem for a null
  presented by finitely many finite bets.

## References

* [EVR26] *Answers to open questions in e-values and anytime-valid inference*, the Lean checks of
  `notes/book/Checks.lean` in github.com/RemyDegenne/evalues_research (2026), from which the
  bridge and its counterexample are adapted.
* [LRR26] M. Larsson, A. Ramdas and J. Ruf, *Testing hypotheses generated by constraints*, Math.
  Oper. Res. (2026), arXiv:2504.02974v5.
-/

public section

open MeasureTheory Set
open scoped ENNReal NNReal

namespace ProbabilityTheory

variable {𝓧 ι : Type*} [MeasurableSpace 𝓧] {𝓔₀ : Set (𝓧 → ℝ≥0∞)} {E : 𝓧 → ℝ≥0∞}

/-! ### The bridge between the two presentations -/

/-- **Polar nulls satisfy the constraints `Y - 1`.** For measurable bets `Y ∈ 𝓔₀`, every
probability measure under which each bet has expectation at most `1` integrates the constraint
`Y - 1`, with a nonpositive integral. No finiteness of the bets is needed. -/
theorem polarNull_inter_subset_constraintNull (hm : ∀ Y ∈ 𝓔₀, Measurable Y) :
    polarNull 𝓔₀ ∩ {μ | IsProbabilityMeasure μ} ⊆
      constraintNull ((fun (Y : 𝓧 → ℝ≥0∞) x ↦ (Y x).toReal - 1) '' 𝓔₀) := by
  rintro μ ⟨hμ, hμ1⟩
  have : IsProbabilityMeasure μ := hμ1
  refine mem_constraintNull_iff.2 ⟨hμ1, ?_⟩
  rintro _ ⟨Y, hY, rfl⟩
  have hle : ∫⁻ x, Y x ∂μ ≤ 1 := lintegral_le_one_of_mem_polarNull hμ hY
  have hfin : ∫⁻ x, Y x ∂μ ≠ ∞ := (hle.trans_lt ENNReal.one_lt_top).ne
  have hint := integrable_toReal_of_lintegral_ne_top (hm Y hY).aemeasurable hfin
  refine ⟨hint.sub (integrable_const 1), ?_⟩
  rw [integral_sub hint (integrable_const 1),
    integral_toReal (hm Y hY).aemeasurable (ae_lt_top (hm Y hY) hfin)]
  simpa using ENNReal.toReal_le_of_le_ofReal zero_le_one (by simpa using hle)

/-- **The null generated by the constraints `Y - 1` is the polar of the bets `Y`**, among
probability measures, for a set `𝓔₀` of measurable bets with finite values. -/
theorem constraintNull_image_toReal_sub_one (hm : ∀ Y ∈ 𝓔₀, Measurable Y)
    (hfin : ∀ Y ∈ 𝓔₀, ∀ x, Y x ≠ ∞) :
    constraintNull ((fun (Y : 𝓧 → ℝ≥0∞) x ↦ (Y x).toReal - 1) '' 𝓔₀) =
      polarNull 𝓔₀ ∩ {μ | IsProbabilityMeasure μ} := by
  refine Subset.antisymm (fun μ hμ ↦ ⟨mem_polarNull_iff.2 fun Y hY ↦ ?_,
    isProbabilityMeasure_of_mem_constraintNull hμ⟩) (polarNull_inter_subset_constraintNull hm)
  have := isProbabilityMeasure_of_mem_constraintNull hμ
  have hint := integrable_of_mem_constraintNull hμ (mem_image_of_mem _ hY)
  have hle := integral_nonpos_of_mem_constraintNull hμ (mem_image_of_mem _ hY)
  -- `Y = ofReal (Y.toReal)` with `Y.toReal = (Y.toReal - 1) + 1` integrable, of integral `≤ 1`
  have hint' : Integrable (fun x ↦ (Y x).toReal) μ :=
    (hint.add (integrable_const 1)).congr (ae_of_all _ fun _ ↦ sub_add_cancel _ _)
  rw [integral_sub hint' (integrable_const 1), integral_const, probReal_univ, one_smul,
    sub_nonpos] at hle
  calc ∫⁻ x, Y x ∂μ = ∫⁻ x, ENNReal.ofReal (Y x).toReal ∂μ := by
        simp_rw [ENNReal.ofReal_toReal (hfin Y hY _)]
    _ = ENNReal.ofReal (∫ x, (Y x).toReal ∂μ) :=
        (ofReal_integral_eq_lintegral_ofReal hint' (ae_of_all _ fun _ ↦ ENNReal.toReal_nonneg)).symm
    _ ≤ 1 := ENNReal.ofReal_le_one.2 hle

/-- **The null generated by the constraints `Y i - 1` is the polar of the bets `Y i`**, among
probability measures, for an indexed family of measurable bets with finite values. -/
theorem constraintNull_range_toReal_sub_one {Y : ι → 𝓧 → ℝ≥0∞} (hm : ∀ i, Measurable (Y i))
    (hfin : ∀ i x, Y i x ≠ ∞) :
    constraintNull (range fun i x ↦ (Y i x).toReal - 1) =
      polarNull (range Y) ∩ {μ | IsProbabilityMeasure μ} := by
  rw [← constraintNull_image_toReal_sub_one (forall_mem_range.2 hm) (forall_mem_range.2 hfin),
    ← range_comp']

/-- **Finiteness cannot be dropped** in `constraintNull_image_toReal_sub_one`. For the single bet
`Y = ∞` the constraint `Y - 1` is the constant `-1`, which every probability measure satisfies,
while no probability measure gives `∞` an expectation at most `1`. -/
theorem constraintNull_image_toReal_sub_one_singleton_top_ne [Nonempty 𝓧] :
    constraintNull ((fun (Y : 𝓧 → ℝ≥0∞) x ↦ (Y x).toReal - 1) '' {fun _ ↦ ∞}) ≠
      polarNull {fun _ ↦ ∞} ∩ {μ | IsProbabilityMeasure μ} := by
  obtain ⟨x₀⟩ := ‹Nonempty 𝓧›
  intro h
  have hmem : Measure.dirac x₀ ∈
      constraintNull ((fun (Y : 𝓧 → ℝ≥0∞) x ↦ (Y x).toReal - 1) '' {fun _ ↦ ∞}) := by
    rw [image_singleton, dirac_mem_constraintNull_iff (by simp)]
    simp
  have hle := lintegral_le_one_of_mem_polarNull (h ▸ hmem).1 (mem_singleton _)
  simp at hle

/-! ### The complete class theorem for finitely many bets -/

/-- **The e-variables for a null presented by finitely many bets** [LRR26, Theorem 3.1]. For
finitely many measurable bets `Y i` with finite values, the e-variables for the probability
measures under which every `Y i` has expectation at most `1` are the measurable functions that are
quasi-surely at most `c + ∑ i, π i * Y i`, for some weights `π i ≥ 0` and a real `c`, possibly
negative, with `c + ∑ i, π i ≤ 1` and `c + ∑ i, π i * Y i` quasi-surely nonnegative. -/
theorem isEVar_polarNull_range_inter_iff [Fintype ι] {Y : ι → 𝓧 → ℝ≥0∞}
    (hm : ∀ i, Measurable (Y i)) (hfin : ∀ i x, Y i x ≠ ∞) :
    IsEVar E (polarNull (range Y) ∩ {μ | IsProbabilityMeasure μ}) ↔
      Measurable E ∧ ∃ (c : ℝ) (π : ι → ℝ≥0), c + ∑ i, (π i : ℝ) ≤ 1 ∧
        ∀ᶠ x in quasiSure (polarNull (range Y) ∩ {μ | IsProbabilityMeasure μ}),
          0 ≤ c + ∑ i, (π i : ℝ) * (Y i x).toReal ∧
            E x ≤ ENNReal.ofReal (c + ∑ i, (π i : ℝ) * (Y i x).toReal) := by
  have hg : ∀ i, Measurable fun x ↦ (Y i x).toReal - 1 := fun i ↦
    (hm i).ennreal_toReal.sub_const 1
  -- the bet `1 + ∑ i, π i * (Y i - 1)` on the constraints is `c + ∑ i, π i * Y i` for
  -- `c = 1 - ∑ i, π i`
  have hbet (π : ι → ℝ≥0) (x : 𝓧) : 1 + ∑ i, (π i : ℝ) * ((Y i x).toReal - 1) =
      (1 - ∑ i, (π i : ℝ)) + ∑ i, (π i : ℝ) * (Y i x).toReal := by
    simp only [mul_sub, mul_one, Finset.sum_sub_distrib]
    ring
  rw [← constraintNull_range_toReal_sub_one hm hfin, isEVar_constraintNull_iff hg]
  refine and_congr_right fun _ ↦ ⟨fun ⟨π, hπ, hE⟩ ↦ ⟨1 - ∑ i, (π i : ℝ), π, by simp, ?_⟩,
    fun ⟨c, π, hc, h⟩ ↦ ⟨π, mem_constraintBets_iff.2 fun μ hμ ↦ ?_, ?_⟩⟩
  · filter_upwards [eventually_quasiSure_iff.2 (mem_constraintBets_iff.1 hπ), hE] with x hx hEx
    rw [← hbet]
    exact ⟨hx, hEx⟩
  · -- `c + ∑ i, π i * Y i ≤ 1 + ∑ i, π i * (Y i - 1)` since `c ≤ 1 - ∑ i, π i`
    filter_upwards [ae_of_eventually_quasiSure h hμ] with x hx
    rw [hbet]
    linarith [hx.1]
  · filter_upwards [h] with x hx
    refine hx.2.trans (ENNReal.ofReal_le_ofReal ?_)
    rw [hbet]
    linarith

end ProbabilityTheory
