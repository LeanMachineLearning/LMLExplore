public import Mathlib.Topology.UnitInterval
import LMLExplore.Analysis.SpecialFunctions.Integrability.PosLog

/-!
# The mean-constraint nulls on `[0, 1]`

The laws on `[0, 1]` (measures on `unitInterval`) with a mean at most `m`, at least `m` or equal
to `m` are the nulls generated by the constraints `x - m`, `m - x` and both [LRR26,
Definition 2.1]. This file names them, and reads the general theory of constraint nulls
(`LMLExplore.EValues.ConstraintNull.CompleteClass`, `.Admissible` and `.KLInf`) on them.

Every point of `[0, 1]` is charged by a member of each null, as soon as the null is not
degenerate, so that quasi-sure statements hold everywhere. The bets are then the affine functions
`1 + l * (x - m)` that are nonnegative on `[0, 1]`, that is, nonnegative at `0` and `1`:

* for the mean at most `m`, with `0 < m`, the slopes `l ∈ [0, 1 / m]`;
* for the mean at least `m`, with `m < 1`, the slopes `l ∈ [-1 / (1 - m), 0]`, written below as
  `1 + l * (m - x)` with `l ∈ [0, 1 / (1 - m)]`;
* for the mean equal to `m`, with `0 < m < 1`, the slopes `l ∈ [-1 / (1 - m), 1 / m]`.

The e-variables are the measurable functions below a bet at every point [LRR26, Theorem 3.1], and
for the mean equal to `m` the bets are exactly the admissible e-variables [Cle25, Theorem 1]. The
dual formula for the smallest relative entropy gives the formula of Honda and Takemura for laws on
`[0, 1]` [HT15]: the smallest relative entropy from `Q` to the laws with mean at least `m` is the
supremum over `l ∈ [0, 1 / (1 - m)]` of `𝔼_Q log (1 + l * (m - X))`. [HT15] also states it for the
laws on `(-∞, 1]`, which this file does not treat.

## Main definitions

* `ProbabilityTheory.meanLeNull m`, `ProbabilityTheory.meanGeNull m`,
  `ProbabilityTheory.meanEqNull m`: the laws on `[0, 1]` with mean at most, at least, equal to `m`.

## Main statements

* `ProbabilityTheory.mem_meanLeNull_iff`, `ProbabilityTheory.mem_meanGeNull_iff`,
  `ProbabilityTheory.mem_meanEqNull_iff`: the members are the probability measures with the given
  mean, and `ProbabilityTheory.meanEqNull_eq_inter`.
* `ProbabilityTheory.quasiSure_meanLeNull`, `ProbabilityTheory.quasiSure_meanGeNull`,
  `ProbabilityTheory.quasiSure_meanEqNull`: the quasi-sure filters are `⊤`.
* `ProbabilityTheory.isEVar_meanLeNull_iff`, `ProbabilityTheory.isEVar_meanGeNull_iff`,
  `ProbabilityTheory.isEVar_meanEqNull_iff`: the e-variables are the measurable functions below
  a bet.
* `ProbabilityTheory.isAdmissibleEVar_meanEqNull_iff`: the admissible e-variables for the laws of
  mean `m` are the bets [Cle25, Theorem 1].
* `ProbabilityTheory.klInf_meanLeNull`, `ProbabilityTheory.klInf_meanGeNull`,
  `ProbabilityTheory.klInf_meanEqNull`: the smallest relative entropies to the three nulls
  [HT15].

## References

* [Cle25] E. Clerico, *On the optimality of coin-betting for mean estimation*, arXiv:2412.02640v4
  (2025).
* [HT15] J. Honda and A. Takemura, *Non-asymptotic analysis of a new bandit algorithm for
  semi-bounded rewards*, J. Mach. Learn. Res. 16 (2015).
* [LRR26] M. Larsson, A. Ramdas and J. Ruf, *Testing hypotheses generated by constraints*, Math.
  Oper. Res. (2026), arXiv:2504.02974v5.
-/

public section

open MeasureTheory Set LMLExplore
open scoped ENNReal NNReal unitInterval

namespace ProbabilityTheory

variable {m : ℝ} {μ Q : Measure I} {E : I → ℝ≥0∞}

/-! ### The three nulls -/

/-- The laws on `[0, 1]` with mean at most `m`: the null generated by the constraint `x - m`. -/
def meanLeNull (m : ℝ) : Set (Measure I) :=
  constraintNull {fun x : I ↦ (x : ℝ) - m}

/-- The laws on `[0, 1]` with mean at least `m`: the null generated by the constraint `m - x`. -/
def meanGeNull (m : ℝ) : Set (Measure I) :=
  constraintNull {fun x : I ↦ m - (x : ℝ)}

/-- The laws on `[0, 1]` with mean `m`: the null generated by the constraints `x - m` and
`m - x`. -/
def meanEqNull (m : ℝ) : Set (Measure I) :=
  constraintNull {fun x : I ↦ (x : ℝ) - m, fun x : I ↦ m - (x : ℝ)}

theorem meanLeNull_def (m : ℝ) : meanLeNull m = constraintNull {fun x : I ↦ (x : ℝ) - m} := (rfl)

theorem meanGeNull_def (m : ℝ) : meanGeNull m = constraintNull {fun x : I ↦ m - (x : ℝ)} := (rfl)

theorem meanEqNull_def (m : ℝ) :
    meanEqNull m = constraintNull {fun x : I ↦ (x : ℝ) - m, fun x : I ↦ m - (x : ℝ)} := (rfl)

/-- The laws of mean `m` are those of mean at most `m` and at least `m`. -/
theorem meanEqNull_eq_inter (m : ℝ) : meanEqNull m = meanLeNull m ∩ meanGeNull m := by
  rw [meanEqNull_def, insert_eq, constraintNull_union, meanLeNull_def, meanGeNull_def]

/-! ### Constraints indexed by finite types -/

/-- The constraint `x - m`, indexed by `Unit`. -/
private theorem meanLeNull_eq_constraintNull_range (m : ℝ) :
    meanLeNull m = constraintNull (range fun _ : Unit ↦ fun x : I ↦ (x : ℝ) - m) := by
  rw [meanLeNull_def, range_const]

/-- The constraint `m - x`, indexed by `Unit`. -/
private theorem meanGeNull_eq_constraintNull_range (m : ℝ) :
    meanGeNull m = constraintNull (range fun _ : Unit ↦ fun x : I ↦ m - (x : ℝ)) := by
  rw [meanGeNull_def, range_const]

/-- The constraints `x - m` and `m - x`, indexed by `Fin 2`. -/
private theorem meanEqNull_eq_constraintNull_range (m : ℝ) :
    meanEqNull m = constraintNull (range ![fun x : I ↦ (x : ℝ) - m, fun x : I ↦ m - (x : ℝ)]) := by
  rw [meanEqNull_def, Matrix.range_cons_cons_empty]

private theorem measurable_meanEq (m : ℝ) :
    ∀ i, Measurable (![fun x : I ↦ (x : ℝ) - m, fun x : I ↦ m - (x : ℝ)] i) :=
  Fin.forall_fin_two.2 ⟨measurable_subtypeVal.sub_const m, measurable_subtypeVal.const_sub m⟩

/-- The combination with weights `ρ` of the constraints `x - m` and `m - x` is the linear function
of slope `ρ 0 - ρ 1` in `x - m`. -/
private theorem sum_mul_meanEq (ρ : Fin 2 → ℝ) (x : I) :
    ∑ i, ρ i * ![fun x : I ↦ (x : ℝ) - m, fun x : I ↦ m - (x : ℝ)] i x =
      (ρ 0 - ρ 1) * ((x : ℝ) - m) := by
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]
  ring

/-- The weights `(l⁺, l⁻)` have the slope `l`. -/
private theorem coe_toNNReal_sub_coe_toNNReal_neg (l : ℝ) :
    ((![l.toNNReal, (-l).toNNReal] 0 : ℝ≥0) : ℝ) - (![l.toNNReal, (-l).toNNReal] 1 : ℝ≥0) = l := by
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Real.coe_toNNReal']
  rcases le_total 0 l with h | h <;> simp [h]

/-! ### Membership -/

/-- The identity of `[0, 1]` is integrable under every finite measure. -/
private theorem integrable_coe (μ : Measure I) [IsFiniteMeasure μ] :
    Integrable (fun x : I ↦ (x : ℝ)) μ :=
  Integrable.of_mem_Icc 0 1 measurable_subtypeVal.aemeasurable (ae_of_all _ fun x : I ↦ x.property)

/-- The laws on `[0, 1]` with mean at most `m` are the probability measures whose mean is at
most `m`. -/
theorem mem_meanLeNull_iff : μ ∈ meanLeNull m ↔ IsProbabilityMeasure μ ∧ ∫ x, (x : ℝ) ∂μ ≤ m := by
  rw [meanLeNull_def, mem_constraintNull_iff]
  refine and_congr_right fun hμ ↦ ?_
  have hx := integrable_coe μ
  have hxm : Integrable (fun x : I ↦ (x : ℝ) - m) μ := hx.sub (integrable_const m)
  simp [integral_sub hx (integrable_const m), hxm]

/-- The laws on `[0, 1]` with mean at least `m` are the probability measures whose mean is at
least `m`. -/
theorem mem_meanGeNull_iff : μ ∈ meanGeNull m ↔ IsProbabilityMeasure μ ∧ m ≤ ∫ x, (x : ℝ) ∂μ := by
  rw [meanGeNull_def, mem_constraintNull_iff]
  refine and_congr_right fun hμ ↦ ?_
  have hx := integrable_coe μ
  have hmx : Integrable (fun x : I ↦ m - (x : ℝ)) μ := (integrable_const m).sub hx
  simp [integral_sub (integrable_const m) hx, hmx]

/-- The laws on `[0, 1]` with mean `m` are the probability measures whose mean is `m`. -/
theorem mem_meanEqNull_iff : μ ∈ meanEqNull m ↔ IsProbabilityMeasure μ ∧ ∫ x, (x : ℝ) ∂μ = m := by
  rw [meanEqNull_eq_inter, mem_inter_iff, mem_meanLeNull_iff, mem_meanGeNull_iff]
  constructor
  · rintro ⟨⟨hμ, h₁⟩, -, h₂⟩
    exact ⟨hμ, le_antisymm h₁ h₂⟩
  · rintro ⟨hμ, h⟩
    exact ⟨⟨hμ, h.le⟩, hμ, h.ge⟩

/-! ### Quasi-sure statements hold everywhere -/

/-- Two linear functions `a * (x - m)` and `b * (x - m)` that are ordered on `[0, 1]`, for
`0 < m < 1`, have the same slope: they are ordered at `0` and at `1`, where `x - m` has opposite
signs. -/
private theorem eq_of_forall_mul_sub_le (hm₀ : 0 < m) (hm₁ : m < 1) {a b : ℝ}
    (h : ∀ x : I, a * ((x : ℝ) - m) ≤ b * ((x : ℝ) - m)) : a = b := by
  have h0 := h 0
  have h1 := h 1
  simp only [Icc.coe_zero, Icc.coe_one] at h0 h1
  nlinarith

/-- Every point of `[0, 1]` is charged by a law with mean at most `m`, for `0 < m`: almost surely
under every such law means everywhere. -/
theorem quasiSure_meanLeNull (hm : 0 < m) : quasiSure (meanLeNull m) = ⊤ := by
  rw [meanLeNull_eq_constraintNull_range, quasiSure_constraintNull_eq_principal
    (fun _ ↦ by fun_prop) (noArbitrageOn_of_forall_neg (x₀ := 0) (mem_univ _) fun _ ↦ by simpa)
    (fun _ _ ↦ by simp), Filter.principal_univ]

/-- Every point of `[0, 1]` is charged by a law with mean at least `m`, for `m < 1`: almost surely
under every such law means everywhere. -/
theorem quasiSure_meanGeNull (hm : m < 1) : quasiSure (meanGeNull m) = ⊤ := by
  rw [meanGeNull_eq_constraintNull_range, quasiSure_constraintNull_eq_principal
    (fun _ ↦ by fun_prop) (noArbitrageOn_of_forall_neg (x₀ := 1) (mem_univ _) fun _ ↦ by simpa)
    (fun _ _ ↦ by simp), Filter.principal_univ]

/-- Every point of `[0, 1]` is charged by a law with mean `m`, for `0 < m < 1`: almost surely
under every such law means everywhere. -/
theorem quasiSure_meanEqNull (hm₀ : 0 < m) (hm₁ : m < 1) : quasiSure (meanEqNull m) = ⊤ := by
  -- a combination that is nonnegative at `0` and at `1` has slope `0`
  have hY : NoArbitrageOn ![fun x : I ↦ (x : ℝ) - m, fun x : I ↦ m - (x : ℝ)] univ := by
    refine noArbitrageOn_iff.2 fun ρ _ h x _ ↦ ?_
    simp only [sum_mul_meanEq] at h ⊢
    rw [← eq_of_forall_mul_sub_le hm₀ hm₁ (a := 0) (b := ρ 0 - ρ 1)
      fun x ↦ by simpa using h x (mem_univ _), zero_mul]
  rw [meanEqNull_eq_constraintNull_range, quasiSure_constraintNull_eq_principal
    (measurable_meanEq m) hY (fun _ _ ↦ by simp), Filter.principal_univ]

/-! ### The bets -/

/-- An affine function `1 + l * (x - m)` is nonnegative on `[0, 1]` exactly when it is
nonnegative at `0` and at `1`. -/
private theorem forall_one_add_mul_sub_nonneg_iff {l : ℝ} :
    (∀ x : I, 0 ≤ 1 + l * ((x : ℝ) - m)) ↔ l * m ≤ 1 ∧ -1 ≤ l * (1 - m) := by
  refine ⟨fun h ↦ ⟨by simpa [sub_nonneg] using h 0, by simpa [neg_le_iff_add_nonneg'] using h 1⟩,
    fun ⟨h0, h1⟩ x ↦ ?_⟩
  have hx0 := unitInterval.nonneg x
  have hx1 := unitInterval.le_one x
  -- the affine function is a convex combination of its values at `0` and `1`
  have : 1 + l * ((x : ℝ) - m) = (1 - x) * (1 - l * m) + x * (1 + l * (1 - m)) := by ring
  rw [this]
  exact add_nonneg (mul_nonneg (by linarith) (by linarith)) (mul_nonneg hx0 (by linarith))

/-- The nonnegative slopes of the bets on the constraint `x - m`, for `0 < m`. -/
private theorem forall_one_add_mul_sub_nonneg_iff_le_inv (hm : 0 < m) {l : ℝ} (hl : 0 ≤ l) :
    (∀ x : I, 0 ≤ 1 + l * ((x : ℝ) - m)) ↔ l ≤ m⁻¹ := by
  rw [forall_one_add_mul_sub_nonneg_iff, ← one_mul m⁻¹, le_mul_inv_iff₀ hm]
  exact ⟨And.left, fun h ↦ ⟨h, by nlinarith⟩⟩

/-- The nonnegative slopes of the bets on the constraint `m - x`, for `m < 1`. -/
private theorem forall_one_add_mul_sub_nonneg_iff_le_inv' (hm : m < 1) {l : ℝ} (hl : 0 ≤ l) :
    (∀ x : I, 0 ≤ 1 + l * (m - (x : ℝ))) ↔ l ≤ (1 - m)⁻¹ := by
  have h (x : I) : l * (m - (x : ℝ)) = -l * ((x : ℝ) - m) := by ring
  simp only [h, forall_one_add_mul_sub_nonneg_iff]
  rw [← one_mul (1 - m)⁻¹, le_mul_inv_iff₀ (sub_pos.2 hm)]
  exact ⟨fun h ↦ by linarith [h.2], fun h ↦ ⟨by nlinarith, by linarith⟩⟩

/-- The slopes of the bets on the constraints `x - m` and `m - x`, for `0 < m < 1`. -/
private theorem forall_one_add_mul_sub_nonneg_iff_mem_Icc (hm₀ : 0 < m) (hm₁ : m < 1) {l : ℝ} :
    (∀ x : I, 0 ≤ 1 + l * ((x : ℝ) - m)) ↔ l ∈ Icc (-(1 - m)⁻¹) m⁻¹ := by
  have h₀ : l ≤ m⁻¹ ↔ l * m ≤ 1 := by rw [← one_mul m⁻¹, le_mul_inv_iff₀ hm₀]
  have h₁ : -(1 - m)⁻¹ ≤ l ↔ -1 ≤ l * (1 - m) := by
    rw [neg_le, ← one_mul (1 - m)⁻¹, le_mul_inv_iff₀ (sub_pos.2 hm₁), neg_mul, neg_le]
  rw [forall_one_add_mul_sub_nonneg_iff, mem_Icc, h₀, h₁, and_comm]

/-- The bets on the constraints `x - m` and `m - x`, for `0 < m < 1`, are the weights whose slope
`π 0 - π 1` is in `[-1 / (1 - m), 1 / m]`. -/
private theorem mem_constraintBets_meanEq_iff (hm₀ : 0 < m) (hm₁ : m < 1) {π : Fin 2 → ℝ≥0} :
    π ∈ constraintBets ![fun x : I ↦ (x : ℝ) - m, fun x : I ↦ m - (x : ℝ)] ↔
      (π 0 : ℝ) - π 1 ∈ Icc (-(1 - m)⁻¹) m⁻¹ := by
  have hq := quasiSure_meanEqNull hm₀ hm₁
  rw [meanEqNull_eq_constraintNull_range] at hq
  simp only [mem_constraintBets_iff_eventually_quasiSure, hq, Filter.eventually_top,
    sum_mul_meanEq, forall_one_add_mul_sub_nonneg_iff_mem_Icc hm₀ hm₁]

/-- The slopes of the bets on the constraints `x - m` and `m - x`, for `0 < m < 1`, are the
`l ∈ [-1 / (1 - m), 1 / m]`. -/
private theorem image_constraintBets_meanEq (hm₀ : 0 < m) (hm₁ : m < 1) :
    (fun (π : Fin 2 → ℝ≥0) ↦ (π 0 : ℝ) - π 1) ''
      constraintBets ![fun x : I ↦ (x : ℝ) - m, fun x : I ↦ m - (x : ℝ)] =
      Icc (-(1 - m)⁻¹) m⁻¹ := by
  refine Subset.antisymm (image_subset_iff.2 fun π hπ ↦ (mem_constraintBets_meanEq_iff hm₀ hm₁).1
    hπ) fun l hl ↦ ⟨![l.toNNReal, (-l).toNNReal], ?_, coe_toNNReal_sub_coe_toNNReal_neg l⟩
  rwa [mem_constraintBets_meanEq_iff hm₀ hm₁, coe_toNNReal_sub_coe_toNNReal_neg]

/-- The slopes of the bets on one constraint `Y` are the `l ∈ [0, c]`, if quasi-sure statements
hold everywhere and the nonnegative slopes `l` of the bets `1 + l * Y` are those below `c`. -/
private theorem image_constraintBets_unit {Y : I → ℝ} {c : ℝ}
    (hq : quasiSure (constraintNull (range fun _ : Unit ↦ Y)) = ⊤)
    (hY : ∀ l : ℝ, 0 ≤ l → ((∀ x, 0 ≤ 1 + l * Y x) ↔ l ≤ c)) :
    (fun (π : Unit → ℝ≥0) ↦ (π () : ℝ)) '' constraintBets (fun _ : Unit ↦ Y) = Icc 0 c := by
  have h (π : Unit → ℝ≥0) : π ∈ constraintBets (fun _ : Unit ↦ Y) ↔ (π () : ℝ) ≤ c := by
    simp only [mem_constraintBets_iff_eventually_quasiSure, hq, Filter.eventually_top,
      Finset.univ_unique, Finset.sum_singleton, PUnit.default_eq_unit, hY _ (π ()).coe_nonneg]
  refine Subset.antisymm (image_subset_iff.2 fun π hπ ↦ ⟨(π ()).coe_nonneg, (h π).1 hπ⟩)
    fun l hl ↦ ⟨fun _ ↦ l.toNNReal, ?_, Real.coe_toNNReal _ hl.1⟩
  rw [h, Real.coe_toNNReal _ hl.1]
  exact hl.2

/-- The slopes of the bets on the constraint `x - m`, for `0 < m`, are the `l ∈ [0, 1 / m]`. -/
private theorem image_constraintBets_meanLe (hm : 0 < m) :
    (fun (π : Unit → ℝ≥0) ↦ (π () : ℝ)) '' constraintBets (fun _ : Unit ↦ fun x : I ↦ (x : ℝ) - m) =
      Icc 0 m⁻¹ :=
  image_constraintBets_unit (meanLeNull_eq_constraintNull_range m ▸ quasiSure_meanLeNull hm)
    fun _ ↦ forall_one_add_mul_sub_nonneg_iff_le_inv hm

/-- The slopes of the bets on the constraint `m - x`, for `m < 1`, are the
`l ∈ [0, 1 / (1 - m)]`. -/
private theorem image_constraintBets_meanGe (hm : m < 1) :
    (fun (π : Unit → ℝ≥0) ↦ (π () : ℝ)) '' constraintBets (fun _ : Unit ↦ fun x : I ↦ m - (x : ℝ)) =
      Icc 0 (1 - m)⁻¹ :=
  image_constraintBets_unit (meanGeNull_eq_constraintNull_range m ▸ quasiSure_meanGeNull hm)
    fun _ ↦ forall_one_add_mul_sub_nonneg_iff_le_inv' hm

/-! ### The e-variables and the admissible e-variables -/

/-- **The e-variables for the laws on `[0, 1]` with mean at most `m`**, for `0 < m`: the
measurable functions below a bet `1 + l * (x - m)` with `l ∈ [0, 1 / m]` at every point. -/
theorem isEVar_meanLeNull_iff (hm : 0 < m) :
    IsEVar E (meanLeNull m) ↔
      Measurable E ∧ ∃ l ∈ Icc 0 m⁻¹, ∀ x, E x ≤ ENNReal.ofReal (1 + l * ((x : ℝ) - m)) := by
  have hq := quasiSure_meanLeNull hm
  rw [meanLeNull_eq_constraintNull_range] at hq ⊢
  rw [isEVar_constraintNull_iff fun _ ↦ by fun_prop, hq, ← image_constraintBets_meanLe hm,
    exists_mem_image]
  simp only [Filter.EventuallyLE, Filter.eventually_top, Finset.univ_unique,
    Finset.sum_singleton, PUnit.default_eq_unit]

/-- **The e-variables for the laws on `[0, 1]` with mean at least `m`**, for `m < 1`: the
measurable functions below a bet `1 + l * (m - x)` with `l ∈ [0, 1 / (1 - m)]` at every point. -/
theorem isEVar_meanGeNull_iff (hm : m < 1) :
    IsEVar E (meanGeNull m) ↔
      Measurable E ∧ ∃ l ∈ Icc 0 (1 - m)⁻¹, ∀ x, E x ≤ ENNReal.ofReal (1 + l * (m - (x : ℝ))) := by
  have hq := quasiSure_meanGeNull hm
  rw [meanGeNull_eq_constraintNull_range] at hq ⊢
  rw [isEVar_constraintNull_iff fun _ ↦ by fun_prop, hq, ← image_constraintBets_meanGe hm,
    exists_mem_image]
  simp only [Filter.EventuallyLE, Filter.eventually_top, Finset.univ_unique,
    Finset.sum_singleton, PUnit.default_eq_unit]

/-- **The e-variables for the laws on `[0, 1]` with mean `m`** [Cle25, Theorem 1], for
`0 < m < 1`: the measurable functions below a bet `1 + l * (x - m)` with
`l ∈ [-1 / (1 - m), 1 / m]` at every point. -/
theorem isEVar_meanEqNull_iff (hm₀ : 0 < m) (hm₁ : m < 1) :
    IsEVar E (meanEqNull m) ↔ Measurable E ∧
      ∃ l ∈ Icc (-(1 - m)⁻¹) m⁻¹, ∀ x, E x ≤ ENNReal.ofReal (1 + l * ((x : ℝ) - m)) := by
  have hq := quasiSure_meanEqNull hm₀ hm₁
  rw [meanEqNull_eq_constraintNull_range] at hq ⊢
  rw [isEVar_constraintNull_iff (measurable_meanEq m), hq, ← image_constraintBets_meanEq hm₀ hm₁,
    exists_mem_image]
  simp only [Filter.EventuallyLE, Filter.eventually_top, sum_mul_meanEq]

/-- **The admissible e-variables for the laws on `[0, 1]` with mean `m` are the bets**
[Cle25, Theorem 1], for `0 < m < 1`: the functions `1 + l * (x - m)` with
`l ∈ [-1 / (1 - m), 1 / m]`. Since every point is charged by a law of mean `m`, an admissible
e-variable is equal to a bet at every point. -/
theorem isAdmissibleEVar_meanEqNull_iff (hm₀ : 0 < m) (hm₁ : m < 1) :
    IsAdmissibleEVar E (meanEqNull m) ↔
      ∃ l ∈ Icc (-(1 - m)⁻¹) m⁻¹, E = fun x : I ↦ ENNReal.ofReal (1 + l * ((x : ℝ) - m)) := by
  have hq := quasiSure_meanEqNull hm₀ hm₁
  rw [meanEqNull_eq_constraintNull_range] at hq ⊢
  constructor
  · intro hE
    obtain ⟨π, hπ, hEπ⟩ := hE.exists_mem_constraintBets_ae_eq (measurable_meanEq m)
    rw [hq, Filter.EventuallyEq, Filter.eventually_top] at hEπ
    exact ⟨_, (mem_constraintBets_meanEq_iff hm₀ hm₁).1 hπ,
      funext fun x ↦ (hEπ x).trans (by rw [sum_mul_meanEq])⟩
  · rintro ⟨l, hl, rfl⟩
    have hπ : ![l.toNNReal, (-l).toNNReal] ∈
        constraintBets ![fun x : I ↦ (x : ℝ) - m, fun x : I ↦ m - (x : ℝ)] := by
      rwa [mem_constraintBets_meanEq_iff hm₀ hm₁, coe_toNNReal_sub_coe_toNNReal_neg]
    -- every bet is admissible: two combinations ordered at `0` and at `1` have the same slope
    have h := isAdmissibleEVar_ofReal_one_add_of_mem_constraintBets (measurable_meanEq m)
      (fun ρ ρ' hρ ↦ ?_) hπ
    · simpa only [sum_mul_meanEq, coe_toNNReal_sub_coe_toNNReal_neg] using h
    · rw [hq, Filter.eventually_top] at hρ ⊢
      simp only [sum_mul_meanEq] at hρ ⊢
      rw [eq_of_forall_mul_sub_le hm₀ hm₁ hρ]
      exact fun _ ↦ le_rfl

/-! ### The smallest relative entropies -/

/-- **The formula of Honda and Takemura** for the laws on `[0, 1]` with mean at most `m`
[HT15], for `0 < m`: the smallest relative entropy from a probability measure `Q`
on `[0, 1]` to the laws with mean at most `m` is the supremum over `l ∈ [0, 1 / m]` of
`𝔼_Q log (1 + l * (X - m))`. -/
theorem klInf_meanLeNull (hm : 0 < m) (Q : Measure I) [IsProbabilityMeasure Q] :
    klInf Q (meanLeNull m) =
      ⨆ l ∈ Icc 0 m⁻¹, ∫ᵉ x, ENNReal.log (ENNReal.ofReal (1 + l * ((x : ℝ) - m))) ∂Q := by
  rw [meanLeNull_eq_constraintNull_range, klInf_constraintNull_eq_iSup_eintegral_log
    (fun _ ↦ by fun_prop) Q
    fun _ ↦ by exact ((integrable_coe Q).sub (integrable_const m)).posLog,
    ← image_constraintBets_meanLe hm, iSup_image]
  simp only [Finset.univ_unique, Finset.sum_singleton, PUnit.default_eq_unit]

/-- **The formula of Honda and Takemura** for the laws on `[0, 1]` with mean at least `m`
[HT15], for `m < 1`: the smallest relative entropy from a probability measure `Q`
on `[0, 1]` to the laws with mean at least `m` is the supremum over `l ∈ [0, 1 / (1 - m)]` of
`𝔼_Q log (1 + l * (m - X))`. -/
theorem klInf_meanGeNull (hm : m < 1) (Q : Measure I) [IsProbabilityMeasure Q] :
    klInf Q (meanGeNull m) =
      ⨆ l ∈ Icc 0 (1 - m)⁻¹, ∫ᵉ x, ENNReal.log (ENNReal.ofReal (1 + l * (m - (x : ℝ)))) ∂Q := by
  rw [meanGeNull_eq_constraintNull_range, klInf_constraintNull_eq_iSup_eintegral_log
    (fun _ ↦ by fun_prop) Q
    fun _ ↦ by exact ((integrable_const m).sub (integrable_coe Q)).posLog,
    ← image_constraintBets_meanGe hm, iSup_image]
  simp only [Finset.univ_unique, Finset.sum_singleton, PUnit.default_eq_unit]

/-- The smallest relative entropy from a probability measure `Q` on `[0, 1]` to the laws with mean
`m`, for `0 < m < 1`: the supremum over `l ∈ [-1 / (1 - m), 1 / m]` of
`𝔼_Q log (1 + l * (X - m))`. -/
theorem klInf_meanEqNull (hm₀ : 0 < m) (hm₁ : m < 1) (Q : Measure I) [IsProbabilityMeasure Q] :
    klInf Q (meanEqNull m) =
      ⨆ l ∈ Icc (-(1 - m)⁻¹) m⁻¹,
        ∫ᵉ x, ENNReal.log (ENNReal.ofReal (1 + l * ((x : ℝ) - m))) ∂Q := by
  rw [meanEqNull_eq_constraintNull_range, klInf_constraintNull_eq_iSup_eintegral_log
    (measurable_meanEq m) Q (Fin.forall_fin_two.2
      ⟨((integrable_coe Q).sub (integrable_const m)).posLog,
        ((integrable_const m).sub (integrable_coe Q)).posLog⟩),
    ← image_constraintBets_meanEq hm₀ hm₁, iSup_image]
  simp only [sum_mul_meanEq]

end ProbabilityTheory
