/-!
# Sequential constraint nulls and betting against them

Let `X k : Ω → 𝓧` be observations, `X k` being `ℱ (k + 1)`-measurable for a filtration `ℱ`, and
let `Φ` be a set of real functions on `𝓧`, the constraints. The sequential constraint null
`ProbabilityTheory.sequentialConstraintNull Φ X ℱ` is the set of probability measures under which,
for every constraint `f ∈ Φ` and every round `k`, `f (X k)` is integrable and has a nonpositive
conditional expectation given `ℱ k`, in the set-integral form
`∫ ω in s, f (X k ω) ∂P ≤ 0` for every `ℱ k`-measurable `s`. It is the sequential form of the null
`ProbabilityTheory.constraintNull Φ` generated by `Φ`: the law of every observation under a member
lies in `constraintNull Φ`, and conversely the law of a sequence whose observations are each
independent of the past, with laws in `constraintNull Φ`, is a member. The observations need not be
independent or identically distributed, and the null need not be dominated.

For finitely many constraints `g i`, a gambler who bets at round `k` the weights `π k`, chosen from
the past (`ℱ k`-measurable), multiplies the wealth by `1 + ∑ i, π k i * g i (X k)`. When these
factors are almost surely nonnegative under every member of the null, which holds as soon as each
`π k` is a bet on the constraints (`ProbabilityTheory.constraintBets g`), the wealth
`∏ k < n, (1 + ∑ i, π k i * g i (X k))` is a test supermartingale for the null, as a case of the
products of conditional e-variables (`ProbabilityTheory.isTestSupermartingale_prod`)
[Cle26b; WSR24; RW, §7.6]. For equality constraints, the null of `g i ≤ 0` and `-g i ≤ 0`, the
weights may have any sign and the wealth is a test martingale.

The bets need not be bounded, and the factors need not be integrable: the proof truncates the bets
on the `ℱ k`-measurable sets where they are bounded and passes to the limit by monotone
convergence.

## Main definitions

* `ProbabilityTheory.sequentialConstraintNull Φ X ℱ`: the sequential null generated by `Φ`.

## Main statements

* `ProbabilityTheory.setIntegral_eq_zero_of_mem_sequentialConstraintNull`: for constraints `f` and
  `-f`, the conditional means are zero.
* `ProbabilityTheory.map_mem_constraintNull_of_mem_sequentialConstraintNull`: the law of an
  observation under a member of the sequential null lies in the null generated by `Φ`.
* `ProbabilityTheory.mem_sequentialConstraintNull_of_indep`,
  `ProbabilityTheory.infinitePi_mem_sequentialConstraintNull`: the law of observations that are
  each independent of the past, with laws in the null generated by `Φ`, is a member; in
  particular the law of a sequence of independent observations with such laws.
* `ProbabilityTheory.isCondEVar_ofReal_one_add_sum_mul`,
  `ProbabilityTheory.isExactCondEVar_ofReal_one_add_sum_mul`: one round of betting on variables
  with nonpositive, or zero, conditional means.
* `ProbabilityTheory.ae_nonneg_one_add_sum_mul_of_mem_constraintBets`: a bet on the constraints
  keeps the wealth nonnegative almost surely under every member of the sequential null.
* `ProbabilityTheory.isTestSupermartingale_prod_ofReal_one_add_sum_mul`,
  `ProbabilityTheory.isTestSupermartingale_prod_of_mem_constraintBets`: the betting wealth is a
  test supermartingale for the sequential constraint null.
* `ProbabilityTheory.isTestMartingale_prod_ofReal_one_add_sum_mul`: for equality constraints, the
  betting wealth is a test martingale.

## References

* [Cle26b] E. Clerico, *Sequential testing of conditionally constrained hypotheses*,
  arXiv:2606.06769v2.
* [RW] A. Ramdas and R. Wang, *Hypothesis Testing with E-values*, Foundations and Trends in
  Statistics 1 (2025), arXiv:2410.23614v6.
* [WSR24] I. Waudby-Smith and A. Ramdas, *Estimating means of bounded random variables by
  betting*, J. R. Stat. Soc. Ser. B 86 (2024), arXiv:2010.09686v7.
-/

public section

open MeasureTheory Set LMLExplore
open scoped ENNReal NNReal

namespace ProbabilityTheory

variable {Ω 𝓧 ι : Type*} {m mΩ : MeasurableSpace Ω} {ℱ : Filtration ℕ mΩ}
  {X : ℕ → Ω → 𝓧} {Φ Ψ : Set (𝓧 → ℝ)} {S : Set (Measure Ω)} {P : Measure Ω} {f : 𝓧 → ℝ}

/-! ### The sequential constraint null -/

/-- The **sequential null generated by a set `Φ` of constraints** on the observations `X k`: the
probability measures under which, for every `f ∈ Φ` and every `k`, `f (X k)` is integrable with a
nonpositive conditional expectation given `ℱ k`, in the form `∫ ω in s, f (X k ω) ∂P ≤ 0` for every
`ℱ k`-measurable `s`. -/
def sequentialConstraintNull (Φ : Set (𝓧 → ℝ)) (X : ℕ → Ω → 𝓧) (ℱ : Filtration ℕ mΩ) :
    Set (Measure Ω) :=
  {P | IsProbabilityMeasure P ∧ ∀ f ∈ Φ, ∀ k, Integrable (fun ω ↦ f (X k ω)) P ∧
    ∀ s, MeasurableSet[ℱ k] s → ∫ ω in s, f (X k ω) ∂P ≤ 0}

/-- Membership in the sequential null generated by constraints. -/
theorem mem_sequentialConstraintNull_iff :
    P ∈ sequentialConstraintNull Φ X ℱ ↔ IsProbabilityMeasure P ∧ ∀ f ∈ Φ, ∀ k,
      Integrable (fun ω ↦ f (X k ω)) P ∧ ∀ s, MeasurableSet[ℱ k] s → ∫ ω in s, f (X k ω) ∂P ≤ 0 :=
  Iff.rfl

/-- The members of the sequential null generated by constraints are probability measures. -/
theorem isProbabilityMeasure_of_mem_sequentialConstraintNull
    (hP : P ∈ sequentialConstraintNull Φ X ℱ) : IsProbabilityMeasure P :=
  hP.1

/-- The members of the sequential null integrate the constraints of every observation. -/
theorem integrable_of_mem_sequentialConstraintNull (hP : P ∈ sequentialConstraintNull Φ X ℱ)
    (hf : f ∈ Φ) (k : ℕ) : Integrable (fun ω ↦ f (X k ω)) P :=
  (hP.2 f hf k).1

/-- Under a member of the sequential null, the constraint of an observation has a nonpositive
integral over every set measurable for the past. -/
theorem setIntegral_nonpos_of_mem_sequentialConstraintNull
    (hP : P ∈ sequentialConstraintNull Φ X ℱ) (hf : f ∈ Φ) {k : ℕ} {s : Set Ω}
    (hs : MeasurableSet[ℱ k] s) : ∫ ω in s, f (X k ω) ∂P ≤ 0 :=
  (hP.2 f hf k).2 s hs

/-- **Equality constraints.** Under a member of the sequential null of constraints containing `f`
and `-f`, the constraint of an observation has a zero integral over every set measurable for the
past. -/
theorem setIntegral_eq_zero_of_mem_sequentialConstraintNull
    (hP : P ∈ sequentialConstraintNull Φ X ℱ) (hf : f ∈ Φ) (hf' : -f ∈ Φ) {k : ℕ} {s : Set Ω}
    (hs : MeasurableSet[ℱ k] s) : ∫ ω in s, f (X k ω) ∂P = 0 :=
  le_antisymm (setIntegral_nonpos_of_mem_sequentialConstraintNull hP hf hs) (by
    simpa [integral_neg] using setIntegral_nonpos_of_mem_sequentialConstraintNull hP hf' hs)

/-- The sequential null shrinks as constraints are added. -/
@[gcongr]
theorem sequentialConstraintNull_anti (h : Φ ⊆ Ψ) :
    sequentialConstraintNull Ψ X ℱ ⊆ sequentialConstraintNull Φ X ℱ :=
  fun _ hP ↦ ⟨hP.1, fun f hf ↦ hP.2 f (h hf)⟩

/-- Without constraints, the sequential null is the set of all probability measures. -/
@[simp]
theorem sequentialConstraintNull_empty :
    sequentialConstraintNull (∅ : Set (𝓧 → ℝ)) X ℱ = {P : Measure Ω | IsProbabilityMeasure P} := by
  ext P
  simp [mem_sequentialConstraintNull_iff]

/-- The sequential null generated by a union of constraint sets is the intersection of the
nulls. -/
theorem sequentialConstraintNull_union :
    sequentialConstraintNull (Φ ∪ Ψ) X ℱ =
      sequentialConstraintNull Φ X ℱ ∩ sequentialConstraintNull Ψ X ℱ := by
  ext P
  exact ⟨fun h ↦ ⟨⟨h.1, fun f hf ↦ h.2 f (.inl hf)⟩, ⟨h.1, fun f hf ↦ h.2 f (.inr hf)⟩⟩,
    fun h ↦ ⟨h.1.1, fun f hf ↦ hf.elim (h.1.2 f) (h.2.2 f)⟩⟩

variable [MeasurableSpace 𝓧]

/-- **The laws of the observations.** For measurable constraints, the law of an observation under
a member of the sequential null lies in the null generated by the constraints. -/
theorem map_mem_constraintNull_of_mem_sequentialConstraintNull (hΦ : ∀ f ∈ Φ, Measurable f)
    (hP : P ∈ sequentialConstraintNull Φ X ℱ) {k : ℕ} (hX : AEMeasurable (X k) P) :
    P.map (X k) ∈ constraintNull Φ := by
  have := isProbabilityMeasure_of_mem_sequentialConstraintNull hP
  refine mem_constraintNull_iff.2 ⟨inferInstance, fun f hf ↦ ⟨?_, ?_⟩⟩
  · exact (integrable_map_measure (hΦ f hf).aestronglyMeasurable hX).2
      (integrable_of_mem_sequentialConstraintNull hP hf k)
  · rw [integral_map hX (hΦ f hf).aestronglyMeasurable, ← setIntegral_univ]
    exact setIntegral_nonpos_of_mem_sequentialConstraintNull hP hf MeasurableSet.univ

/-- **Independent observations.** For measurable constraints, a probability measure under which
every observation `X k` is independent of the past `ℱ k`, with a law in the null generated by the
constraints, belongs to the sequential null. This contains the laws of independent sequences, and
of i.i.d. sequences, with laws in the null. -/
theorem mem_sequentialConstraintNull_of_indep [IsProbabilityMeasure P]
    (hΦ : ∀ f ∈ Φ, Measurable f) (hX : ∀ k, Measurable (X k))
    (hind : ∀ k, Indep (MeasurableSpace.comap (X k) inferInstance) (ℱ k) P)
    (hmap : ∀ k, P.map (X k) ∈ constraintNull Φ) :
    P ∈ sequentialConstraintNull Φ X ℱ := by
  refine ⟨inferInstance, fun f hf k ↦ ?_⟩
  have hint : Integrable (fun ω ↦ f (X k ω)) P :=
    (integrable_map_measure (hΦ f hf).aestronglyMeasurable (hX k).aemeasurable).1
      (integrable_of_mem_constraintNull (hmap k) hf)
  refine ⟨hint, fun s hs ↦ ?_⟩
  have hcond := condExp_indep_eq (f := fun ω ↦ f (X k ω)) (hX k).comap_le
    (ℱ.le k) ((hΦ f hf).comp (comap_measurable (X k))).stronglyMeasurable (hind k)
  rw [← setIntegral_condExp (ℱ.le k) hint hs, setIntegral_congr_ae (ℱ.le k s hs)
    (hcond.mono fun ω hω _ ↦ hω), setIntegral_const, smul_eq_mul]
  refine mul_nonpos_of_nonneg_of_nonpos measureReal_nonneg ?_
  rw [← integral_map (hX k).aemeasurable (hΦ f hf).aestronglyMeasurable]
  exact integral_nonpos_of_mem_constraintNull (hmap k) hf

/-- **Independent sequences.** For measurable constraints, the law `Measure.infinitePi μ` of a
sequence of independent observations on `ℕ → 𝓧` with laws `μ k` in the null generated by the
constraints belongs to the sequential null of the coordinates and the filtration of the strict
past `Filtration.naturalLT`. With `μ k = μ₀` for every `k`, this contains the i.i.d. laws. -/
theorem infinitePi_mem_sequentialConstraintNull (hΦ : ∀ f ∈ Φ, Measurable f)
    {μ : ℕ → Measure 𝓧} [∀ k, IsProbabilityMeasure (μ k)] (hμ : ∀ k, μ k ∈ constraintNull Φ) :
    Measure.infinitePi μ ∈ sequentialConstraintNull Φ (fun k (ω : ℕ → 𝓧) ↦ ω k)
      (Filtration.naturalLT (fun k (ω : ℕ → 𝓧) ↦ ω k) measurable_pi_apply) :=
  mem_sequentialConstraintNull_of_indep hΦ measurable_pi_apply
    (Filtration.indep_naturalLT_infinitePi μ) fun k ↦
      (Measure.infinitePi_map_eval μ k).symm ▸ hμ k

/-! ### One round of betting -/

/-- The sets on which bets `w` are bounded by `N`, in the sum of their absolute values. -/
private theorem measurableSet_sum_abs_le [Fintype ι] {w : Ω → ι → ℝ}
    (hw : ∀ i, Measurable[m] fun ω ↦ w ω i) (N : ℕ) :
    MeasurableSet[m] {ω | ∑ i, |w ω i| ≤ N} :=
  (Finset.measurable_sum _ fun i _ ↦ (continuous_abs.measurable.comp (hw i))) measurableSet_Iic

/-- The sets on which the bets are bounded by `N` increase with `N`. -/
private theorem monotone_inter_sum_abs_le [Fintype ι] (s : Set Ω) (w : Ω → ι → ℝ) :
    Monotone fun N : ℕ ↦ s ∩ {ω | ∑ i, |w ω i| ≤ N} := fun _ _ hN ↦
  inter_subset_inter_right s (ofPred_subset_ofPred.2 fun _ hω ↦ hω.trans (by exact_mod_cast hN))

/-- The sets on which the bets are bounded by `N` exhaust `s`. -/
private theorem iUnion_inter_sum_abs_le [Fintype ι] (s : Set Ω) (w : Ω → ι → ℝ) :
    ⋃ N : ℕ, s ∩ {ω | ∑ i, |w ω i| ≤ N} = s := by
  rw [← inter_iUnion, iUnion_eq_univ_iff.2 fun ω ↦ exists_nat_ge (∑ i, |w ω i|), inter_univ]

/-- The products of the truncated bets with the variables are integrable. -/
private theorem integrable_indicator_mul [Fintype ι] (hm : m ≤ mΩ) {Y : Ω → ℝ}
    (hY : Integrable Y P) {w : Ω → ι → ℝ} (hw : ∀ i, Measurable[m] fun ω ↦ w ω i) (i : ι)
    {s : Set Ω} (hs : MeasurableSet[m] s) (N : ℕ) :
    Integrable (fun ω ↦ (s ∩ {ω | ∑ i, |w ω i| ≤ N}).indicator (fun ω ↦ w ω i) ω * Y ω) P := by
  refine hY.bdd_mul (c := N) (((hw i).indicator (hs.inter (measurableSet_sum_abs_le hw N))).mono
    hm le_rfl).aestronglyMeasurable (ae_of_all _ fun ω ↦ ?_)
  by_cases hω : ω ∈ s ∩ {ω | ∑ i, |w ω i| ≤ N}
  · rw [indicator_of_mem hω, Real.norm_eq_abs]
    exact (Finset.single_le_sum (f := fun i ↦ |w ω i|) (fun _ _ ↦ abs_nonneg _)
      (Finset.mem_univ i)).trans hω.2
  · simp [indicator_of_notMem hω]

/-- The expectation of a factor `1 + ∑ i, w i * Y i` over a set of the past, as the limit of its
expectations where the bets are bounded. -/
private theorem setLIntegral_ofReal_one_add_sum_mul [Fintype ι] (hm : m ≤ mΩ) [IsFiniteMeasure P]
    {Y : ι → Ω → ℝ} (hY : ∀ i, Integrable (Y i) P) {w : Ω → ι → ℝ}
    (hw : ∀ i, Measurable[m] fun ω ↦ w ω i) (hpos : ∀ᵐ ω ∂P, 0 ≤ 1 + ∑ i, w ω i * Y i ω)
    {s : Set Ω} (hs : MeasurableSet[m] s) :
    ∫⁻ ω in s, ENNReal.ofReal (1 + ∑ i, w ω i * Y i ω) ∂P =
      ⨆ N : ℕ, ENNReal.ofReal (P.real (s ∩ {ω | ∑ i, |w ω i| ≤ N}) +
        ∑ i, ∫ ω, (s ∩ {ω | ∑ i, |w ω i| ≤ N}).indicator (fun ω ↦ w ω i) ω * Y i ω ∂P) := by
  conv_lhs => rw [← iUnion_inter_sum_abs_le s w]
  rw [setLIntegral_iUnion_of_directed _ (monotone_inter_sum_abs_le s w).directed_le]
  refine iSup_congr fun N ↦ ?_
  have hA : MeasurableSet (s ∩ {ω | ∑ i, |w ω i| ≤ N}) :=
    hm _ (hs.inter (measurableSet_sum_abs_le hw N))
  -- on the set where the bets are bounded by `N`, every product `w i * Y i` is integrable
  have hint : ∀ i, IntegrableOn (fun ω ↦ w ω i * Y i ω) (s ∩ {ω | ∑ i, |w ω i| ≤ N}) P := by
    intro i
    have h := integrable_indicator_mul hm (hY i) hw i hs N
    simp_rw [← indicator_mul_left] at h
    exact (integrable_indicator_iff hA).1 h
  have hint' : IntegrableOn (fun ω ↦ 1 + ∑ i, w ω i * Y i ω) (s ∩ {ω | ∑ i, |w ω i| ≤ N}) P :=
    (integrable_const 1).add (integrable_finsetSum _ fun i _ ↦ hint i)
  rw [← ofReal_integral_eq_lintegral_ofReal hint' (ae_restrict_of_ae hpos),
    integral_add (integrable_const 1) (integrable_finsetSum _ fun i _ ↦ hint i),
    integral_finsetSum _ fun i _ ↦ hint i, setIntegral_const, smul_eq_mul, mul_one]
  simp_rw [← indicator_mul_left, integral_indicator hA]

/-- **One round of betting on variables with nonpositive conditional means.** Let `Y i` be
measurable variables that are integrable with a nonpositive conditional expectation given `m`
under every member of a null of finite measures, and let `w i ≥ 0` be `m`-measurable weights such
that `1 + ∑ i, w i * Y i` is almost surely nonnegative under every member. Then
`1 + ∑ i, w i * Y i` is a conditional e-variable given `m`. The weights need not be bounded. -/
theorem isCondEVar_ofReal_one_add_sum_mul [Fintype ι] (hm : m ≤ mΩ)
    (hS : ∀ P ∈ S, IsFiniteMeasure P) {Y : ι → Ω → ℝ} (hY_meas : ∀ i, Measurable (Y i))
    (hY : ∀ P ∈ S, ∀ i, Integrable (Y i) P)
    (hY_le : ∀ P ∈ S, ∀ i s, MeasurableSet[m] s → ∫ ω in s, Y i ω ∂P ≤ 0) {w : Ω → ι → ℝ}
    (hw : ∀ i, Measurable[m] fun ω ↦ w ω i) (hw_nonneg : ∀ ω i, 0 ≤ w ω i)
    (hpos : ∀ P ∈ S, ∀ᵐ ω ∂P, 0 ≤ 1 + ∑ i, w ω i * Y i ω) :
    IsCondEVar (fun ω ↦ ENNReal.ofReal (1 + ∑ i, w ω i * Y i ω)) m S := by
  refine ⟨by have := fun i ↦ (hw i).mono hm le_rfl; fun_prop, fun P hP s hs ↦ ?_⟩
  have := hS P hP
  rw [setLIntegral_ofReal_one_add_sum_mul hm (hY P hP) hw (hpos P hP) hs]
  refine iSup_le fun N ↦ ?_
  have hA := hs.inter (measurableSet_sum_abs_le hw N)
  calc ENNReal.ofReal (P.real (s ∩ {ω | ∑ i, |w ω i| ≤ N}) +
        ∑ i, ∫ ω, (s ∩ {ω | ∑ i, |w ω i| ≤ N}).indicator (fun ω ↦ w ω i) ω * Y i ω ∂P)
      ≤ ENNReal.ofReal (P.real (s ∩ {ω | ∑ i, |w ω i| ≤ N})) := by
        refine ENNReal.ofReal_le_ofReal (add_le_of_nonpos_right (Finset.sum_nonpos fun i _ ↦ ?_))
        exact integral_mul_nonpos_of_forall_setIntegral_nonpos hm (hY P hP i) (hY_le P hP i)
          ((hw i).indicator hA).stronglyMeasurable
          (ae_of_all _ fun ω ↦ indicator_nonneg (fun ω _ ↦ hw_nonneg ω i) ω)
          (integrable_indicator_mul hm (hY P hP i) hw i hs N)
    _ = P (s ∩ {ω | ∑ i, |w ω i| ≤ N}) := ofReal_measureReal
    _ ≤ P s := measure_mono inter_subset_left

/-- **One round of betting on variables with zero conditional means.** Let `Y i` be measurable
variables that are integrable with a zero conditional expectation given `m` under every member of
a null of finite measures, and let `w i` be `m`-measurable weights, of any sign, such that
`1 + ∑ i, w i * Y i` is almost surely nonnegative under every member. Then
`1 + ∑ i, w i * Y i` is an exact conditional e-variable given `m`. -/
theorem isExactCondEVar_ofReal_one_add_sum_mul [Fintype ι] (hm : m ≤ mΩ)
    (hS : ∀ P ∈ S, IsFiniteMeasure P) {Y : ι → Ω → ℝ} (hY_meas : ∀ i, Measurable (Y i))
    (hY : ∀ P ∈ S, ∀ i, Integrable (Y i) P)
    (hY_eq : ∀ P ∈ S, ∀ i s, MeasurableSet[m] s → ∫ ω in s, Y i ω ∂P = 0) {w : Ω → ι → ℝ}
    (hw : ∀ i, Measurable[m] fun ω ↦ w ω i)
    (hpos : ∀ P ∈ S, ∀ᵐ ω ∂P, 0 ≤ 1 + ∑ i, w ω i * Y i ω) :
    IsExactCondEVar (fun ω ↦ ENNReal.ofReal (1 + ∑ i, w ω i * Y i ω)) m S := by
  refine ⟨by have := fun i ↦ (hw i).mono hm le_rfl; fun_prop, fun P hP s hs ↦ ?_⟩
  have := hS P hP
  rw [setLIntegral_ofReal_one_add_sum_mul hm (hY P hP) hw (hpos P hP) hs]
  have h0 : ∀ N : ℕ, ∑ i, ∫ ω, (s ∩ {ω | ∑ i, |w ω i| ≤ N}).indicator (fun ω ↦ w ω i) ω *
      Y i ω ∂P = 0 := fun N ↦ Finset.sum_eq_zero fun i _ ↦
    integral_mul_eq_zero_of_forall_setIntegral_eq_zero hm (hY P hP i) (hY_eq P hP i)
      ((hw i).indicator (hs.inter (measurableSet_sum_abs_le hw N))).stronglyMeasurable
      (integrable_indicator_mul hm (hY P hP i) hw i hs N)
  simp only [h0, add_zero, measureReal_def, ENNReal.ofReal_toReal (measure_ne_top P _)]
  rw [← (monotone_inter_sum_abs_le s w).measure_iUnion, iUnion_inter_sum_abs_le]

/-! ### Betting against the sequential constraint null -/

variable [Fintype ι] {g : ι → 𝓧 → ℝ}

/-- **Bets keep the wealth nonnegative.** For measurable constraints `g i`, if the weights `π ω`
are bets on the constraints (`ProbabilityTheory.constraintBets g`) for every `ω`, then
`1 + ∑ i, π ω i * g i (X k)` is almost surely nonnegative under every member of the sequential
null. The weights need not be measurable. -/
theorem ae_nonneg_one_add_sum_mul_of_mem_constraintBets (hg : ∀ i, Measurable (g i))
    (hP : P ∈ sequentialConstraintNull (range g) X ℱ) {k : ℕ} (hX : Measurable (X k))
    {π : Ω → ι → ℝ≥0} (hπ : ∀ ω, π ω ∈ constraintBets g) :
    ∀ᵐ ω ∂P, 0 ≤ 1 + ∑ i, (π ω i : ℝ) * g i (X k ω) := by
  obtain ⟨Y, hY, hYμ, hYna⟩ := exists_measurableSet_noArbitrageOn hg
  have hmap := map_mem_constraintNull_of_mem_sequentialConstraintNull
    (forall_mem_range.2 hg) hP hX.aemeasurable
  have hXY : ∀ᵐ ω ∂P, X k ω ∈ Y :=
    (ae_map_iff hX.aemeasurable hY).1 (mem_ae_iff.2 (hYμ _ hmap))
  filter_upwards [hXY] with ω hω
  exact (forall_ae_iff_of_noArbitrageOn hg hYna hYμ).1 (mem_constraintBets_iff.1 (hπ ω)) (X k ω)
    hω

/-- **The betting wealth is a test supermartingale** [Cle26b; RW, §7.6]. For measurable
constraints `g i`, observations `X k` measurable for `ℱ (k + 1)` and weights `π k` measurable for
`ℱ k`, if every factor `1 + ∑ i, π k i * g i (X k)` is almost surely nonnegative under every member
of the sequential null, then the wealth `∏ k < n, (1 + ∑ i, π k i * g i (X k))` is a test
supermartingale for the null. -/
theorem isTestSupermartingale_prod_ofReal_one_add_sum_mul (hg : ∀ i, Measurable (g i))
    (hX : ∀ k, Measurable[ℱ (k + 1)] (X k)) {π : ℕ → Ω → ι → ℝ≥0}
    (hπ : ∀ k i, Measurable[ℱ k] fun ω ↦ π k ω i)
    (hpos : ∀ P ∈ sequentialConstraintNull (range g) X ℱ, ∀ k,
      ∀ᵐ ω ∂P, 0 ≤ 1 + ∑ i, (π k ω i : ℝ) * g i (X k ω)) :
    IsTestSupermartingale
      (fun n ω ↦ ∏ k ∈ Finset.range n, ENNReal.ofReal (1 + ∑ i, (π k ω i : ℝ) * g i (X k ω)))
      ℱ (sequentialConstraintNull (range g) X ℱ) := by
  refine isTestSupermartingale_prod
    (fun _ ↦ isProbabilityMeasure_of_mem_sequentialConstraintNull) (fun k ↦ ?_) fun k ↦
    isCondEVar_ofReal_one_add_sum_mul (ℱ.le k) (fun P hP ↦
      have := isProbabilityMeasure_of_mem_sequentialConstraintNull hP; inferInstance)
      (fun i ↦ (hg i).comp ((hX k).mono (ℱ.le _) le_rfl))
      (fun P hP i ↦ integrable_of_mem_sequentialConstraintNull hP (mem_range_self i) k)
      (fun P hP i s hs ↦ setIntegral_nonpos_of_mem_sequentialConstraintNull hP
        (mem_range_self i) hs)
      (fun i ↦ (hπ k i).coe_nnreal_real) (fun ω i ↦ (π k ω i).coe_nonneg) fun P hP ↦ hpos P hP k
  have := fun i ↦ ((hπ k i).mono (ℱ.mono k.le_succ) le_rfl).coe_nnreal_real
  have := fun i ↦ (hg i).comp (hX k)
  fun_prop

/-- **Betting with bets on the constraints is a test supermartingale** [Cle26b; RW, §7.6]. For
measurable constraints `g i`, observations `X k` measurable for `ℱ (k + 1)` and bets `π k`
measurable for `ℱ k` and valued in the bets on the constraints, the wealth
`∏ k < n, (1 + ∑ i, π k i * g i (X k))` is a test supermartingale for the sequential null. -/
theorem isTestSupermartingale_prod_of_mem_constraintBets (hg : ∀ i, Measurable (g i))
    (hX : ∀ k, Measurable[ℱ (k + 1)] (X k)) {π : ℕ → Ω → ι → ℝ≥0}
    (hπ : ∀ k i, Measurable[ℱ k] fun ω ↦ π k ω i) (hπg : ∀ k ω, π k ω ∈ constraintBets g) :
    IsTestSupermartingale
      (fun n ω ↦ ∏ k ∈ Finset.range n, ENNReal.ofReal (1 + ∑ i, (π k ω i : ℝ) * g i (X k ω)))
      ℱ (sequentialConstraintNull (range g) X ℱ) :=
  isTestSupermartingale_prod_ofReal_one_add_sum_mul hg hX hπ fun _ hP k ↦
    ae_nonneg_one_add_sum_mul_of_mem_constraintBets hg hP ((hX k).mono (ℱ.le _) le_rfl) (hπg k)

/-- **For equality constraints, the betting wealth is a test martingale** [WSR24; RW, §7.6]. For
measurable constraints `g i`, the sequential null of `g i ≤ 0` and `-g i ≤ 0` is that of the
conditional means `E[g i (X k) | ℱ k] = 0`. For observations `X k` measurable for `ℱ (k + 1)` and
weights `c k` of any sign measurable for `ℱ k`, if every factor `1 + ∑ i, c k i * g i (X k)` is
almost surely nonnegative under every member of this null, then the wealth
`∏ k < n, (1 + ∑ i, c k i * g i (X k))` is a test martingale for it. -/
theorem isTestMartingale_prod_ofReal_one_add_sum_mul (hg : ∀ i, Measurable (g i))
    (hX : ∀ k, Measurable[ℱ (k + 1)] (X k)) {c : ℕ → Ω → ι → ℝ}
    (hc : ∀ k i, Measurable[ℱ k] fun ω ↦ c k ω i)
    (hpos : ∀ P ∈ sequentialConstraintNull (range g ∪ range (-g)) X ℱ, ∀ k,
      ∀ᵐ ω ∂P, 0 ≤ 1 + ∑ i, c k ω i * g i (X k ω)) :
    IsTestMartingale
      (fun n ω ↦ ∏ k ∈ Finset.range n, ENNReal.ofReal (1 + ∑ i, c k ω i * g i (X k ω)))
      ℱ (sequentialConstraintNull (range g ∪ range (-g)) X ℱ) := by
  have hmem : ∀ i, g i ∈ range g ∪ range (-g) := fun i ↦ .inl (mem_range_self i)
  have hmem' : ∀ i, -g i ∈ range g ∪ range (-g) := fun i ↦ .inr ⟨i, rfl⟩
  refine isTestMartingale_prod
    (fun _ ↦ isProbabilityMeasure_of_mem_sequentialConstraintNull) (fun k ↦ ?_) fun k ↦
    isExactCondEVar_ofReal_one_add_sum_mul (ℱ.le k) (fun P hP ↦
      have := isProbabilityMeasure_of_mem_sequentialConstraintNull hP; inferInstance)
      (fun i ↦ (hg i).comp ((hX k).mono (ℱ.le _) le_rfl))
      (fun P hP i ↦ integrable_of_mem_sequentialConstraintNull hP (hmem i) k)
      (fun P hP i _ hs ↦ setIntegral_eq_zero_of_mem_sequentialConstraintNull hP (hmem i)
        (hmem' i) hs)
      (hc k) fun P hP ↦ hpos P hP k
  have := fun i ↦ (hc k i).mono (ℱ.mono k.le_succ) le_rfl
  have := fun i ↦ (hg i).comp (hX k)
  fun_prop

end ProbabilityTheory
