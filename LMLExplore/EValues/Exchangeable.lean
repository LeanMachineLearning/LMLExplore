/-!
# E-variables for exchangeability at a fixed sample size

The exchangeable probability laws on `ι → α`, for a finite type `ι` of indices, are the laws
invariant under the permutations of the coordinates: the invariant null of the action
`e ↦ e ∘ σ` of `Equiv.Perm ι` on `ι → α`, the action of `(Equiv.Perm ι)ᵈᵐᵃ`
(`ProbabilityTheory.invariantMeasuresOfMeasureUnivEq_domMulAct_perm`). Their e-variables are
therefore described by the symmetrization `x ↦ (∑ σ, X (x ∘ σ)) / #(Equiv.Perm ι)` [LRR26,
Example 5.7]:
* `X` is an e-variable exactly when `∑ σ, X (x ∘ σ) ≤ #(Equiv.Perm ι)` at every point, and an
  exact e-variable exactly when equality holds at every point;
* the e-variables are the measurable functions dominated by `1 + f - avg f` for an `f` with values
  in `[-1, ∞]` with `avg f ≤ 0`, written `u + (1 - avg u)` with `u = 1 + f`;
* for every measurable `f` with finite values, `f / avg f` with `0 / 0 = 1` is an exact e-variable.
  The conformal and soft-rank e-values of nonnegative scores are of this form.

Through Tau Ceti's `ExchangeableAt`, such an e-variable applied to the first `n` observations of
a process is an e-variable for every probability measure under which the process is exchangeable
at `n` (`ProbabilityTheory.IsEVar.comp_exchangeableAt`). Through Tau Ceti's `ExchangeableFamily`,
an e-variable (an exact e-variable) applied to a finite exchangeable family of random variables is
an e-variable (an exact e-variable) for every probability measure under which the family is
exchangeable (`ProbabilityTheory.IsEVar.comp_exchangeableFamily`,
`ProbabilityTheory.IsExactEVar.comp_exchangeableFamily`).

## Main statements

* `ProbabilityTheory.isEVar_exchangeableLaws_iff`,
  `ProbabilityTheory.isExactEVar_exchangeableLaws_iff`: the e-variables and the exact
  e-variables by the symmetrization.
* `ProbabilityTheory.isEVar_exchangeableLaws_iff_exists_le`: [LRR26, Example 5.7].
* `ProbabilityTheory.isExactEVar_exchangeableLaws_ite_div`: the normalized scores `f / avg f`.
* `ProbabilityTheory.IsEVar.comp_exchangeableAt`: the transfer to processes exchangeable at `n`.
* `ProbabilityTheory.IsEVar.comp_exchangeableFamily`,
  `ProbabilityTheory.IsExactEVar.comp_exchangeableFamily`: the transfer to exchangeable families.

## References

* [LRR26] M. Larsson, A. Ramdas and J. Ruf, *Testing hypotheses generated by constraints*, Math.
  Oper. Res. (2026), arXiv:2504.02974v5: Example 5.7.
-/

public section

open MeasureTheory Measure TauCeti.MeasureTheory TauCeti.Probability
open scoped ENNReal

namespace ProbabilityTheory

variable {ι α Ω : Type*} [MeasurableSpace α] {mΩ : MeasurableSpace Ω}

/-- **The exchangeable laws as an invariant null**: the probability measures on `ι → α` invariant
under the action `e ↦ e ∘ σ` of the permutations of the coordinates are the exchangeable
probability laws. -/
theorem invariantMeasuresOfMeasureUnivEq_domMulAct_perm :
    invariantMeasuresOfMeasureUnivEq (Equiv.Perm ι)ᵈᵐᵃ (ι → α) 1 =
      exchangeableLaws ∩ {μ : Measure (ι → α) | IsProbabilityMeasure μ} := by
  ext μ
  have hmap : SMulInvariantMeasure (Equiv.Perm ι)ᵈᵐᵃ (ι → α) μ ↔
      ∀ c : (Equiv.Perm ι)ᵈᵐᵃ, μ.map (c • ·) = μ :=
    (smulInvariantMeasure_tfae (Equiv.Perm ι)ᵈᵐᵃ μ).out 1 6
  rw [mem_invariantMeasuresOfMeasureUnivEq_iff, hmap, Set.mem_inter_iff, mem_exchangeableLaws,
    Set.mem_ofPred_eq, isProbabilityMeasure_iff, ← DomMulAct.mk.forall_congr_right]
  simp_rw [DomMulAct.mk_smul, Equiv.Perm.smul_def]

section Fintype

variable [Fintype ι] [DecidableEq ι] {X f : (ι → α) → ℝ≥0∞}

/-- **The e-variables for exchangeability**: a function is an e-variable for the exchangeable
probability laws on `ι → α` exactly when it is measurable and its sum over the permutations of the
coordinates is at most the number of permutations at every point [LRR26, Example 5.7]. -/
theorem isEVar_exchangeableLaws_iff :
    IsEVar X (exchangeableLaws ∩ {μ : Measure (ι → α) | IsProbabilityMeasure μ}) ↔
      Measurable X ∧ ∀ x : ι → α,
        ∑ σ : Equiv.Perm ι, X (fun i ↦ x (σ i)) ≤ Fintype.card (Equiv.Perm ι) := by
  rw [← invariantMeasuresOfMeasureUnivEq_domMulAct_perm, isEVar_invariantMeasures_iff_sum_le]
  simp_rw [Fintype.sum_domMulAct, DomMulAct.mk_smul, Equiv.Perm.smul_def, Fintype.card_domMulAct]

/-- **The exact e-variables for exchangeability**: a function is an exact e-variable for the
exchangeable probability laws on `ι → α` exactly when it is measurable and its sum over the
permutations of the coordinates is the number of permutations at every point. -/
theorem isExactEVar_exchangeableLaws_iff :
    IsExactEVar X (exchangeableLaws ∩ {μ : Measure (ι → α) | IsProbabilityMeasure μ}) ↔
      Measurable X ∧ ∀ x : ι → α,
        ∑ σ : Equiv.Perm ι, X (fun i ↦ x (σ i)) = Fintype.card (Equiv.Perm ι) := by
  rw [← invariantMeasuresOfMeasureUnivEq_domMulAct_perm, isExactEVar_invariantMeasures_iff_sum_eq]
  simp_rw [Fintype.sum_domMulAct, DomMulAct.mk_smul, Equiv.Perm.smul_def, Fintype.card_domMulAct]

/-- **The e-variables for exchangeability** [LRR26, Example 5.7]: a function is an e-variable for
the exchangeable probability laws on `ι → α` exactly when it is measurable and dominated by
`u + (1 - avg u)`, for a measurable `u` whose symmetrization
`avg u x = (∑ σ, u (x ∘ σ)) / #(Equiv.Perm ι)` is at most one. With `f = u - 1`, this is
`1 + f - avg f` for an `f` with values in `[-1, ∞]` with `avg f ≤ 0`. -/
theorem isEVar_exchangeableLaws_iff_exists_le :
    IsEVar X (exchangeableLaws ∩ {μ : Measure (ι → α) | IsProbabilityMeasure μ}) ↔
      Measurable X ∧ ∃ u : (ι → α) → ℝ≥0∞, Measurable u ∧
        (∀ x : ι → α,
          ∑ σ : Equiv.Perm ι, u (fun i ↦ x (σ i)) ≤ Fintype.card (Equiv.Perm ι)) ∧
        ∀ x, X x ≤ u x +
          (1 - (∑ σ : Equiv.Perm ι, u (fun i ↦ x (σ i))) / Fintype.card (Equiv.Perm ι)) := by
  rw [← invariantMeasuresOfMeasureUnivEq_domMulAct_perm,
    isEVar_invariantMeasures_iff_exists_le_sum]
  simp_rw [Fintype.sum_domMulAct, DomMulAct.mk_smul, Equiv.Perm.smul_def, Fintype.card_domMulAct]

/-- **Normalized scores are exact e-variables for exchangeability** [LRR26, Example 5.7]: for a
measurable `f` with finite values, the ratio `f / avg f` of `f` to its symmetrization
`avg f x = (∑ σ, f (x ∘ σ)) / #(Equiv.Perm ι)`, with `0 / 0 = 1`, is an exact e-variable for the
exchangeable probability laws. -/
theorem isExactEVar_exchangeableLaws_ite_div (hf : Measurable f) (hfin : ∀ x, f x ≠ ∞) :
    IsExactEVar
      (fun x ↦ if ∑ σ : Equiv.Perm ι, f (fun i ↦ x (σ i)) = 0 then 1 else
        f x / ((∑ σ : Equiv.Perm ι, f (fun i ↦ x (σ i))) / Fintype.card (Equiv.Perm ι)))
      (exchangeableLaws ∩ {μ : Measure (ι → α) | IsProbabilityMeasure μ}) := by
  have h := isExactEVar_invariantMeasures_ite_div_sum (G := (Equiv.Perm ι)ᵈᵐᵃ) hf hfin
  simp_rw [Fintype.sum_domMulAct, DomMulAct.mk_smul, Equiv.Perm.smul_def, Fintype.card_domMulAct,
    invariantMeasuresOfMeasureUnivEq_domMulAct_perm] at h
  exact h

end Fintype

/-! ### Processes exchangeable at a fixed sample size -/

/-- Under a measure for which a process is exchangeable at `n`, the law of the first `n`
coordinates is an exchangeable law. -/
theorem _root_.TauCeti.Probability.ExchangeableAt.prefixLaw_mem_exchangeableLaws {μ : Measure Ω}
    {X : ℕ → Ω → α} {n : ℕ} (h : ExchangeableAt μ X n)
    (hX : ∀ i : Fin n, AEMeasurable (X i) μ) : prefixLaw μ X n ∈ exchangeableLaws :=
  mem_exchangeableLaws.2 fun σ ↦ by
  rw [prefixLaw_def, map_blockLaw_reindex μ _ σ hX]
  exact h σ

/-- An e-variable for the exchangeable probability laws on `Fin n → α`, applied to the first `n`
coordinates of a measurable process, is an e-variable for the probability measures under which
the process is exchangeable at `n`. -/
theorem IsEVar.comp_exchangeableAt {n : ℕ} {E : (Fin n → α) → ℝ≥0∞}
    (hE : IsEVar E (exchangeableLaws ∩ {μ : Measure (Fin n → α) | IsProbabilityMeasure μ}))
    {X : ℕ → Ω → α} (hX : ∀ i : Fin n, Measurable (X i)) :
    IsEVar (fun ω ↦ E fun i : Fin n ↦ X i ω)
      {P | IsProbabilityMeasure P ∧ ExchangeableAt P X n} := by
  refine (hE.anti_set ?_).comp (Measurable.of_eval hX)
  rintro _ ⟨P, ⟨_, hP⟩, rfl⟩
  have hmem := hP.prefixLaw_mem_exchangeableLaws fun i ↦ (hX i).aemeasurable
  rw [prefixLaw_def, blockLaw_def] at hmem
  exact ⟨hmem, inferInstance⟩

/-! ### Exchangeable families -/

section Family

variable [Countable ι] {X : ι → Ω → α}

/-- An e-variable for the exchangeable probability laws on `ι → α`, applied to a family of
measurable random variables, is an e-variable for the probability measures under which the family
is exchangeable. -/
theorem IsEVar.comp_exchangeableFamily {E : (ι → α) → ℝ≥0∞}
    (hE : IsEVar E (exchangeableLaws ∩ {μ : Measure (ι → α) | IsProbabilityMeasure μ}))
    (hX : ∀ i, Measurable (X i)) :
    IsEVar (fun ω ↦ E fun i ↦ X i ω) {P | IsProbabilityMeasure P ∧ ExchangeableFamily P X} := by
  refine (hE.anti_set ?_).comp (Measurable.of_eval hX)
  rintro _ ⟨P, ⟨_, hP⟩, rfl⟩
  exact ⟨hP.map_mem_exchangeableLaws fun i ↦ (hX i).aemeasurable, inferInstance⟩

/-- An exact e-variable for the exchangeable probability laws on `ι → α`, applied to a family of
measurable random variables, is an exact e-variable for the probability measures under which the
family is exchangeable. -/
theorem IsExactEVar.comp_exchangeableFamily {E : (ι → α) → ℝ≥0∞}
    (hE : IsExactEVar E (exchangeableLaws ∩ {μ : Measure (ι → α) | IsProbabilityMeasure μ}))
    (hX : ∀ i, Measurable (X i)) :
    IsExactEVar (fun ω ↦ E fun i ↦ X i ω)
      {P | IsProbabilityMeasure P ∧ ExchangeableFamily P X} := by
  refine (hE.anti_set ?_).comp (Measurable.of_eval hX)
  rintro _ ⟨P, ⟨_, hP⟩, rfl⟩
  exact ⟨hP.map_mem_exchangeableLaws fun i ↦ (hX i).aemeasurable, inferInstance⟩

end Family

end ProbabilityTheory
