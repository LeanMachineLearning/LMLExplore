/-!
# E-variables for the invariant laws of a group action

For a group `G` acting measurably on `Ω`, the invariant null is the set of `G`-invariant
probability measures on `Ω`, Tau Ceti's `invariantMeasuresOfMeasureUnivEq G Ω 1`. For a
probability measure `η` on `G`, such as the Haar probability measure of a compact group or the
uniform measure on a finite group, its e-variables are described by the orbit average
`avg X = orbitAverage η X`, the average of `X` over the orbits:
* for a left-invariant `η`, `X` is an e-variable exactly when `avg X ≤ 1` everywhere, and an
  exact e-variable exactly when `avg X = 1` everywhere;
* for a left-invariant `η`, the e-variables are the measurable functions dominated by an exact
  e-variable `1 + f - avg f`, for an `f` with values in `[-1, ∞]` whose orbit average is
  nonpositive [LRR26, Theorem 5.5];
* for a right-invariant `η` and every measurable `f ≥ 0`, the ratio `f / avg f` with `0 / 0 = 1`
  is an e-variable, exact when `avg f` is finite everywhere [LRR26, Example 5.7].

In `ℝ≥0∞` the function `1 + f` is a function `u ≥ 0` with `avg u ≤ 1`, and `1 + f - avg f` is
`u + (1 - avg u)`, the form in which the statements are made. For a finite group the orbit
average is `(∑ g, X (g • x)) / #G`: the statements for finite groups need no measurable structure
on `G`.
The exchangeable laws are the case of the permutations of the coordinates
(`LMLExplore/EValues/Exchangeable.lean`).

## Main statements

* `ProbabilityTheory.isEVar_invariantMeasures_iff`: `X` is an e-variable exactly when it is
  measurable with `avg X ≤ 1`, and `ProbabilityTheory.isExactEVar_invariantMeasures_iff`: exact
  exactly when `avg X = 1`.
* `ProbabilityTheory.isExactEVar_invariantMeasures_add_one_sub` and
  `ProbabilityTheory.isEVar_invariantMeasures_iff_exists_le`: [LRR26, Theorem 5.5].
* `ProbabilityTheory.isEVar_invariantMeasures_ite_div` and
  `ProbabilityTheory.isExactEVar_invariantMeasures_ite_div`: the normalized functions `f / avg f`.
* `ProbabilityTheory.isEVar_invariantMeasures_iff_sum_le` and
  `ProbabilityTheory.isExactEVar_invariantMeasures_iff_sum_eq`: for a finite group,
  `∑ g, X (g • x) ≤ #G`, respectively `= #G`, at every point.

## Implementation notes

[LRR26] state the theorem for a compact group with its Haar probability measure. Here `η` is any
probability measure on `G`, left-invariant where the orbits' uniform laws `η.map (· • x)` must be
invariant, and right-invariant where the orbit average must be constant on the orbits; no topology
on `G` is used. The action is jointly measurable (`MeasurableSMul₂`), which makes orbit averages
measurable.

## References

* [LRR26] M. Larsson, A. Ramdas and J. Ruf, *Testing hypotheses generated by constraints*, Math.
  Oper. Res. (2026), arXiv:2504.02974v5: Lemma 5.4, Theorem 5.5 and Example 5.7.
-/

public section

open MeasureTheory Measure TauCeti.MeasureTheory
open scoped ENNReal

namespace ProbabilityTheory

variable {G Ω : Type*} [Group G] {mΩ : MeasurableSpace Ω} [MulAction G Ω] {X f : Ω → ℝ≥0∞}

/-- A member of the invariant null is a probability measure. -/
private lemma isProbabilityMeasure_of_mem_invariantMeasures {μ : Measure Ω}
    (hμ : μ ∈ invariantMeasuresOfMeasureUnivEq G Ω 1) : IsProbabilityMeasure μ :=
  ⟨(mem_invariantMeasuresOfMeasureUnivEq_iff.1 hμ).2⟩

section OrbitAverage

variable [MeasurableSpace G] [MeasurableSMul₂ G Ω] {η : Measure G}
  [IsProbabilityMeasure η]

/-- Against an invariant probability measure, a measurable function and its orbit average have
the same integral. -/
private lemma lintegral_orbitAverage_of_mem {μ : Measure Ω}
    (hμ : μ ∈ invariantMeasuresOfMeasureUnivEq G Ω 1) (hX : Measurable X) :
    ∫⁻ x, orbitAverage η X x ∂μ = ∫⁻ x, X x ∂μ := by
  have := (mem_invariantMeasuresOfMeasureUnivEq_iff.1 hμ).1
  have := isProbabilityMeasure_of_mem_invariantMeasures hμ
  simp [lintegral_orbitAverage hX]

/-- For a left-invariant `η`, the image `η.map (· • x)` of `η` on the orbit of `x` belongs to the
invariant null. -/
private lemma map_smul_const_mem [MeasurableMul G] [η.IsMulLeftInvariant] (x : Ω) :
    η.map (· • x) ∈ invariantMeasuresOfMeasureUnivEq G Ω 1 :=
  mem_invariantMeasuresOfMeasureUnivEq_iff.2 ⟨smulInvariantMeasure_map_smul_const x, measure_univ⟩

/-- A measurable function whose orbit average is at most one is an e-variable for the invariant
null. -/
theorem isEVar_invariantMeasures_of_orbitAverage_le_one (hX : Measurable X)
    (h : orbitAverage η X ≤ 1) : IsEVar X (invariantMeasuresOfMeasureUnivEq G Ω 1) where
  measurable := hX
  lintegral_le_one μ hμ := by
    have := isProbabilityMeasure_of_mem_invariantMeasures hμ
    rw [← lintegral_orbitAverage_of_mem (η := η) hμ hX]
    exact (lintegral_mono h).trans_eq (by simp)

/-- For a left-invariant `η`, the orbit average of an e-variable for the invariant null is at most
one: it is the expectation of the e-variable under the uniform law `η.map (· • x)` on an orbit. -/
theorem IsEVar.orbitAverage_le_one [MeasurableMul G] [η.IsMulLeftInvariant]
    (hX : IsEVar X (invariantMeasuresOfMeasureUnivEq G Ω 1)) : orbitAverage η X ≤ 1 := fun x ↦ by
  rw [← lintegral_map_smul_const hX.measurable]
  exact hX.lintegral_le_one (map_smul_const_mem x)

/-- **The e-variables for the invariant null**: for a left-invariant probability measure `η` on
`G`, a function is an e-variable for the invariant laws exactly when it is measurable and its
orbit average is at most one everywhere. -/
theorem isEVar_invariantMeasures_iff [MeasurableMul G] [η.IsMulLeftInvariant] :
    IsEVar X (invariantMeasuresOfMeasureUnivEq G Ω 1) ↔
      Measurable X ∧ orbitAverage η X ≤ 1 :=
  ⟨fun hX ↦ ⟨hX.measurable, hX.orbitAverage_le_one⟩,
    fun h ↦ isEVar_invariantMeasures_of_orbitAverage_le_one h.1 h.2⟩

/-- A measurable function whose orbit average is one is an exact e-variable for the invariant
null. -/
theorem isExactEVar_invariantMeasures_of_orbitAverage_eq_one (hX : Measurable X)
    (h : orbitAverage η X = 1) : IsExactEVar X (invariantMeasuresOfMeasureUnivEq G Ω 1) :=
  .of_lintegral_eq_one hX fun μ hμ ↦ by
    have := isProbabilityMeasure_of_mem_invariantMeasures hμ
    rw [← lintegral_orbitAverage_of_mem (η := η) hμ hX, h]
    simp

/-- **The exact e-variables for the invariant null**: for a left-invariant probability measure
`η` on `G`, a function is an exact e-variable for the invariant laws exactly when it is measurable
and its orbit average is one everywhere. -/
theorem isExactEVar_invariantMeasures_iff [MeasurableMul G] [η.IsMulLeftInvariant] :
    IsExactEVar X (invariantMeasuresOfMeasureUnivEq G Ω 1) ↔
      Measurable X ∧ orbitAverage η X = 1 := by
  refine ⟨fun hX ↦ ⟨hX.measurable, funext fun x ↦ ?_⟩,
    fun h ↦ isExactEVar_invariantMeasures_of_orbitAverage_eq_one h.1 h.2⟩
  rw [← lintegral_map_smul_const hX.measurable]
  exact hX.lintegral_eq_one (map_smul_const_mem x)

/-- **The exact e-variables `1 + f - avg f`** [LRR26, Theorem 5.5]: for a measurable `u ≥ 0`
whose orbit average `avg u` is at most one, `u + (1 - avg u)` is an exact e-variable for the
invariant null. With `f = u - 1`, a function with values in `[-1, ∞]` whose orbit average
`avg f = avg u - 1` is nonpositive, it is `1 + f - avg f`. -/
theorem isExactEVar_invariantMeasures_add_one_sub {u : Ω → ℝ≥0∞} (hu : Measurable u)
    (h : orbitAverage η u ≤ 1) :
    IsExactEVar (fun x ↦ u x + (1 - orbitAverage η u x))
      (invariantMeasuresOfMeasureUnivEq G Ω 1) := by
  have hu' := hu.orbitAverage (η := η)
  refine .of_lintegral_eq_one (hu.add (measurable_const.sub hu')) fun μ hμ ↦ ?_
  have := isProbabilityMeasure_of_mem_invariantMeasures hμ
  have hle : ∫⁻ x, orbitAverage η u x ∂μ ≤ 1 := (lintegral_mono h).trans_eq (by simp)
  have hsub : ∫⁻ x, (1 - orbitAverage η u x) ∂μ = 1 - ∫⁻ x, orbitAverage η u x ∂μ := by
    simpa using lintegral_sub (μ := μ) (f := fun _ ↦ 1) hu'
      (ne_top_of_le_ne_top ENNReal.one_ne_top hle) (.of_forall h)
  rw [lintegral_add_left hu, hsub, lintegral_orbitAverage_of_mem (η := η) hμ hu]
  rw [lintegral_orbitAverage_of_mem (η := η) hμ hu] at hle
  simpa using add_tsub_cancel_of_le hle

/-- **The e-variables for the invariant null** [LRR26, Theorem 5.5]: for a left-invariant
probability measure `η` on `G`, a function is an e-variable for the invariant laws exactly when it
is measurable and dominated by an exact e-variable `u + (1 - avg u)` with `u` measurable and
`avg u ≤ 1`, that is, by `1 + f - avg f` for an `f` with values in `[-1, ∞]` with `avg f ≤ 0`. -/
theorem isEVar_invariantMeasures_iff_exists_le [MeasurableMul G] [η.IsMulLeftInvariant] :
    IsEVar X (invariantMeasuresOfMeasureUnivEq G Ω 1) ↔
      Measurable X ∧ ∃ u : Ω → ℝ≥0∞, Measurable u ∧ orbitAverage η u ≤ 1 ∧
        X ≤ fun x ↦ u x + (1 - orbitAverage η u x) := by
  refine ⟨fun hX ↦ ⟨hX.measurable, X, hX.measurable, hX.orbitAverage_le_one,
    fun _ ↦ le_self_add⟩, fun ⟨hX, u, hu, h, hle⟩ ↦ ?_⟩
  exact (isExactEVar_invariantMeasures_add_one_sub hu h).toIsEVar.mono hX hle

/-- **Normalized functions are exact e-variables** [LRR26, Example 5.7]: for a right-invariant
probability measure `η` on `G` and a measurable `f ≥ 0` with finite orbit averages, the ratio
`f / avg f`, with `0 / 0 = 1`, is an exact e-variable for the invariant null. -/
theorem isExactEVar_invariantMeasures_ite_div [MeasurableMul G] [η.IsMulRightInvariant]
    (hf : Measurable f) (hfin : ∀ x, orbitAverage η f x ≠ ∞) :
    IsExactEVar (fun x ↦ if orbitAverage η f x = 0 then 1 else f x / orbitAverage η f x)
      (invariantMeasuresOfMeasureUnivEq G Ω 1) := by
  have hf' := hf.orbitAverage (η := η)
  refine isExactEVar_invariantMeasures_of_orbitAverage_eq_one (η := η)
    (.ite (measurableSet_eq_fun hf' measurable_const) measurable_const (hf.div hf'))
    (funext fun x ↦ ?_)
  simp [orbitAverage_ite_div (η := η) hf, hfin x]

/-- **Normalized functions are e-variables**: for a right-invariant probability measure `η` on
`G` and a measurable `f ≥ 0`, the ratio `f / avg f`, with `0 / 0 = 1`, is an e-variable for the
invariant null. It is exact when `avg f` is finite everywhere
(`isExactEVar_invariantMeasures_ite_div`). -/
theorem isEVar_invariantMeasures_ite_div [MeasurableMul G] [η.IsMulRightInvariant]
    (hf : Measurable f) :
    IsEVar (fun x ↦ if orbitAverage η f x = 0 then 1 else f x / orbitAverage η f x)
      (invariantMeasuresOfMeasureUnivEq G Ω 1) := by
  have hf' := hf.orbitAverage (η := η)
  refine isEVar_invariantMeasures_of_orbitAverage_le_one (η := η)
    (.ite (measurableSet_eq_fun hf' measurable_const) measurable_const (hf.div hf'))
    fun x ↦ ?_
  rw [orbitAverage_ite_div (η := η) hf]
  split_ifs <;> simp

end OrbitAverage

/-! ### Finite groups -/

section Finite

variable [Fintype G] [MeasurableConstSMul G Ω]

omit [Group G] in
/-- The number of elements of a finite group, as an extended nonnegative real, is not zero. -/
private lemma natCast_card_ne_zero [Nonempty G] : (Fintype.card G : ℝ≥0∞) ≠ 0 :=
  Nat.cast_ne_zero.2 Fintype.card_ne_zero

/-- A finite group carries a σ-algebra and a left- and right-invariant probability measure `η`, the
uniform measure, for which the action is jointly measurable and the orbit averages are the averages
`(∑ g, f (g • x)) / #G` over the group. -/
private lemma exists_uniform : ∃ (_ : MeasurableSpace G) (_ : MeasurableMul G)
    (_ : MeasurableSMul₂ G Ω) (η : Measure G), IsProbabilityMeasure η ∧ η.IsMulLeftInvariant ∧
      η.IsMulRightInvariant ∧
      ∀ f : Ω → ℝ≥0∞, orbitAverage η f = fun x ↦ (∑ g : G, f (g • x)) / Fintype.card G := by
  let : MeasurableSpace G := ⊤
  have : DiscreteMeasurableSpace G := ⟨fun _ ↦ trivial⟩
  refine ⟨‹_›, inferInstance, ⟨measurable_from_prod_countable_right measurable_const_smul⟩,
    (Fintype.card G : ℝ≥0∞)⁻¹ • count, ⟨?_⟩, inferInstance, inferInstance,
    orbitAverage_inv_card_smul_count⟩
  simp [count_univ, ENat.card_eq_coe_fintype_card, ENNReal.inv_mul_cancel]

/-- **The e-variables for the invariant null of a finite group**: a function is an e-variable for
the laws invariant under a finite group `G` exactly when it is measurable and
`∑ g, X (g • x) ≤ #G` at every point. -/
theorem isEVar_invariantMeasures_iff_sum_le :
    IsEVar X (invariantMeasuresOfMeasureUnivEq G Ω 1) ↔
      Measurable X ∧ ∀ x, ∑ g : G, X (g • x) ≤ Fintype.card G := by
  obtain ⟨_, _, _, η, _, _, _, hη⟩ := exists_uniform (G := G) (Ω := Ω)
  have hG := natCast_card_ne_zero (G := G)
  rw [isEVar_invariantMeasures_iff (η := η), hη, Pi.le_def]
  simp_rw [Pi.one_apply, ENNReal.div_le_iff hG (ENNReal.natCast_ne_top _), one_mul]

/-- **The exact e-variables for the invariant null of a finite group**: a function is an exact
e-variable for the laws invariant under a finite group `G` exactly when it is measurable and
`∑ g, X (g • x) = #G` at every point. -/
theorem isExactEVar_invariantMeasures_iff_sum_eq :
    IsExactEVar X (invariantMeasuresOfMeasureUnivEq G Ω 1) ↔
      Measurable X ∧ ∀ x, ∑ g : G, X (g • x) = Fintype.card G := by
  obtain ⟨_, _, _, η, _, _, _, hη⟩ := exists_uniform (G := G) (Ω := Ω)
  have hG := natCast_card_ne_zero (G := G)
  rw [isExactEVar_invariantMeasures_iff (η := η), hη, funext_iff]
  simp_rw [Pi.one_apply, ENNReal.div_eq_one_iff hG (ENNReal.natCast_ne_top _)]

/-- **The e-variables for the invariant null of a finite group** [LRR26, Theorem 5.5, Example
5.7]: a function is an e-variable for the laws invariant under a finite group `G` exactly when it
is measurable and dominated by `u + (1 - avg u)` for a measurable `u` whose average
`avg u x = (∑ g, u (g • x)) / #G` over the orbits is at most one. -/
theorem isEVar_invariantMeasures_iff_exists_le_sum :
    IsEVar X (invariantMeasuresOfMeasureUnivEq G Ω 1) ↔
      Measurable X ∧ ∃ u : Ω → ℝ≥0∞, Measurable u ∧ (∀ x, ∑ g : G, u (g • x) ≤ Fintype.card G) ∧
        ∀ x, X x ≤ u x + (1 - (∑ g : G, u (g • x)) / Fintype.card G) := by
  obtain ⟨_, _, _, η, _, _, _, hη⟩ := exists_uniform (G := G) (Ω := Ω)
  have hG := natCast_card_ne_zero (G := G)
  rw [isEVar_invariantMeasures_iff_exists_le (η := η)]
  simp_rw [hη, Pi.le_def, Pi.one_apply, ENNReal.div_le_iff hG (ENNReal.natCast_ne_top _), one_mul]

/-- **Normalized functions are exact e-variables for a finite group** [LRR26, Example 5.7]: for a
measurable `f` with finite values, the ratio `f / avg f` of `f` to its average
`avg f x = (∑ g, f (g • x)) / #G` over the orbits, with `0 / 0 = 1`, is an exact e-variable for the
laws invariant under a finite group `G`. -/
theorem isExactEVar_invariantMeasures_ite_div_sum (hf : Measurable f) (hfin : ∀ x, f x ≠ ∞) :
    IsExactEVar
      (fun x ↦ if ∑ g : G, f (g • x) = 0 then 1 else
        f x / ((∑ g : G, f (g • x)) / Fintype.card G))
      (invariantMeasuresOfMeasureUnivEq G Ω 1) := by
  obtain ⟨_, _, _, η, _, _, _, hη⟩ := exists_uniform (G := G) (Ω := Ω)
  have hG := natCast_card_ne_zero (G := G)
  have h := isExactEVar_invariantMeasures_ite_div (η := η) hf fun x ↦ by
    rw [hη]
    exact ENNReal.div_ne_top (ENNReal.sum_ne_top.2 fun g _ ↦ hfin _) hG
  simpa [hη] using h

end Finite

end ProbabilityTheory
