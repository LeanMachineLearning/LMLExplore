/-!
# The polarity between nulls and bets

An e-variable for a null `S` is a measurable `X : Ω → ℝ≥0∞` with `∫⁻ X ∂P ≤ 1` for every `P ∈ S`
(Statlib's `IsEVar`). This pairing of measures with nonnegative functions, the pairing of the
bipolar theorem of Brannath and Schachermayer [BS99], sets up a Galois connection between nulls and
sets of bets. This file defines its side on measures:

* `ProbabilityTheory.polarNull 𝓔`, the null generated by a set `𝓔` of bets: the measures `μ`
  with `∫⁻ X ∂μ ≤ 1` for every `X ∈ 𝓔`;
* `ProbabilityTheory.upperExp S X`, the upper expectation `⨆ P ∈ S, ∫⁻ X ∂P` of a null.

A null presented by constraints or by bets is a polar, intersected with the probability measures
where needed, and Statlib's effective null `effectiveSet S` is the polar of the set of
e-variables of `S` (`effectiveSet_eq_polarNull`), the closure of `S` for the Galois connection.
The set of e-variables of a null is written `{X | IsEVar X S}`: its convexity, its closure under
`liminf` and its solidity are Statlib's `convex_isEVar`, `isEVar_liminf` and `IsEVar.mono`.

## Main statements

* `ProbabilityTheory.subset_setOf_isEVar_iff`: the Galois connection
  `𝓔 ⊆ {X | IsEVar X S} ↔ S ⊆ polarNull 𝓔`, for measurable bets and every null.
* `ProbabilityTheory.isEVar_iff_upperExp_le_one`: e-variables are the measurable functions of
  upper expectation at most one.
* `ProbabilityTheory.effectiveSet_polarNull`: every polar is closed, `effectiveSet (polarNull 𝓔)`
  being `polarNull 𝓔`.
* `ProbabilityTheory.convex_polarNull`, `ProbabilityTheory.isLowerSet_polarNull`,
  `ProbabilityTheory.mem_polarNull_of_tendsto`: every polar is convex, solid and closed under
  setwise limits along any filter.
* `ProbabilityTheory.measure_univ_le_one_of_mem_polarNull`: when the constant `1` is a bet, the
  members of the polar have mass at most one.

None of these needs the bets to be measurable, except the Galois connection, whose left side
asks for measurability: a non-measurable function is never an e-variable.

## References

* [BS99] W. Brannath and W. Schachermayer, *A bipolar theorem for `L⁰₊(Ω, F, P)`*, Séminaire de
  Probabilités XXXIII, Lecture Notes in Math. 1709 (1999).
* [LRR25] M. Larsson, A. Ramdas and J. Ruf, *The numeraire e-variable and reverse information
  projection*, Ann. Statist. 53 (2025), arXiv:2402.18810v4, Definition 3.1.

The definitions and the proofs of convexity, solidity and closure under setwise limits are adapted
from `notes/book/Suggested.lean` and `notes/book/Checks.lean` (commit `88fb487`) in the paper
project `RemyDegenne/evalues_research` (Apache 2.0).
-/

public section

open MeasureTheory Filter Set
open scoped ENNReal Topology

namespace ProbabilityTheory

variable {Ω : Type*}

/-! ### The upper expectation -/

section UpperExp

variable {mΩ : MeasurableSpace Ω} {S T : Set (Measure Ω)} {P : Measure Ω} {X Y : Ω → ℝ≥0∞}
  {c : ℝ≥0∞}

/-- The upper expectation of `X` under a null `S`: the supremum of the expectations of `X` under
the members of `S`. -/
noncomputable def upperExp (S : Set (Measure Ω)) (X : Ω → ℝ≥0∞) : ℝ≥0∞ :=
  ⨆ P ∈ S, ∫⁻ ω, X ω ∂P

theorem lintegral_le_upperExp (hP : P ∈ S) : ∫⁻ ω, X ω ∂P ≤ upperExp S X :=
  le_biSup (fun P ↦ ∫⁻ ω, X ω ∂P) hP

theorem upperExp_le_iff : upperExp S X ≤ c ↔ ∀ P ∈ S, ∫⁻ ω, X ω ∂P ≤ c :=
  iSup₂_le_iff

/-- The upper expectation is monotone in the null. -/
@[gcongr]
theorem upperExp_mono_set (hST : S ⊆ T) : upperExp S X ≤ upperExp T X :=
  biSup_mono fun _ hP ↦ hST hP

/-- The upper expectation is monotone in the function. -/
@[gcongr]
theorem upperExp_mono (hXY : X ≤ Y) : upperExp S X ≤ upperExp S Y :=
  iSup₂_mono fun _ _ ↦ lintegral_mono hXY

@[simp]
theorem upperExp_empty : upperExp (∅ : Set (Measure Ω)) X = 0 := by
  simp [upperExp]

@[simp]
theorem upperExp_singleton : upperExp {P} X = ∫⁻ ω, X ω ∂P := by
  simp [upperExp]

theorem upperExp_union : upperExp (S ∪ T) X = max (upperExp S X) (upperExp T X) :=
  iSup_union

/-- E-variables are the measurable functions of upper expectation at most one, for every null. -/
theorem isEVar_iff_upperExp_le_one : IsEVar X S ↔ Measurable X ∧ upperExp S X ≤ 1 := by
  rw [upperExp_le_iff]
  exact ⟨fun h ↦ ⟨h.measurable, fun _ hP ↦ h.lintegral_le_one hP⟩, fun h ↦ ⟨h.1, h.2⟩⟩

theorem IsEVar.upperExp_le_one (hX : IsEVar X S) : upperExp S X ≤ 1 :=
  (isEVar_iff_upperExp_le_one.1 hX).2

end UpperExp

/-! ### The null generated by a set of bets -/

section Polar

variable [MeasurableSpace Ω] {𝓔 𝓕 : Set (Ω → ℝ≥0∞)} {S : Set (Measure Ω)} {μ ν : Measure Ω}
  {X : Ω → ℝ≥0∞}

/-- The null generated by a set `𝓔` of bets: the measures `μ` under which every bet `X ∈ 𝓔` has
`∫⁻ X ∂μ ≤ 1`. The σ-algebra is an instance argument, as `𝓔` does not determine it. -/
def polarNull (𝓔 : Set (Ω → ℝ≥0∞)) : Set (Measure Ω) :=
  {μ | ∀ X ∈ 𝓔, ∫⁻ ω, X ω ∂μ ≤ 1}

theorem mem_polarNull_iff : μ ∈ polarNull 𝓔 ↔ ∀ X ∈ 𝓔, ∫⁻ ω, X ω ∂μ ≤ 1 :=
  Iff.rfl

theorem lintegral_le_one_of_mem_polarNull (hμ : μ ∈ polarNull 𝓔) (hX : X ∈ 𝓔) :
    ∫⁻ ω, X ω ∂μ ≤ 1 :=
  hμ X hX

/-- More bets generate a smaller null. -/
@[gcongr]
theorem polarNull_anti (h𝓔𝓕 : 𝓔 ⊆ 𝓕) : polarNull 𝓕 ⊆ polarNull 𝓔 :=
  fun _ hμ X hX ↦ hμ X (h𝓔𝓕 hX)

@[simp]
theorem polarNull_empty : polarNull (∅ : Set (Ω → ℝ≥0∞)) = univ := by
  simp [polarNull]

theorem polarNull_union : polarNull (𝓔 ∪ 𝓕) = polarNull 𝓔 ∩ polarNull 𝓕 := by
  ext μ
  simp only [mem_polarNull_iff, mem_union, mem_inter_iff]
  exact ⟨fun h ↦ ⟨fun X hX ↦ h X (.inl hX), fun X hX ↦ h X (.inr hX)⟩,
    fun h X hX ↦ hX.elim (h.1 X) (h.2 X)⟩

/-- A measurable bet is an e-variable for the null it generates. -/
theorem isEVar_polarNull (hX : Measurable X) (hX𝓔 : X ∈ 𝓔) : IsEVar X (polarNull 𝓔) :=
  ⟨hX, fun _ hμ ↦ hμ X hX𝓔⟩

/-- The Galois connection between nulls and sets of bets: a set of measurable bets consists of
e-variables for `S` exactly when `S` is contained in the null that the bets generate. -/
theorem subset_setOf_isEVar_iff (h𝓔 : ∀ X ∈ 𝓔, Measurable X) :
    𝓔 ⊆ {X | IsEVar X S} ↔ S ⊆ polarNull 𝓔 :=
  ⟨fun h _ hμ _ hX ↦ (h hX).lintegral_le_one hμ, fun h X hX ↦ ⟨h𝓔 X hX, fun _ hμ ↦ h hμ X hX⟩⟩

/-- Statlib's effective null of `S` is the polar of the set of e-variables of `S`: the two
definitions unfold to the same set. -/
theorem effectiveSet_eq_polarNull (S : Set (Measure Ω)) :
    effectiveSet S = polarNull {X | IsEVar X S} :=
  Set.ext fun _ ↦ Iff.rfl

/-- The integral of a bet is the integral of a measurable function below it that is an
e-variable for the null the bets generate. -/
private theorem exists_isEVar_polarNull_lintegral_eq (hX : X ∈ 𝓔) (μ : Measure Ω) :
    ∃ g, IsEVar g (polarNull 𝓔) ∧ ∫⁻ ω, X ω ∂μ = ∫⁻ ω, g ω ∂μ := by
  obtain ⟨g, hg, hgX, hint⟩ := exists_measurable_le_lintegral_eq μ X
  exact ⟨g, ⟨hg, fun _ hν ↦ (lintegral_mono hgX).trans (hν X hX)⟩, hint⟩

/-- Every polar is closed for the Galois connection: its effective null is itself. The bets need
not be measurable. -/
@[simp]
theorem effectiveSet_polarNull (𝓔 : Set (Ω → ℝ≥0∞)) : effectiveSet (polarNull 𝓔) = polarNull 𝓔 := by
  refine Subset.antisymm (fun μ hμ X hX ↦ ?_) subset_effectiveSet
  obtain ⟨g, hg, hint⟩ := exists_isEVar_polarNull_lintegral_eq hX μ
  rw [hint]
  exact hμ g hg

/-- Every polar is convex. The bets need not be measurable. -/
theorem convex_polarNull (𝓔 : Set (Ω → ℝ≥0∞)) : Convex ℝ≥0∞ (polarNull 𝓔) := by
  intro μ hμ ν hν a b _ _ hab X hX
  rw [lintegral_add_measure, lintegral_smul_measure, lintegral_smul_measure, smul_eq_mul,
    smul_eq_mul]
  calc a * ∫⁻ ω, X ω ∂μ + b * ∫⁻ ω, X ω ∂ν
  _ ≤ a * 1 + b * 1 := by gcongr; exacts [hμ X hX, hν X hX]
  _ = 1 := by simpa using hab

/-- Every polar contains the convex hull of each of its subsets. -/
theorem convexHull_subset_polarNull (hS : S ⊆ polarNull 𝓔) : convexHull ℝ≥0∞ S ⊆ polarNull 𝓔 :=
  convexHull_min hS (convex_polarNull 𝓔)

/-- Every polar is solid: a measure below a member is a member. -/
theorem isLowerSet_polarNull (𝓔 : Set (Ω → ℝ≥0∞)) : IsLowerSet (polarNull 𝓔) :=
  fun _ _ hμν hν X hX ↦ (lintegral_mono' hμν le_rfl).trans (hν X hX)

/-- A measure below a member of a polar is a member. -/
theorem mem_polarNull_of_le (hν : ν ∈ polarNull 𝓔) (hμν : μ ≤ ν) : μ ∈ polarNull 𝓔 :=
  isLowerSet_polarNull 𝓔 hμν hν

/-- If `μs i` is eventually in a polar along a filter, and `μ s ≤ liminf (μs · s)` for every
measurable set `s`, then `μ` is in the polar. The bets need not be measurable. -/
theorem mem_polarNull_of_measure_le_liminf {ι : Type*} {l : Filter ι} [l.NeBot]
    {μs : ι → Measure Ω} (hμs : ∀ᶠ i in l, μs i ∈ polarNull 𝓔)
    (h : ∀ s, MeasurableSet s → μ s ≤ liminf (fun i ↦ μs i s) l) : μ ∈ polarNull 𝓔 := by
  intro X hX
  obtain ⟨g, hg, hint⟩ := exists_isEVar_polarNull_lintegral_eq hX μ
  rw [hint]
  exact (lintegral_le_liminf_lintegral_of_forall_measurableSet_measure_le_liminf_measure
    hg.measurable h).trans (liminf_le_of_frequently_le (hμs.mono fun _ hi ↦
      hg.lintegral_le_one hi).frequently)

/-- Every polar is closed under setwise limits along any filter: if `μs i s` tends to `μ s` for
every measurable set `s`, and `μs i` is eventually in the polar, then so is `μ`. -/
theorem mem_polarNull_of_tendsto {ι : Type*} {l : Filter ι} [l.NeBot] {μs : ι → Measure Ω}
    (hμs : ∀ᶠ i in l, μs i ∈ polarNull 𝓔)
    (h : ∀ s, MeasurableSet s → Tendsto (fun i ↦ μs i s) l (𝓝 (μ s))) : μ ∈ polarNull 𝓔 :=
  mem_polarNull_of_measure_le_liminf hμs fun s hs ↦ (h s hs).liminf_eq.ge

/-- When the constant `1` is a bet, every member of the polar has mass at most one. -/
theorem measure_univ_le_one_of_mem_polarNull (h1 : 1 ∈ 𝓔) (hμ : μ ∈ polarNull 𝓔) :
    μ univ ≤ 1 := by
  simpa using hμ 1 h1

end Polar

end ProbabilityTheory
